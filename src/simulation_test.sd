// Runs the game without a window and checks the rules: the walls, the traffic, being run over, crossing and the
// abilities. Game.simulate reads no input, so the heroes are given their orders here.
//
//     saad run simulation_test.sd        from src

import aov;
import fmt;
import math;
import random;
use raylib;

Dt :: 1.0 / 60.0;

main :: () {
    testPushOutOfRect();
    testWalls();
    testTraffic();
    testNoGapBetweenLanes();
    testFrozenCars();
    testRunOver();
    testCrossing();
    testAbilities();
    fmt.print("All simulation tests passed");
}

near :: (a: f32, b: f32, tolerance: f32 = 0.001) -> bool {
    return math.fabsf(a - b) <= tolerance;
}

testPushOutOfRect :: () {
    wall := Rectangle{0, 0, 2, 10};

    // Not touching
    assert(!aov.pushOutOfRect({5, 5}, 1, wall).hasValue());

    // Overlapping from the left: pushed out to the left side
    pushed := aov.pushOutOfRect({-0.5, 5}, 1, wall);
    assert(pushed.hasValue() && near(pushed.value().x, -1) && near(pushed.value().y, 5));

    // The center inside, nearest to the right side
    inside := aov.pushOutOfRect({1.8, 5}, 1, wall);
    assert(inside.hasValue() && near(inside.value().x, 3));

    // At a corner: out along the diagonal
    corner := aov.pushOutOfRect({2.5, -0.5}, 1, wall);
    assert(corner.hasValue() && near(corner.value().distance({2, 0}), 1));
}

testWalls :: () {
    game := aov.newGame(1);
    defer game.free();
    clearRoad(game);

    // Allan walks straight into the long wall on the start side, and stops there
    game.spawnHero(.allan);
    game.hero.position = Vector3{-60, 0, 30};
    game.hero.moveTo(Vector3{0, 0, 30});
    for 0..600 { game.simulate(Dt); }
    wallSide := -aov.RoadHalfWidth - aov.WallWidth;
    assert(game.hero.position.x <= wallSide - game.hero.info().hitRadius + 0.01);
    assert(!game.hero.isMoving);

    // Ghosty floats through it
    game.spawnHero(.ghosty);
    game.hero.position = Vector3{-60, 0, 30};
    game.hero.moveTo(Vector3{-30, 0, 30});
    for 0..600 { game.simulate(Dt); }
    assert(near(game.hero.position.x, -30, 0.01));

    // Nobody leaves the field
    game.hero.position = Vector3{-70, 0, 0};
    game.hero.moveTo(Vector3{-200, 0, 0});
    for 0..600 { game.simulate(Dt); }
    assert(game.hero.position.x >= -aov.MapHalfWidth);
}

testTraffic :: () {
    rng := random.newRandom(42);
    traffic := aov.newTraffic(0, &rng);
    assert(traffic.activeCount() > 20);

    // Every car drives from the far end of the road towards the camera, and never back
    for 0..3000 {
        before: [aov.MaxCars]f32;
        for car, i in traffic.cars { before[i] = car.z; }
        traffic.update(Dt, &rng, null);
        for car, i in traffic.cars {
            if !car.isActive { continue; }
            assert(car.speed > 0);
            justSpawned := car.z == -aov.RoadEnd - car.length() * 0.5;     // A new car in the place of one that left
            if !justSpawned { assert(car.z >= before[i]); }
            if car.isActive { assert(car.z >= -aov.RoadEnd - car.length() && car.z <= aov.RoadEnd + car.length()); }
        }
    }

    // A faster car drives straight through a slower one in its lane: nobody waits
    clear: aov.Traffic;
    clear.lanes[0].speed = 10;
    clear.lanes[0].spawnTimer = 100000;
    clear.cars[0] = aov.Car{isActive: true, lane: 0, z: 0, speed: 5};
    clear.cars[1] = aov.Car{isActive: true, lane: 0, z: -10, speed: 20};
    for 0..60 { clear.update(Dt, &rng, null); }
    assert(clear.cars[1].z > clear.cars[0].z);
    assert(near(clear.cars[0].z, 5, 0.01) && near(clear.cars[1].z, 10, 0.01));

    // A higher level is faster
    slowLane := traffic.lanes[3].speed;
    traffic.setLevel(10, &rng);
    assert(traffic.lanes.reduce(0.0, (sum, lane) => sum + lane.speed) > slowLane);
}

testNoGapBetweenLanes :: () {
    // Between two cars side by side there is less room than the smallest hero takes
    for kind in aov.HeroKind.values {
        assert(aov.LaneWidth - aov.CarWidth < kind.definition().hitRadius * 2);
    }

    // Standing on the line between two lanes, a car in either lane gets you
    for lane in 0..aov.LaneCount {
        traffic: aov.Traffic;
        traffic.cars[0] = aov.Car{isActive: true, lane: lane as int, z: 0, speed: 10};
        left  := aov.laneCenter(lane as int) - aov.LaneWidth * 0.5;
        right := aov.laneCenter(lane as int) + aov.LaneWidth * 0.5;
        assert(traffic.carHitting({left, 0}, 0.7).hasValue());
        assert(traffic.carHitting({right, 0}, 0.7).hasValue());
        assert(aov.laneAt(aov.laneCenter(lane as int)) == lane);
    }
}

testFrozenCars :: () {
    rng := random.newRandom(7);
    traffic := aov.newTraffic(3, &rng);

    // Frozen cars stay where they are, and the cars behind them drive on through them
    frozen := traffic.freezeAround({0, 0}, 30, 8);
    assert(frozen > 0);
    positions: [aov.MaxCars]f32;
    for car, i in traffic.cars { positions[i] = car.z; }

    for 0..(4 * 60) { traffic.update(Dt, &rng, null); }
    for car, i in traffic.cars {
        if car.isActive && car.frozenLeft > 0 { assert(car.z == positions[i]); }
    }
    assert(traffic.cars.countWhere(car => car.isActive && car.frozenLeft > 0) == frozen);

    // And drive on when they thaw
    for 0..(10 * 60) { traffic.update(Dt, &rng, null); }
    assert(traffic.cars.countWhere(car => car.isActive && car.frozenLeft > 0) == 0);
}

testRunOver :: () {
    game := aov.newGame(3);
    defer game.free();

    // Standing still in the middle of a busy lane does not end well
    kind := game.hero.kind;
    game.hero.position = Vector3{aov.laneCenter(2), 0, 0};
    for 0..(30 * 60) {
        game.simulate(Dt);
        if game.phase.kind == .runOver { break; }
        game.hero.position = Vector3{aov.laneCenter(2), 0, 0};
    }
    assert(game.phase.kind == .runOver);
    assert(game.stats.deaths == 1 && game.stats.deathsBy[kind] == 1);

    // After a moment the next hero comes, never the same one, on the same side
    for 0..((aov.RespawnDelay + 0.1) * 60) as int { game.simulate(Dt); }
    assert(game.phase.kind == .playing);
    assert(game.hero.kind != kind);
    assert(game.startSide == .left && near(game.hero.position.x, aov.SpawnX));
}

testCrossing :: () {
    game := aov.newGame(5);
    defer game.free();
    clearRoad(game);

    // Walk in at the opening on the start side, across the empty road, and out at the opening on the far side
    game.spawnHero(.allan);
    walkTo(game, game.world.entrance.at() - Vector3{4, 0, 0});
    walkTo(game, game.world.entrance.at() + Vector3{4, 0, 0});
    walkTo(game, game.world.exit.at() - Vector3{4, 0, 0});
    walkTo(game, game.world.exit.at() + Vector3{6, 0, 0});

    assert(game.phase.kind == .crossed);
    assert(game.stats.crossings == 1 && game.stats.bestTime.hasValue());

    for 0..(2 * 60) { game.simulate(Dt); }
    assert(game.phase.kind == .playing && game.stats.level == 1);
    assert(game.hero.kind != .allan);

    // The next hero starts on the far side, and crosses back, in at the opening there and out at the first one
    assert(game.startSide == .right && near(game.hero.position.x, -aov.SpawnX));
    walkTo(game, game.world.exit.at() + Vector3{4, 0, 0});
    walkTo(game, game.world.exit.at() - Vector3{4, 0, 0});
    walkTo(game, game.world.entrance.at() + Vector3{4, 0, 0});
    walkTo(game, game.world.entrance.at() - Vector3{6, 0, 0});
    assert(game.phase.kind == .crossed && game.stats.crossings == 2);
    for 0..(2 * 60) { game.simulate(Dt); }
    assert(game.startSide == .left && near(game.hero.position.x, aov.SpawnX));
}

testAbilities :: () {
    game := aov.newGame(9);
    defer game.free();
    clearRoad(game);

    // Every hero has abilities, no more than there are keys, each with an icon
    for kind in aov.HeroKind.values {
        abilities := kind.definition().abilities;
        assert(abilities.count >= 1 && abilities.count <= aov.MaxAbilities);
        for ability in abilities {
            assert(ability.icon.len > 0 && ability.name.len > 0);
            assert(ability.isPassive() == (ability.cooldown == 0));
        }
    }

    // Allan: Q sprints, then cools down. His passive makes him faster all the time
    game.spawnHero(.allan);
    normal := game.hero.speed();
    assert(near(normal, aov.HeroKind.allan.definition().moveSpeed * 1.1));
    game.useAbility(0);
    assert(game.hero.speed() > normal * 2);
    assert(!game.hero.abilityReady(0) && game.hero.abilityReady(1));
    for 0..(7 * 60) { game.simulate(Dt); }
    assert(near(game.hero.speed(), normal) && game.hero.abilityReady(0));

    // W blinks to the cursor, no further than its range
    game.hero.position = Vector3{-70, 0, 0};
    game.mouseGround = Vector3{-70, 0, 40};
    game.useAbility(1);
    assert(game.hero.position.distance(Vector3{-70, 0, 12}) < 0.01);
    assert(!game.hero.abilityReady(1));

    // A passive can't be cast, and slots past the last ability do nothing
    game.useAbility(2);
    game.useAbility(5);
    assert(game.hero.cooldowns[2] == 0 && game.hero.cooldowns[5] == 0);

    // The butcher hooks a point and is pulled to it, no further than the hook reaches
    game.spawnHero(.butcher);
    game.hero.position = Vector3{-70, 0, 0};
    game.mouseGround = Vector3{-55, 0, 10};
    game.useAbility(0);
    assert(game.hero.hook.hasValue());
    for 0..60 { game.simulate(Dt); }
    assert(!game.hero.hook.hasValue());
    assert(game.hero.position.distance(Vector3{-55, 0, 10}) < 0.5);

    // Aimed past its reach, it goes as far as it reaches
    game.hero.cooldowns[0] = 0;
    game.mouseGround = Vector3{-55, 0, -190};
    game.useAbility(0);
    for 0..120 { game.simulate(Dt); }
    assert(game.hero.position.distance(Vector3{-55, 0, 10 - 26}) < 0.5);

    // A wall in the way stops the pull at the wall
    game.hero.cooldowns[0] = 0;
    game.mouseGround = Vector3{0, 0, -16};
    game.useAbility(0);
    for 0..120 { game.simulate(Dt); }
    assert(!game.hero.hook.hasValue());
    assert(near(game.hero.position.x, -aov.RoadHalfWidth - aov.WallWidth - game.hero.info().hitRadius, 0.05));

    // Frosty freezes the cars around him, and his chill aura slows the cars near him
    game.spawnHero(.frosty);
    game.traffic = aov.newTraffic(0, &game.rng);
    game.hero.position = Vector3{-aov.RoadHalfWidth + 2, 0, 0};
    game.useAbility(0);
    assert(game.traffic.cars.some(car => car.isActive && car.frozenLeft > 0));

    slowed: aov.Traffic;
    slowed.lanes[0].spawnTimer = 100000;
    slowed.cars[0] = aov.Car{isActive: true, lane: 0, z: 0, speed: 10};
    slowed.cars[1] = aov.Car{isActive: true, lane: 0, z: -40, speed: 10};
    zone := aov.SlowZone{{aov.laneCenter(0), 0}, 12, 0.4};
    slowed.update(1, &game.rng, zone);
    assert(near(slowed.cars[0].z, 6) && near(slowed.cars[1].z, -30));

    // Ghosty: Q fades, and the cars drive through him while he is faded
    game.spawnHero(.ghosty);
    game.traffic = aov.newTraffic(5, &game.rng);
    game.useAbility(0);
    assert(game.hero.isFaded() && !game.hero.abilityReady(0));
    for 0..60 {
        game.hero.position = Vector3{aov.laneCenter(4), 0, 0};
        game.simulate(Dt);
        if !game.hero.isFaded() { break; }
        assert(game.phase.kind == .playing);
    }
}

//
// Helpers
//

// Takes every car off the road, and keeps new ones away for a long time
clearRoad :: (game: *aov.Game) {
    for *car in game.traffic.cars { car.isActive = false; }
    for *lane in game.traffic.lanes { lane.spawnTimer = 100000; }
}

walkTo :: (game: *aov.Game, point: Vector3) {
    game.hero.moveTo(point);
    for 0..(20 * 60) {
        game.simulate(Dt);
        if !game.hero.isMoving || game.phase.kind != .playing { return; }
    }
    assert(false);
}
