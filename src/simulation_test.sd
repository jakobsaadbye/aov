// Runs the game without a window and checks the rules: the walls, the traffic, being run over, crossing and the
// abilities. Game.simulate reads no input, so the heroes are given their orders here.
//
//     saad run simulation_test.sd        from src

import console;
import core;
import bots;
import fmt;
import math;
import random;
import json;
import time;
use raylib;

Dt :: 1.0 / 60.0;

noZones: [..]core.SlowZone;

main :: () {
    fmt.print("start");
    testPushOutOfRect();
    fmt.print("rect");
    testWalls();
    fmt.print("testWalls");
    testTraffic();
    fmt.print("testTraffic");
    testNoGapBetweenLanes();
    fmt.print("testNoGapBetweenLanes");
    testFrozenCars();
    fmt.print("testFrozenCars");
    testRunOver();
    fmt.print("testRunOver");
    testHealth();
    fmt.print("testHealth");
    testCrossing();
    fmt.print("testCrossing");
    testAbilities();
    fmt.print("testAbilities");
    testNewHeroes();
    fmt.print("testNewHeroes");
    testCommands();
    testEnemySpells();
    testForecast();
    testBotCrosses();
    testRecording();
    testGenomes();
    testKills();
    testConsole();
    testItems();
    testHazards();
    testSpectating();
    testItemAuras();
    testMatch();
    testParticles();
    fmt.print("All simulation tests passed");
}

near :: (a: f32, b: f32, tolerance: f32 = 0.001) -> bool {
    return math.fabsf(a - b) <= tolerance;
}

testPushOutOfRect :: () {
    wall := Rectangle{0, 0, 2, 10};

    // Not touching
    assert(!core.pushOutOfRect({5, 5}, 1, wall).hasValue());

    // Overlapping from the left: pushed out to the left side
    pushed := core.pushOutOfRect({-0.5, 5}, 1, wall);
    assert(pushed.hasValue() && near(pushed.value().x, -1) && near(pushed.value().y, 5));

    // The center inside, nearest to the right side
    inside := core.pushOutOfRect({1.8, 5}, 1, wall);
    assert(inside.hasValue() && near(inside.value().x, 3));

    // At a corner: out along the diagonal
    corner := core.pushOutOfRect({2.5, -0.5}, 1, wall);
    assert(corner.hasValue() && near(corner.value().distance({2, 0}), 1));
}

testWalls :: () {
    game := bots.newGame(1, bots: 0);
    defer game.free();
    clearRoad(game);

    // Allan walks straight into the long wall on the start side, and stops there
    game.spawnHero(0, .allan);
    game.you().hero.position = Vector3{-108, 0, 30};
    game.you().hero.moveTo(Vector3{0, 0, 30});
    for 0..600 { game.simulate(Dt); }
    wallSide := -core.RoadHalfWidth - core.WallWidth;
    assert(game.you().hero.position.x <= wallSide - game.you().hero.info().hitRadius + 0.01);
    assert(!game.you().hero.isMoving);

    // Ghosty floats through it
    game.spawnHero(0, .ghosty);
    game.you().hero.position = Vector3{-108, 0, 30};
    game.you().hero.moveTo(Vector3{-78, 0, 30});
    for 0..600 { game.simulate(Dt); }
    assert(near(game.you().hero.position.x, -78, 0.01));

    // Nobody leaves the field
    game.you().hero.position = Vector3{-118, 0, 0};
    game.you().hero.moveTo(Vector3{-248, 0, 0});
    for 0..600 { game.simulate(Dt); }
    assert(game.you().hero.position.x >= -core.MapHalfWidth);
}

testTraffic :: () {
    rng := random.newRandom(42);
    traffic := core.newTraffic(0, &rng);
    assert(traffic.activeCount() > 20);

    // Every car drives from the far end of the road towards the camera, and never back
    for 0..3000 {
        before: [core.MaxCars]f32;
        for car, i in traffic.cars { before[i] = car.z; }
        traffic.update(Dt, &rng, noZones);
        for car, i in traffic.cars {
            if !car.isActive { continue; }
            assert(car.speed > 0);
            justSpawned := car.age == 0;            // A new car in the place of one that left
            if !justSpawned { assert(car.z >= before[i]); }
            // Ambulances at the side of a convoy start a bit behind
            assert(car.z >= -core.RoadEnd - car.length() - core.EmergencyBehind && car.z <= core.RoadEnd + car.length());
        }
    }

    // A faster car drives straight through a slower one in its lane: nobody waits
    clear: core.Traffic;
    clear.lanes[0].speed = 10;
    clear.lanes[0].spawnTimer = 100000;
    clear.cars[0] = core.Car{isActive: true, lane: 0, z: 0, speed: 5};
    clear.cars[1] = core.Car{isActive: true, lane: 0, z: -10, speed: 20};
    for 0..60 { clear.update(Dt, &rng, noZones); }
    assert(clear.cars[1].z > clear.cars[0].z);
    assert(near(clear.cars[0].z, 5, 0.01) && near(clear.cars[1].z, 10, 0.01));

    // A higher level is faster
    slowLane := traffic.lanes[3].speed;
    traffic.setLevel(10, &rng);
    assert(traffic.lanes.reduce(0.0, (sum, lane) => sum + lane.speed) > slowLane);
}

testNoGapBetweenLanes :: () {
    // Between two cars side by side there is less room than the smallest hero takes
    for kind in core.HeroKind.values {
        assert(core.LaneWidth - core.CarWidth < kind.definition().hitRadius * 2);
    }

    // Standing on the line between two lanes, a car in either lane gets you
    for lane in 0..core.LaneCount {
        traffic: core.Traffic;
        traffic.cars[0] = core.Car{isActive: true, lane: lane as int, z: 0, speed: 10};
        left  := core.laneCenter(lane as int) - core.LaneWidth * 0.5;
        right := core.laneCenter(lane as int) + core.LaneWidth * 0.5;
        assert(traffic.carHitting({left, 0}, 0.7).hasValue());
        assert(traffic.carHitting({right, 0}, 0.7).hasValue());
        assert(core.laneAt(core.laneCenter(lane as int)) == lane);
    }
}

testFrozenCars :: () {
    rng := random.newRandom(7);
    traffic := core.newTraffic(3, &rng);

    // Frozen cars stay where they are, and the cars behind them drive on through them
    frozen := traffic.freezeAround({0, 0}, 30, 8);
    assert(frozen > 0);
    positions: [core.MaxCars]f32;
    for car, i in traffic.cars { positions[i] = car.z; }

    for 0..(4 * 60) { traffic.update(Dt, &rng, noZones); }
    for car, i in traffic.cars {
        if car.isActive && car.frozenLeft > 0 { assert(car.z == positions[i]); }
    }
    assert(traffic.cars.countWhere(car => car.isActive && car.frozenLeft > 0) == frozen);

    // And drive on when they thaw
    for 0..(10 * 60) { traffic.update(Dt, &rng, noZones); }
    assert(traffic.cars.countWhere(car => car.isActive && car.frozenLeft > 0) == 0);
}

testRunOver :: () {
    game := bots.newGame(3, bots: 0);
    defer game.free();

    // Standing still in the middle of a busy lane does not end well
    kind := game.you().hero.kind;
    game.you().hero.position = Vector3{core.laneCenter(2), 0, 0};
    for 0..(30 * 60) {
        game.simulate(Dt);
        if game.you().phase.kind == .runOver { break; }
        game.you().hero.position = Vector3{core.laneCenter(2), 0, 0};
    }
    assert(game.you().phase.kind == .runOver);
    assert(game.you().stats.deaths == 1 && game.you().stats.deathsBy[kind] == 1);

    // After a moment the next hero comes, never the same one, on the same side
    for 0..((core.RespawnDelay + 0.1) * 60) as int { game.simulate(Dt); }
    assert(game.you().phase.kind == .playing);
    assert(game.you().hero.kind != kind);
    assert(game.you().startSide == .left && near(game.you().hero.position.x, core.SpawnX));
}

testHealth :: () {
    game := bots.newGame(4, bots: 0);
    defer game.free();
    clearRoad(game);

    // A car on a hero takes health fast: Allan doesn't last long
    game.spawnHero(0, .allan);
    game.you().hero.position = Vector3{core.laneCenter(3), 0, 0};
    game.traffic.cars[0] = core.Car{isActive: true, lane: 3, z: 0, speed: 0.001};
    seconds := 0.0;
    while game.you().phase.kind == .playing && seconds < 2 {
        game.simulate(Dt);
        seconds += Dt;
    }
    assert(game.you().phase.kind == .runOver && seconds < 0.4);

    // The butcher survives a car driving over him, then heals
    for 0..(2 * 60) { game.simulate(Dt); }
    clearRoad(game);
    game.spawnHero(0, .butcher);
    maxHealth := game.you().hero.info().maxHealth;
    game.you().hero.position = Vector3{core.laneCenter(3), 0, 0};
    game.traffic.cars[0] = core.Car{isActive: true, lane: 3, z: -10, speed: 20};    // Over him in about half a second
    for 0..90 { game.simulate(Dt); }
    assert(game.you().phase.kind == .playing);
    assert(game.you().hero.health < maxHealth * 0.6 && game.you().hero.health > 0);

    // Nothing heals him, on the road or off it
    for 0..(3 * 60) { game.simulate(Dt); }
    assert(game.you().hero.health < maxHealth * 0.6);
    game.you().hero.position = Vector3{-108, 0, 0};
    for 0..(6 * 60) { game.simulate(Dt); }
    assert(game.you().hero.health < maxHealth * 0.6);

    // Faded, the cars do nothing
    game.spawnHero(0, .ghosty);
    game.you().hero.position = Vector3{core.laneCenter(3), 0, 0};
    game.traffic.cars[0] = core.Car{isActive: true, lane: 3, z: 0, speed: 0.001};
    game.useAbility(0);
    for 0..60 { game.simulate(Dt); }
    assert(game.you().phase.kind == .playing && game.you().hero.health == game.you().hero.info().maxHealth);
}

testCrossing :: () {
    game := bots.newGame(5, bots: 0);
    defer game.free();
    clearRoad(game);

    // Walk in at the opening on the start side, across the empty road, and out at the opening on the far side
    game.spawnHero(0, .allan);
    walkTo(game, game.world.entrance.at() - Vector3{4, 0, 0});
    walkTo(game, game.world.entrance.at() + Vector3{4, 0, 0});
    walkTo(game, game.world.exit.at() - Vector3{4, 0, 0});
    walkTo(game, game.world.exit.at() + Vector3{6, 0, 0});

    assert(game.you().phase.kind == .crossed);
    assert(game.you().stats.crossings == 1 && game.you().stats.bestTime.hasValue());

    for 0..(2 * 60) { game.simulate(Dt); }
    assert(game.you().phase.kind == .playing && game.level() == 1);
    assert(game.you().hero.kind != .allan);

    // The next hero starts on the far side, and crosses back, in at the opening there and out at the first one
    assert(game.you().startSide == .right && near(game.you().hero.position.x, -core.SpawnX));
    walkTo(game, game.world.exit.at() + Vector3{4, 0, 0});
    walkTo(game, game.world.exit.at() - Vector3{4, 0, 0});
    walkTo(game, game.world.entrance.at() + Vector3{4, 0, 0});
    walkTo(game, game.world.entrance.at() - Vector3{6, 0, 0});
    assert(game.you().phase.kind == .crossed && game.you().stats.crossings == 2);
    for 0..(2 * 60) { game.simulate(Dt); }
    assert(game.you().startSide == .left && near(game.you().hero.position.x, core.SpawnX));
}

testAbilities :: () {
    game := bots.newGame(9, bots: 0);
    defer game.free();
    clearRoad(game);

    // Every hero has abilities, no more than there are keys, each with an icon
    for kind in core.HeroKind.values {
        abilities := kind.definition().abilities;
        assert(abilities.count >= 1 && abilities.count <= core.MaxAbilities);
        for ability in abilities {
            assert(ability.icon.len > 0 && ability.name.len > 0);
            assert(ability.isPassive() == (ability.cooldown == 0));
        }
    }

    // Allan: Q sprints, then cools down. His passive makes him faster all the time
    game.spawnHero(0, .allan);
    normal := game.you().hero.speed();
    assert(near(normal, core.HeroKind.allan.definition().moveSpeed * 1.1));
    game.useAbility(0);
    assert(game.you().hero.speed() > normal * 2);
    assert(!game.you().hero.abilityReady(0));
    for 0..(7 * 60) { game.simulate(Dt); }
    assert(near(game.you().hero.speed(), normal) && game.you().hero.abilityReady(0));

    // He has no blink: only Sprint on Q
    assert(game.you().hero.abilityOnKey(0) == 0 && game.you().hero.abilityOnKey(1) == -1 && game.you().hero.keyOf(1) == -1);

    // Frosty's Slide blinks to the cursor, no further than its range
    game.spawnHero(0, .frosty);
    game.you().hero.position = Vector3{-118, 0, 0};
    game.mouseGround = Vector3{-118, 0, 40};
    game.useAbility(1);
    assert(game.you().hero.position.distance(Vector3{-118, 0, 9}) < 0.01);
    assert(!game.you().hero.abilityReady(1));

    // The keys go to the abilities that are cast, in order. Passives have none
    frosty := core.newHero(.frosty, {0, 0, 0}, 0);
    assert(frosty.abilityOnKey(1) == 1 && frosty.abilityOnKey(2) == -1 && frosty.keyOf(2) == -1);

    // A passive can't be cast, and slots past the last ability do nothing
    game.useAbility(2);
    game.useAbility(5);
    assert(game.you().hero.cooldowns[2] == 0 && game.you().hero.cooldowns[5] == 0);

    // The butcher's hook bites into a car, and he is pulled to its side
    game.spawnHero(0, .butcher);
    butcher := &game.you().hero;
    grass := -core.RoadHalfWidth - core.WallWidth - 6;
    butcher.position = Vector3{core.laneCenter(0), 0, 0};    // On the road, in an empty lane
    game.traffic.cars[0] = core.Car{isActive: true, kind: .car, lane: 3, z: 0, speed: 0.001};
    game.mouseGround = Vector3{core.laneCenter(3), 0, 0};
    game.useAbility(0);
    assert(butcher.hook.hasValue());
    for 0..120 { game.simulate(Dt); }
    assert(!butcher.hook.hasValue());
    beside := core.laneCenter(3) - core.CarWidth * 0.5 - butcher.info().hitRadius - 0.4;
    assert(near(butcher.position.x, beside, 0.5));

    // Without a car to bite, it comes back and nothing happens
    clearRoad(game);
    butcher.cooldowns[0] = 0;
    butcher.position = Vector3{grass, 0, 0};
    game.mouseGround = Vector3{grass + 20, 0, 0};
    game.useAbility(0);
    for 0..120 { game.simulate(Dt); }
    assert(!butcher.hook.hasValue() && near(butcher.position.x, grass, 0.01));

    // He walks while it flies, and it goes past an enemy without catching it
    butcher.cooldowns[0] = 0;
    butcher.position = Vector3{grass, 0, 0};
    butcher.moveTo(Vector3{grass, 0, 20});
    game.mouseGround = Vector3{grass + 20, 0, 0};
    game.useAbility(0);
    for 0..12 { game.simulate(Dt); }
    assert(butcher.hook.hasValue() && butcher.position.z > 1);

    // Frosty freezes the cars around him, and his chill aura slows the cars near him
    game.spawnHero(0, .frosty);
    game.traffic = core.newTraffic(0, &game.rng);
    game.you().hero.position = Vector3{-core.RoadHalfWidth + 2, 0, 0};
    game.useAbility(0);
    assert(game.traffic.cars.some(car => car.isActive && car.frozenLeft > 0));

    slowed: core.Traffic;
    slowed.lanes[0].spawnTimer = 100000;
    slowed.cars[0] = core.Car{isActive: true, lane: 0, z: 0, speed: 10};
    slowed.cars[1] = core.Car{isActive: true, lane: 0, z: -40, speed: 10};
    zone := core.SlowZone{{core.laneCenter(0), 0}, 12, 0.4};
    zones: [..]core.SlowZone = [zone];
    slowed.update(1, &game.rng, zones);
    assert(near(slowed.cars[0].z, 6) && near(slowed.cars[1].z, -30));

    // Ghosty: Q fades, and the cars drive through him while he is faded
    game.spawnHero(0, .ghosty);
    game.traffic = core.newTraffic(5, &game.rng);
    game.useAbility(0);
    assert(game.you().hero.isFaded() && !game.you().hero.abilityReady(0));
    for 0..60 {
        game.you().hero.position = Vector3{core.laneCenter(4), 0, 0};
        game.simulate(Dt);
        if !game.you().hero.isFaded() { break; }
        assert(game.you().phase.kind == .playing);
    }
}

testNewHeroes :: () {
    game := bots.newGame(3, bots: 0);
    defer game.free();

    // Bjørn leaps over the wall and the cars, which can't hit him in the air, and lands where he aimed
    game.spawnHero(0, .bjorn);
    game.traffic = core.newTraffic(8, &game.rng);
    start := Vector3{-core.RoadHalfWidth - core.WallWidth - 2, 0, 0};
    game.you().hero.position = start;
    game.mouseGround = Vector3{-core.RoadHalfWidth + 9, 0, 0};
    game.useAbility(0);
    assert(game.you().hero.isAirborne() && !game.you().hero.abilityReady(0));
    for 0..30 {
        game.simulate(Dt);
        assert(game.you().phase.kind == .playing && game.you().hero.health == game.you().hero.info().maxHealth);
    }
    assert(game.you().hero.isAirborne());
    for 0..30 { game.simulate(Dt); }
    assert(!game.you().hero.isAirborne() || game.you().phase.kind != .playing);

    // His iron hide halves the damage of a car
    assert(near(game.you().hero.damageTaken(), 0.5));
    game.spawnHero(0, .allan);
    assert(near(game.you().hero.damageTaken(), 1));

    // Hilda stops the lanes around her: the cars queue up before the line, one behind the other, and drive on after
    game.spawnHero(0, .hilda);
    clearRoad(game);
    lane := 6;
    game.you().hero.position = Vector3{core.laneCenter(lane), 0, 20};
    for i in 0..3 {
        game.traffic.cars[i] = core.Car{isActive: true, lane: lane as int, z: -20 - i as f32 * 12, speed: 15};
    }
    game.traffic.cars[3] = core.Car{isActive: true, lane: lane as int + 4, z: -20, speed: 15};     // Outside of her lanes
    game.useAbility(0);
    assert(game.stopSigns.count == 1);
    for 0..150 { game.simulate(Dt); }
    line := game.stopSigns[0].line;
    first := game.traffic.cars[0];
    assert(near(first.z + first.length() * 0.5, line, 0.05) && first.isBraking);
    for i in 1..3 {
        ahead := game.traffic.cars[i - 1];
        behind := game.traffic.cars[i];
        gap := (ahead.z - ahead.length() * 0.5) - (behind.z + behind.length() * 0.5);
        assert(near(gap, core.QueueGap, 0.05));
    }
    assert(near(game.traffic.cars[3].z, -20 + 15 * 2.5, 0.1));         // Drove on as if nothing happened
    for 0..120 { game.simulate(Dt); }
    assert(game.traffic.cars[0].z > line);

    // Mira's time warp slows every car on the road
    game.spawnHero(0, .mira);
    warped: core.Traffic;
    warped.lanes[0].spawnTimer = 100000;
    warped.cars[0] = core.Car{isActive: true, lane: 0, z: 0, speed: 10};
    warped.warpTime(0.7, 3);
    warped.update(1, &game.rng, noZones);
    assert(near(warped.cars[0].z, 3) && warped.isWarped());

    // Her rewind takes her back to where she was, with the health she had then
    clearRoad(game);
    game.you().hero.position = Vector3{-118, 0, 0};
    walkTo(game, Vector3{-108, 0, 0});
    game.you().hero.health = 5;
    for 0..200 { game.simulate(Dt); }            // Standing still, so the last 3 seconds are all here
    game.you().hero.moveTo(Vector3{-118, 0, 20});
    for 0..60 { game.simulate(Dt); }
    game.useAbility(1);
    assert(game.you().hero.position.distance(Vector3{-108, 0, 0}) < 2.5);
}

testCommands :: () {
    game := bots.newGame(4, bots: 1);
    defer game.free();
    clearRoad(game);
    assert(game.players.count == 2 && !game.you().isBot() && game.players[1].isBot());

    // A move is carried out in the next simulate
    you := game.you();
    you.hero.position = Vector3{-118, 0, 0};
    you.order(core.Command{move: {-108, 0}});
    for 0..120 { game.simulate(Dt); }
    assert(you.hero.ground().distance({-108, 0}) < 0.5 && you.commands.count == 0);

    // A stunned hero doesn't move, and doesn't cast
    you.hero.addStatus(.stun, 1);
    you.order(core.Command{move: {-118, 0}});
    game.simulate(Dt);
    for 0..30 { game.simulate(Dt); }
    assert(you.hero.ground().distance({-108, 0}) < 0.5);
    assert(!you.hero.abilityReady(0));
}

testEnemySpells :: () {
    game := bots.newGame(5, bots: 1);
    defer game.free();
    clearRoad(game);
    enemy := &game.players[1];
    enemy.brain = null;         // It stands still, for the test

    // The butcher's hook only bites into cars: it goes past an enemy, which stays where it was
    game.spawnHero(0, .butcher);
    game.you().hero.position = Vector3{-118, 0, 0};
    enemy.hero.position = Vector3{-103, 0, 0};
    game.cast(0, 0, {-98, 0});
    for 0..120 { game.simulate(Dt); }
    assert(near(enemy.hero.position.x, -103, 0.01) && enemy.hero.harmedBy < 0);
    assert(!game.you().hero.hook.hasValue());

    // Bjørn's bash stuns the nearest enemy and knocks it away from him
    game.spawnHero(0, .bjorn);
    game.you().hero.position = Vector3{-118, 0, 0};
    enemy.hero.position = Vector3{-115, 0, 0};
    enemy.hero.clearStatus(.stun);
    bashSlot := 1;
    game.cast(0, bashSlot, {-115, 0});
    assert(enemy.hero.timeLeft(.stun) > 1);
    for 0..60 { game.simulate(Dt); }
    assert(near(enemy.hero.position.x, -115 + 9, 0.3));

    // Out of reach, it isn't cast at all
    game.you().hero.cooldowns[bashSlot] = 0;
    enemy.hero.position = Vector3{-98, 0, 0};
    game.cast(0, bashSlot, {-98, 0});
    assert(game.you().hero.abilityReady(bashSlot));

    // Mira locks the enemy nearest the point in time
    game.spawnHero(0, .mira);
    enemy.hero.clearStatus(.stun);
    game.you().hero.position = Vector3{-118, 0, 0};
    enemy.hero.position = Vector3{-108, 0, 5};
    game.cast(0, 2, {-109, 4});
    assert(enemy.hero.timeLeft(.timeLock) > 1.9 && !enemy.hero.canAct());
    enemy.order(core.Command{move: {-118, 20}});
    for 0..60 { game.simulate(Dt); }
    assert(near(enemy.hero.position.x, -108) && near(enemy.hero.position.z, 5));
}

// The forecast of the bots says when the cars it knows of will be where: what it says is free, is
testForecast :: () {
    game := bots.newGame(6, bots: 0);
    defer game.free();
    for 0..600 { game.simulate(Dt); }
    // No more new cars: only the ones the forecast knows of
    for *lane in game.traffic.lanes { lane.spawnTimer = 100000; }

    radius: f32 = 0.75;
    forecast := bots.newForecast(game, bots.ForecastOptions{radius: radius, margin: 0, leadTime: 0, trailTime: 0});
    rng := random.newRandom(3);
    cells: [..]int;
    defer cells.free();
    for 0..400 {
        cells.add(bots.cellAt({rng.uniform(-core.RoadHalfWidth, core.RoadHalfWidth) as f32, rng.uniform(-60, 60) as f32}));
    }

    free := 0;
    t: f32 = 0;
    while t < 6 {
        for cell in cells {
            if forecast.intervalAt(cell, t) < 0 { continue; }
            free += 1;
            assert(!game.traffic.carHitting(bots.cellCenter(cell), radius).hasValue());
        }
        game.traffic.update(Dt, &game.rng, noZones);
        t += Dt;
    }
    assert(free > 0);

    // A frozen car stays where it is in the forecast too
    game.traffic.cars[0] = core.Car{isActive: true, lane: 3, z: 0, speed: 10, frozenLeft: 2};
    frozen := bots.newForecast(game, bots.ForecastOptions{radius: radius});
    point := Vector2{core.laneCenter(3), 0};
    assert(frozen.hitTime(point, 0) == 0 && frozen.safeFor(point, 1.5) == 0);
}

// A bot gets across on its own, without being run over, on a road with traffic
testBotCrosses :: () {
    game := bots.newGame(7, bots: 1, humans: 0);
    defer game.free();
    bot := &game.players[0];
    game.spawnHero(0, .allan);
    for 0..(90 * 60) {
        game.simulate(Dt);
        if bot.stats.crossings > 0 { break; }
    }
    assert(bot.stats.crossings == 1 && bot.stats.deaths == 0);
    assert((bot.brain as *bots.Bot).profile().plans > 0);
}

// A game played back from its recording is the same game
testRecording :: () {
    game := bots.newGame(9, bots: 3, humans: 1);
    defer game.free();
    rng := random.newRandom(1);
    for frame in 0..900 {
        if frame == 100 { game.you().order(core.Command{move: {-108, 20}}); }
        if frame == 400 { game.you().order(core.Command{cast: {slot: 0, target: {-40, 0}}}); }
        if frame == 600 {
            // A new game with easier bots, as F5 after changing the difficulty while paused
            game.nextDifficulty = .easy;
            game.restartPending = true;
        }
        game.step((1.0 / 60.0) * rng.uniform(0.8, 1.2) as f32);    // Frames aren't all as long
    }
    assert(game.recording.frames.count == 900 && game.recording.checksums.count == 15 && game.difficulty == .easy);

    // Through JSON, like a file
    text := json.encode(game.recording);
    recording, err := json.decode<core.Recording>(text);
    assert(err == null && recording.frames.count == 900);

    replay := bots.newReplay(recording);
    defer replay.free();
    while !replay.replay.isFinished() { replay.step(0); }
    assert(!replay.replay.diverged.hasValue() && replay.difficulty == .easy);
    for player, i in game.players {
        assert(replay.players[i].hero.position == player.hero.position && replay.players[i].stats.deaths == player.stats.deaths);
    }

    // A replay of a game that has changed doesn't match, and says so
    changed := bots.newReplay(recording);
    defer changed.free();
    // Moved, which a bot walking to the same place can make up for, and hurt, which lasts
    changed.players[1].hero.position.x += 3;
    changed.players[1].hero.health = 1;
    changed.players[1].hero.hurtFor = 0;
    while !changed.replay.isFinished() { changed.step(0); }
    assert(changed.replay.diverged.hasValue());
}

testGenomes :: () {
    rng := random.newRandom(4);
    genome := bots.randomGenome(&rng);

    // Through JSON by the names of the genes, and a gene that a file doesn't have starts at its default
    values := genome.toJson();
    back := bots.fromJson(values);
    for gene in bots.Gene.values { assert(back.get(gene) == genome.get(gene)); }
    values.remove("castBar");
    assert(bots.fromJson(values).get(.castBar) == bots.GeneRanges[bots.Gene.castBar].default);

    // Mutation and crossover stay in the ranges
    for 0..200 {
        genome = bots.mutate(bots.crossover(genome, bots.randomGenome(&rng), &rng), &rng, 1, 1);
        for gene in bots.Gene.values {
            range := bots.GeneRanges[gene];
            assert(genome.get(gene) >= range.low && genome.get(gene) <= range.high);
        }
    }

    // The easier the level, the slower it reacts and plans, and the less keen it is
    best := bots.defaultGenome();
    for d in 1..core.Difficulty.count {
        easier := (d as int - 1) as core.Difficulty;
        harder := d as core.Difficulty;
        a := easier.handicap().apply(best);
        b := harder.handicap().apply(best);
        assert(a.get(.reactionTime) >= b.get(.reactionTime) && a.get(.replanEvery) >= b.get(.replanEvery));
        assert(a.get(.castBar) >= b.get(.castBar) && a.get(.aggression) <= b.get(.aggression));
    }
    expert := core.Difficulty.expert.handicap().apply(best);
    for gene in bots.Gene.values { assert(near(expert.get(gene), best.get(gene))); }
}

// A car that gets an enemy just after a bash is a kill of the basher
testKills :: () {
    game := bots.newGame(11, bots: 1);
    defer game.free();
    clearRoad(game);
    enemy := &game.players[1];
    enemy.brain = null;
    game.spawnHero(0, .bjorn);
    game.spawnHero(1, .allan);
    game.you().hero.position = Vector3{core.laneCenter(2) - 4, 0, 0};
    enemy.hero.position = Vector3{core.laneCenter(2) - 1, 0, 0};
    game.cast(0, 1, enemy.hero.ground());
    for 0..30 { game.simulate(Dt); }
    game.traffic.cars[0] = core.Car{isActive: true, kind: .truck, lane: core.laneAt(enemy.hero.position.x), z: enemy.hero.position.z - 9, speed: 30};
    for 0..60 { game.simulate(Dt); }
    assert(enemy.stats.deaths == 1 && game.you().stats.kills == 1);
}

//
// Helpers
//

// Takes every car off the road, and keeps new ones away for a long time
// No cars, and nothing that brings any: no rush hour, no ambulance, no oil
clearRoad :: (game: *core.Game) {
    for *car in game.traffic.cars { car.isActive = false; }
    for *lane in game.traffic.lanes { lane.spawnTimer = 100000; }
    game.traffic.hasEvents = false;
    game.traffic.emergencyLane = -1;
    game.slicks.list.clear();
    game.slicks.nextIn = 100000;
}

walkTo :: (game: *core.Game, point: Vector3) {
    game.you().hero.moveTo(point);
    for 0..(60 * 60) {
        game.simulate(Dt);
        if !game.you().hero.isMoving || game.you().phase.kind != .playing { return; }
    }
    assert(false);
}

consoleGame: *core.Game;

getConsoleGame :: () -> *core.Game {
    return consoleGame;
}

// The console reads what is typed into the parameters of the commands, and gives them the game
testConsole :: () {
    consoleGame = bots.newGame(12, bots: 1);
    defer consoleGame.free();
    console.provide(getConsoleGame);
    game := consoleGame;

    console.execute("toggleWireframes; toggleHitboxes");
    assert(game.debug.wireframes && game.debug.hitboxes);

    // An enum by its name, in any case, and the change of hero is recorded
    console.execute("SETHERO Butcher");
    assert(game.pendingHero.hasValue() && game.pendingHero.value() == .butcher);
    game.step(Dt);
    assert(game.you().hero.kind == .butcher);
    assert(game.recording.frames[game.recording.frames.count - 1].hero.hasValue());

    // Wrong input is an error in the console, and changes nothing
    lines := console.lines().count;
    console.execute("setHero nobody");
    console.execute("inspect 0");             // You, not a bot
    console.execute("noSuchCommand 1 2");
    assert(console.lines().count == lines + 6);       // Each line typed, and its error
    assert(console.lines()[console.lines().count - 1].kind == .error);
    assert(game.you().hero.kind == .butcher);

    // An optional parameter, and at, which runs a command at a time
    console.execute("inspect 1");
    assert(game.inspector.isOpen && game.inspector.player == 1);
    console.execute("at 2 toggleWireframes");
    console.update(1);
    assert(game.debug.wireframes);
    console.update(2);
    assert(!game.debug.wireframes);

    // Every command has a line of help
    for entry in console.commands() { assert(entry.help.len > 0); }
    fmt.print("Console: % commands", console.commands().count);
}

// Items: picked up by walking over them, two at most, and they boost every hero of the player after
testItems :: () {
    game := bots.newGame(13, bots: 0);
    defer game.free();
    clearRoad(game);
    you := game.you();
    game.spawnHero(game.local, .allan);
    assert(!game.items.onRoad.hasValue() && game.items.nextIn > 0);

    // One comes when its time is up
    for 0..((core.FirstItemAfter + 1) * 60) as int { game.simulate(Dt); }
    assert(game.items.onRoad.hasValue());

    // Walking over it puts it in the backpack, and a new one is on its way
    game.items.onRoad = core.GroundItem{kind: .firstAid, position: {-108, 0}};
    health := you.hero.maxHealth();
    walkTo(game, Vector3{-108, 0, 0});
    assert(you.backpack.count == 1 && you.backpack.items[0] == .firstAid);
    assert(!game.items.onRoad.hasValue() && game.items.nextIn >= core.ItemEveryLow);
    assert(near(you.hero.maxHealth(), health * 1.4));
    assert(near(you.hero.health, you.hero.maxHealth()));

    // Speed and damage
    speed := you.hero.speed();
    game.pickUp(game.local, .sneakers);
    assert(near(you.hero.speed(), speed * 1.15));
    assert(you.backpack.isFull());

    // In a full backpack a new item takes the place of the oldest, unless it is locked (a command, so it is recorded)
    you.order(core.Command{lockItem: 0});
    game.simulate(Dt);
    assert(you.backpack.locked[0]);
    game.items.onRoad = core.GroundItem{kind: .hardHat, position: you.hero.ground()};
    game.simulate(Dt);
    assert(!game.items.onRoad.hasValue() && you.backpack.count == 2);
    assert(you.backpack.items[0] == .firstAid && you.backpack.locked[0] && you.backpack.items[1] == .hardHat);

    // With all of them locked, it stays on the road
    you.order(core.Command{lockItem: 1});
    game.simulate(Dt);
    game.items.onRoad = core.GroundItem{kind: .clover, position: you.hero.ground()};
    game.simulate(Dt);
    assert(game.items.onRoad.hasValue() && you.backpack.items[1] == .hardHat);
    game.items.onRoad = null;

    // Unlocked, the oldest goes first
    you.order(core.Command{lockItem: 0});
    game.simulate(Dt);
    game.pickUp(game.local, .sneakers);
    assert(you.backpack.items[0] == .hardHat && you.backpack.locked[0] && you.backpack.items[1] == .sneakers);
    you.backpack = core.Backpack{};
    game.pickUp(game.local, .firstAid);
    game.pickUp(game.local, .sneakers);

    // The next hero has the boost too
    game.spawnHero(game.local, .butcher);
    assert(near(you.hero.maxHealth(), core.HeroKind.butcher.definition().maxHealth * 1.4));
    assert(near(you.hero.health, you.hero.maxHealth()));

    // The clover: once each hero, a car doesn't run it over
    you.backpack = core.Backpack{};
    game.spawnHero(game.local, .allan);
    game.pickUp(game.local, .clover);
    assert(you.hero.savesLeft == 1);
    you.hero.position = Vector3{core.laneCenter(3), 0, 0};
    you.hero.stop();
    game.traffic.cars[0] = core.Car{isActive: true, kind: .truck, lane: 3, z: -12, speed: 30};
    for 0..120 { game.simulate(Dt); }
    assert(you.isPlaying() && you.stats.deaths == 0 && you.hero.savesLeft == 0);

    // A new game empties the backpacks
    game.restart();
    assert(you.backpack.count == 0 && !game.items.onRoad.hasValue());

    // A bot goes out of its way for an item on the road
    botGame := bots.newGame(14, bots: 1, humans: 0);
    defer botGame.free();
    clearRoad(botGame);
    bot := &botGame.players[0];
    botGame.spawnHero(0, .allan);
    botGame.items.onRoad = core.GroundItem{kind: .hourglass, position: {0, 20}};
    for 0..(40 * 60) {
        botGame.simulate(Dt);
        if bot.backpack.count > 0 { break; }
    }
    assert(bot.backpack.count == 1 && bot.backpack.items[0] == .hourglass);
}

// No healing on the road, rush hour, ambulances and oil slicks
testHazards :: () {
    game := bots.newGame(15, bots: 0);
    defer game.free();
    clearRoad(game);
    you := game.you();
    game.spawnHero(game.local, .butcher);

    // Only a First Aid Kit heals: 10% of the most health a second, from a while after a car was on the hero
    you.hero.position = Vector3{core.laneCenter(2), 0, 0};
    you.hero.stop();
    you.hero.health = 50;
    you.hero.hurtFor = 0;
    for 0..(4 * 60) { game.simulate(Dt); }
    assert(near(you.hero.health, 50));
    game.pickUp(game.local, .firstAid);
    most := you.hero.maxHealth();
    health := you.hero.health;
    you.hero.hurtFor = 0;
    for 0..(core.HealDelay * 60) as int { game.simulate(Dt); }
    assert(near(you.hero.health, health, 0.5));
    for 0..60 { game.simulate(Dt); }
    assert(near(you.hero.health, health + most * 0.1, 1));
    you.backpack = core.Backpack{};
    you.refreshStats();

    // Rush hour: a warning, then the cars come closer after each other, then calm again
    traffic := &game.traffic;
    traffic.hasEvents = true;
    traffic.nextEmergency = 100000;
    traffic.rush = .calm;
    traffic.rushLeft = 0.01;
    game.simulate(Dt);
    assert(traffic.rush == .coming);
    calmGap := core.minSpawnGap(traffic, 20);
    for 0..((core.RushWarning + 0.1) * 60) as int { game.simulate(Dt); }
    assert(traffic.rush == .rush && traffic.rushGap() < 1);
    assert(core.minSpawnGap(traffic, 20) < calmGap + 0.01);
    for 0..((core.RushLengthHigh + 0.1) * 60) as int { game.simulate(Dt); }
    assert(traffic.rush == .calm);

    // An ambulance: its siren, then it comes down its lane much faster than the cars of the lane
    clearRoad(game);
    traffic.hasEvents = true;
    traffic.rushLeft = 1000;
    traffic.sirenFor(9);
    for 0..((core.EmergencyWarning + 0.1) * 60) as int { game.simulate(Dt); }
    ambulance: ?core.Car = null;
    lanes: [..]int;
    defer lanes.free();
    for car in traffic.cars {
        if !car.isActive || car.kind != .ambulance { continue; }
        lanes.add(car.lane);
        if car.lane == 9 { ambulance = car; }
    }
    assert(ambulance.hasValue() && lanes.count == 3 && lanes.contains(8) && lanes.contains(10));
    assert(near(ambulance.value().speed, traffic.emergencySpeed()));
    for lane in traffic.lanes { assert(ambulance.value().speed > lane.speed * core.MaxSpawnSpeed); }
    // Nothing slows an ambulance down: a freeze, a stop sign in its lane or a time warp
    traffic.warpTime(0.5, 5);
    traffic.halt(8, 10, 0, 5);
    for car in traffic.cars {
        if car.isActive && car.kind == .ambulance { _ := traffic.freezeAround(car.rect().center(), 3, 5); }
    }
    before: [core.MaxCars]f32;
    for car, i in traffic.cars { before[i] = car.z; }
    traffic.update(0.5, &game.rng, []);
    for car, i in traffic.cars {
        if car.isActive && car.kind == .ambulance { assert(near(car.z - before[i], car.speed * 0.5, 0.01)); }
    }
    traffic.warpLeft = 0;
    for *lane in traffic.lanes { lane.haltLeft = 0; }
    fmt.print("An ambulance in lane 9 drives % m/s, at the middle % s after its siren", fmt.fixed(ambulance.value().speed, 1),
        fmt.fixed(core.EmergencyWarning + (core.RoadEnd + core.VanLength * 0.5) / ambulance.value().speed, 1));

    // The bots know of it from its siren on
    traffic.sirenFor(4);
    forecast := bots.newForecast(game, bots.ForecastOptions{radius: 1});
    point := Vector2{core.laneCenter(4), 0};
    hit := forecast.hitTime(point, 0);
    assert(hit < core.EmergencyWarning + (core.RoadEnd + 8) / traffic.emergencySpeed());

    // An oil slick: a hero that walks onto it slides on the way it went, and can't turn until it is off
    clearRoad(game);
    traffic.emergencyLane = -1;
    game.slicks.list.clear();
    game.spawnHero(game.local, .allan);
    game.addSlick(Vector2{-30, 0}, 6);
    you.hero.position = Vector3{-40, 0, 0};
    you.hero.moveTo(Vector3{-20, 0, 0});
    for 0..(0.8 * 60) as int { game.simulate(Dt); }
    assert(you.hero.slideLeft > 0);
    you.hero.moveTo(Vector3{-30, 0, 30});            // Turning on the oil doesn't work
    z := you.hero.position.z;
    for 0..10 { game.simulate(Dt); }
    assert(near(you.hero.position.z, z, 0.01));

    // The bots see the oil as never safe
    forecast2 := bots.newForecast(game, bots.ForecastOptions{radius: 1});
    assert(forecast2.safeFor(Vector2{-30, 0}, 0) == 0);
    assert(forecast2.safeFor(Vector2{-30, 20}, 0) > 0);

    // A car that leaks leaves blobs of oil behind it, on its lane
    clearRoad(game);
    game.traffic.cars[0] = core.Car{isActive: true, kind: .car, lane: 6, z: -40, speed: 15};
    assert(game.leak(&game.slicks.rng));
    for 0..90 { game.simulate(Dt); }
    assert(game.slicks.list.count >= 3);
    for slick in game.slicks.list { assert(math.fabsf(slick.center.x - core.laneCenter(6)) < 1); }
}

// Spectating: nobody at the keyboard, and the view follows any player, which the game doesn't record
testSpectating :: () {
    game := bots.newGame(16, bots: 3, humans: 0);
    defer game.free();
    assert(!game.hasLocal() && game.canSwitchView() && game.watched == 0);
    game.watch(2);
    assert(game.you() == &game.players[2] && game.inspector.player == 2);
    game.watch(7);                                  // No such player: stays
    assert(game.watched == 2);
    for 0..120 { game.step(Dt); }
    for frame in game.recording.frames { assert(!frame.hero.hasValue()); }

    // Playing, the view stays on you
    playing := bots.newGame(16, bots: 3, humans: 1);
    defer playing.free();
    assert(playing.hasLocal() && !playing.canSwitchView() && playing.you() == &playing.players[0]);
}

// The items that give an aura or an effect, not only numbers
testItemAuras :: () {
    game := bots.newGame(17, bots: 1);
    defer game.free();
    clearRoad(game);
    you := game.you();
    enemy := &game.players[1];
    enemy.brain = null;
    game.spawnHero(0, .allan);
    game.spawnHero(1, .allan);

    // Frost Charm: an aura that slows the cars, which the bots' forecast knows of too
    assert(!you.hero.chillAura().hasValue());
    game.pickUp(0, .frostCharm);
    assert(you.hero.chillAura().hasValue() && near(you.hero.chillAura().value().radius, core.FrostRadius));

    // Garlic: an enemy near the hero walks slower, one further away doesn't
    game.pickUp(1, .garlic);
    you.hero.position = Vector3{-108, 0, 0};
    enemy.hero.position = Vector3{-108, 0, 4};
    speed := you.hero.speed();
    game.simulate(Dt);
    assert(near(you.hero.speed(), speed * (1 - core.ItemAuraSlow)));
    enemy.hero.position = Vector3{-108, 0, 30};
    game.simulate(Dt);
    assert(near(you.hero.speed(), speed));

    // Spring Shoes: a car bounces the hero over it towards the far side, then not again for a while
    you.backpack = core.Backpack{};
    game.spawnHero(0, .allan);
    game.pickUp(0, .springShoes);
    you.hero.position = Vector3{core.laneCenter(3), 0, 0};
    you.hero.stop();
    game.traffic.cars[0] = core.Car{isActive: true, kind: .truck, lane: 3, z: -8, speed: 25};
    for 0..60 { game.simulate(Dt); }
    assert(you.isPlaying() && you.stats.deaths == 0 && you.hero.bounceLeft > 0);
    assert(you.hero.position.x > core.laneCenter(3) + 4);
}

// A match: a crossing ends the round for everyone, the first to enough crossings wins, and heroes shove each other
testMatch :: () {
    game := bots.newGame(18, bots: 2);
    defer game.free();
    clearRoad(game);
    for *player in game.players { player.brain = null; }
    game.setLength(.short);
    assert(game.length.crossingsToWin() == 5 && game.recording.length == .short);

    // You cross: the others stop, and all start again from the far side, the others with the same hero
    other := &game.players[1];
    kind := other.hero.kind;
    game.heroCrossed(0);
    assert(other.phase.kind == .regroup && game.side == .right);
    for 0..((core.RegroupTime + 0.2) * 60) as int { game.simulate(Dt); }
    for player in game.players { assert(player.isPlaying() && player.startSide == .right); }
    assert(other.hero.kind == kind && other.hero.position.x > 0);

    // The fifth crossing wins: the heroes stand still, the results are shown, then a new game starts
    game.you().stats.crossings = 4;
    game.heroCrossed(0);
    assert(game.isOver() && game.winner == 0);
    position := game.players[2].hero.position;
    game.players[2].order(core.Command{move: {0, 0}});
    for 0..60 { game.step(Dt); }
    assert(game.players[2].hero.position == position);
    for 0..((core.EndTime + 0.5) * 60) as int { game.step(Dt); }
    assert(!game.isOver() && game.you().stats.crossings == 0 && game.length == .short);

    // Shoving: walking into an enemy pushes it away, further for a heavier hero, and counts for a kill
    clearRoad(game);
    game.spawnHero(0, .butcher);
    game.spawnHero(1, .allan);
    game.you().hero.position = Vector3{-108, 0, 0};
    other.hero.position = Vector3{-106, 0, 0};
    other.hero.stop();
    game.you().hero.moveTo(Vector3{-88, 0, 0});
    for 0..30 { game.simulate(Dt); }
    assert(other.hero.position.x > -106 + core.ShoveDistance && other.hero.harmedBy == 0);
    assert(game.you().hero.shoveLeft > 0);
}

// Particles: they move by their style, stain the ground, die, and are quick. Off, nothing is made
testParticles :: () {
    system := core.newParticles(1);
    defer system.free();
    system.emit(.blood, Vector3{0, 2, 0}, 50);
    assert(system.count() == 0);                    // Off: only where someone looks

    system.isOn = true;
    system.emit(.blood, Vector3{0, 2, 0}, 50);
    system.emit(.sparks, Vector3{0, 2, 0}, 30);
    assert(system.count() == 80);
    for 0..(3 * 60) { system.update(Dt); }
    assert(system.count() == 0 && system.stainCount > 30);     // The drops landed and stained the road

    // A rate: about as many as asked for
    for 0..60 { system.emitRate(.heal, Vector3{}, 30, Dt); }
    assert(system.count() > 20 && system.count() < 40);

    // Many at once: an update of 15000 is quick
    system.clear();
    for fx in core.Fx.values { system.emit(fx, Vector3{0, 2, 0}, 1200, radius: 5); }
    count := system.count();
    started := time.clock();
    for 0..10 { system.update(Dt); }
    perFrame := (time.clock() - started) / 10 * 1000;
    fmt.print("Particles: an update of % takes % ms", count, fmt.fixed(perFrame as f32, 3));
    assert(count > 10000 && perFrame < 8);
}
