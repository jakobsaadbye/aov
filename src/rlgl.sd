RL_QUADS :: 7;

extern "C" {
    rlSetTexture  :: (id: u32) -> void;
    rlBegin       :: (mode: s32) -> void;
    rlEnd         :: () -> void;
    rlVertex3f    :: (x: float, y: float, z: float) -> void;
    rlTexCoord2f  :: (x: float, y: float) -> void;
    rlNormal3f    :: (x: float, y: float, z: float) -> void;
    rlColor4ub    :: (r: u8, g: u8, b: u8, a: u8) -> void;
    rlPushMatrix  :: () -> void;
    rlPopMatrix  :: () -> void;
}