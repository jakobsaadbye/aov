namespace aov;

import fmt;
import math;
import mem;
import allocators;
use raylib;

// The 2D overlay: the score, the card of the hero with its ability, the banner, the help and the debug numbers.
// The texts of a frame are made in an arena, which is cleared at the end of the frame

PanelColor  :: Color{20, 24, 28, 200};
BorderColor :: Color{255, 255, 255, 40};
TextColor   :: Color{235, 235, 235, 255};
DimColor    :: Color{160, 165, 170, 255};

@threadLocal
frameArena: allocators.Arena;

drawHud :: method (game: *Game, assets: *Assets) {
    previous := mem.setAllocator(&frameArena);
    defer frameArena.clear();
    defer mem.setAllocator(previous);

    drawScore(game);
    drawHeroCard(game, assets);
    drawBanner(game);
    if game.showHelp       { drawHelp(); }
    if game.debug.overlay  { drawDebug(game); }
    if game.isPaused       { drawPaused(); }

    mouse := GetMousePosition();
    DrawTexture(assets.cursor, mouse.x as int - 2, mouse.y as int, White);
}

drawScore :: (game: *Game) {
    panel := Rectangle{16, 16, 270, 132};
    drawPanel(panel);

    x := panel.x as int + 14;
    y := panel.y as int + 12;
    drawText("ALLAN OVER VEJEN", x, y, 20, {255, 210, 90, 255});
    drawText(fmt.sprint("Level %", game.stats.level + 1), x, y + 30, 18, TextColor);
    drawText(fmt.sprint("Crossings  %", game.stats.crossings), x, y + 54, 18, TextColor);
    drawText(fmt.sprint("Run over   %", game.stats.deaths), x, y + 76, 18, TextColor);

    best := "-";
    if game.stats.bestTime.hasValue() { best = fmt.sprint("% s", fmt.fixed(game.stats.bestTime.value(), 1)); }
    drawText(fmt.sprint("Best time  %", best), x, y + 98, 18, TextColor);
}

// The bottom of the screen, like in Dota 2: the portrait of the hero, and a button for each ability with its icon, its
// key and its cooldown. The mouse on a button shows what the ability does
AbilityButtonSize :: 64;
AbilityButtonGap  :: 10;
AbilityKeyNames   :: ["Q", "W", "E", "R", "D", "F"];

drawHeroCard :: (game: *Game, assets: *Assets) {
    hero := &game.hero;
    info := hero.info();
    abilities := hero.abilities();

    portraitSize := 96;
    buttons := abilities.count as int;
    width  := 24 + portraitSize + 20 + buttons * (AbilityButtonSize + AbilityButtonGap) - AbilityButtonGap + 12;
    width   = math.max(width, 420);
    height := 132;
    panel := Rectangle{(GetScreenWidth() - width) as f32 * 0.5, (GetScreenHeight() - height - 16) as f32, width as f32, height as f32};
    drawPanel(panel);

    x := panel.x as int + 12;
    y := panel.y as int + 12;

    // The portrait: the color of the hero, with eyes
    portrait := Rectangle{x as f32, (y + 12) as f32, portraitSize as f32, portraitSize as f32};
    DrawRectangleRec(portrait, info.color);
    DrawRectangleLinesEx(portrait, 2, {255, 255, 255, 90});
    DrawRectangle(x + 26, y + 48, 12, 14, {20, 20, 20, 255});
    DrawRectangle(x + 58, y + 48, 12, 14, {20, 20, 20, 255});

    left := x + portraitSize + 20;
    drawText(info.name, left, y, 24, TextColor);
    drawText(fmt.sprint("% s", fmt.fixed(hero.timeAlive, 1)), panel.x as int + width - 70, y + 4, 18, DimColor);

    // The abilities
    mouse := GetMousePosition();
    game.hoveredAbility = -1;
    for ability, i in abilities {
        slot := i as int;
        button := Rectangle{(left + slot * (AbilityButtonSize + AbilityButtonGap)) as f32, (y + 36) as f32, AbilityButtonSize, AbilityButtonSize};
        drawAbilityButton(game, assets, ability, slot, button);
        if CheckCollisionPointRec(mouse, button) { game.hoveredAbility = slot; }
    }

    if game.hoveredAbility >= 0 {
        slot := game.hoveredAbility;
        button := Rectangle{(left + slot * (AbilityButtonSize + AbilityButtonGap)) as f32, (y + 36) as f32, AbilityButtonSize, AbilityButtonSize};
        drawAbilityTooltip(abilities[slot], slot, button);
    }
}

drawAbilityButton :: (game: *Game, assets: *Assets, ability: Ability, slot: int, button: Rectangle) {
    hero := &game.hero;
    x := button.x as int;
    y := button.y as int;
    size := AbilityButtonSize;

    icon := assets.icons[ability.icon];
    DrawTexturePro(icon, {0, 0, icon.width as f32, icon.height as f32}, button, {0, 0}, 0, White);

    if ability.isPassive() {
        // A passive is always on: a darker frame, and no cooldown
        DrawRectangleLinesEx(button, 2, {120, 110, 90, 255});
    } else {
        cooldown := hero.cooldowns[slot];
        if cooldown > 0 {
            // The dark part shrinks clockwise from the top, like in Warcraft 3 and Dota 2, with the seconds left on it
            left := cooldown / ability.cooldown;
            BeginScissorMode(x, y, size, size);
            DrawCircleSector({button.x + size * 0.5, button.y + size * 0.5}, size as f32, -90 + (1 - left) * 360, 270, 48, {0, 0, 0, 170});
            EndScissorMode();

            seconds := fmt.sprint("%", math.ceilf(cooldown) as int);
            if cooldown < 1 { seconds = fmt.sprint("%", fmt.fixed(cooldown, 1)); }
            textSize := 26;
            textX := x + (size - textWidth(seconds, textSize)) / 2;
            drawText(seconds, textX + 2, y + 21, textSize, Black);
            drawText(seconds, textX, y + 19, textSize, White);
        }

        // Lit up while its effect is going on, e.g a sprint
        isActive := false;
        switch v in ability.effect {
            case .sprint { isActive = hero.sprintLeft > 0; }
            case .fade   { isActive = hero.fadeLeft > 0; }
            case .hook   { isActive = hero.hook.hasValue(); }
            else         { }
        }

        frame := Color{60, 55, 45, 255};
        if cooldown <= 0 { frame = {200, 180, 120, 255}; }
        if isActive      { frame = {255, 230, 90, 255}; }
        DrawRectangleLinesEx(button, 2, frame);
        if isActive { DrawRectangleLinesEx({button.x - 3, button.y - 3, button.width + 6, button.height + 6}, 2, {255, 230, 90, 140}); }
    }

    // The key in the corner
    key := AbilityKeyNames[slot];
    DrawRectangle(x + 2, y + 2, 18, 18, {0, 0, 0, 180});
    keyColor := White;
    if ability.isPassive() { keyColor = DimColor; }
    drawText(key, x + 6, y + 3, 16, keyColor);
}

drawAbilityTooltip :: (ability: Ability, slot: int, button: Rectangle) {
    width := 320;
    lines := wrapText(ability.description, 16, width - 24);
    height := 64 + lines.count as int * 20;

    x := math.clamp(button.x as int + AbilityButtonSize / 2 - width / 2, 8, GetScreenWidth() - width - 8);
    y := button.y as int - 48 - height - 8;      // Above the panel of the hero
    rect := Rectangle{x as f32, y as f32, width as f32, height as f32};
    DrawRectangleRounded(rect, 0.06, 6, {14, 16, 20, 235});
    DrawRectangleRoundedLinesEx(rect, 0.06, 6, 1, {200, 180, 120, 160});

    drawText(ability.name, x + 12, y + 10, 22, {255, 210, 90, 255});
    detail := fmt.sprint("Passive");
    if !ability.isPassive() { detail = fmt.sprint("[%]   Cooldown % s", AbilityKeyNames[slot], ability.cooldown as int); }
    drawText(detail, x + 12, y + 36, 16, DimColor);
    for line, i in lines {
        drawText(line, x + 12, y + 60 + i as int * 20, 16, TextColor);
    }
}

// Breaks a text into lines that fit a width, at the spaces
wrapText :: (text: string, size: int, width: int) -> [..]string {
    lines: [..]string;
    line := "";
    for word in text.split(" ") {
        candidate := word;
        if line.len > 0 { candidate = fmt.sprint("% %", line, word); }
        if line.len > 0 && textWidth(candidate, size) > width {
            lines.add(line);
            line = word;
        } else {
            line = candidate;
        }
    }
    if line.len > 0 { lines.add(line); }
    return lines;
}

drawBanner :: (game: *Game) {
    banner := game.banner;
    if banner.timeLeft <= 0 || banner.text.len == 0 { return; }

    alpha := math.clamp(banner.timeLeft / 0.5, 0, 1);
    size := 30;
    width := textWidth(banner.text, size);
    x := (GetScreenWidth() - width) / 2;
    y := 90;

    DrawRectangle(x - 20, y - 12, width + 40, size + 24, ColorAlpha(PanelColor, 0.8 * alpha));
    drawText(banner.text, x + 2, y + 2, size, ColorAlpha(Black, 0.6 * alpha));
    drawText(banner.text, x, y, size, ColorAlpha(banner.color, alpha));
}

drawHelp :: () {
    lines := [
        "Right click   walk there",
        "Q W E R       the abilities",
        "S             stop",
        "Y             lock / unlock the camera",
        "Space         camera to the hero",
        "Wheel         zoom",
        "P pause   F5 new game   H hide this",
    ];

    lineHeight := 20;
    panel := Rectangle{16, (GetScreenHeight() - lines.count * lineHeight - 40) as f32, 330, (lines.count * lineHeight + 24) as f32};
    drawPanel(panel);
    for line, i in lines {
        drawText(line, panel.x as int + 12, panel.y as int + 12 + i as int * lineHeight, 16, DimColor);
    }
}

drawDebug :: (game: *Game) {
    camera := game.camera.view;
    hero := game.hero;
    lines := [
        fmt.sprint("FPS %", GetFPS()),
        fmt.sprint("Camera % % %", fmt.fixed(camera.position.x, 1), fmt.fixed(camera.position.y, 1), fmt.fixed(camera.position.z, 1)),
        fmt.sprint("Hero % %", fmt.fixed(hero.position.x, 1), fmt.fixed(hero.position.z, 1)),
        fmt.sprint("Cars %", game.traffic.activeCount()),
        fmt.sprint("Phase %", game.phase.kind),
        "F1 wireframes   F2 hitboxes",
    ];

    width := 300;
    x := GetScreenWidth() - width - 16;
    DrawRectangle(x, 16, width, lines.count as int * 20 + 20, PanelColor);
    for line, i in lines {
        drawText(line, x + 12, 26 + i as int * 20, 16, Lime);
    }
}

drawPaused :: () {
    DrawRectangle(0, 0, GetScreenWidth(), GetScreenHeight(), {0, 0, 0, 120});
    text := "PAUSED";
    width := textWidth(text, 60);
    drawText(text, (GetScreenWidth() - width) / 2, GetScreenHeight() / 2 - 60, 60, White);
    hint := "Press P or Esc to go on";
    drawText(hint, (GetScreenWidth() - textWidth(hint, 20)) / 2, GetScreenHeight() / 2 + 10, 20, DimColor);
}

drawPanel :: (rect: Rectangle) {
    DrawRectangleRounded(rect, 0.08, 6, PanelColor);
    DrawRectangleRoundedLinesEx(rect, 0.08, 6, 1, BorderColor);
}

// raylib draws a c.string, so the text is copied with a 0 after it
drawText :: (text: string, x: int, y: int, size: int, color: Color) {
    cText := text.toCString();
    defer cText.free();
    DrawText(cText, x, y, size, color);
}

textWidth :: (text: string, size: int) -> int {
    cText := text.toCString();
    defer cText.free();
    return MeasureText(cText, size);
}
