namespace aov;

use raylib;

// The textures, meshes and the shader of the game. The textures are made when the game starts, so it runs without any
// files. When the data folder of the repository is there (data/textures/..., which isn't in git), its textures are
// used instead

Assets :: struct {
    lighting: Lighting;
    lit:      Material;     // The lit material that the solid things are drawn with. Its color is set for each
    cube:     Mesh;         // A 1x1x1 cube, scaled to make walls, cars and heroes
    cylinder: Mesh;         // Radius 1, height 1

    ground:        Mesh;    // The field
    groundMaterial: Material;
    road:          Mesh;
    roadMaterial:  Material;
    outside:       Mesh;    // The land around the field, to the horizon
    outsideMaterial: Material;

    cursor: ?Texture;
}

loadAssets :: () -> Assets {
    assets: Assets;
    dataFolder := findDataFolder();

    assets.lighting = newLighting();
    assets.cube     = GenMeshCube(1, 1, 1);
    assets.cylinder = GenMeshCylinder(1, 1, 16);
    assets.lit      = assets.lighting.newMaterial(White);

    // The field: grass, tiled
    grass, fromData := loadTextureOr(dataFolder, "textures/grass/Grass_02.png", () -> Image {
        // Green, with lighter and darker patches
        image := GenImageColor(256, 256, {92, 150, 64, 255});
        patches := GenImagePerlinNoise(256, 256, 0, 0, 6);
        ImageDraw(&image, patches, {0, 0, 256, 256}, {0, 0, 256, 256}, {255, 255, 255, 70});
        UnloadImage(patches);
        return image;
    });
    grassColor := White;
    if fromData { grassColor = Color{0, 228, 48, 255}; }   // The grass texture of the data folder is grey
    assets.ground = GenMeshPlane(MapHalfWidth * 2, MapHalfLength * 2, 1, 1);
    tileTexture(&assets.ground, 10, 8);
    assets.groundMaterial = assets.lighting.newMaterial(grassColor);
    assets.groundMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture = grass;

    // The land around it, darker, so the field stands out
    assets.outside = GenMeshPlane(900, 900, 1, 1);
    tileTexture(&assets.outside, 60, 60);
    assets.outsideMaterial = assets.lighting.newMaterial(ColorBrightness(grassColor, -0.4));
    assets.outsideMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture = grass;

    // The road, with its markings painted on: one texture is the whole width of the road, and repeats along it
    assets.road = GenMeshPlane(RoadHalfWidth * 2, RoadEnd * 2, 1, 1);
    tileTexture(&assets.road, 1, RoadEnd * 2 / RoadMarkingRepeat);
    assets.roadMaterial = assets.lighting.newMaterial(White);
    assets.roadMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture = makeRoadTexture(dataFolder);

    // The cursor of Warcraft and the window icon, when they are in the data folder
    if dataFolder.hasValue() {
        iconPath := dataPath(dataFolder.value(), "window_icon.png");
        defer iconPath.free();
        if FileExists(iconPath) {
            icon := LoadImage(iconPath);
            ImageFormat(&icon, .uncompressedR8g8b8a8);
            SetWindowIcon(icon);
            UnloadImage(icon);
        }

        path := dataPath(dataFolder.value(), "textures/cursor/human.png");
        defer path.free();
        if FileExists(path) {
            assets.cursor = LoadTexture(path);
        }
    }

    return assets;
}

unload :: method (assets: *Assets) {
    UnloadTexture(assets.groundMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture);
    UnloadTexture(assets.roadMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture);
    if assets.cursor.hasValue() { UnloadTexture(assets.cursor.value()); }

    UnloadMesh(assets.cube);
    UnloadMesh(assets.cylinder);
    UnloadMesh(assets.ground);
    UnloadMesh(assets.road);
    UnloadMesh(assets.outside);

    assets.lighting.unload();
}

// Draws the unit cube scaled, turned around y and moved, with the lit material in a color
drawBox :: method (assets: *Assets, center: Vector3, size: Vector3, angle: f32, color: Color) {
    assets.lit.maps[MaterialMapIndex.materialMapAlbedo].color = color;
    transform := MatrixScale(size.x, size.y, size.z) * MatrixRotateY(angle) * MatrixTranslate(center.x, center.y, center.z);
    DrawMesh(assets.cube, assets.lit, transform);
}

// Draws the unit cylinder standing on a point
drawCylinder :: method (assets: *Assets, base: Vector3, radius: f32, height: f32, color: Color) {
    assets.lit.maps[MaterialMapIndex.materialMapAlbedo].color = color;
    transform := MatrixScale(radius, height, radius) * MatrixTranslate(base.x, base.y, base.z);
    DrawMesh(assets.cylinder, assets.lit, transform);
}

//
// Textures
//

RoadMarkingRepeat :: 16.0;     // The length of road one copy of the road texture covers: a dash and a gap
RoadPixelsPerUnit :: 8;

makeRoadTexture :: (dataFolder: ?string) -> Texture {
    width  := (RoadHalfWidth * 2) as int * RoadPixelsPerUnit;
    height := RoadMarkingRepeat as int * RoadPixelsPerUnit;

    // Asphalt: grey with a bit of grit
    image := GenImageColor(width, height, {78, 80, 86, 255});
    grit := GenImageWhiteNoise(width, height, 0.5);
    ImageDraw(&image, grit, {0, 0, width as f32, height as f32}, {0, 0, width as f32, height as f32}, {255, 255, 255, 18});
    UnloadImage(grit);

    // The asphalt of the data folder instead, when it is there
    if dataFolder.hasValue() {
        path := dataPath(dataFolder.value(), "textures/road/Ground_03.png");
        defer path.free();
        if FileExists(path) {
            asphalt := LoadImage(path);
            source := Rectangle{0, 0, asphalt.width as f32, asphalt.height as f32};
            for tile in 0..(width / height) {
                ImageDraw(&image, asphalt, source, {(tile * height) as f32, 0, height as f32, height as f32}, White);
            }
            UnloadImage(asphalt);
        }
    }

    px :: (units: f32) -> int { return (units * RoadPixelsPerUnit) as int; };

    // The lines along the edges, a dashed line between the lanes, and the double line of the median
    edge := px(0.3);
    ImageDrawRectangle(&image, px(0.4), 0, edge, height, {235, 235, 235, 255});
    ImageDrawRectangle(&image, width - px(0.4) - edge, 0, edge, height, {235, 235, 235, 255});

    for lane in 1..LaneCount {
        x := px(LaneWidth * lane as f32);
        if lane == LanesPerDirection {
            ImageDrawRectangle(&image, x - px(0.55), 0, px(0.3), height, {240, 200, 40, 255});
            ImageDrawRectangle(&image, x + px(0.25), 0, px(0.3), height, {240, 200, 40, 255});
        } else {
            ImageDrawRectangle(&image, x - px(0.12), 0, px(0.24), px(6), {225, 225, 225, 255});
        }
    }

    texture := LoadTextureFromImage(image);
    UnloadImage(image);
    GenTextureMipmaps(&texture);
    SetTextureFilter(texture, .trilinear);
    return texture;
}

// A texture of the data folder, or the image that make gives, e.g when the data folder isn't there. True when it is from
// the data folder
loadTextureOr :: (dataFolder: ?string, file: string, make: () -> Image) -> Texture, bool {
    image: Image;
    found := false;

    if dataFolder.hasValue() {
        path := dataPath(dataFolder.value(), file);
        defer path.free();
        if FileExists(path) {
            image = LoadImage(path);
            found = true;
        }
    }
    if !found { image = make(); }

    texture := LoadTextureFromImage(image);
    UnloadImage(image);
    GenTextureMipmaps(&texture);
    SetTextureFilter(texture, .trilinear);
    return texture, found;
}

// Makes a texture repeat over a plane of GenMeshPlane, which goes from 0 to 1 over the whole plane
tileTexture :: (mesh: *Mesh, repeatX: f32, repeatZ: f32) {
    for i in 0..mesh.vertexCount {
        mesh.texcoords[i * 2]     *= repeatX;
        mesh.texcoords[i * 2 + 1] *= repeatZ;
    }
    UpdateMeshBuffer(*mesh, 1, mesh.texcoords, mesh.vertexCount * 2 * sizeof(f32) as int, 0);
}

//
// The data folder
//

// The data folder of the repository, next to src. The game can be run from the repository, from src or from src/build
findDataFolder :: () -> ?string {
    candidates := ["data", "../data", "../../data"];
    for candidate in candidates {
        marker := dataPath(candidate, "textures");
        defer marker.free();
        if DirectoryExists(marker) { return candidate; }
    }

    // Next to the program, e.g src/build/out.exe
    programFolder := GetApplicationDirectory().toString();
    for candidate in candidates {
        folder := fmt.sprint("%/%", programFolder, candidate);
        marker := dataPath(folder, "textures");
        defer marker.free();
        if DirectoryExists(marker) { return folder; }
        folder.free();
    }
    return null;
}

// A path in the data folder, as a c.string for raylib. Free it
dataPath :: (folder: string, file: string) -> c.string {
    path := fmt.sprint("%/%", folder, file);
    defer path.free();
    return path.toCString();
}
