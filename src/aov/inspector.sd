namespace aov;

// The inspector of the bots (F4): what one bot thinks, while the game goes on. Tab picks the next bot.
//
// In the world it shows what the bot knows (for the Bot of bot.sd: where it is safe from the cars right now, and its plan),
// and in a panel what it is doing and why: waiting for a gap, walking, dodging, the score of each of its abilities.
// What is shown is up to the Brain (drawInspection and describe), so another kind of bot shows what it thinks with.
//
// When you spectate (--spectate), the camera follows the bot that is inspected. Otherwise space does, while it is held.

import fmt;
import math;
use raylib;

Inspector :: struct {
    isOpen: bool;
    player: int = -1;       // The player whose bot is inspected
}

InspectorLine :: struct {
    text:  string;
    color: Color = TextColor;
}

// The keys of the inspector: F4 opens and closes it, Tab picks the next bot
updateInspector :: method (game: *Game) {
    if IsKeyPressed(.f4) {
        game.inspector.isOpen = !game.inspector.isOpen;
        if game.inspector.isOpen && !game.inspectedIsBot() { game.inspectNextBot(); }
    }
    if game.inspector.isOpen && IsKeyPressed(.tab) { game.inspectNextBot(); }
}

inspectNextBot :: method (game: *Game) {
    for k in 1...game.players.count {
        i := (game.inspector.player + k as int) % game.players.count as int;
        if i < 0 { i += game.players.count as int; }
        if game.players[i].isBot() {
            game.inspector.player = i;
            return;
        }
    }
}

inspectedIsBot :: method (game: *Game) -> bool {
    player := game.inspector.player;
    return player >= 0 && player < game.players.count && game.players[player].isBot();
}

// The hero the camera follows: yours, or the inspected bot's when you spectate or hold space
followedHero :: method (game: *Game) -> Vector3 {
    if game.inspector.isOpen && game.inspectedIsBot() && (game.you().isBot() || IsKeyDown(.space)) {
        return game.players[game.inspector.player].hero.position;
    }
    return game.you().hero.position;
}

// In the 3D scene: the plans of all bots, faintly, and what the inspected one knows
drawInspection3D :: (game: *Game) {
    if !game.inspector.isOpen { return; }
    drawPlans(game);
    if game.inspectedIsBot() {
        index := game.inspector.player;
        game.players[index].brain.drawInspection(game, index);
    }
}

// The panel, on the right of the screen
drawInspectorPanel :: (game: *Game) {
    if !game.inspector.isOpen { return; }
    lines: [..]InspectorLine;
    if !game.inspectedIsBot() {
        lines.add(InspectorLine{text: "No bot to inspect"});
    } else {
        index := game.inspector.player;
        game.players[index].brain.describe(game, index, &lines);
    }
    lines.add(InspectorLine{text: "Tab: the next bot", color: DimColor});

    width := 380;
    lineHeight := 21;
    x := GetScreenWidth() - width - 16;
    panel := Rectangle{x as f32, 16, width as f32, (lines.count * lineHeight + 50) as f32};
    drawPanel(panel);
    drawTitle("Inspector", x + 14, 24, 20, {255, 210, 90, 255});
    for line, i in lines {
        drawText(line.text, x + 14, 54 + i as int * lineHeight, 16, line.color);
    }
}

// The plans of the bots: their way across, in the color of each
drawPlans :: (game: *Game) {
    for player in game.players {
        if !player.isBot() || !player.isPlaying() { continue; }
        path := player.brain.plannedPath();
        previous := player.hero.position + Vector3{0, 0.4, 0};
        for waypoint in path {
            point := waypoint.point.at(0.4);
            DrawLine3D(previous, point, ColorAlpha(player.color, 0.7));
            previous = point;
        }
        if path.count > 0 { DrawSphere(path[path.count - 1].point.at(0.5), 0.5, player.color); }
    }
}

// The color of how long something stays free of cars: red now, yellow soon, green for a while
safetyColor :: (seconds: f32, alpha: f32) -> Color {
    if seconds <= 0 { return ColorAlpha({230, 40, 40, 255}, alpha); }
    if seconds < 1.5 { return ColorAlpha(ColorLerp({240, 90, 40, 255}, {250, 220, 60, 255}, seconds / 1.5), alpha); }
    return ColorAlpha(ColorLerp({250, 220, 60, 255}, {80, 220, 90, 255}, math.min((seconds - 1.5) / 2.5, 1)), alpha);
}

//
// What the Bot of bot.sd shows
//

InspectRadius :: 16.0;      // How far around its hero the inspector shows where it is safe

drawInspection :: method (bot: *Bot, game: *Game, me: int) {
    player := &game.players[me];
    if !player.isPlaying() || !bot.hasForecast { return; }
    hero := &player.hero;
    now := game.time - bot.forecastAt;

    // Each cell around it, in the color of how long it stays free of cars, by what the bot knows. Walls are grey
    center := hero.ground();
    steps := math.floorf(InspectRadius / CellSize) as int;
    centerCell := cellAt(center);
    if centerCell < 0 { return; }
    middle := cellCenter(centerCell);
    for dy in -steps...steps {
        for dx in -steps...steps {
            point := middle + Vector2{dx as f32 * CellSize, dy as f32 * CellSize};
            if point.distance(center) > InspectRadius { continue; }
            cell := cellAt(point);
            if cell < 0 { continue; }
            color := Color{120, 120, 130, 90};
            if !bot.forecast.blocked[cell] {
                interval := bot.forecast.intervalAt(cell, now);
                free: f32 = 0;
                if interval >= 0 { free = bot.forecast.safe[interval].end - now; }
                color = safetyColor(free, 0.33);
            }
            DrawCube(point.at(0.2), CellSize * 0.9, 0.03, CellSize * 0.9, color);
        }
    }

    // Its plan: the points where it waits for a gap are yellow, and bigger the longer it waits
    previous := hero.position + Vector3{0, 0.5, 0};
    arrived := game.time;
    for waypoint, i in bot.plan {
        if i < bot.next { continue; }
        point := waypoint.point.at(0.5);
        DrawCylinderEx(previous, point, 0.12, 0.12, 4, player.color);
        wait := waypoint.depart - arrived;
        if wait > 0.15 {
            DrawSphere(previous, 0.3 + math.min(wait, 3) * 0.2, {250, 220, 60, 220});
        }
        previous = point;
        arrived = waypoint.arrive;
    }

    // A ring around it in the color of how soon a car is on it
    hit := bot.forecast.hitTime(center, now, 0) - now;
    DrawCircle3D(hero.position + Vector3{0, 0.3, 0}, hero.info().hitRadius + 0.6, {1, 0, 0}, 90, safetyColor(hit, 1));
    DrawCircle3D(hero.position + Vector3{0, 0.3, 0}, hero.info().hitRadius + 0.5, {1, 0, 0}, 90, safetyColor(hit, 1));
}

describe :: method (bot: *Bot, game: *Game, me: int, lines: *[..]InspectorLine) {
    player := &game.players[me];
    hero := &player.hero;
    decision := bot.decision;
    lines.add(InspectorLine{fmt.sprint("% (%) · %", player.name, bot.personality.label, hero.info().name), player.color});

    doing := switch decision.mode {
        case .waiting    => "Waiting for a gap";
        case .walking    => "Walking its plan";
        case .dodging    => "Dodging a car it didn't plan for";
        case .casting    => fmt.sprint("Casting %", decision.lastCast);
        case .noPlan     => "No plan: standing still";
        case .cantAct    => "Can't act: stunned, dragged or in the air";
        case .notPlaying => "Not on the field";
    };
    if decision.mode == .waiting && bot.next < bot.plan.count {
        doing = fmt.sprint("Waiting for a gap: leaves in % s", fmt.fixed(bot.plan[bot.next].depart - game.time, 1));
    }
    lines.add(InspectorLine{text: doing});

    if bot.hasForecast && player.isPlaying() {
        now := game.time - bot.forecastAt;
        hit := bot.forecast.hitTime(hero.ground(), now, 0) - now;
        text := "No car coming";
        if hit < ForecastHorizon { text = fmt.sprint("A car is on it in % s", fmt.fixed(hit, 1)); }
        lines.add(InspectorLine{text, safetyColor(hit, 1)});
    }

    across := "goes part of the way, to where it can wait";
    if bot.reachesGoal { across = "all the way across"; }
    lines.add(InspectorLine{text: fmt.sprint("Plan: % points, %", bot.plan.count - bot.next, across)});
    lines.add(InspectorLine{fmt.sprint("Last search: % ms, % states. Forecast % s old",
        fmt.fixed((decision.lastSearch * 1000) as f32, 1), decision.lastStates, fmt.fixed(game.time - bot.forecastAt, 2)), DimColor});

    // The abilities, with the score of the last look at them against the bar
    lines.add(InspectorLine{fmt.sprint("Abilities (cast when over %):", fmt.fixed(decision.bar, 2)), DimColor});
    for ability, slot in hero.abilities() {
        score := decision.scores[slot];
        state := "";
        color := TextColor;
        if ability.isPassive() {
            state = "passive";
            color = DimColor;
        } else if !hero.abilityReady(slot as int) || score < 0 {
            state = fmt.sprint("cooling down, % s", fmt.fixed(hero.cooldowns[slot], 1));
            color = DimColor;
        } else {
            state = fmt.sprint("%", fmt.fixed(score, 2));
            if score > decision.bar { color = {120, 255, 140, 255}; }
        }
        lines.add(InspectorLine{fmt.sprint("    %: %", ability.name, state), color});
    }
    if decision.lastCast.len > 0 {
        lines.add(InspectorLine{fmt.sprint("Last cast % % s ago", decision.lastCast, fmt.fixed(game.time - decision.lastCastAt, 1)), DimColor});
    }

    stats := bot.stats;
    lines.add(InspectorLine{fmt.sprint("Waited % s, walked % s, dodged % times", stats.waiting as int, stats.walking as int, stats.dodges), DimColor});
    lines.add(InspectorLine{fmt.sprint("Crossed %, run over %", player.stats.crossings, player.stats.deaths), DimColor});
}
