namespace aov;

import math;
import random;
use raylib;

// The cars on the motorway. Every lane drives towards +z, from the far end of the road to the near one. Each car has a
// speed of its own, and a faster car drives straight through a slower one in its lane, so nobody waits

CarKind :: enum {
    car,
    van,
    truck,
}

Car :: struct {
    isActive:   bool;
    kind:       CarKind;
    lane:       int;
    z:          f32;        // The middle of the car along the road
    color:      Color;
    speed:      f32;
    frozenLeft: f32;        // Seconds it is frozen by Frosty
    layer:      int;        // 0 to 3, different for cars after each other in a lane. Drawn a bit bigger by it, so two
                            // cars that drive through each other don't have their faces in the same place (z-fighting)
    hasHonked:  bool;

    // The health it takes off a hero it is on, per second
    damagePerSecond :: method () -> f32 {
        return switch self.kind {
            case .car   => CarDamagePerSecond;
            case .van   => CarDamagePerSecond * 1.2;
            case .truck => CarDamagePerSecond * 1.6;
        };
    }

    length :: method () -> f32 {
        return self.kind.length();
    }

    height :: method () -> f32 {
        return switch self.kind {
            case .car   => CarHeight;
            case .van   => VanHeight;
            case .truck => TruckHeight;
        };
    }

    // The footprint on the ground: x and z
    rect :: method () -> Rectangle {
        x := laneCenter(self.lane);
        length := self.length();
        return {x - CarWidth * 0.5, self.z - length * 0.5, CarWidth, length};
    }

    position :: method () -> Vector3 {
        return {laneCenter(self.lane), 0, self.z};
    }
}

length :: method (kind: CarKind) -> f32 {
    return switch kind {
        case .car   => CarLength;
        case .van   => VanLength;
        case .truck => TruckLength;
    };
}

Lane :: struct {
    speed:      f32;        // The speed its cars drive around
    spawnTimer: f32;        // Seconds to the next car
    spawned:    int;        // Cars so far, for the layer of the next
}

Traffic :: struct {
    cars:  [MaxCars]Car;
    lanes: [LaneCount]Lane;
    level: int;
}

CarColors :: [
    Color{236, 240, 241, 255}, Color{ 44,  62,  80, 255}, Color{192,  57,  43, 255}, Color{ 41, 128, 185, 255},
    Color{243, 156,  18, 255}, Color{ 39, 174,  96, 255}, Color{142,  68, 173, 255}, Color{149, 165, 166, 255},
    Color{211,  84,   0, 255}, Color{ 22, 160, 133, 255},
];

laneCenter :: (lane: int) -> f32 {
    return -RoadHalfWidth + LaneWidth * (lane as f32 + 0.5);
}

// The lane at a point across the road
laneAt :: (x: f32) -> int {
    return math.clamp(math.floorf((x + RoadHalfWidth) / LaneWidth) as int, 0, LaneCount - 1);
}

// Where the road starts and ends, past the edges of the field
RoadEnd :: MapHalfLength + RoadOverhang;

newTraffic :: (level: int, rng: *random.Random) -> Traffic {
    traffic: Traffic;
    traffic.setLevel(level, rng);

    // Fill the road, as if the traffic had been driving for a while
    for 0..400 {
        traffic.update(0.1, rng, null);
    }
    return traffic;
}

setLevel :: method (traffic: *Traffic, level: int, rng: *random.Random) {
    previous := 1 + SpeedUpPerLevel * traffic.level as f32;
    traffic.level = math.min(level, MaxLevel);
    speedUp := 1 + SpeedUpPerLevel * traffic.level as f32;

    for *lane in traffic.lanes {
        lane.speed = rng.uniform(MinCarSpeed, MaxCarSpeed) as f32 * speedUp;
    }

    // The cars on the road speed up too
    for *car in traffic.cars {
        if car.isActive { car.speed *= speedUp / previous; }
    }
}

// A circle on the road where the cars drive slower, e.g around Frosty
SlowZone :: struct {
    center: Vector2;
    radius: f32;
    slow:   f32;            // 0.4 is 40% slower
}

update :: method (traffic: *Traffic, dt: f32, rng: *random.Random, slowZone: ?SlowZone) {
    for *car in traffic.cars {
        if !car.isActive { continue; }

        if car.frozenLeft > 0 {
            car.frozenLeft -= dt;
            continue;
        }

        speed := car.speed;
        if slowZone.hasValue() {
            zone := slowZone.value();
            if CheckCollisionCircleRec(zone.center, zone.radius, car.rect()) { speed *= 1 - zone.slow; }
        }
        car.z += speed * dt;
        if car.z > RoadEnd + car.length() {
            car.isActive = false;
        }
    }

    for *lane, i in traffic.lanes {
        lane.spawnTimer -= dt;
        if lane.spawnTimer > 0 { continue; }

        traffic.spawn(i as int, rng);

        // The time to the next car shrinks as the levels go up
        gap := rng.uniform(8, 50) as f32 * (1 - 0.03 * traffic.level as f32);
        lane.spawnTimer = (gap + CarLength) / lane.speed;
    }
}

// Puts a new car at the start of a lane, at the far end of the road
spawn :: method (traffic: *Traffic, lane: int, rng: *random.Random) {
    kind := CarKind.car;
    roll := rng.random();
    if roll < 0.12      { kind = .truck; }
    else if roll < 0.25 { kind = .van; }

    // Every car drives a bit faster or slower than its lane. Trucks are slow
    speed := traffic.lanes[lane].speed * rng.uniform(0.8, 1.2) as f32;
    if kind == .truck { speed *= 0.8; }

    for *car in traffic.cars {
        if car.isActive { continue; }

        *car = Car{
            isActive: true,
            kind:     kind,
            lane:     lane,
            z:        -RoadEnd - kind.length() * 0.5,
            color:    rng.choice(CarColors),
            speed:    speed,
            layer:    traffic.lanes[lane].spawned % 4,
        };
        traffic.lanes[lane].spawned += 1;
        return;
    }
    // Every car is on the road already
}

// Freezes the cars within the radius of a point
freezeAround :: method (traffic: *Traffic, point: Vector2, radius: f32, duration: f32) -> int {
    frozen := 0;
    for *car in traffic.cars {
        if !car.isActive { continue; }
        if CheckCollisionCircleRec(point, radius, car.rect()) {
            car.frozenLeft = duration;
            frozen += 1;
        }
    }
    return frozen;
}

// The first car that hits a circle on the ground
carHitting :: method (traffic: *Traffic, center: Vector2, radius: f32) -> ?*Car {
    for *car in traffic.cars {
        if car.isActive && CheckCollisionCircleRec(center, radius, car.rect()) {
            return car;
        }
    }
    return null;
}

activeCount :: method (traffic: *Traffic) -> int {
    return traffic.cars.countWhere(car => car.isActive);
}
