namespace aov;

use raylib;

// The sun: a directional light with a bit of shine, plus ambient light, and a haze in the distance. The shader is in the
// program, so the game needs no files for it

Lighting :: struct {
    shader:       Shader;
    viewPosition: int;          // The location of the uniform of the camera position
}

SunDirection :: Vector3{-0.45, -1, -0.35};
SunColor     :: Vector3{1.0, 0.95, 0.85};
AmbientColor :: Vector3{0.42, 0.45, 0.52};
HazeColor    :: Vector3{0.36, 0.46, 0.38};

newLighting :: () -> Lighting {
    shader := LoadShaderFromMemory(
"#version 330
in vec3 vertexPosition;
in vec2 vertexTexCoord;
in vec3 vertexNormal;

uniform mat4 mvp;
uniform mat4 matModel;
uniform mat4 matNormal;

out vec3 fragPosition;
out vec2 fragTexCoord;
out vec3 fragNormal;

void main() {
    fragPosition = vec3(matModel * vec4(vertexPosition, 1.0));
    fragTexCoord = vertexTexCoord;
    fragNormal   = normalize(vec3(matNormal * vec4(vertexNormal, 0.0)));
    gl_Position  = mvp * vec4(vertexPosition, 1.0);
}
",
"#version 330
in vec3 fragPosition;
in vec2 fragTexCoord;
in vec3 fragNormal;

uniform sampler2D texture0;
uniform vec4 colDiffuse;
uniform vec3 viewPos;
uniform vec3 sunDirection;
uniform vec3 sunColor;
uniform vec3 ambientColor;
uniform vec3 hazeColor;

out vec4 finalColor;

void main() {
    vec4 base = texture(texture0, fragTexCoord) * colDiffuse;

    vec3 normal  = normalize(fragNormal);
    vec3 toLight = normalize(-sunDirection);
    vec3 toEye   = normalize(viewPos - fragPosition);

    float diffuse  = max(dot(normal, toLight), 0.0);
    float specular = pow(max(dot(normal, normalize(toLight + toEye)), 0.0), 24.0) * 0.18;

    vec3 color = base.rgb * (ambientColor + sunColor * diffuse) + sunColor * specular * diffuse;

    float haze = clamp((length(viewPos - fragPosition) - 140.0) / 260.0, 0.0, 0.75);
    finalColor = vec4(mix(color, hazeColor, haze), base.a);
}
");

    // DrawMesh sets these when the shader has them
    shader.locs[ShaderLocationIndex.shaderLocMatrixModel as int]  = GetShaderLocation(shader, "matModel");
    shader.locs[ShaderLocationIndex.shaderLocMatrixNormal as int] = GetShaderLocation(shader, "matNormal");

    lighting := Lighting{shader: shader, viewPosition: GetShaderLocation(shader, "viewPos")};
    lighting.setVector("sunDirection", SunDirection.normalize());
    lighting.setVector("sunColor", SunColor);
    lighting.setVector("ambientColor", AmbientColor);
    lighting.setVector("hazeColor", HazeColor);
    return lighting;
}

setVector :: method (lighting: *Lighting, name: string, value: Vector3) {
    cName := name.toCString();
    defer cName.free();
    SetShaderValue(lighting.shader, GetShaderLocation(lighting.shader, cName), &value, .vec3);
}

// Once a frame, before drawing, for the shine and the haze
setCamera :: method (lighting: *Lighting, camera: Camera3D) {
    position := camera.position;
    SetShaderValue(lighting.shader, lighting.viewPosition, &position, .vec3);
}

// A material that is lit by the sun, in a color
newMaterial :: method (lighting: *Lighting, color: Color) -> Material {
    material := LoadMaterialDefault();
    material.shader = lighting.shader;
    material.maps[MaterialMapIndex.materialMapAlbedo as int].color = color;
    return material;
}

unload :: method (lighting: *Lighting) {
    UnloadShader(lighting.shader);
}
