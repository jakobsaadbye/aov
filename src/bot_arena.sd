// The bots play on their own, without a window, as fast as they can, and it says how they did: crossings, deaths, how
// long a crossing took, how much of the time they waited for gaps, and what their thinking cost. For tuning the bots,
// and to see that a change made them better
//
//     saad run bot_arena.sd                                    4 bots, 3 games of 3 minutes
//     saad run bot_arena.sd -- --bots 6 --games 5 --seconds 300 --seed 42
//     saad run bot_arena.sd -- --peaceful                      they don't cast on each other: how well they cross
//     saad run bot_arena.sd -- --difficulty normal             bots of a difficulty (expert when not given)
//     saad run bot_arena.sd -- --default                       with the hand tuned genes instead of the trained ones
//     saad run bot_arena.sd -- --gene leadTime=0.2             with a gene changed, after --default when that is given
//     saad run bot_arena.sd -- --level 5                       the traffic starts at level 5 (6 crossings in)
//     saad run bot_arena.sd -- --bots 1 --trace > trace.txt    what a bot does each frame; tools/plot_bot.py draws it
//     saad run bot_arena.sd -- --nododge                       without the reflex: what the plans do on their own
//
// Build it with --llvm (saad build bot_arena.sd --llvm): the bots think about 10 times as fast

import core;
import bots;
import fmt;
import os;
import time;
import random;
use raylib;

Dt :: 1.0 / 60.0;

main :: () {
    botCount := 4;
    games := 3;
    seconds := 180;
    seed: u64 = 1;
    peaceful := false;
    mixed := false;         // A bot of each difficulty in each game, and how each difficulty did
    byDifficulty: [core.Difficulty.count]core.Stats;
    fitnessOf:    [core.Difficulty.count]f32;
    difficulty := core.Difficulty.expert;
    level := 0;
    args := os.args();
    i := 1;
    while i < args.count {
        next := "";
        if i + 1 < args.count { next = args[i + 1]; }
        switch args[i] {
            case "--bots"     { botCount = (next.toInt() ?? 4) as int; i += 1; }
            case "--games"    { games = (next.toInt() ?? 3) as int; i += 1; }
            case "--seconds"  { seconds = (next.toInt() ?? 180) as int; i += 1; }
            case "--seed"     { seed = (next.toInt() ?? 1) as u64; i += 1; }
            case "--peaceful" { peaceful = true; }
            case "--mixed"    { mixed = true; }
            case "--difficulty" {
                index := core.Difficulty.names.indexOf(next);
                if index >= 0 { difficulty = index as core.Difficulty; }
                i += 1;
            }
            case "--hits"     { bots.debugHits = true; }
            case "--level"    { level = (next.toInt() ?? 0) as int; i += 1; }     // The traffic starts at this level
            case "--nododge"  { bots.noDodge = true; }
            case "--trace"    { bots.debugTrace = true; bots.debugHits = true; }
            case "--default"  { bots.useGenome(bots.defaultGenome()); }     // The hand tuned genes, not the trained ones
            case "--gene" {
                // e.g --gene leadTime=0.2: one gene of the genome they play with, changed
                genome := bots.trainedGenome();
                at := next.indexOf("=");
                gene := bots.Gene.names.indexOf(next.slice(0, at));
                value := next.slice(at + 1, next.len).toFloat();
                if gene >= 0 && value.hasValue() { genome.set(gene as bots.Gene, value.value() as f32); bots.useGenome(genome); }
                else { fmt.print("Unknown gene '%'", next); }
                i += 1;
            }
            else              { fmt.print("Unknown option '%'", args[i]); }
        }
        i += 1;
    }

    totalCrossings := 0;
    totalDeaths := 0;
    worstFrame: f64 = 0;
    thinking: f64 = 0;
    frames := 0;

    for g in 0..games {
        game: *core.Game = null;
        if mixed {
            rng := random.newRandom(seed + g as u64);
            personalities: [..]bots.BotPersonality;
            // A different seat for each difficulty in each game, so where a bot starts doesn't count
            for k in 0..core.Difficulty.count {
                personalities.add(bots.personalityFor(((k + g) % core.Difficulty.count) as core.Difficulty, &rng));
            }
            game = bots.newGameWith(seed + g as u64, personalities, humans: 0);
        } else {
            game = bots.newGame(seed + g as u64, bots: botCount, humans: 0, difficulty: difficulty);
        }
        defer game.free();
        if level > 0 { game.startAtLevel(level); }
        if peaceful {
            for *player in game.players { (player.brain as *bots.Bot).personality.genome.set(.aggression, 0); }
        }

        steps := (seconds as f32 / Dt) as int;
        for 0..steps {
            start := time.clock();
            game.simulate(Dt);
            took := time.clock() - start;
            thinking += took;
            if took > worstFrame { worstFrame = took; }
            frames += 1;
        }

        fmt.print("Game % (seed %), % s, level %:", g + 1, seed + g as u64, seconds, game.level() + 1);
        for player, i in game.players {
            best := "-";
            if player.stats.bestTime.hasValue() { best = fmt.sprint("% s", fmt.fixed(player.stats.bestTime.value(), 1)); }
            profile := (player.brain as *bots.Bot).profile();
            plans := atLeastOne(profile.plans);
            fmt.print("    %   across %   run over %   items %   best %   |  waits % s, walks % s, no plan % s, dodged %  |  search % ms (% of % forecasts, % ms each), % states, % found a way",
                player.name, player.stats.crossings, player.stats.deaths, player.stats.items, best,
                profile.waiting as int, profile.walking as int, profile.noPlan as int, profile.dodges,
                fmt.fixed((profile.planSeconds / plans as f64 * 1000) as f32, 1), profile.plans, profile.forecasts,
                fmt.fixed((profile.forecastSeconds / atLeastOne(profile.forecasts) as f64 * 1000) as f32, 2),
                profile.expanded / plans as i64, fmt.fixed(profile.reachedGoal as f32 / plans as f32, 2));
            if mixed {
                level := &byDifficulty[(i + g) % core.Difficulty.count];
                fitnessOf[(i + g) % core.Difficulty.count] += bots.fitnessOf(game, i as int);
                level.crossings += player.stats.crossings;
                level.deaths += player.stats.deaths;
                level.kills += player.stats.kills;
            }
            totalCrossings += player.stats.crossings;
            totalDeaths += player.stats.deaths;
        }
    }

    if mixed {
        fmt.print("");
        for level, d in byDifficulty {
            fmt.print("%:  across %, run over %, kills %, fitness % a game", core.Difficulty.names[d], level.crossings, level.deaths, level.kills, fmt.fixed(fitnessOf[d] / games as f32, 2));
        }
    }
    fmt.print("");
    fmt.print("Crossings %, run over % (% crossings for each death)", totalCrossings, totalDeaths, fmt.fixed(totalCrossings as f32 / atLeastOne(totalDeaths) as f32, 2));
    fmt.print("A frame took % ms on average, % ms at most", fmt.fixed((thinking / frames as f64 * 1000) as f32, 3), fmt.fixed((worstFrame * 1000) as f32, 2));
}

atLeastOne :: (n: int) -> int {
    if n < 1 { return 1; }
    return n;
}
