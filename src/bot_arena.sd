// The bots play on their own, without a window, as fast as they can, and it says how they did: crossings, deaths, how
// long a crossing took, how much of the time they waited for gaps, and what their thinking cost. For tuning the bots,
// and to see that a change made them better
//
//     saad run bot_arena.sd                                    4 bots, 3 games of 3 minutes
//     saad run bot_arena.sd -- --bots 6 --games 5 --seconds 300 --seed 42
//     saad run bot_arena.sd -- --peaceful                      they don't cast on each other: how well they cross
//     saad run bot_arena.sd -- --difficulty normal             bots of a difficulty (expert when not given)
//
// Build it with --llvm (saad build bot_arena.sd --llvm): the bots think about 10 times as fast

import aov;
import fmt;
import os;
import time;
import random;
use raylib;

Dt :: 1.0 / 60.0;

main :: () {
    bots := 4;
    games := 3;
    seconds := 180;
    seed: u64 = 1;
    peaceful := false;
    mixed := false;         // A bot of each difficulty in each game, and how each difficulty did
    byDifficulty: [aov.Difficulty.count]aov.Stats;
    fitnessOf:    [aov.Difficulty.count]f32;
    difficulty := aov.Difficulty.expert;
    args := os.args();
    i := 1;
    while i < args.count {
        next := "";
        if i + 1 < args.count { next = args[i + 1]; }
        switch args[i] {
            case "--bots"     { bots = (next.toInt() ?? 4) as int; i += 1; }
            case "--games"    { games = (next.toInt() ?? 3) as int; i += 1; }
            case "--seconds"  { seconds = (next.toInt() ?? 180) as int; i += 1; }
            case "--seed"     { seed = (next.toInt() ?? 1) as u64; i += 1; }
            case "--peaceful" { peaceful = true; }
            case "--mixed"    { mixed = true; }
            case "--difficulty" {
                index := aov.Difficulty.names.indexOf(next);
                if index >= 0 { difficulty = index as aov.Difficulty; }
                i += 1;
            }
            case "--hits"     { aov.debugHits = true; }
            else              { fmt.print("Unknown option '%'", args[i]); }
        }
        i += 1;
    }

    totalCrossings := 0;
    totalDeaths := 0;
    worstFrame: f64 = 0;
    thinking: f64 = 0;
    frames := 0;

    for g in 0..games {
        game: *aov.Game = null;
        if mixed {
            rng := random.newRandom(seed + g as u64);
            personalities: [..]aov.BotPersonality;
            // A different seat for each difficulty in each game, so where a bot starts doesn't count
            for k in 0..aov.Difficulty.count {
                personalities.add(aov.personalityFor(((k + g) % aov.Difficulty.count) as aov.Difficulty, &rng));
            }
            game = aov.newGameWith(seed + g as u64, personalities, humans: 0);
        } else {
            game = aov.newGame(seed + g as u64, bots: bots, humans: 0, difficulty: difficulty);
        }
        defer game.free();
        if peaceful {
            for *player in game.players { (player.brain as *aov.Bot).personality.genome.set(.aggression, 0); }
        }

        steps := (seconds as f32 / Dt) as int;
        for 0..steps {
            start := time.clock();
            game.simulate(Dt);
            took := time.clock() - start;
            thinking += took;
            if took > worstFrame { worstFrame = took; }
            frames += 1;
        }

        fmt.print("Game % (seed %), % s, level %:", g + 1, seed + g as u64, seconds, game.level() + 1);
        for player, i in game.players {
            best := "-";
            if player.stats.bestTime.hasValue() { best = fmt.sprint("% s", fmt.fixed(player.stats.bestTime.value(), 1)); }
            profile := player.brain.profile();
            plans := atLeastOne(profile.plans);
            fmt.print("    %   across %   run over %   best %   |  waits % s, walks % s, no plan % s, dodged %  |  search % ms (% of % forecasts), % states, % found a way",
                player.name, player.stats.crossings, player.stats.deaths, best,
                profile.waiting as int, profile.walking as int, profile.noPlan as int, profile.dodges,
                fmt.fixed((profile.planSeconds / plans as f64 * 1000) as f32, 1), profile.plans, profile.forecasts,
                profile.expanded / plans as i64, fmt.fixed(profile.reachedGoal as f32 / plans as f32, 2));
            if mixed {
                level := &byDifficulty[(i + g) % aov.Difficulty.count];
                fitnessOf[(i + g) % aov.Difficulty.count] += aov.fitnessOf(game, i as int);
                level.crossings += player.stats.crossings;
                level.deaths += player.stats.deaths;
                level.kills += player.stats.kills;
            }
            totalCrossings += player.stats.crossings;
            totalDeaths += player.stats.deaths;
        }
    }

    if mixed {
        fmt.print("");
        for level, d in byDifficulty {
            fmt.print("%:  across %, run over %, kills %, fitness % a game", aov.Difficulty.names[d], level.crossings, level.deaths, level.kills, fmt.fixed(fitnessOf[d] / games as f32, 2));
        }
    }
    fmt.print("");
    fmt.print("Crossings %, run over % (% crossings for each death)", totalCrossings, totalDeaths, fmt.fixed(totalCrossings as f32 / atLeastOne(totalDeaths) as f32, 2));
    fmt.print("A frame took % ms on average, % ms at most", fmt.fixed((thinking / frames as f64 * 1000) as f32, 3), fmt.fixed((worstFrame * 1000) as f32, 2));
}

atLeastOne :: (n: int) -> int {
    if n < 1 { return 1; }
    return n;
}
