namespace core;

// The numbers that tune the game. The world is laid out on the ground plane: x runs from left to right across the road,
// z from the far end of the road (negative) towards the camera (positive), and y is up.

WindowWidth  :: 1600;
WindowHeight :: 900;
TargetFps    :: 144;

// The playing field
MapHalfWidth  :: 80.0;      // x from -80 to 80
MapHalfLength :: 64.0;      // z from -64 to 64

// The motorway runs along z, and all of its lanes drive from the far end (the top of the screen) towards the camera.
// The cars are nearly as wide as their lanes, so no hero fits between two of them
LaneWidth     :: 6.0;
LaneCount     :: 16;
RoadHalfWidth :: LaneWidth * LaneCount * 0.5;     // 48: the road covers x from -48 to 48
RoadOverhang  :: 40.0;                            // How far the road goes on past the field, where the cars come from

// The walls along both sides of the road, each with one opening to get on and off it
WallWidth       :: 3.0;
WallHeight      :: 4.0;
OpeningLength   :: 18.0;
OpeningInset    :: 10.0;    // From the end of the field to the opening

// Where heroes start on the left side, and how far past the middle they have to get. Mirrored on the right side
SpawnX    :: -MapHalfWidth + 8;
GoalX     :: RoadHalfWidth + WallWidth + 4;   // Past the wall on the far side

WallSegmentLength :: 5.0;     // The length of data/models/wall.obj, which is repeated along each wall

// Traffic. The sizes of the vehicles are those of their models in data/models (see tools/make_models.py)
MaxCars         :: 160;
CarWidth        :: 5.2;
CarLength       :: 8.0;
VanLength       :: 9.0;
TruckLength     :: 16.0;
CarHeight       :: 2.4;
VanHeight       :: 3.0;
TruckHeight     :: 4.2;
MinCarSpeed     :: 6.0;
MaxCarSpeed     :: 17.0;
SpeedUpPerLevel :: 0.06;    // Every crossing makes the traffic this much faster
MaxLevel        :: 15;

// Heroes
ClickReachedDistance :: 0.3;
RespawnDelay         :: 1.25;   // Seconds from being run over to the next hero
CarDamagePerSecond   :: 100.0;  // The health a car takes while it is on a hero. Vans and trucks take more
HealDelay            :: 1.5;    // Seconds without being hit before a hero with a First Aid Kit heals

// Effects
MaxParticles :: 256;
MaxSplats    :: 24;
SplatLifetime :: 10.0;
