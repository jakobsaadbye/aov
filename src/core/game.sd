namespace core;

import fmt;
import math;
import mem;
import random;
use raylib;

// The game: a few players, each with a hero, racing across the same road. One player is you, the others are bots.
//
// Everything a player does is a Command: walk somewhere, stop, or cast an ability at a point. Your keys and mouse make
// commands (readInput), and so does the brain of a bot (src/bots), so a bot can do exactly what you can and nothing
// more. Game.simulate moves the world on and reads no input, so it runs without a window, e.g in simulation_test.sd

MaxPlayers :: 6;

// What a player's hero is doing right now
Phase :: union {
    playing;
    runOver: struct { timeLeft: f32; };     // The hero was hit, and the next one comes soon
    crossed: struct { timeLeft: f32; };     // The hero made it, and celebrates for a moment
    regroup: struct { timeLeft: f32; };     // Another made it: it stands still, then starts again from that side
}

Stats :: struct {
    crossings: int;
    deaths:    int;
    kills:     int;                         // Enemies a car got soon after this player hooked, bashed or locked them
    bestTime:  ?f32;                        // The fastest crossing, in seconds
    items:     int;                         // Items picked up
    deathsBy:  [HeroKind.count]int;         // How many of each hero the road has taken
}

// An order to a hero. The target of a cast is a point on the ground: where to blink or hook to, or near which enemy
// to cast on, like the cursor of a player
Command :: union {
    move: Vector2;
    stop;
    cast: struct { slot: int; target: Vector2; };
    lockItem: int;                          // Locks the item in a slot of the backpack, or unlocks it
}

Player :: struct {
    name:      string;
    color:     Color;                       // Of the ring under the hero, and the name on the scoreboard
    hero:      Hero;
    phase:     Phase;
    stats:     Stats;
    startSide: Side;                        // Where the hero starts. It flips with every crossing
    brain:     Brain;                       // What gives the orders of a bot. Null for a player at the keyboard
    commands:  [..]Command;                 // The orders of this frame, carried out by Game.simulate
    backpack:  Backpack;                    // The items it picked up, which boost all of its heroes (items.sd)
    perks:     [..]PerkKind;                // Picked after the crossings, for all of its heroes (perks.sd)
    decoy:     ?Decoy;                      // Tim & Tom's other twin, while it walks (world_effects.sd)

    isBot :: method () -> bool {
        return self.brain != null;
    }

    isPlaying :: method () -> bool {
        return self.phase.kind == .playing;
    }

    order :: method * (command: Command) {
        self.commands.add(command);
    }
}

PlayerColors :: [
    Color{90, 255, 110, 255},     // You: green, like the selected unit of Warcraft
    Color{255, 90, 80, 255},
    Color{80, 170, 255, 255},
    Color{255, 200, 60, 255},
    Color{210, 110, 255, 255},
    Color{90, 230, 220, 255},
];

// A line of text in the middle of the screen that fades out
Banner :: struct {
    text:     string;
    color:    Color;
    timeLeft: f32;
}

BannerTime :: 2.5;

// The lines in the corner of what happened to the other players, like the kill feed of Dota
FeedLine :: struct {
    text:     string;
    color:    Color;
    timeLeft: f32;
}

FeedTime  :: 6.0;
FeedLines :: 5;

DebugToggles :: struct {
    wireframes: bool;
    hitboxes:   bool;
    overlay:    bool;
}

// What gives the orders of a bot: something that looks at the game and gives its player's hero orders, with the same
// Commands that your keys and mouse give. So a bot can't do anything you can't, and the game knows nothing of how it
// thinks: the bots of the bots namespace (src/bots) are one kind of Brain, and a new kind is a new struct with these
// methods, without changing the game
Brain :: interface {
    // Looks at the game and gives the hero of player me its orders for this frame, with player.order(command)
    think :: method * (game: *Game, me: int, dt: f32);

    // Forgets what it was doing, e.g for a new game
    reset :: method * ();

    // Gives back its memory, when the game is over
    free :: method * ();

    // Plays at another difficulty, from the next game, which is chosen on the pause screen
    setDifficulty :: method * (difficulty: Difficulty);

    // A car hit its hero, e.g to find out why (bot_arena.sd --hits)
    wasHit :: method * (game: *Game, me: int, car: *Car);

    // For the inspector (F4, inspector.sd): its plan, faintly, which is drawn for every bot; what it knows in the world,
    // in 3D, e.g where it is safe and where it is going; and lines of text that say what it is doing and why
    drawPlan :: method (game: *Game, me: int);
    drawInspection :: method * (game: *Game, me: int);
    describe :: method * (game: *Game, me: int, lines: *[..]InspectorLine);
}

// How good the bots are, which is chosen on the pause screen and kept in recordings. What it means is up to the Brain
Difficulty :: enum {
    easy,
    normal,
    hard,
    expert,
}

Game :: struct {
    rng:         random.Random;
    world:       World;
    traffic:     Traffic;
    players:     [..]Player;                // Added before the game starts, so a *Player stays where it is
    local:       int;                       // The player at the keyboard, or -1 for none: a spectator
    watched:     int;                       // The player the camera and the HUD follow: the one at the keyboard, or
                                            // when spectating, the one picked with Tab or 1 to 6. Only what is shown,
                                            // not what is played, so it isn't recorded and each viewer has their own
    time:        f32;                       // Seconds since the game started
    camera:      RtsCamera;
    effects:     Effects;
    banner:      Banner;
    feed:        [..]FeedLine;
    isPaused:    bool;
    showHelp:    bool = true;
    debug:       DebugToggles;
    mouseGround: ?Vector3;                  // The point on the ground under the mouse
    hoveredAbility: int = -1;               // The slot of the ability whose icon the mouse is on, set by the HUD
    hoveredItem: int = -1;                  // and of the item in the backpack
    mouseOnHud:  bool;                      // The mouse is on the hero card: a click there isn't on the ground
    aiming:      int = -1;                  // An ability whose icon was clicked: the next left click on the ground casts it
    sounds:      SoundPlayer;               // Silent until it is loaded, e.g in simulation_test.sd
    inspector:   Inspector;                 // F4: what a bot thinks (inspector.sd)
    recording:   Recording;                 // What was played so far (recording.sd)
    replay:      *Replay;                   // The recording that is played back, or null
    isStepping:  bool;                      // In a frame of advance, which is recorded or replayed
    difficulty:  Difficulty;                // Of the bots
    nextDifficulty: ?Difficulty;            // Chosen while paused, for the next game
    restartPending:  bool;                  // Keys of this frame, carried out by advance
    pendingHero: ?HeroKind;                 // The hero the player at the keyboard changes to, e.g by setHero
    keyboardTaken: bool;                    // The console (F1) is open: the game reads no keys or mouse
    stopSigns:   [..]StopSign;              // Hilda's signs and Birgit's barricades, while their lanes are stopped
    bridges:     [..]Bridge;                // Birgit's footbridges (motions.sd)
    projectiles: [..]Projectile;            // Thrown things, e.g Ivar's axe (world_effects.sd)
    rain:        [..]Rain;                  // Stormy's downpours
    peels:       [..]Peel;                  // Banana peels on the ground
    strikes:     [..]Strike;                // Stormy's lightning, while it is seen
    items:       Items;                     // The item on the road, and when the next one comes (items.sd)
    slicks:      Slicks;                    // The oil on the road (slicks.sd)
    restarts:    int;                       // Games started, the first one too
    length:      GameLength = .medium;      // How many crossings win (match.sd)
    nextLength:  ?GameLength;               // Chosen while paused, for the next game
    pauseRow:    int;                       // The setting the arrow keys change on the pause screen
    side:        Side = .left;              // Where everybody starts from, in this round
    winner:      int = -1;                  // Who won, while the results are shown
    endLeft:     f32;                       // Seconds until the next game
    asyncBots:   bool;                      // The bots search for their ways on threads of their own, so a frame never
                                            // waits for them. Only in the window: elsewhere a seed always plays the
                                            // same game (bots/search_job.sd)
}

// Says when a rush hour is coming, starts and ends, and sounds the siren of an ambulance
announceTraffic :: method (game: *Game, rushBefore: RushPhase, sirenBefore: int) {
    traffic := &game.traffic;
    if traffic.rush != rushBefore {
        switch traffic.rush {
            case .coming { game.showBanner({255, 170, 60, 255}, "Rush hour in % seconds!", RushWarning as int); }
            case .rush   { game.showBanner({255, 90, 60, 255}, "Rush hour!"); }
            case .calm   { game.showBanner({140, 220, 140, 255}, "The rush is over"); }
        }
    }
    if traffic.emergencyLane >= 0 && sirenBefore < 0 {
        game.sounds.playAt("traffic.siren", Vector3{laneCenter(traffic.emergencyLane), 0, -MapHalfLength}, 1.0);
        game.announce(-1, {255, 80, 80, 255}, "Ambulances are coming!");
    }
}

// What stops the cars of some lanes for a while, where it stands
SignKind :: enum {
    stopSign,       // Hilda holds it up
    barricade,      // Birgit put it on the road
}

StopSign :: struct {
    kind:     SignKind;
    position: Vector3;
    timeLeft: f32;
    lanes:    [2]int;                       // The first and the last lane it stops
    line:     f32;                          // Where the cars stop
}

// A game with you (or no one at the keyboard with humans: 0) and bots with these brains, named by the names. The bots
// namespace makes the brains, e.g with bots.newGame
newGame :: (seed: u64, brains: []Brain, names: []string, humans: int = 1, difficulty := Difficulty.normal) -> *Game {
    game := new(Game);
    game.rng = random.newRandom(seed);
    game.effects.particles = newParticles(seed);
    game.world = newWorld();
    game.difficulty = difficulty;
    game.recording = Recording{seed: seed, bots: brains.count as int, humans: humans, difficulty: difficulty};
    if humans > 0 { game.addPlayer("You", null); }
    else          { game.local = -1; }       // Spectating: the view starts on the first bot
    for brain, i in brains {
        if game.players.count >= MaxPlayers { break; }
        game.addPlayer(names[i], brain);
    }
    game.restart();
    return game;
}

addPlayer :: method (game: *Game, name: string, brain: Brain) {
    assert(game.players.count < MaxPlayers);
    game.players.add(Player{name: name, color: PlayerColors[game.players.count], brain: brain});
}

restart :: method (game: *Game) {
    game.time    = 0;
    game.traffic = newTraffic(0, &game.rng);
    game.effects.clear();
    game.stopSigns.clear();
    game.bridges.clear();
    game.projectiles.clear();
    game.rain.clear();
    game.peels.clear();
    game.strikes.clear();
    for *player in game.players { player.decoy = null; }
    // Seeded by the games so far, so a replay has the same items and oil as the game it recorded
    game.restarts += 1;
    game.winner = -1;
    game.side = .left;
    game.items = newItems(game.recording.seed + game.restarts as u64);
    game.slicks.list.free();
    game.slicks = newSlicks(game.recording.seed + game.restarts as u64);

    for *player, i in game.players {
        player.stats = Stats{};
        player.backpack = Backpack{};
        player.perks.clear();
        player.startSide = .left;
        player.commands.clear();
        kind := (game.rng.between(0, HeroKind.count as int - 1)) as HeroKind;
        game.spawnHero(i as int, kind);
        if player.isBot() { player.brain.reset(); }
    }
    game.camera = newRtsCamera(game.you().hero.position);
}

free :: method (game: *Game) {
    game.banner.text.free();
    for line in game.feed { line.text.free(); }
    game.feed.free();
    game.stopSigns.free();
    game.bridges.free();
    game.projectiles.free();
    game.rain.free();
    game.peels.free();
    game.strikes.free();
    game.effects.particles.free();
    game.slicks.list.free();
    for *player in game.players {
        player.commands.free();
        player.perks.free();
        if player.isBot() { player.brain.free(); }
    }
    for *frame in game.recording.frames { frame.commands.free(); }
    game.recording.frames.free();
    game.recording.checksums.free();
    game.players.free();
    if game.replay != null { mem.delete(game.replay); }
    mem.delete(game);
}

// The player the screen shows: the one at the keyboard, or the one watched when spectating
you :: method (game: *Game) -> *Player {
    return &game.players[game.watched];
}

// Whether someone plays at this keyboard, or only watches
hasLocal :: method (game: *Game) -> bool {
    return game.local >= 0;
}

// When the view can go to another player: when spectating, and in a replay, where the keyboard plays nothing
canSwitchView :: method (game: *Game) -> bool {
    return !game.hasLocal() || game.replay != null;
}

// Watches another player
watch :: method (game: *Game, index: int) {
    if index < 0 || index >= game.players.count { return; }
    game.watched = index;
    if game.players[index].isBot() { game.inspector.player = index; }
}

// The traffic gets faster with the crossings of the player that is ahead
level :: method (game: *Game) -> int {
    best := 0;
    for player in game.players { best = math.max(best, player.stats.crossings); }
    return best;
}

showBanner :: method (game: *Game, color: Color, format: string, args: ...any) {
    game.banner.text.free();
    game.banner = Banner{text: fmt.sprint(format, ...args), color: color, timeLeft: BannerTime};
}

// Tells what happened: to you in the banner, to the others in the feed
announce :: method (game: *Game, player: int, color: Color, format: string, args: ...any) {
    if player == game.watched {
        game.showBanner(color, format, ...args);
        return;
    }
    if game.feed.count >= FeedLines { game.feed.removeAt(0).text.free(); }
    game.feed.add(FeedLine{text: fmt.sprint(format, ...args), color: color, timeLeft: FeedTime});
}

// Once a frame: the keys and the mouse, the thoughts of the bots, then the world moves on by dt seconds
update :: method (game: *Game, dt: f32) {
    game.handleKeys();
    game.advance(dt);
    game.updateCamera(dt);
}

// The keys that work at any time, also while paused. Once a frame
handleKeys :: method (game: *Game) {
    game.camera.takesKeys = !game.keyboardTaken;
    if game.keyboardTaken { return; }
    if IsKeyPressed(.p) || IsKeyPressed(.escape) {
        game.isPaused = !game.isPaused;
        game.sounds.setPaused(game.isPaused);
    }
    if IsKeyPressed(.h)  { game.showHelp = !game.showHelp; }
    if IsKeyPressed(.f8) { game.saveRecordingNow(); }
    if game.isPaused && game.replay == null {
        // The settings of the next game (F5): up and down pick one, left and right change it
        if IsKeyPressed(.up) || IsKeyPressed(.down) { game.pauseRow = 1 - game.pauseRow; }
        step := 0;
        if IsKeyPressed(.left)  { step = -1; }
        if IsKeyPressed(.right) { step = 1; }
        if step != 0 && game.pauseRow == 0 {
            current := (game.nextDifficulty ?? game.difficulty) as int;
            game.nextDifficulty = ((current + step + Difficulty.count) % Difficulty.count) as Difficulty;
        }
        if step != 0 && game.pauseRow == 1 {
            current := (game.nextLength ?? game.length) as int;
            game.nextLength = ((current + step + GameLength.count) % GameLength.count) as GameLength;
        }
    }
    game.updateInspector();
    if game.replay != null { return; }      // A replay plays what was recorded
    if IsKeyPressed(.f5) { game.restartPending = true; }
}

// One step of the game, unless it is paused: your orders, and the world moves on by dt seconds
advance :: method (game: *Game, dt: f32) {
    if game.isPaused { return; }
    game.mouseGround = game.camera.groundPoint(GetMousePosition());
    if game.replay == null { game.readInput(); }
    game.step(dt);
}

// A frame of the game that is recorded, or in a replay, the next recorded frame instead, with its time step. Reads no
// input, so it runs without a window, e.g in simulation_test.sd
step :: method (game: *Game, dt: f32) {
    step := dt;
    restart := game.restartPending;
    hero := game.pendingHero;
    game.restartPending = false;
    game.pendingHero = null;
    difficulty: ?Difficulty = null;
    if restart && game.nextDifficulty.hasValue() && game.nextDifficulty.value() != game.difficulty {
        difficulty = game.nextDifficulty;
    }
    length: ?GameLength = null;
    if restart && game.nextLength.hasValue() && game.nextLength.value() != game.length { length = game.nextLength; }
    if game.replay != null {
        if game.replay.isFinished() { return; }
        frame := game.replay.recording.frames[game.replay.frame];
        step = frame.dt;
        restart = frame.restart;
        hero = frame.hero;
        if frame.nextHero && game.hasLocal() { hero = ((game.players[game.local].hero.kind as int + 1) % HeroKind.count) as HeroKind; }    // Older recordings
        difficulty = frame.difficulty;
        length = frame.length;
    } else {
        game.recordFrame(step, restart, hero);
        game.recording.frames[game.recording.frames.count - 1].difficulty = difficulty;
        game.recording.frames[game.recording.frames.count - 1].length = length;
    }

    if difficulty.hasValue() { game.setDifficulty(difficulty.value()); }
    if length.hasValue() {
        game.length = length.value();
        game.nextLength = null;
    }
    if restart {
        game.restart();
        game.showBanner(White, "New game");
    }
    if hero.hasValue() && game.hasLocal() && game.players[game.local].isPlaying() { game.spawnHero(game.local, hero.value()); }

    game.isStepping = true;
    game.simulate(step);
    game.isStepping = false;
    game.checkFrame();
    if game.replay != null {
        game.replay.frame += 1;
        game.replay.reportEnd(game);
    }
}

// The camera follows the hero, unless it is unlocked with Y. Space brings it back to the hero while held
updateCamera :: method (game: *Game, dt: f32) {
    if IsKeyPressed(.y) && !game.keyboardTaken { game.camera.isLocked = !game.camera.isLocked; }
    game.camera.update(dt, game.followedHero(), IsKeyDown(.space));
}

// The keys and the mouse, as commands of the player at the keyboard
readInput :: method (game: *Game) {
    if !game.hasLocal() { return; }                         // Spectating
    player := &game.players[game.local];
    if !player.isPlaying() { return; }
    if game.keyboardTaken { return; }

    // Right click: walks there, or on an item in the backpack, locks it. It also stops aiming an ability
    if IsMouseButtonPressed(.right) {
        game.aiming = -1;
        if game.hoveredItem >= 0 {
            player.order(Command{lockItem: game.hoveredItem});
        } else if !game.mouseOnHud && game.mouseGround.hasValue() {
            point := game.mouseGround.value().xz();
            player.order(Command{move: point});
            game.effects.clickMarker(point);
        }
    }

    // Left click on the icon of an ability: cast at once, or aimed with the next left click on the ground
    if IsMouseButtonPressed(.left) {
        if game.hoveredAbility >= 0 {
            game.aiming = -1;
            ability := player.hero.abilities()[game.hoveredAbility];
            if ability.isPassive() {
                // Nothing to cast
            } else if !player.hero.abilityReady(game.hoveredAbility) {
                game.sounds.play("ui.not_ready");
            } else if ability.aimsAtPoint() {
                game.aiming = game.hoveredAbility;
            } else {
                player.order(Command{cast: {slot: game.hoveredAbility, target: player.hero.ground()}});
            }
        } else if game.aiming >= 0 && !game.mouseOnHud && game.mouseGround.hasValue() {
            if player.hero.abilityReady(game.aiming) {
                player.order(Command{cast: {slot: game.aiming, target: game.mouseGround.value().xz()}});
            }
            game.aiming = -1;
        }
    }
    if IsKeyPressed(.s) { player.order(.stop); }

    // The first ability that is cast is on Q, the second on W, ... Passives have no key
    for key, i in AbilityKeys {
        if !IsKeyPressed(key) { continue; }
        slot := player.hero.abilityOnKey(i as int);
        if slot < 0 { continue; }
        if !player.hero.abilityReady(slot) {
            game.sounds.play("ui.not_ready");
            continue;
        }
        target := player.hero.ground();
        if game.mouseGround.hasValue() { target = game.mouseGround.value().xz(); }
        player.order(Command{cast: {slot: slot, target: target}});
        game.aiming = -1;
    }
}

// Moves the world on by dt seconds: the bots think, the orders are carried out, the heroes and the cars move
simulate :: method (game: *Game, dt: f32) {
    profileBegin(.simulate);
    defer profileEnd(.simulate);
    game.time += dt;
    game.updateStench();

    // While the results are shown, the heroes stand still
    over := game.isOver();
    for *player, i in game.players {
        if player.isBot() && !over {
            profileBegin(.bots);
            player.brain.think(game, i as int, dt);
            profileEnd(.bots);
        }
        if game.isStepping { game.recordOrReplay(i as int); }
        if over { player.commands.clear(); continue; }
        profileBegin(.heroes);
        game.carryOut(i as int);
        game.updatePlayer(i as int, dt);
        profileEnd(.heroes);
    }
    game.updateMatch(dt);

    game.separateHeroes();
    game.updateItems(dt);
    game.updateSlicks(dt);

    // Chill auras, rain and Gudrun slow the cars around them
    slowZones := game.slowZones();
    defer slowZones.free();
    rushBefore := game.traffic.rush;
    sirenBefore := game.traffic.emergencyLane;
    profileBegin(.traffic);
    game.traffic.update(dt, &game.rng, slowZones);
    profileEnd(.traffic);
    game.announceTraffic(rushBefore, sirenBefore);

    for i in 0..game.stopSigns.count {
        game.stopSigns[i].timeLeft -= dt;
    }
    game.stopSigns.removeWhere(sign => sign.timeLeft <= 0);
    game.updateBridges(dt);
    game.updateWorldEffects(dt);
    game.updatePeels(dt);
    for *strike in game.strikes { strike.timeLeft -= dt; }
    game.strikes.removeWhere(strike => strike.timeLeft <= 0);

    for *line in game.feed { line.timeLeft -= dt; }
    while game.feed.count > 0 && game.feed[0].timeLeft <= 0 { game.feed.removeAt(0).text.free(); }

    profileBegin(.effects);
    game.effects.update(dt);
    game.emitEffects(dt);
    profileEnd(.effects);
    game.banner.timeLeft -= dt;
}

// Heroes don't stand inside each other on the grass, e.g where they start or at the opening of a wall: two that overlap
// are pushed apart, half each, like the units of an RTS. Not on the road, where it would push a hero into a car it planned
// around, and not in the air or through the walls
separateHeroes :: method (game: *Game) {
    for i in 0..game.players.count {
        a := &game.players[i];
        if !a.isPlaying() || a.hero.isAirborne() { continue; }
        for j in i + 1..game.players.count {
            b := &game.players[j];
            if !b.isPlaying() || b.hero.isAirborne() { continue; }
            offset := b.hero.ground() - a.hero.ground();
            distance := offset.length();
            room := a.hero.info().hitRadius + b.hero.info().hitRadius;
            if distance >= room { continue; }

            // One that walks into the other shoves it, anywhere (match.sd)
            if game.shove(i as int, j as int) || game.shove(j as int, i as int) { continue; }

            // Else they just stand apart, but not by the road, where a nudge could put one in front of a car
            if isNearRoad(a.hero.ground()) || isNearRoad(b.hero.ground()) { continue; }
            direction := Vector2{1, 0};
            if distance > 0.001 { direction = offset / distance; }
            push := direction * ((room - distance) * 0.5);
            a.hero.position = game.world.resolveCollisions(a.hero.ground() - push, a.hero.info().hitRadius, a.hero.walksThroughWalls()).at();
            b.hero.position = game.world.resolveCollisions(b.hero.ground() + push, b.hero.info().hitRadius, b.hero.walksThroughWalls()).at();
        }
    }
}

isNearRoad :: (point: Vector2) -> bool {
    return math.fabsf(point.x) < RoadHalfWidth + 3;
}

// The orders a player gave this frame
carryOut :: method (game: *Game, index: int) {
    player := &game.players[index];
    defer player.commands.clear();
    if !player.isPlaying() { return; }

    for command in player.commands {
        switch v in command {
            case .move { player.hero.moveTo(v.at()); }
            case .stop { player.hero.stop(); }
            case .cast { game.cast(index, v.slot, v.target); }
            case .lockItem {
                if v >= 0 && v < player.backpack.count { player.backpack.locked[v] = !player.backpack.locked[v]; }
            }
        }
    }
}

updatePlayer :: method (game: *Game, index: int, dt: f32) {
    player := &game.players[index];
    switch v in &player.phase {
        case .playing {
            game.moveHero(index, dt);

            // A car on the hero takes health, fast. Without one for a while, the hero heals
            hero := &player.hero;
            car := game.traffic.carHitting(hero.ground(), hero.info().hitRadius);
            if car.hasValue() && car.value().kind == .ambulance && hero.stats.ambulanceProof { car = null; }
            if car.hasValue() && !hero.carsPass() && !game.onBridge(hero.ground()) && !game.dodgedCar(index, car.value()) {
                if hero.hurtFor > 0.3 { game.sounds.playAt("hero.hurt", hero.position, 0.8, 0.06); }
                if hero.hurtFor > 0.3 && player.isBot() { player.brain.wasHit(game, index, car.value()); }
                hero.health -= car.value().damagePerSecond() * hero.damageTaken() * dt;
                hero.clearStatus(.sleep);
                hero.hurtFor = 0;
                if hero.health <= 0 && !game.savedByClover(index) {
                    game.heroRunOver(index, car.value());
                }
            } else {
                hero.hurtFor += dt;
                // Only a First Aid Kit heals, a while after a car was on the hero
                if hero.hurtFor > HealDelay && hero.stats.regen > 0 {
                    hero.health = math.min(hero.maxHealth(), hero.health + hero.maxHealth() * hero.stats.regen * dt);
                }
            }

            if player.isPlaying() && hasCrossed(hero.ground(), player.startSide) {
                game.heroCrossed(index);
            }
        }
        case .runOver {
            v.timeLeft -= dt;
            if v.timeLeft <= 0 { game.spawnNextHero(index); }
        }
        case .crossed {
            v.timeLeft -= dt;
            player.hero.walkCycle += dt * 14;     // Jumping for joy
            if v.timeLeft <= 0 && !game.isOver() {
                // The next hero starts where this one got to, and crosses back
                player.startSide = game.side;
                game.traffic.setLevel(game.level(), &game.rng);
                game.spawnNextHero(index);
            }
        }
        case .regroup {
            v.timeLeft -= dt;
            if v.timeLeft <= 0 && !game.isOver() {
                // The same hero, from the side the round was won on
                player.startSide = game.side;
                game.spawnHero(index, player.hero.kind);
                if player.isBot() { player.brain.reset(); }
            }
        }
    }
}

moveHero :: method (game: *Game, index: int, dt: f32) {
    hero := &game.players[index].hero;
    info := hero.info();

    hero.timeAlive += dt;
    for *cooldown in hero.cooldowns { *cooldown = math.max(0, *cooldown - dt); }
    hero.updateStatuses(dt);
    hero.bounceLeft = math.max(0, hero.bounceLeft - dt);
    hero.shoveLeft  = math.max(0, hero.shoveLeft - dt);
    hero.nimbleLeft = math.max(0, hero.nimbleLeft - dt);
    game.updateTraitsOverTime(index, dt);

    if hero.ride.hasValue() {
        game.rideCar(index, dt);
        return;
    }
    if hero.dash.hasValue() {
        game.moveDash(index, dt);
        return;
    }

    if hero.leap.hasValue() {
        game.flyLeap(index, dt);
        return;
    }
    hero.recordTrail(dt);

    if hero.displacement.hasValue() {
        game.displace(index, dt);
        return;
    }
    if hero.hook.hasValue() && game.pullHook(index, dt) { return; }
    if hero.isStopped() { return; }

    // Scared, taunted or a puppet: it walks by itself
    steered := hero.steeredTo();
    if steered.hasValue() {
        hero.target = steered.value().at();
        hero.isMoving = true;
    }

    before := hero.position;
    facingBefore := hero.facing;
    if game.slide(hero, dt) {
        // On the oil: it can't turn
    } else if hero.isMoving {
        toTarget := hero.target.xz() - hero.position.xz();
        distance := toTarget.length();
        step := hero.speed() * dt;

        if distance <= math.max(step, ClickReachedDistance) {
            hero.position = hero.target;
            hero.isMoving = false;
        } else {
            direction := toTarget / distance;
            hero.position += direction.at() * step;
            hero.facing = math.atan2f(direction.x, direction.y);
            hero.walkCycle += step * 1.6;
        }
    }

    hero.position = game.world.resolveCollisions(hero.ground(), info.hitRadius, hero.walksThroughWalls()).at();

    // Mads gathers speed walking straight on, and loses it when he turns
    if hero.stats.momentum {
        turn := math.fabsf(math.remainderf(hero.facing - facingBefore, Pi * 2));
        if !hero.isMoving       { hero.momentum = math.max(0, hero.momentum - dt * 2); }
        else if turn > 0.4      { hero.momentum *= 0.3; }
        else                    { hero.momentum = math.min(1, hero.momentum + dt * 0.5); }
    }

    // Walking into a wall: give up after a moment, instead of pushing against it forever
    if hero.isMoving && Vector3Distance(before, hero.position) < hero.speed() * dt * 0.1 {
        hero.stop();
    }
}

// Through the air, over cars and walls, and down again
flyLeap :: method (game: *Game, index: int, dt: f32) {
    hero := &game.players[index].hero;
    leap := hero.leap.value();
    leap.flight = math.min(1, leap.flight + dt / leap.duration);
    hero.position = leap.from.lerp(leap.to, leap.flight);
    hero.walkCycle += dt * 6;

    if leap.flight < 1 {
        hero.leap = leap;
        return;
    }

    hero.leap = null;
    hero.position = game.world.resolveCollisions(hero.ground(), hero.info().hitRadius, hero.walksThroughWalls()).at();
    hero.stop();
    hero.forgetTrail();
    game.effects.addRing(hero.ground(), 0.5, 6, {230, 200, 150, 255}, 0.45);
    game.effects.particles.emit(.dust, hero.position, 16);
    if index == game.watched { game.camera.shake = math.max(game.camera.shake, 0.15); }
    game.sounds.playAt("ability.land", hero.position, 1, 0.05);
}

// Knocked away or dragged: moved to a point, stopped by the walls
displace :: method (game: *Game, index: int, dt: f32) {
    hero := &game.players[index].hero;
    move := hero.displacement.value();
    toPoint := move.to.xz() - hero.ground();
    distance := toPoint.length();
    step := move.speed * dt;

    if distance <= step {
        hero.position = game.world.resolveCollisions(move.to.xz(), hero.info().hitRadius, false).at();
        hero.displacement = null;
        hero.stop();
        return;
    }

    before := hero.position;
    hero.position += (toPoint / distance).at() * step;
    hero.position = game.world.resolveCollisions(hero.ground(), hero.info().hitRadius, false).at();
    if Vector3Distance(before, hero.position) < step * 0.25 {
        hero.displacement = null;       // Into a wall
        hero.stop();
    }
}

// Casts an ability of the player at the keyboard, aimed at the mouse, at once. For tests and debugging
useAbility :: method (game: *Game, slot: int) {
    if !game.hasLocal() { return; }
    target := game.players[game.local].hero.ground();
    if game.mouseGround.hasValue() { target = game.mouseGround.value().xz(); }
    game.cast(game.local, slot, target);
}

heroRunOver :: method (game: *Game, index: int, car: *Car) {
    player := &game.players[index];
    hero := &player.hero;
    info := hero.info();

    player.stats.deaths += 1;
    player.stats.deathsBy[hero.kind] += 1;

    // An enemy who hooked, bashed or locked it just before gets the kill
    killer := -1;
    if hero.harmedBy >= 0 && hero.harmedBy != index && game.time - hero.harmedAt < KillCredit {
        killer = hero.harmedBy;
        game.players[killer].stats.kills += 1;
    }

    // The car throws the bits along the road
    push := Vector3{0, 0, car.speed * 0.6};
    middle := hero.position + Vector3{0, info.height * 0.5, 0};
    particles := &game.effects.particles;
    particles.emit(.blood, middle, 60, push: push);
    particles.emit(.mist, middle, 8, push: push * 0.3);
    particles.emit(.bits, middle, 30, push: push, tint: ColorAlpha(info.color, 1));
    particles.addStain(hero.ground(), info.width * 2.2, {130, 10, 15, 230});
    if index == game.watched { game.camera.shake = 0.35; }
    game.sounds.playAt("hero.death", hero.position);

    vehicle := switch car.kind {
        case .car   => "a car";
        case .van   => "a van";
        case .truck => "a truck";
        case .ambulance => "an ambulance";
    };
    if killer >= 0 {
        game.announce(index, {255, 90, 80, 255}, "% (%) was run over by %, thanks to %", info.name, player.name, vehicle, game.players[killer].name);
        if killer == game.local && index != game.local { game.showBanner({255, 210, 90, 255}, "You got % run over!", player.name); }
    } else if index == game.watched {
        game.showBanner({255, 90, 80, 255}, "% was run over by %!", info.name, vehicle);
    } else {
        game.announce(index, {255, 90, 80, 255}, "% (%) was run over by %", info.name, player.name, vehicle);
    }

    player.phase = Phase{runOver: {timeLeft: RespawnDelay}};
}

heroCrossed :: method (game: *Game, index: int) {
    player := &game.players[index];
    hero := &player.hero;
    time := hero.timeAlive;

    player.stats.crossings += 1;
    isRecord := !player.stats.bestTime.hasValue() || time < player.stats.bestTime.value();
    if isRecord { player.stats.bestTime = time; }

    if index == game.watched {
        if isRecord {
            game.showBanner({120, 255, 140, 255}, "% made it across in % s. A new record!", hero.info().name, fmt.fixed(time, 1));
        } else {
            game.showBanner({120, 255, 140, 255}, "% made it across in % s", hero.info().name, fmt.fixed(time, 1));
        }
        game.sounds.play("hero.crossed", 0.8);
    } else {
        game.announce(index, {120, 255, 140, 255}, "% (%) made it across in % s", hero.info().name, player.name, fmt.fixed(time, 1));
        game.sounds.playAt("hero.crossed", hero.position, 0.5);
    }

    hero.stop();
    game.effects.addRing(hero.ground(), 0.5, 8, {120, 255, 140, 255}, 0.8);
    player.phase = Phase{crossed: {timeLeft: RegroupTime}};
    game.endRound(index);
}

// The bots play at a difficulty, e.g for a new game
setDifficulty :: method (game: *Game, difficulty: Difficulty) {
    game.difficulty = difficulty;
    game.nextDifficulty = null;
    for *player in game.players {
        if player.isBot() { player.brain.setDifficulty(difficulty); }
    }
}

// A random hero, never the same as the one before
spawnNextHero :: method (game: *Game, index: int) {
    next := game.rng.between(0, HeroKind.count as int - 2);
    if next >= game.players[index].hero.kind as int { next += 1; }
    game.spawnHero(index, next as HeroKind);
}

spawnHero :: method (game: *Game, index: int, kind: HeroKind) {
    player := &game.players[index];

    // Looking across the road, towards the other side. The players stand in a row along the side
    facing := Pi * 0.5;
    if player.startSide == .right { facing = -Pi * 0.5; }
    spot := game.world.spawnPoint(player.startSide);
    spot.z += (index as f32 - (game.players.count - 1) as f32 * 0.5) * SpawnSpacing;

    player.hero  = newHero(kind, spot, facing);
    player.hero.goalSign = player.startSide.opposite().sign();
    player.hero.lostIn = LostEveryLow;
    player.phase = .playing;
    player.hero.stats = statsOf(player);
    player.hero.savesLeft = player.hero.stats.saves;
    player.hero.health = player.hero.maxHealth();
    if index == game.watched { game.sounds.play("hero.spawn", 0.6); }
}

SpawnSpacing :: 7.0;
KillCredit   :: 3.0;    // Seconds after a hook, bash or lock that a car getting the enemy counts as a kill

