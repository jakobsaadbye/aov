namespace core;

import fmt;
import math;
import random;
use raylib;

// The sounds and the music of the game, played by name through a SoundPlayer:
//
//     sounds.play("hero.crossed");                 // data/sounds/hero/crossed.wav, or one of crossed_1.wav, ...
//     sounds.playAt("ability.blink", position);    // quieter the further it is from the listener, and panned
//     sounds.playMusic("traffic", 0.3);            // data/music/traffic.ogg, streamed and looped
//     sounds.playSoundtrack("band", 0.5);          // the pieces of data/music/band, one at a time, with silence between
//
// Every .wav, .ogg and .mp3 in data/sounds/<group>/ is a sound named "<group>.<name>": a new sound is a file dropped in
// there, without changing the game. Files that end in _<number> are variants of the same sound, and one is picked at
// random each time. A SoundPlayer that isn't loaded, e.g in simulation_test.sd, plays nothing

VoicesPerSound  :: 4;       // How many times one sound can play at the same time
HearingDistance :: 70.0;    // How far away a sound played at a position can be heard
PausedVolume    :: 0.12;    // Of the music while the game is paused. The sounds of the world stop
DuckSpeed       :: 4.0;     // How fast the volume follows a pause, per second

// The soundtracks (tools/make_audio.sd, data/music/<name>/): each a few pieces for a little band that go together, played
// in a random order, each once, with a breath of silence between them, so the music changes instead of looping one tune
// all game. The game plays one of them, picked with the soundtrack command
SoundtrackInfo :: struct {
    name:  string;
    about: string;
}

Soundtracks :: [
    SoundtrackInfo{"band", "cheerful and melodic: piano, pizzicato, marimba and guitar"},
    SoundtrackInfo{"quiet", "calm, sparse ambient piano with room between the notes"},
    SoundtrackInfo{"board", "a light party-game groove that stays in the background"},
    SoundtrackInfo{"folk", "a Nordic folk band at a village dance: fiddle, nyckelharpa, accordion"},
    SoundtrackInfo{"toybox", "comedic cartoon music on toy instruments"},
];

// The pieces of each, by the soundtrack they are in, e.g data/music/band/puddles.ogg
SoundtrackPiece :: struct {
    soundtrack: string;
    name:       string;
}

SoundtrackPieces :: [
    SoundtrackPiece{"band", "first_light"}, SoundtrackPiece{"band", "puddles"}, SoundtrackPiece{"band", "lanterns"}, SoundtrackPiece{"band", "far_side"},
    SoundtrackPiece{"quiet", "dew"}, SoundtrackPiece{"quiet", "long_light"},
    SoundtrackPiece{"board", "dice_roll"}, SoundtrackPiece{"board", "shortcut"},
    SoundtrackPiece{"folk", "midsummer"}, SoundtrackPiece{"folk", "crossroads"},
    SoundtrackPiece{"toybox", "wind_up"}, SoundtrackPiece{"toybox", "pratfall"},
];
Soundtrack      :: "band";      // The one played from the start
FirstPieceAfter :: 2.0;     // Seconds of silence before the first piece
SilenceLeast    :: 3.0;     // and between two pieces, from this
SilenceMost     :: 6.0;     // to this

// One file of a sound, with copies of it that share its samples, so it can play over itself
SoundVariant :: struct {
    voices: [VoicesPerSound]Sound;
    next:   int;
}

SoundEntry :: struct {
    variants: [..]SoundVariant;
}

MusicTrack :: struct {
    music:       Music;
    volume:      f32;               // As asked for, before muting and pausing
    isPlaying:   bool;
    isMuted:     bool;
    pausesWithGame: bool;           // Stops while the game is paused, e.g the hum of the traffic, which has stopped too
}

SoundPlayer :: struct {
    isReady:  bool;
    bank:     Map<string, SoundEntry>;
    tracks:   Map<string, MusicTrack>;
    missing:  Map<string, bool>;    // Names that were asked for and aren't there, warned about once
    listener: Vector3;
    rng:      random.Random;
    isPaused: bool;
    duck:     f32 = 1;              // 1 while playing, PausedVolume while paused, and in between while it fades

    soundtrackName:  string;        // Of Soundtracks
    soundtrack:      [..]string;    // The names of its pieces, which are tracks
    piece:           int = -1;      // The one playing, or -1 in the silence between two
    lastPiece:       int = -1;
    silence:         f32;           // Seconds until the next one
    soundtrackVolume: f32;
    soundtrackMuted: bool;
}

// Opens the audio device, and loads every sound and piece of music of the data folder
load :: method (player: *SoundPlayer, dataFolder: string) {
    InitAudioDevice();
    if !IsAudioDeviceReady() {
        fmt.print("WARNING: No audio device, so the game is silent");
        return;
    }
    player.isReady = true;
    player.rng = random.newRandom(1234);

    for file in soundFiles(tprint("%sounds", dataFolder)) {
        source := LoadSound(tempCString(file.path));

        variant: SoundVariant;
        variant.voices[0] = source;
        for i in 1..VoicesPerSound { variant.voices[i] = LoadSoundAlias(source); }

        if !player.bank.has(file.key) { player.bank[file.key] = SoundEntry{}; }
        player.bank[file.key].variants.add(variant);
    }

    for file in soundFiles(tprint("%music", dataFolder)) {
        music := LoadMusicStream(tempCString(file.path));
        music.looping = true;
        // The key of music is its name alone, e.g "traffic" for music/traffic.ogg
        name := file.key.slice(file.key.indexOf(".") + 1);
        player.tracks[name] = MusicTrack{music: music};
    }

    fmt.print("INFO: SOUND: % sounds and % pieces of music in %", player.bank.count, player.tracks.count, dataFolder);
}

@private
SoundFile :: struct {
    path: string;
    key:  string;           // "<folder>.<name>", without the number of a variant
}

// The sound files in a folder and below
@private
soundFiles :: (folder: string) -> [..]SoundFile {
    files := LoadDirectoryFilesEx(tempCString(folder), ".wav;.ogg;.mp3", true);
    defer UnloadDirectoryFiles(files);

    result: [..]SoundFile;
    for i in 0..files.count {
        path := files.paths[i].toString().copy();

        file := GetFileNameWithoutExt(files.paths[i]).toString().copy();     // raylib's own buffer, used again below
        defer file.free();
        name := file;
        underscore := file.lastIndexOf("_");
        if underscore > 0 && isNumber(file.slice(underscore + 1)) {
            name = file.slice(0, underscore);
        }

        directory := GetDirectoryPath(files.paths[i]);
        group := GetFileName(directory).toString();

        result.add(SoundFile{path: path, key: fmt.sprint("%.%", group, name)});
    }
    return result;
}

@private
isNumber :: (text: string) -> bool {
    if text.len == 0 { return false; }
    for c in text { if !c.isDigit() { return false; } }
    return true;
}

// True with a chance from 0 to 1, from the sounds' own random numbers, which a game doesn't depend on
chance :: method (player: *SoundPlayer, p: f32) -> bool {
    return player.rng.uniform(0, 1) < p as f64;
}

// Plays a sound by its name, e.g "hero.crossed". pitchSpread changes the pitch a bit at random, e.g 0.05
play :: method (player: *SoundPlayer, name: string, volume: f32 = 1, pitchSpread: f32 = 0) {
    player.playPanned(name, volume, 0.5, pitchSpread);
}

// Plays a sound at a place in the world: quieter the further it is from the listener, and to the left or right of it
playAt :: method (player: *SoundPlayer, name: string, position: Vector3, volume: f32 = 1, pitchSpread: f32 = 0) {
    distance := Vector3Distance(position, player.listener);
    if distance > HearingDistance { return; }
    loudness := 1 - distance / HearingDistance;
    pan := math.clamp(0.5 - (position.x - player.listener.x) / (HearingDistance * 2), 0.15, 0.85);   // raylib's pan: 1 is left
    // Never quite silent near the edge, so what the hero does is always heard
    player.playPanned(name, volume * (0.35 + 0.65 * loudness * loudness), pan, pitchSpread);
}

@private
playPanned :: method (player: *SoundPlayer, name: string, volume: f32, pan: f32, pitchSpread: f32) {
    if !player.isReady || player.isPaused { return; }
    if !player.bank.has(name) {
        if !player.missing.has(name) {
            fmt.print("WARNING: No sound named '%' in data/sounds", name);
            player.missing[name.copy()] = true;
        }
        return;
    }

    entry := &player.bank[name];
    which := player.rng.between(0, entry.variants.count as int - 1);
    variant := &entry.variants[which];
    voice := variant.voices[variant.next];
    variant.next = (variant.next + 1) % VoicesPerSound;

    SetSoundVolume(voice, volume);
    SetSoundPan(voice, pan);
    SetSoundPitch(voice, 1 + player.rng.uniform(-pitchSpread, pitchSpread) as f32);
    PlaySound(voice);
}

// Where the sounds played with playAt are heard from, e.g the point the camera looks at
setListener :: method (player: *SoundPlayer, position: Vector3) {
    player.listener = position;
}

// Starts a piece of music of data/music, looped, e.g "traffic"
playMusic :: method (player: *SoundPlayer, name: string, volume: f32 = 1, pausesWithGame := false) {
    if !player.isReady || !player.tracks.has(name) { return; }
    track := &player.tracks[name];
    track.volume = volume;
    track.pausesWithGame = pausesWithGame;
    if !track.isPlaying { PlayMusicStream(track.music); }
    track.isPlaying = true;
    player.applyVolume(track);
}

// Turns a piece of music off and on again. It goes on where it was
toggleMute :: method (player: *SoundPlayer, name: string) {
    if !player.isReady || !player.tracks.has(name) { return; }
    track := &player.tracks[name];
    track.isMuted = !track.isMuted;
    player.applyVolume(track);
}

// Plays the pieces of a soundtrack of Soundtracks one after the other in a random order, with silence between, from now
// on, instead of the one before. Pieces that aren't in data/music are left out. False when there is no soundtrack by the name
playSoundtrack :: method (player: *SoundPlayer, soundtrack: string, volume: f32 = 1) -> bool {
    found := false;
    for info in Soundtracks { if info.name == soundtrack { found = true; } }
    if !found { return false; }
    if !player.isReady { return true; }
    if player.piece >= 0 {
        track := &player.tracks[player.soundtrack[player.piece]];
        StopMusicStream(track.music);
        track.isPlaying = false;
    }
    player.soundtrack.clear();
    player.soundtrackName = soundtrack;
    for piece in SoundtrackPieces {
        if piece.soundtrack != soundtrack { continue; }
        name := piece.name;
        if player.tracks.has(name) { player.soundtrack.add(name); }
        else { fmt.print("WARNING: SOUND: no music named % in data/music", name); }
    }
    player.soundtrackVolume = volume;
    player.piece = -1;
    player.lastPiece = -1;
    player.silence = FirstPieceAfter;
    return true;
}

// Turns the soundtrack off and on again, e.g with the M key. A piece that plays goes on, unheard
toggleSoundtrack :: method (player: *SoundPlayer) {
    player.soundtrackMuted = !player.soundtrackMuted;
    for name in player.soundtrack {
        track := &player.tracks[name];
        track.isMuted = player.soundtrackMuted;
        player.applyVolume(track);
    }
}

// Once a frame: the next piece after its silence, and the silence after a piece that has ended
@private
updateSoundtrack :: method (player: *SoundPlayer, dt: f32) {
    if player.soundtrack.count == 0 { return; }
    if player.piece >= 0 {
        track := &player.tracks[player.soundtrack[player.piece]];
        if IsMusicStreamPlaying(track.music) { return; }
        track.isPlaying = false;
        player.lastPiece = player.piece;
        player.piece = -1;
        player.silence = player.rng.uniform(SilenceLeast, SilenceMost) as f32;
        return;
    }
    player.silence -= dt;
    if player.silence > 0 { return; }

    // Any but the one before, so none comes twice in a row
    count := player.soundtrack.count as int;
    next := player.rng.between(0, count - 1);
    if next == player.lastPiece && count > 1 { next = (next + player.rng.between(1, count - 1)) % count; }
    player.piece = next;
    track := &player.tracks[player.soundtrack[next]];
    track.music.looping = false;
    track.isMuted = player.soundtrackMuted;
    player.playMusic(player.soundtrack[next], player.soundtrackVolume);
}

// While the game is paused, the sounds that play stop, the music is quiet, and the music of the world stops
setPaused :: method (player: *SoundPlayer, isPaused: bool) {
    if !player.isReady || player.isPaused == isPaused { return; }
    player.isPaused = isPaused;

    for _, entry in player.bank {
        for variant in entry.variants {
            for voice in variant.voices {
                if isPaused { PauseSound(voice); } else { ResumeSound(voice); }
            }
        }
    }
    for *entry in player.tracks {
        track := &entry.value;
        if !track.pausesWithGame || !track.isPlaying { continue; }
        if isPaused { PauseMusicStream(track.music); } else { ResumeMusicStream(track.music); }
    }
}

@private
applyVolume :: method (player: *SoundPlayer, track: *MusicTrack) {
    volume := track.volume * player.duck;
    if track.isMuted { volume = 0; }
    SetMusicVolume(track.music, volume);
}

// Once a frame: the music is streamed, and fades to and from the volume of a pause
update :: method (player: *SoundPlayer, dt: f32) {
    if !player.isReady { return; }

    target: f32 = 1;
    if player.isPaused { target = PausedVolume; }
    step := DuckSpeed * dt;
    if player.duck < target { player.duck = math.min(player.duck + step, target); }
    else                    { player.duck = math.max(player.duck - step, target); }

    for *entry in player.tracks {
        track := &entry.value;
        if !track.isPlaying { continue; }
        player.applyVolume(track);
        UpdateMusicStream(track.music);
    }
    player.updateSoundtrack(dt);
}

unload :: method (player: *SoundPlayer) {
    if !player.isReady { return; }
    for _, entry in player.bank {
        for variant in entry.variants {
            for i in 1..VoicesPerSound { UnloadSoundAlias(variant.voices[i]); }
            UnloadSound(variant.voices[0]);
        }
    }
    for _, track in player.tracks { UnloadMusicStream(track.music); }
    CloseAudioDevice();
    player.isReady = false;
}
