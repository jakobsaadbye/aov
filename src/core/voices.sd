namespace core;

// The voices of the heroes: a few lines each, for when it comes onto the field, casts, gets across, is run over, and
// gets an enemy run over. They are sounds like the others, in data/sounds/voice/ (tools/make_audio.sd): "voice.hugo_cast"
// is one of hugo_cast_1.ogg, hugo_cast_2.ogg, ... at random.
//
// So that the heroes don't talk over each other all the time, a hero says a line at most every few seconds, and only
// some of the times it casts; being run over and getting a kill always get a line. The hero the camera follows is heard
// at full volume, the others where they are. The chances come from the sounds' own random numbers, not the game's, so a
// game plays the same with sound or without it

use raylib;

VoiceEvent :: enum {
    spawn,
    cast,
    crossed,
    death,
    kill,
}

VoiceGap         :: 4.0;     // Seconds after a hero said something before it says something else, unless it matters
CastLineChance   :: 0.35;    // How often a cast gets a line
OtherSpawnChance :: 0.3;     // How often another player's hero says its line when it comes onto the field

say :: method (game: *Game, index: int, event: VoiceEvent) {
    player := &game.players[index];
    sounds := &game.sounds;
    if !sounds.isReady { return; }
    important := event == .death || event == .kill;
    if !important && game.time < player.voiceUntil { return; }
    if event == .cast && !sounds.chance(CastLineChance) { return; }
    if event == .spawn && index != game.watched && !sounds.chance(OtherSpawnChance) { return; }

    name := tprint("voice.%_%", HeroKind.names[player.hero.kind], VoiceEvent.names[event]);
    if index == game.watched { sounds.play(name, 1.0); }
    else                     { sounds.playAt(name, player.hero.position, 0.85); }
    player.voiceUntil = game.time + VoiceGap;
}
