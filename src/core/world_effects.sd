namespace core;

// What abilities leave in the world for a while: things thrown through the air (Ivar's axe, a banana peel), traffic
// cones, Tim & Tom's decoy, and the zones that slow the cars, which the traffic and the forecast of the bots both use
// (slowZones)

import math;
use raylib;

//
// Where the cars drive slower: chill auras
//

slowZones :: method (game: *Game) -> [..]SlowZone {
    zones: [..]SlowZone;
    for *player in game.players {
        if !player.isPlaying() { continue; }
        hero := &player.hero;
        aura := hero.chillAura();
        if aura.hasValue() { zones.add(SlowZone{hero.ground(), aura.value().radius, aura.value().slow}); }
    }
    return zones;
}

// A traffic cone in a lane: the cars that come to it swerve into a lane beside it
Cone :: struct {
    position: Vector2;
    timeLeft: f32;
}

ConeSwerveAhead :: 6.0;     // How far before the cone the cars swerve

//
// Thrown things
//

ProjectileKind :: enum {
    axe,
    banana,
}

Projectile :: struct {
    kind:         ProjectileKind;
    position:     Vector2;
    velocity:     Vector2;
    distanceLeft: f32;
    owner:        int;
    power:        f32;      // Seconds of what it does to the one it hits
    spin:         f32;
}

ProjectileRadius :: 1.0;

throwProjectile :: method (game: *Game, owner: int, kind: ProjectileKind, target: Vector2, range: f32, speed: f32, power: f32) -> bool {
    hero := &game.players[owner].hero;
    toward := target - hero.ground();
    if toward.length() < 0.5 { return false; }
    direction := toward.normalize();
    hero.facing = math.atan2f(direction.x, direction.y);
    distance := range;
    if kind == .banana { distance = math.min(range, toward.length()); }       // A peel lands where it is thrown
    game.projectiles.add(Projectile{kind: kind, position: hero.ground() + direction * 1.2, velocity: direction * speed,
        distanceLeft: distance, owner: owner, power: power});
    return true;
}

updateWorldEffects :: method (game: *Game, dt: f32) {
    game.swerveAtCones(dt);

    for *projectile in game.projectiles {
        step := projectile.velocity * dt;
        projectile.position += step;
        projectile.distanceLeft -= step.length();
        projectile.spin += dt * 18;
        hit := game.projectileHit(projectile);
        if hit >= 0 {
            game.projectileHits(projectile, hit);
            projectile.distanceLeft = -1;
        } else if projectile.distanceLeft <= 0 {
            game.projectileLands(projectile);
        }
    }
    game.projectiles.removeWhere(projectile => projectile.distanceLeft <= 0);

    for *player, i in game.players { game.updateDecoy(i as int, dt); }
}

// The enemy a thrown thing flies into, or -1
@private
projectileHit :: method (game: *Game, projectile: *Projectile) -> int {
    for *player, i in game.players {
        if i as int == projectile.owner || !player.isPlaying() || !player.hero.isTargetable() { continue; }
        if player.hero.ground().distance(projectile.position) <= player.hero.info().hitRadius + ProjectileRadius { return i as int; }
    }
    return -1;
}

@private
projectileHits :: method (game: *Game, projectile: *Projectile, victim: int) {
    hero := &game.players[victim].hero;
    switch projectile.kind {
        case .axe {
            hero.addStatus(.stun, projectile.power, source: projectile.owner, time: game.time);
            hero.clearStatus(.sleep);
            game.effects.particles.emit(.sparks, hero.position + Vector3{0, 2, 0}, 14);
            game.sounds.playAt("ability.axe_hit", hero.position);
            owner := &game.players[projectile.owner];
            game.announce(victim, {255, 150, 90, 255}, "% was hit by the axe of % (%)!", hero.info().name, owner.hero.info().name, owner.name);
        }
        case .banana {
            game.slipOnBanana(victim, projectile.owner);
        }
    }
}

@private
projectileLands :: method (game: *Game, projectile: *Projectile) {
    switch projectile.kind {
        case .axe    { game.effects.particles.emit(.dust, projectile.position.at(0.3), 8); }
        case .banana { game.peels.add(Peel{position: projectile.position, timeLeft: PeelTime, owner: projectile.owner}); }
    }
}

drawProjectiles :: (game: *Game) {
    for projectile in game.projectiles {
        at := projectile.position.at(2.0);
        direction := projectile.velocity.normalize().at();
        switch projectile.kind {
            case .axe {
                // A spinning axe: a handle and a head at its end
                spin := Vector3{math.sinf(projectile.spin), math.cosf(projectile.spin), 0} * 0.9;
                spin = Vector3{spin.x * direction.z, spin.y, -spin.x * direction.x} + direction * spin.x * 0.2;
                DrawCylinderEx(at - spin, at + spin, 0.08, 0.08, 6, {120, 80, 40, 255});
                DrawCube(at + spin * 1.1, 0.5, 0.5, 0.5, {200, 200, 210, 255});
            }
            case .banana {
                DrawSphereEx(at - Vector3{0, 1, 0}, 0.4, 6, 6, {250, 220, 60, 255});
            }
        }
    }
}

//
// Tim & Tom's decoy: the other twin, who walks on towards the far side. Spells cast on them hit it first
//

Decoy :: struct {
    position: Vector2;
    velocity: Vector2;
    timeLeft: f32;
    facing:   f32;
}

updateDecoy :: method (game: *Game, index: int, dt: f32) {
    player := &game.players[index];
    if !player.decoy.hasValue() { return; }
    decoy := player.decoy.value();
    decoy.timeLeft -= dt;
    // He minds the cars: on when the way ahead stays free, else he waits, else he steps back out of the way
    radius := player.hero.info().hitRadius;
    step := decoy.velocity * dt;
    if !game.decoyWayIsFree(decoy.position, decoy.velocity, radius) {
        step = Vector2{0, 0};
        if !game.decoyWayIsFree(decoy.position, Vector2{0, 0}, radius) {
            if game.decoyWayIsFree(decoy.position, decoy.velocity * -1, radius) { step = decoy.velocity * -dt; }
            else { step = decoy.velocity * dt; }
        }
    }
    decoy.position = game.world.resolveCollisions(decoy.position + step, radius, false);
    if decoy.timeLeft <= 0 || !player.isPlaying() || game.traffic.carHitting(decoy.position, player.hero.info().hitRadius).hasValue() {
        game.popDecoy(index);
        return;
    }
    player.decoy = decoy;
}

DecoyLooksAhead :: 0.6;     // Seconds ahead the other twin looks for the cars

// If walking on at a velocity from a point keeps clear of the cars for a moment
decoyWayIsFree :: method (game: *Game, from: Vector2, velocity: Vector2, radius: f32) -> bool {
    for k in 1...4 {
        t := DecoyLooksAhead * k as f32 / 4;
        if game.traffic.carWillHit(from + velocity * t, radius + 0.2, t) { return false; }
    }
    return true;
}

popDecoy :: method (game: *Game, index: int) {
    player := &game.players[index];
    if !player.decoy.hasValue() { return; }
    game.effects.particles.emit(.wisps, player.decoy.value().position.at(1.5), 24, tint: {255, 220, 120, 255});
    player.decoy = null;
}

drawDecoys :: (game: *Game, assets: *Assets) {
    for player in game.players {
        if !player.decoy.hasValue() || !player.isPlaying() { continue; }
        decoy := player.decoy.value();
        bob := math.fabsf(math.sinf(game.time * 9)) * 0.3;
        assets.drawHero(player.hero.kind, decoy.position.at(bob), decoy.facing, {255, 255, 255, 170});
        DrawCircle3D(decoy.position.at(0.18), player.hero.info().width * 0.85, {1, 0, 0}, 90, ColorAlpha(player.color, 0.4));
    }
}

swerveAtCones :: method (game: *Game, dt: f32) {
    for *cone in game.cones {
        cone.timeLeft -= dt;
        lane := laneAt(cone.position.x);
        for *car, c in game.traffic.cars {
            if !car.isActive || car.lane != lane || car.shift != 0 { continue; }
            front := car.z + car.length() * 0.5;
            if front > cone.position.y + 0.5 || cone.position.y - front > ConeSwerveAhead { continue; }
            if car.kind == .bus {
                if cone.position.y - front < 0.5 {
                    cone.timeLeft = 0;
                    game.effects.particles.emit(.bits, cone.position.at(0.5), 12, tint: {255, 110, 20, 255});
                }
                continue;
            }
            side := 1;
            if lane == LaneCount - 1 || (lane > 0 && c % 2 == 0) { side = -1; }
            game.traffic.moveToLane(c as int, lane + side);
        }
    }
    game.cones.removeWhere(cone => cone.timeLeft <= 0);
}

drawCones :: (game: *Game) {
    for cone in game.cones {
        alpha := math.min(cone.timeLeft, 1);
        // An orange cone with a white stripe
        base := cone.position.at(0);
        DrawCube(base + Vector3{0, 0.05, 0}, 1.2, 0.1, 1.2, ColorAlpha({255, 110, 20, 255}, alpha));
        DrawCylinder(base, 0.5, 0.06, 1.6, 10, ColorAlpha({255, 110, 20, 255}, alpha));
        DrawCylinder(base + Vector3{0, 0.7, 0}, 0.32, 0.26, 0.25, 10, ColorAlpha(White, alpha));
    }
}

//
// Banana peels on the ground: the first enemy of the one who threw it that steps on it slips
//

Peel :: struct {
    position: Vector2;
    timeLeft: f32;
    owner:    int;
}

PeelTime :: 12.0;
PeelSlip :: 5.0;           // How far it slides

updatePeels :: method (game: *Game, dt: f32) {
    for *peel in game.peels {
        peel.timeLeft -= dt;
        for *player, i in game.players {
            if i as int == peel.owner || !player.isPlaying() || player.hero.isAirborne() { continue; }
            if player.hero.ground().distance(peel.position) > player.hero.info().hitRadius + 0.6 { continue; }
            game.slipOnBanana(i as int, peel.owner);
            peel.timeLeft = 0;
            break;
        }
    }
    game.peels.removeWhere(peel => peel.timeLeft <= 0);
}

slipOnBanana :: method (game: *Game, victim: int, owner: int) {
    hero := &game.players[victim].hero;
    if hero.stats.slipProof { return; }
    forward := Vector2{math.sinf(hero.facing), math.cosf(hero.facing)};
    hero.addStatus(.stun, 0.9, source: owner, time: game.time);
    if !hero.stats.unshovable {
        hero.displacement = Displacement{to: (hero.ground() + forward * PeelSlip).at(), speed: 14};
    }
    game.sounds.playAt("item.banana", hero.position);
    game.announce(victim, {250, 220, 60, 255}, "% slipped on a banana peel!", game.players[victim].name);
}

drawPeels :: (game: *Game) {
    for peel in game.peels {
        at := peel.position.at(0.2);
        for k in 0..3 {
            angle := k as f32 * 2.1;
            DrawCube(at + Vector3{math.sinf(angle) * 0.35, 0, math.cosf(angle) * 0.35}, 0.35, 0.08, 0.6, {250, 220, 60, 255});
        }
        DrawSphere(at, 0.15, {120, 90, 30, 255});
    }
}
