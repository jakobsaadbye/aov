namespace core;

import fmt;
import math;
import mem;
use raylib;

// The 2D overlay: the score, the card of the hero with its ability, the banner, the help and the debug numbers.
// The texts of a frame are made in an arena, which is cleared at the end of the frame

PanelColor  :: Color{20, 24, 28, 200};
BorderColor :: Color{255, 255, 255, 40};
TextColor   :: Color{235, 235, 235, 255};
DimColor    :: Color{160, 165, 170, 255};

// The fonts: Cinzel for titles and names, and Fira Sans for the rest. Both are
// in data/fonts, under the SIL Open Font License
Fonts :: struct {
    text:  Font;
    title: Font;
}

@private
fonts: ?Fonts;

FontLoadSize :: 64;     // The size the glyphs are made at. Smaller text is drawn from them, smoothed by mipmaps

loadFonts :: () {
    // The Latin-1 letters, with æ, ø and å
    codepoints: [..]int;
    for c in 32..256 { codepoints.add(c as int); }
    defer codepoints.free();

    load :: (file: string, codepoints: [..]int) -> Font {
        font := LoadFontEx(dataPath(file), FontLoadSize, codepoints.data, codepoints.count as int);
        GenTextureMipmaps(&font.texture);
        SetTextureFilter(font.texture, .trilinear);
        return font;
    };
    fonts = Fonts{text: load("fonts/FiraSans-SemiBold.ttf", codepoints), title: load("fonts/Cinzel-Bold.ttf", codepoints)};
}

unloadFonts :: () {
    if !fonts.hasValue() { return; }
    UnloadFont(fonts.value().text);
    UnloadFont(fonts.value().title);
}

drawHud :: method (game: *Game, assets: *Assets) {
    previous := useTemp();      // The texts of the HUD are for this frame
    defer mem.setAllocator(previous);

    for player, i in game.players {
        if player.phase.kind != .runOver { drawHealthOverHero(game, i as int); }
    }
    drawBlindness(game);
    drawScoreboard(game, assets);
    drawFeed(game);
    drawHeroCard(game, assets);
    if game.canSwitchView() { drawWatching(game); }
    drawBanner(game);
    drawTalentOffer(game, assets);
    if game.showHelp       { drawHelp(); }
    if game.debug.overlay  { drawDebug(game); }
    drawInspectorPanel(game);
    drawResults(game);
    if game.isPaused       { drawPaused(game); }

    mouse := GetMousePosition();
    DrawTexture(assets.cursor, mouse.x as int - 2, mouse.y as int, White);
}

// The players, the one furthest ahead first: their hero, crossings and deaths. Yours is lit up
drawScoreboard :: (game: *Game, assets: *Assets) {
    order: [..]int;
    for _, i in game.players { order.add(i as int); }
    // By crossings, then by fewer deaths
    for i in 1..order.count {
        j := i;
        while j > 0 && isAhead(game.players[order[j]], game.players[order[j - 1]]) {
            order.swap(j, j - 1);
            j -= 1;
        }
    }

    rowHeight := 24;
    panel := Rectangle{14, 14, 440, (104 + order.count * rowHeight) as f32};
    drawPanel(panel);
    x := panel.x as int + 14;
    y := panel.y as int + 10;
    drawTitle("Allan over vejen", x + 4, y + 2, 22, UiGold);
    difficulty := Difficulty.names[game.difficulty];
    drawText(fmt.sprint("First to %  ·  %", game.length.crossingsToWin(), difficulty), x + 230, y + 6, 16, UiGoldDim);
    uiDivider((panel.x + panel.width * 0.5) as int, y + 34, panel.width as int - 40);

    headerY := y + 40;
    drawText("Across", x + 200, headerY, 14, DimColor);
    drawText("Run over", x + 254, headerY, 14, DimColor);
    drawText("Kills", x + 318, headerY, 14, DimColor);
    drawText("Items", x + 362, headerY, 14, DimColor);
    for index, row in order {
        player := game.players[index];
        rowY := headerY + 20 + row as int * rowHeight;
        if index == game.watched { DrawRectangle(panel.x as int + 4, rowY - 3, panel.width as int - 8, rowHeight, {255, 255, 255, 22}); }
        DrawRectangle(x, rowY + 3, 10, 10, player.color);
        name := player.name;
        if player.isPlaying() || player.phase.kind == .crossed { name = fmt.sprint("%  ·  %", player.name, player.hero.info().name); }
        drawText(name, x + 18, rowY - 1, 17, TextColor);
        drawText(fmt.sprint("%", player.stats.crossings), x + 214, rowY - 1, 17, TextColor);
        drawText(fmt.sprint("%", player.stats.deaths), x + 274, rowY - 1, 17, DimColor);
        drawText(fmt.sprint("%", player.stats.kills), x + 326, rowY - 1, 17, DimColor);
        for item, k in player.backpack.list() {
            icon := assets.icons[item.itemDefinition().icon];
            DrawTexturePro(icon, {0, 0, icon.width as f32, icon.height as f32}, {(x + 362 + k as int * 22) as f32, (rowY - 1) as f32, 19, 19}, {0, 0}, 0, White);
        }
    }

    // The item on the road, or when the next one comes
    itemY := headerY + 26 + order.count as int * rowHeight;
    if game.items.onRoad.hasValue() {
        item := game.items.onRoad.value().kind.itemDefinition();
        drawText(fmt.sprint("On the road: %", item.name), x, itemY, 15, item.color);
    } else {
        drawText(fmt.sprint("The next item in % s", math.ceilf(game.items.nextIn) as int), x, itemY, 15, DimColor);
    }
}

isAhead :: (a: Player, b: Player) -> bool {
    if a.stats.crossings != b.stats.crossings { return a.stats.crossings > b.stats.crossings; }
    return a.stats.deaths < b.stats.deaths;
}

// What happened to the other players, under the scoreboard
drawFeed :: (game: *Game) {
    y := 14 + 104 + game.players.count as int * 24 + 12;     // Under the scoreboard
    for line in game.feed {
        alpha := math.min(1, line.timeLeft);
        drawText(line.text, 22, y + 1, 16, ColorAlpha(Black, 0.8 * alpha));
        drawText(line.text, 20, y, 16, ColorAlpha(line.color, alpha));
        y += 21;
    }
}

// The health of a hero over its head, and the name of its player
drawHealthOverHero :: (game: *Game, index: int) {
    player := &game.players[index];
    hero := &player.hero;
    info := hero.info();
    head := GetWorldToScreen(hero.position + Vector3{0, info.height + 1.0, 0}, game.camera.view);
    width: f32 = 66;
    bar := Rectangle{head.x - width * 0.5, head.y - 2, width, 12};
    drawHealthBar(bar, hero);
    if index != game.watched {
        nameWidth := textWidth(player.name, 15);
        drawText(player.name, head.x as int - nameWidth / 2 + 1, head.y as int - 18, 15, ColorAlpha(Black, 0.8));
        drawText(player.name, head.x as int - nameWidth / 2, head.y as int - 19, 15, player.color);
    }
}

// The whole bar is the most health of the hero. The health it has of its own is green (red when it is low), and what an
// item adds (the First Aid Kit) comes after it in grey
drawHealthBar :: (bar: Rectangle, hero: *Hero) {
    most := hero.maxHealth();
    own := hero.info().maxHealth;
    health := math.clamp(hero.health, 0, most);
    if !drawPart(.bar, bar, scale: 0.8) { DrawRectangleRec({bar.x - 1, bar.y - 1, bar.width + 2, bar.height + 2}, {0, 0, 0, 200}); }
    inner := Rectangle{bar.x + 3, bar.y + 3, bar.width - 6, bar.height - 6};

    ownWidth := inner.width * math.min(health, own) / most;
    share := math.min(health, own) / own;
    color := ColorLerp({220, 45, 35, 255}, {70, 200, 60, 255}, math.clamp(share * 1.6 - 0.3, 0, 1));
    DrawRectangleGradientV(inner.x as int, inner.y as int, ownWidth as int, inner.height as int, ColorBrightness(color, 0.15), ColorBrightness(color, -0.35));
    if health > own {
        extraWidth := inner.width * (health - own) / most;
        DrawRectangleGradientV((inner.x + ownWidth) as int, inner.y as int, extraWidth as int, inner.height as int, {200, 205, 210, 255}, {120, 125, 130, 255});
    }
    fill := inner.width * health / most;
    DrawRectangleRec({inner.x, inner.y, fill, inner.height * 0.35}, {255, 255, 255, 45});       // A shine
    if most > own {
        DrawRectangleRec({inner.x + inner.width * own / most - 1, inner.y, 2, inner.height}, {0, 0, 0, 160});   // Where its own ends
    }
}

// The bottom of the screen: the portrait of the hero, its health, and a button for each ability with
// its icon, its key and its cooldown. The passives come last, set back, without a key. The mouse on a button shows
// what the ability does
AbilityButtonSize :: 64;
AbilityButtonGap  :: 10;
PassiveGap        :: 26;     // Between the abilities that are cast and the passives

HeroCardHeight :: 182;
PortraitBox    :: 112;

drawHeroCard :: (game: *Game, assets: *Assets) {
    hero := &game.you().hero;
    info := hero.info();
    abilities := hero.abilities();

    // Where each button goes: the abilities that are cast first, then the passives
    slots: [..]int;
    defer slots.free();
    for ability, i in abilities { if !ability.isPassive() { slots.add(i as int); } }
    actives := slots.count as int;
    for ability, i in abilities { if ability.isPassive() { slots.add(i as int); } }

    buttonsWidth := slots.count as int * (AbilityButtonSize + AbilityButtonGap) - AbilityButtonGap;
    if actives > 0 && actives < slots.count { buttonsWidth += PassiveGap - AbilityButtonGap; }
    backpackWidth := game.you().backpack.size * (ItemSlotSize + 8) - 8;
    width  := math.max(20 + PortraitBox + 10 + TalentTreeWidth + 24 + buttonsWidth + 40 + backpackWidth + 24, 640);
    height := HeroCardHeight;
    panel := Rectangle{(GetScreenWidth() - width) as f32 * 0.5, (GetScreenHeight() - height - 10) as f32, width as f32, height as f32};
    game.mouseOnHud = CheckCollisionPointRec(GetMousePosition(), panel);
    uiPanel(panel);

    x := panel.x as int + 20;
    top := panel.y as int + 20;

    // The portrait: the hero itself, in 3D, in a sunken slot with a gold frame. A render texture is upside down, so it is
    // drawn with a negative height
    portraitRect := Rectangle{x as f32, top as f32, PortraitBox, PortraitBox};
    uiSlot(portraitRect);
    assets.drawPortrait(hero.kind, game, hero);
    size := PortraitResolution as f32;
    DrawTexturePro(assets.portrait.texture, {0, 0, size, -size}, {portraitRect.x + 5, portraitRect.y + 5, PortraitBox - 10, PortraitBox - 10}, {0, 0}, 0, White);
    uiIconFrame(portraitRect);

    // The name across the foot of the portrait, on a band that darkens towards the bottom, so the row of what is on the
    // hero has the top of the panel to itself; and how long the hero has lived, at the top in the middle
    band := Rectangle{portraitRect.x + 5, portraitRect.y + PortraitBox - 5 - 30, PortraitBox - 10, 30};
    DrawRectangleGradientV(band.x as int, band.y as int, band.width as int, band.height as int, {0, 0, 0, 0}, {0, 0, 0, 200});
    nameSize := 18;
    if titleWidth(info.name, nameSize) > (band.width - 8) as int { nameSize = 15; }
    nameX := (portraitRect.x + PortraitBox * 0.5) as int - titleWidth(info.name, nameSize) / 2;
    nameY := (portraitRect.y + PortraitBox) as int - 5 - nameSize - 6;
    drawTitle(info.name, nameX + 1, nameY + 1, nameSize, ColorAlpha(Black, 0.8));
    drawTitle(info.name, nameX, nameY, nameSize, UiGold);
    alive := tprint("Alive % s", fmt.fixed(hero.timeAlive, 1));
    drawText(alive, (panel.x + panel.width * 0.5) as int - textWidth(alive, 14) / 2, panel.y as int + 16, 14, UiGoldDim);

    // The talent tree, right of the portrait
    treeRect := Rectangle{(x + PortraitBox + 10) as f32, top as f32, TalentTreeWidth, PortraitBox};
    onTree := drawTalentTree(game, assets, &game.players[game.watched], treeRect);

    // The abilities
    left := x + PortraitBox + 10 + TalentTreeWidth + 24;
    drawTitle("Abilities", left, top - 2, 15, UiGoldDim);
    mouse := GetMousePosition();
    game.hoveredAbility = -1;
    hoveredButton: Rectangle;
    bx := left;
    buttonY := top + 20;
    for slot, n in slots {
        if n as int == actives && actives > 0 {
            // A gold line between the abilities that are cast and the passives
            bx += PassiveGap - AbilityButtonGap;
            DrawRectangleGradientV(bx - PassiveGap / 2 - 1, buttonY + 4, 2, AbilityButtonSize - 8, UiGoldDim, ColorAlpha(UiGoldDim, 0));
        }
        button := Rectangle{bx as f32, buttonY as f32, AbilityButtonSize, AbilityButtonSize};
        drawAbilityButton(game, assets, abilities[slot], slot, button);
        if CheckCollisionPointRec(mouse, button) {
            game.hoveredAbility = slot;
            hoveredButton = button;
        }
        bx += AbilityButtonSize + AbilityButtonGap;
    }

    // A gold line before the backpack
    backpackX := (panel.x + panel.width) as int - 24 - backpackWidth;
    DrawRectangleGradientV(backpackX - 20, top, 2, PortraitBox - 10, ColorAlpha(UiGoldDim, 0.9), ColorAlpha(UiGoldDim, 0));

    // Health, under all of it
    healthBar := Rectangle{x as f32, (top + PortraitBox + 12) as f32, (width - 40) as f32, 22};
    drawHealthBar(healthBar, hero);
    healthText := tprint("% / %", math.ceilf(math.max(hero.health, 0)) as int, hero.maxHealth() as int);
    textX := x + (width - 40 - textWidth(healthText, 16)) / 2;
    drawText(healthText, textX + 1, top + PortraitBox + 15, 16, Black);
    drawText(healthText, textX, top + PortraitBox + 14, 16, White);

    drawBackpack(game, assets, backpackX, buttonY);
    drawBuffs(game, assets, panel);
    if onTree { drawTalentTreeTip(game, &game.players[game.watched], treeRect); }
    if game.hoveredAbility >= 0 {
        drawAbilityTooltip(hero, abilities[game.hoveredAbility], hoveredButton, panel);
    }
}

ItemSlotSize :: 56;

// The backpack, at the right of the hero card: the items, and an empty slot for each one more it can hold. The mouse on
// an item says what it does
drawBackpack :: (game: *Game, assets: *Assets, x: int, y: int) {
    backpack := &game.you().backpack;
    drawTitle("Backpack", x, y - 22, 15, UiGoldDim);
    mouse := GetMousePosition();
    game.hoveredItem = -1;
    hovered: ?Rectangle = null;
    for slot in 0..backpack.size {
        box := Rectangle{(x + slot as int * (ItemSlotSize + 8)) as f32, y as f32, ItemSlotSize, ItemSlotSize};
        uiSlot(box);
        if slot >= backpack.count { continue; }
        kind := backpack.items[slot];
        item := kind.itemDefinition();
        icon := assets.icons[item.icon];
        inner := Rectangle{box.x + 4, box.y + 4, box.width - 8, box.height - 8};
        DrawTexturePro(icon, {0, 0, icon.width as f32, icon.height as f32}, inner, {0, 0}, 0, White);
        left, seconds := itemCooldown(game.you(), slot as int);
        drawCooldown(inner, left, seconds, 20);
        highlight: ?Color = null;
        if slot as int == game.aimingItem { highlight = UiGold; }
        uiIconFrame(box, highlight);
        if item.isUsed() {
            // Its key in the corner, and how many uses are left
            DrawRectangle(box.x as int + 4, box.y as int + 4, 15, 16, {0, 0, 0, 200});
            drawText(tprint("%", slot + 1), box.x as int + 7, box.y as int + 4, 14, UiGold);
            if item.charges > 0 {
                text := tprint("%", backpack.charges[slot]);
                drawText(text, (box.x + box.width) as int - 6 - textWidth(text, 16), (box.y + box.height) as int - 20, 16, White);
            }
        }
        isHovered := CheckCollisionPointRec(mouse, box);
        // Locked: a padlock in the corner. On hover, a faint one says a right click locks it
        if backpack.locked[slot] { drawLock(box, 1); }
        else if isHovered        { drawLock(box, 0.45); }
        if isHovered {
            game.hoveredItem = slot as int;
            hovered = box;
        }
    }
    if hovered.hasValue() {
        item := backpack.items[game.hoveredItem].itemDefinition();
        lines := wrapText(item.description, 16, 330);
        defer lines.free();
        uiTooltip(hovered.value(), item.name, item.color, lines, "Item");
    }
}

// Over the hero card when spectating: whom the view follows, and how to watch another
drawWatching :: (game: *Game) {
    player := game.you();
    text := tprint("Watching %   ·   Tab or 1 to % for another player", player.name, game.players.count);
    width := textWidth(text, 17) + 70;
    x := (GetScreenWidth() - width) / 2;
    y := GetScreenHeight() - HeroCardHeight - 10 - 80;
    drawPanel({x as f32, y as f32, width as f32, 40});
    DrawRectangle(x + 22, y + 15, 10, 10, player.color);
    drawText(text, x + 40, y + 10, 17, Parchment);
}

// A padlock in the corner of an item that is locked, or a faint one while the mouse is on it: a right click locks it
drawLock :: (box: Rectangle, alpha: f32) {
    // In the top right corner, where the cursor doesn't cover it
    x := (box.x + box.width) as int - 16;
    y := box.y as int + 4;
    DrawRectangle(x - 2, y - 2, 16, 16, ColorAlpha(Black, 0.65 * alpha));
    DrawRing({(x + 6) as f32, (y + 5) as f32}, 3, 5, 180, 360, 12, ColorAlpha({230, 220, 200, 255}, alpha));
    DrawRectangle(x + 1, y + 5, 10, 7, ColorAlpha({230, 200, 90, 255}, alpha));
}

// The dark part of a cooldown that shrinks clockwise from the top, with the seconds left
drawCooldown :: (box: Rectangle, left: f32, seconds: f32, textSize: int) {
    if left <= 0 { return; }
    x := box.x as int;
    y := box.y as int;
    BeginScissorMode(x, y, box.width as int, box.height as int);
    DrawCircleSector({box.x + box.width * 0.5, box.y + box.height * 0.5}, box.width, -90 + (1 - left) * 360, 270, 48, {0, 0, 0, 170});
    EndScissorMode();
    if seconds <= 0 { return; }
    text := tprint("%", math.ceilf(seconds) as int);
    if seconds < 1 { text = tprint("%", fmt.fixed(seconds, 1)); }
    textX := x + (box.width as int - textWidth(text, textSize)) / 2;
    textY := y + (box.height as int - textSize) / 2 - 2;
    drawText(text, textX + 2, textY + 2, textSize, Black);
    drawText(text, textX, textY, textSize, White);
}

drawAbilityButton :: (game: *Game, assets: *Assets, ability: Ability, slot: int, button: Rectangle) {
    hero := &game.you().hero;
    x := button.x as int;
    y := button.y as int;
    icon := assets.icons[ability.icon];
    source := Rectangle{0, 0, icon.width as f32, icon.height as f32};

    if ability.isPassive() {
        // A passive sits back in a sunken slot, smaller and a bit dimmed
        uiSlot(button);
        inset: f32 = 9;
        DrawTexturePro(icon, source, {button.x + inset, button.y + inset, button.width - inset * 2, button.height - inset * 2}, {0, 0}, 0, {200, 200, 200, 255});
        return;
    }

    inner := Rectangle{button.x + 4, button.y + 4, button.width - 8, button.height - 8};
    DrawTexturePro(icon, source, inner, {0, 0}, 0, White);
    cooldown := hero.cooldowns[slot];
    drawCooldown(inner, cooldown / (ability.cooldown * hero.stats.cooldown), cooldown, 26);

    // Lit up while it is aimed, or just cast
    highlight: ?Color = null;
    justCast := cooldown > 0 && ability.cooldown * hero.stats.cooldown - cooldown < math.max(ability.duration, 0.3);
    if justCast || slot == game.aiming { highlight = UiGold; }
    uiIconFrame(button, highlight);

    // The key in the corner
    key := AbilityKeyNames[hero.keyOf(slot)];
    DrawRectangle(x + 5, y + 5, 18, 19, {0, 0, 0, 200});
    DrawRectangleLines(x + 5, y + 5, 18, 19, UiGoldDim);
    drawText(key, x + 9, y + 5, 16, UiGold);
}

drawAbilityTooltip :: (hero: *Hero, ability: Ability, button: Rectangle, panel: Rectangle) {
    lines := wrapText(ability.description, 16, 330);
    defer lines.free();
    detail := "Passive";
    if !ability.isPassive() { detail = tprint("Cooldown % s", fmt.fixed(ability.cooldown * hero.stats.cooldown, 1)); }
    // Above the panel of the hero
    anchor := Rectangle{button.x, panel.y - 24, button.width, 1};
    uiTooltip(anchor, ability.name, UiGold, lines, detail);
}

// Breaks a text into lines that fit a width, at the spaces
wrapText :: (text: string, size: int, width: int) -> [..]string {
    lines: [..]string;
    line := "";
    for word in text.split(" ") {
        candidate := word;
        if line.len > 0 { candidate = fmt.sprint("% %", line, word); }
        if line.len > 0 && textWidth(candidate, size) > width {
            lines.add(line);
            line = word;
        } else {
            line = candidate;
        }
    }
    if line.len > 0 { lines.add(line); }
    return lines;
}

drawBanner :: (game: *Game) {
    banner := game.banner;
    if banner.timeLeft <= 0 || banner.text.len == 0 { return; }

    alpha := math.clamp(banner.timeLeft / 0.5, 0, 1);
    size := 32;
    width := titleWidth(banner.text, size);
    x := (GetScreenWidth() - width) / 2;
    y := 90;

    // On a plaque
    plaque := Rectangle{(x - size * 2) as f32, (y - 10) as f32, (width + size * 4) as f32, (size + 22) as f32};
    if !drawPart(.plaque, plaque, ColorAlpha(White, alpha)) { DrawRectangleRec(plaque, ColorAlpha(PanelColor, 0.8 * alpha)); }
    drawTitle(banner.text, x + 2, y + 3, size, ColorAlpha(Black, 0.6 * alpha));
    drawTitle(banner.text, x, y + 1, size, ColorAlpha(banner.color, alpha));
}

HelpLine :: struct {
    keys: string;
    what: string;
}

drawHelp :: () {
    lines := [
        HelpLine{"Right click", "Walk there"},
        HelpLine{"Q W E R", "The abilities"},
        HelpLine{"Left click", "An ability's icon: cast it"},
        HelpLine{"S", "Stop"},
        HelpLine{"Y", "Lock or unlock the camera"},
        HelpLine{"Space", "Camera to the hero"},
        HelpLine{"Wheel", "Zoom"},
        HelpLine{"M", "Music on or off"},
        HelpLine{"P", "Pause"},
        HelpLine{"F5", "New game"},
        HelpLine{"F4", "Inspect the bots (Tab: next)"},
        HelpLine{"Tab, 1-6", "Watch another (spectating)"},
        HelpLine{"F1", "Console"},
        HelpLine{"H", "Hide this"},
    ];

    lineHeight := 21;
    panel := Rectangle{16, (GetScreenHeight() - lines.count * lineHeight - 40) as f32, 320, (lines.count * lineHeight + 22) as f32};
    drawPanel(panel);
    for line, i in lines {
        y := panel.y as int + 11 + i as int * lineHeight;
        drawText(line.keys, panel.x as int + 14, y, 16, {255, 210, 90, 255});
        drawText(line.what, panel.x as int + 120, y, 16, DimColor);
    }
}

drawDebug :: (game: *Game) {
    camera := game.camera.view;
    hero := game.you().hero;
    lines: [..]string;
    defer lines.free();
    lines.add(tprint("FPS %", GetFPS()));
    lines.add(tprint("Camera % % %", fmt.fixed(camera.position.x, 1), fmt.fixed(camera.position.y, 1), fmt.fixed(camera.position.z, 1)));
    lines.add(tprint("Hero % %", fmt.fixed(hero.position.x, 1), fmt.fixed(hero.position.z, 1)));
    lines.add(tprint("Cars %, particles %", game.traffic.activeCount(), game.effects.particles.count()));
    timings := profileLines();
    defer timings.free();
    for line in timings { lines.add(line); }

    width := 330;
    x := GetScreenWidth() - width - 16;
    drawPanel({x as f32, 16, width as f32, (lines.count as int * 20 + 30) as f32});
    for line, i in lines {
        drawText(line, x + 16, 30 + i as int * 20, 16, Lime);
    }
}

drawPaused :: (game: *Game) {
    DrawRectangle(0, 0, GetScreenWidth(), GetScreenHeight(), {0, 0, 0, 120});
    centerX := GetScreenWidth() / 2;
    centerY := GetScreenHeight() / 2;

    // A menu: a panel with the title on a plaque, and the settings of the next game in it
    width := 620;
    height := 290;
    panel := Rectangle{(centerX - width / 2) as f32, (centerY - height / 2) as f32, width as f32, height as f32};
    uiPanel(panel);
    uiPlaque("Paused", centerX, panel.y as int - 26, 34);
    hint := "Press P or Esc to go on";
    drawText(hint, centerX - textWidth(hint, 18) / 2, panel.y as int + 34, 18, Parchment);
    uiDivider(centerX, panel.y as int + 72, width - 80);

    // The settings of the next game: up and down pick one, left and right change it
    chosen := game.nextDifficulty ?? game.difficulty;
    name := Difficulty.names[chosen];
    length := game.nextLength ?? game.length;
    lengthName := GameLength.names[length];
    rows := [
        tprint("Bots:   <  %%  >", name.slice(0, 1).toUpper(), name.slice(1)),
        tprint("Game:   <  %%, first to %  >", lengthName.slice(0, 1).toUpper(), lengthName.slice(1), length.crossingsToWin()),
    ];
    for row, i in rows {
        y := panel.y as int + 96 + i as int * 52;
        color := Parchment;
        if i == game.pauseRow {
            color = UiGold;
            DrawRectangle(panel.x as int + 30, y - 6, width - 60, 44, {255, 210, 110, 22});
        }
        drawTitle(row, centerX - titleWidth(row, 28) / 2, y, 28, color);
    }
    note := "Up and down to pick, left and right to change";
    if chosen != game.difficulty || length != game.length { note = "From the next game: press F5"; }
    drawText(note, centerX - textWidth(note, 16) / 2, panel.y as int + height - 44, 16, UiGoldDim);
}

drawPanel :: (rect: Rectangle) {
    uiPanel(rect, 0.6);
}

//
// Text. raylib draws a c.string, so the text is copied with a 0 after it
//

drawText :: (text: string, x: int, y: int, size: int, color: Color) {
    drawWith(false, text, x, y, size, color);
}

drawTitle :: (text: string, x: int, y: int, size: int, color: Color) {
    drawWith(true, text, x, y, size, color);
}

textWidth :: (text: string, size: int) -> int {
    return measureWith(false, text, size);
}

titleWidth :: (text: string, size: int) -> int {
    return measureWith(true, text, size);
}

@private
drawWith :: (title: bool, text: string, x: int, y: int, size: int, color: Color) {
    cText := tempCString(text);
    if !fonts.hasValue() {
        DrawText(cText, x, y, size, color);     // raylib's own, before the fonts are loaded
        return;
    }
    font := fonts.value().text;
    if title { font = fonts.value().title; }
    DrawTextEx(font, cText, {x as f32, y as f32}, size as f32, size * 0.03, color);
}

@private
measureWith :: (title: bool, text: string, size: int) -> int {
    cText := tempCString(text);
    if !fonts.hasValue() { return MeasureText(cText, size); }
    font := fonts.value().text;
    if title { font = fonts.value().title; }
    return MeasureTextEx(font, cText, size as f32, size * 0.03).x as int;
}

// Blinded by a flash: the screen is white, and fades back
drawBlindness :: (game: *Game) {
    hero := &game.you().hero;
    if !hero.has(.blind) { return; }
    alpha := math.min(hero.timeLeft(.blind) / 1.2, 1) * 0.92;
    DrawRectangle(0, 0, GetScreenWidth(), GetScreenHeight(), ColorAlpha({255, 252, 240, 255}, alpha));
}
