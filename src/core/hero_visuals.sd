namespace core;

// Drawing that several heroes share: a hero turned into a toad, and what its definition draws besides its model

import math;
use raylib;

drawHeroExtras :: (game: *Game, index: int, bob: f32) {
    hero := &game.players[index].hero;
    if hero.has(.hex) { return; }
    draw := hero.info().drawExtras;
    if draw != null { draw(game, index, bob); }

    // Healing with a bandage: a green cross that pulses over the head
    if hero.has(.mending) {
        top := hero.position + Vector3{0, hero.info().height + 1 + bob, 0};
        pulse := 0.8 + 0.2 * math.sinf(game.time * 8);
        DrawCube(top, 0.9 * pulse, 0.3, 0.3, {90, 230, 110, 255});
        DrawCube(top, 0.3, 0.9 * pulse, 0.3, {90, 230, 110, 255});
    }
    // Taunted: a red mark. Blinded: stars of the flash
    top := hero.position + Vector3{0, hero.info().height + 0.7 + bob, 0};
    if hero.has(.taunt) { DrawCube(top, 0.25, 0.8, 0.25, {255, 60, 50, 255}); }
    if hero.has(.blind) {
        for k in 0..4 {
            angle := game.time * 4 + k as f32 * Pi * 0.5;
            DrawSphere(top + Vector3{math.sinf(angle) * 0.8, 0.1, math.cosf(angle) * 0.8}, 0.14, {255, 255, 230, 255});
        }
    }
    if hero.has(.sleep) {
        for k in 0..3 {
            rise := math.fmodf(game.time * 0.8 + k as f32 * 0.33, 1);
            DrawCube(top + Vector3{0.4 + rise * 0.6, rise * 1.4, 0}, 0.35 * (1 - rise * 0.5), 0.35 * (1 - rise * 0.5), 0.05, ColorAlpha({220, 230, 255, 255}, 1 - rise));
        }
    }
    // In a trance: purple rings that rise round him, slowly
    if hero.has(.trance) {
        for k in 0..3 {
            rise := math.fmodf(game.time * 0.6 + k as f32 / 3, 1);
            DrawCircle3D(hero.position + Vector3{0, rise * hero.info().height, 0}, hero.info().hitRadius + 0.6, {1, 0, 0}, 90, ColorAlpha({200, 120, 255, 255}, 1 - rise));
        }
    }
    // Berserk: a red glow on the ground that throbs
    if hero.has(.berserk) {
        throb := 0.5 + 0.5 * math.sinf(game.time * 14);
        DrawCylinder(hero.position + Vector3{0, 0.14, 0}, hero.info().hitRadius + 0.8 + throb * 0.3, hero.info().hitRadius + 0.8, 0.02, 16, ColorAlpha({255, 60, 30, 255}, 0.35 + throb * 0.25));
    }
    // Repelling: blue rings that run out to as far as he pushes the cars, and the lines of his field, looping from
    // over his head round to his feet as round a bar magnet, turning slowly, with a spark running along each
    if hero.has(.repel) {
        for k in 0..3 {
            t := math.fmodf(game.time * 1.5 + k as f32 / 3, 1);
            DrawCircle3D(hero.position + Vector3{0, 0.3, 0}, RepelRadius * t, {1, 0, 0}, 90, ColorAlpha({110, 160, 255, 255}, (1 - t) * 0.8));
        }
        height := hero.info().height;
        fade := math.min(hero.timeLeft(.repel) / 0.3, 1);
        for line in 0..8 {
            angle := line as f32 * Pi / 4 + game.time * 0.9;
            out := Vector3{math.cosf(angle), 0, math.sinf(angle)};
            reach := 2.6 + 0.6 * (line % 2) as f32;
            previous := hero.position + Vector3{0, height + 0.3 + bob, 0};
            Steps :: 12;
            for k in 1..(Steps + 1) {
                t := k as f32 / Steps as f32;
                point := hero.position + out * (math.sinf(t * Pi) * reach) + Vector3{0, (height + 0.3) * (1 - t) + 0.1 + bob * (1 - t), 0};
                DrawCylinderEx(previous, point, 0.04, 0.04, 4, ColorAlpha({120, 175, 255, 255}, 0.5 * fade));
                previous = point;
            }
            s := math.fmodf(game.time * 1.4 + line as f32 * 0.37, 1);
            spark := hero.position + out * (math.sinf(s * Pi) * reach) + Vector3{0, (height + 0.3) * (1 - s) + 0.1, 0};
            DrawSphere(spark, 0.11, ColorAlpha({220, 235, 255, 255}, fade));
        }
    }
    drawScrap(game, hero, bob);
    // Frozen: a block of ice round it
    if hero.has(.frozen) {
        info := hero.info();
        center := hero.position + Vector3{0, info.height * 0.5, 0};
        DrawCube(center, info.width * 0.95, info.height * 1.05, info.width * 0.95, ColorAlpha({200, 240, 255, 255}, 0.35));
        DrawCubeWires(center, info.width * 0.95, info.height * 1.05, info.width * 0.95, ColorAlpha({235, 250, 255, 255}, 0.8));
    }
    if hero.has(.tangled) {
        DrawCylinderWires(hero.position + Vector3{0, 0.6, 0}, hero.info().hitRadius + 0.3, hero.info().hitRadius + 0.3, 1.2, 8, {230, 90, 160, 255});
    }
}

// Sigrid's hex: a fat green toad with big eyes, where the hero was
drawToad :: (position: Vector3, facing: f32, time: f32) {
    Green :: Color{90, 160, 60, 255};
    Belly :: Color{200, 210, 120, 255};
    hop := math.fabsf(math.sinf(time * 5)) * 0.4;
    base := position + Vector3{0, hop, 0};
    forward := Vector3{math.sinf(facing), 0, math.cosf(facing)};
    right := Vector3{forward.z, 0, -forward.x};
    DrawSphereEx(base + Vector3{0, 0.7, 0}, 0.9, 10, 10, Green);
    DrawSphereEx(base + Vector3{0, 0.5, 0} + forward * 0.35, 0.6, 8, 8, Belly);
    for side in [-1.0, 1.0] {
        eye := base + Vector3{0, 1.45, 0} + forward * 0.45 + right * (side * 0.42);
        DrawSphere(eye, 0.28, Green);
        DrawSphere(eye + forward * 0.18 + Vector3{0, 0.05, 0}, 0.14, Black);
        DrawSphere(base + Vector3{0, 0.2, 0} + right * (side * 0.8) - forward * 0.3, 0.35, Green);
    }
}
