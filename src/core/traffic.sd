namespace core;

import math;
import random;
use raylib;

// The cars on the motorway. Every lane drives towards +z, from the far end of the road to the near one. Each car has a
// speed of its own, and a faster car drives straight through a slower one in its lane, so nobody waits

CarKind :: enum {
    car,
    van,
    truck,
    ambulance,      // Now and then, much faster than the rest, with a siren a moment before it comes (traffic_events.sd)
}

Car :: struct {
    isActive:   bool;
    kind:       CarKind;
    lane:       int;
    z:          f32;        // The middle of the car along the road
    color:      Color;
    speed:      f32;
    frozenLeft: f32;        // Seconds it is frozen by Frosty
    isBraking:  bool;       // Held up in a lane that Hilda stopped, with its brake lights on
    age:        f32;        // Seconds since it was spawned
    leakLeft:   f32;        // Seconds it still leaks oil (slicks.sd)
    leakTimer:  f32;        // Seconds to its next drop
    layer:      int;        // 0 to 3, different for cars after each other in a lane. Drawn a bit bigger by it, so two
                            // cars that drive through each other don't have their faces in the same place (z-fighting)

    // The health it takes off a hero it is on, per second
    damagePerSecond :: method () -> f32 {
        return switch self.kind {
            case .car   => CarDamagePerSecond;
            case .van   => CarDamagePerSecond * 1.2;
            case .truck => CarDamagePerSecond * 1.6;
            case .ambulance => CarDamagePerSecond * 2;
        };
    }

    length :: method () -> f32 {
        return self.kind.length();
    }

    height :: method () -> f32 {
        return switch self.kind {
            case .car   => CarHeight;
            case .van       => VanHeight;
            case .ambulance => VanHeight;
            case .truck => TruckHeight;
        };
    }

    // The footprint on the ground: x and z
    rect :: method () -> Rectangle {
        x := laneCenter(self.lane);
        length := self.length();
        return {x - CarWidth * 0.5, self.z - length * 0.5, CarWidth, length};
    }

    position :: method () -> Vector3 {
        return {laneCenter(self.lane), 0, self.z};
    }
}

length :: method (kind: CarKind) -> f32 {
    return switch kind {
        case .car   => CarLength;
        case .van       => VanLength;
        case .ambulance => VanLength;
        case .truck => TruckLength;
    };
}

Lane :: struct {
    speed:      f32;        // The speed its cars drive around
    spawnTimer: f32;        // Seconds to the next car
    spawned:    int;        // Cars so far, for the layer of the next
    haltLeft:   f32;        // Seconds the lane is stopped by Hilda. Its cars queue up before haltLine
    haltLine:   f32;        // The z that the first car in the queue stops at with its front
}

Traffic :: struct {
    cars:  [MaxCars]Car;
    lanes: [LaneCount]Lane;
    level: int;
    warpLeft: f32;          // Seconds left of Mira's time warp, which slows every car by warpSlow
    warpSlow: f32;

    // Rush hour and ambulances (traffic_events.sd)
    hasEvents:     bool;        // Not while the road is filled at the start
    rush:          RushPhase;
    rushLeft:      f32;         // Seconds left of the phase
    nextEmergency: f32;         // Seconds to the next siren
    emergencyLane: int = -1;    // The middle lane of the ambulances that come, after their siren
    emergencyIn:   f32;         // and the seconds until it is on the road
}

// The room a car in a queue leaves to the car in front of it
QueueGap :: 1.5;

CarColors :: [
    Color{236, 240, 241, 255}, Color{ 44,  62,  80, 255}, Color{192,  57,  43, 255}, Color{ 41, 128, 185, 255},
    Color{243, 156,  18, 255}, Color{ 39, 174,  96, 255}, Color{142,  68, 173, 255}, Color{149, 165, 166, 255},
    Color{211,  84,   0, 255}, Color{ 22, 160, 133, 255},
];

laneCenter :: (lane: int) -> f32 {
    return -RoadHalfWidth + LaneWidth * (lane as f32 + 0.5);
}

// The lane at a point across the road
laneAt :: (x: f32) -> int {
    return math.clamp(math.floorf((x + RoadHalfWidth) / LaneWidth) as int, 0, LaneCount - 1);
}

// Where the road starts and ends, past the edges of the field
RoadEnd :: MapHalfLength + RoadOverhang;

newTraffic :: (level: int, rng: *random.Random) -> Traffic {
    traffic: Traffic;
    traffic.setLevel(level, rng);

    // Fill the road, as if the traffic had been driving for a while
    noZones: [..]SlowZone;
    for 0..400 {
        traffic.update(0.1, rng, noZones);
    }
    traffic.startEvents(rng);
    return traffic;
}

setLevel :: method (traffic: *Traffic, level: int, rng: *random.Random) {
    previous := 1 + SpeedUpPerLevel * traffic.level as f32;
    traffic.level = math.min(level, MaxLevel);
    speedUp := 1 + SpeedUpPerLevel * traffic.level as f32;

    for *lane in traffic.lanes {
        lane.speed = rng.uniform(MinCarSpeed, MaxCarSpeed) as f32 * speedUp;
    }

    // The cars on the road speed up too
    for *car in traffic.cars {
        if car.isActive { car.speed *= speedUp / previous; }
    }
}

// A circle on the road where the cars drive slower, e.g around Frosty
SlowZone :: struct {
    center: Vector2;
    radius: f32;
    slow:   f32;            // 0.4 is 40% slower
}

update :: method (traffic: *Traffic, dt: f32, rng: *random.Random, slowZones: []SlowZone) {
    // Where each car of a stopped lane may get to: up to the line, or the car in front of it in the queue
    limits: [MaxCars]f32;
    for *car, i in traffic.cars {
        car.isBraking = false;
        limits[i] = RoadEnd * 10;
    }
    for *lane, l in traffic.lanes {
        if lane.haltLeft <= 0 { continue; }
        lane.haltLeft -= dt;
        traffic.queueUp(l as int, &limits);
    }

    warp: f32 = 1;
    if traffic.warpLeft > 0 {
        traffic.warpLeft -= dt;
        warp = 1 - traffic.warpSlow;
    }

    for *car, i in traffic.cars {
        if !car.isActive { continue; }

        car.age += dt;
        if car.frozenLeft > 0 {
            car.frozenLeft -= dt;
            continue;
        }

        speed := car.speed;
        for zone in slowZones {
            if CheckCollisionCircleRec(zone.center, zone.radius, car.rect()) { speed *= 1 - zone.slow; }
        }
        next := car.z + speed * warp * dt;
        if next > limits[i] {
            next = math.max(car.z, limits[i]);
            car.isBraking = true;
        }
        car.z = next;
        if car.z > RoadEnd + car.length() {
            car.isActive = false;
        }
    }

    traffic.updateEvents(dt, rng);

    for *lane, i in traffic.lanes {
        lane.spawnTimer -= dt;
        if lane.spawnTimer > 0 { continue; }

        traffic.spawn(i as int, rng);

        // The time to the next car shrinks as the levels go up, and in rush hour
        gap := rng.uniform(MinSpawnGap, MaxSpawnGap) as f32 * gapShrink(traffic.level) * traffic.rushGap();
        lane.spawnTimer = (gap + CarLength) / lane.speed;
    }
}

// The room between two cars of a lane when the second comes in, before the levels shrink it
MinSpawnGap :: 8.0;
MaxSpawnGap :: 50.0;

// How much faster or slower than its lane a new car drives, at the most. A truck drives at 0.8 of that
MinSpawnSpeed :: 0.8 * 0.8;
MaxSpawnSpeed :: 1.2;

gapShrink :: (level: int) -> f32 {
    return 1 - 0.03 * level as f32;
}

// The shortest time between two cars of a lane, for the forecast of the bots: as in rush hour when it is coming
minSpawnGap :: (traffic: *Traffic, laneSpeed: f32) -> f32 {
    rush: f32 = 1;
    if traffic.rush != .calm { rush = RushGap; }
    return (MinSpawnGap * gapShrink(traffic.level) * rush + CarLength) / laneSpeed;
}

// Puts a new car at the start of a lane, at the far end of the road
spawn :: method (traffic: *Traffic, lane: int, rng: *random.Random) {
    kind := CarKind.car;
    roll := rng.random();
    if roll < 0.12      { kind = .truck; }
    else if roll < 0.25 { kind = .van; }

    // Every car drives a bit faster or slower than its lane. Trucks are slow
    speed := traffic.lanes[lane].speed * rng.uniform(MinSpawnSpeed / 0.8, MaxSpawnSpeed) as f32;
    if kind == .truck { speed *= 0.8; }

    for *car in traffic.cars {
        if car.isActive { continue; }

        *car = Car{
            isActive: true,
            kind:     kind,
            lane:     lane,
            z:        -RoadEnd - kind.length() * 0.5,
            color:    rng.choice(CarColors),
            speed:    speed,
            layer:    traffic.lanes[lane].spawned % 4,
        };
        traffic.lanes[lane].spawned += 1;
        return;
    }
    // Every car is on the road already
}

// The queue of a stopped lane: the cars that haven't got to its line, front to back. The first stops at the line, and
// every other one behind the car in front of it
@private
queueUp :: method (traffic: *Traffic, lane: int, limits: *[MaxCars]f32) {
    line := traffic.lanes[lane].haltLine;
    queue: [MaxCars]int;
    count := 0;
    for car, i in traffic.cars {
        if !car.isActive || car.lane != lane || car.z + car.length() * 0.5 > line + 0.5 { continue; }
        // Sorted by z, the front of the queue first
        at := count;
        while at > 0 && traffic.cars[queue[at - 1]].z < car.z {
            queue[at] = queue[at - 1];
            at -= 1;
        }
        queue[at] = i as int;
        count += 1;
    }

    front := line;
    for k in 0..count {
        car := &traffic.cars[queue[k]];
        (*limits)[queue[k]] = front - car.length() * 0.5;
        front = math.min(front, car.z - car.length() * 0.5) - QueueGap;
    }
}

// Stops the lanes from first to last, inclusive: their cars queue up before the line, a z on the road
halt :: method (traffic: *Traffic, first: int, last: int, line: f32, duration: f32) {
    for lane in math.max(first, 0)...math.min(last, LaneCount - 1) {
        traffic.lanes[lane].haltLeft = duration;
        traffic.lanes[lane].haltLine = line;
    }
}

// Every car on the road drives slower for a while
warpTime :: method (traffic: *Traffic, slow: f32, duration: f32) {
    traffic.warpLeft = duration;
    traffic.warpSlow = slow;
}

isWarped :: method (traffic: *Traffic) -> bool {
    return traffic.warpLeft > 0;
}

// Freezes the cars within the radius of a point
freezeAround :: method (traffic: *Traffic, point: Vector2, radius: f32, duration: f32) -> int {
    frozen := 0;
    for *car in traffic.cars {
        if !car.isActive { continue; }
        if CheckCollisionCircleRec(point, radius, car.rect()) {
            car.frozenLeft = duration;
            frozen += 1;
        }
    }
    return frozen;
}

// The first car that hits a circle on the ground
carHitting :: method (traffic: *Traffic, center: Vector2, radius: f32) -> ?*Car {
    for *car in traffic.cars {
        if car.isActive && CheckCollisionCircleRec(center, radius, car.rect()) {
            return car;
        }
    }
    return null;
}

activeCount :: method (traffic: *Traffic) -> int {
    return traffic.cars.countWhere(car => car.isActive);
}
