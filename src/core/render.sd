namespace core;

import math;
use raylib;

// The 3D scene: the ground, the road, the walls, the cars, the hero and the effects

SkyColor  :: Color{106, 138, 112, 255};
ShadowColor :: Color{0, 0, 0, 70};
FrozenColor :: Color{170, 230, 255, 255};

drawScene :: method (game: *Game, assets: *Assets) {
    profileBegin(.scene);
    defer profileEnd(.scene);
    assets.lighting.setCamera(game.camera.view);

    // raylib's near plane of 0.01 leaves the depth buffer too little precision at the distance of the camera, and the
    // flat layers on the ground (the grass, the road, the shadows) flicker through each other
    rlSetClipPlanes(0.5, 1500);
    BeginMode3D(game.camera.view);
    defer EndMode3D();

    // The ground, below everything
    DrawMesh(assets.outside, assets.outsideMaterial, MatrixTranslate(0, -0.4, 0));
    DrawMesh(assets.ground, assets.groundMaterial, MatrixIdentity());
    DrawMesh(assets.road, assets.roadMaterial, MatrixTranslate(0, 0.06, 0));
    DrawMesh(assets.laneMarkings, assets.laneMarkingsMaterial, MatrixIdentity());
    drawGoalStrip(game.you().startSide.opposite());
    drawSlicks(game);
    drawEmergencyWarning(game);
    drawTimetable(game);

    if game.debug.wireframes { rlEnableWireMode(); }

    for wall in game.world.walls {
        assets.drawWall(wall);
    }
    frustum := game.camera.frustum();
    profileBegin(.scenery);
    assets.drawScenery(&frustum);
    profileEnd(.scenery);

    profileBegin(.cars);
    for *car in game.traffic.cars {
        if car.isActive && frustum.sees(car.position(), car.length() * 0.5 + 1) { drawCar(game, assets, car); }
    }
    profileEnd(.cars);
    for sign in game.stopSigns { drawStopSign(assets, sign); }
    drawBridges(game, assets);
    drawCones(game);
    drawTrampolines(game, assets);
    drawPortals(game);
    drawRods(game);
    drawPeels(game);
    drawProjectiles(game);
    drawStrikes(game);
    drawDecoys(game, assets);

    // Shadows, stains and rings lie on the ground, above the road
    for *car in game.traffic.cars {
        if car.isActive && frustum.sees(car.position(), car.length() * 0.5 + 1) {
            rect := car.rect();
            DrawCube(rect.center().at(0.12 + car.layer as f32 * 0.006), rect.width + 0.4, 0.02, rect.height + 0.4, ShadowColor);
        }
    }
    game.effects.drawRings();
    drawItem(game, assets);
    drawItemAuras(game);

    if game.hasLocal() && game.watched == game.local && game.you().isPlaying() { drawAbilityHints(game); }
    for player, i in game.players {
        if player.phase.kind == .runOver { continue; }
        drawHero(assets, game, i as int);
    }
    drawInspection3D(game);
    profileBegin(.particles);
    game.effects.particles.draw(assets, game.camera.view);
    profileEnd(.particles);

    if game.debug.wireframes { rlDisableWireMode(); }
    if game.debug.hitboxes { drawHitboxes(game); }
}

// The lines along the edges of the road, and dashed lines between the lanes: flat quads, made into one mesh once
// (laneMarkingsMesh), so they are drawn at once
LaneLineColor :: Color{235, 235, 225, 255};

laneMarkingRects :: () -> [..]Rectangle {
    DashLength :: 3.0;
    DashPeriod :: 9.0;
    rects: [..]Rectangle;
    for side in [-1.0, 1.0] {
        rects.add(Rectangle{side * (RoadHalfWidth - 0.4) - 0.15, -RoadEnd, 0.3, RoadEnd * 2});
    }
    dashes := (RoadEnd * 2 / DashPeriod) as int;
    for lane in 1..LaneCount {
        x := -RoadHalfWidth + LaneWidth * lane as f32;
        for i in 0..dashes {
            z := -RoadEnd + (i as f32 + 0.5) * DashPeriod;
            rects.add(Rectangle{x - 0.1, z - DashLength * 0.5, 0.2, DashLength});
        }
    }
    return rects;
}

// Flat rectangles of the ground at a height, facing up, as one mesh
flatMesh :: (rects: []Rectangle, y: f32) -> Mesh {
    mesh: Mesh;
    mesh.vertexCount = rects.count as int * 6;
    mesh.triangleCount = rects.count as int * 2;
    mesh.vertices  = MemAlloc((mesh.vertexCount * 3 * sizeof(f32)) as uint) as *f32;
    mesh.normals   = MemAlloc((mesh.vertexCount * 3 * sizeof(f32)) as uint) as *f32;
    mesh.texcoords = MemAlloc((mesh.vertexCount * 2 * sizeof(f32)) as uint) as *f32;
    v := 0;
    for rect in rects {
        corners := [
            Vector2{rect.x, rect.y}, Vector2{rect.x, rect.y + rect.height}, Vector2{rect.x + rect.width, rect.y + rect.height},
            Vector2{rect.x, rect.y}, Vector2{rect.x + rect.width, rect.y + rect.height}, Vector2{rect.x + rect.width, rect.y},
        ];
        for corner in corners {
            mesh.vertices[v * 3] = corner.x;
            mesh.vertices[v * 3 + 1] = y;
            mesh.vertices[v * 3 + 2] = corner.y;
            mesh.normals[v * 3] = 0;
            mesh.normals[v * 3 + 1] = 1;
            mesh.normals[v * 3 + 2] = 0;
            mesh.texcoords[v * 2] = 0;
            mesh.texcoords[v * 2 + 1] = 0;
            v += 1;
        }
    }
    UploadMesh(&mesh, false);
    return mesh;
}

// A light strip on the side of the road where the heroes are going
drawGoalStrip :: (side: Side) {
    width := MapHalfWidth - GoalX;
    center := Vector3{side.sign() * (GoalX + width * 0.5), 0.08, 0};
    DrawCube(center, width, 0.02, MapHalfLength * 2, {255, 240, 150, 40});
    DrawCube(Vector3{side.sign() * GoalX, 0.1, 0}, 0.25, 0.02, MapHalfLength * 2, {255, 240, 150, 160});
}

drawCar :: (game: *Game, assets: *Assets, car: *Car) {
    time := game.time;
    color := car.color;
    if car.frozenLeft > 0 { color = ColorLerp(color, FrozenColor, 0.75); }
    // Backing up (Mira's reverse) or rushing (Hilda's wave)
    lane := game.traffic.lanes[car.lane];
    if lane.paceLeft > 0 && car.kind != .ambulance {
        if lane.pace < 0 { color = ColorLerp(color, ReverseColor, 0.4); }
        else             { color = ColorLerp(color, RushColor, 0.3); }
    }
    if car.hauntedBy >= 0 { color = ColorLerp(color, {190, 210, 255, 255}, 0.5 + 0.2 * math.sinf(time * 8)); }
    // Cars that drive through each other are drawn at slightly different sizes, so their faces don't fight
    scale := 1 + car.layer as f32 * 0.012;
    position := car.position();
    if car.liftedLeft > 0 {
        // Up on Karl's jack: raised, with the jack under it
        lift := LiftHeight * math.min(1, math.min(car.liftedLeft * 3, (LiftTime - car.liftedLeft + 0.01) * 6));
        position.y += lift;
        for k in [-1.0, 1.0] {
            foot := car.position() + Vector3{0, 0, k * car.length() * 0.25};
            DrawCube(foot + Vector3{0, 0.15, 0}, 1.2, 0.3, 0.8, {200, 40, 30, 255});
            DrawCylinderEx(foot + Vector3{0, 0.3, 0}, foot + Vector3{0, lift + 0.2, 0}, 0.18, 0.18, 6, {120, 120, 130, 255});
        }
    }
    assets.drawVehicle(car.kind, position, color, scale);
    if car.kind == .ambulance { drawEmergencyLights(assets, car, time); }

    if car.frozenLeft > 0 {
        // A shell of ice
        DrawCube(car.position() + Vector3{0, car.height() * 0.5 + 0.2, 0}, CarWidth + 0.5, car.height() + 0.6, car.length() + 0.5, {200, 240, 255, 70});
    }

    if car.isBraking {
        // Brake lights at the back, which faces the far end of the road
        back := car.position() + Vector3{0, 1.1, -car.length() * 0.5 - 0.05};
        for side in [-1.0, 1.0] {
            assets.drawBox(back + Vector3{side * (CarWidth * 0.5 - 0.6), 0, 0}, {0.8, 0.35, 0.15}, {255, 40, 30, 255});
        }
    }
}

ReverseColor :: Color{150, 110, 230, 255};
RushColor    :: Color{255, 220, 80, 255};

// Hilda's stop sign where she raised it, and a stop line across the lanes it stops
drawStopSign :: (assets: *Assets, sign: StopSign) {
    left  := laneCenter(sign.lanes[0]) - LaneWidth * 0.5;
    right := laneCenter(sign.lanes[1]) + LaneWidth * 0.5;
    fade := math.min(1, sign.timeLeft * 2);
    DrawCube({(left + right) * 0.5, 0.11, sign.line}, right - left, 0.02, 0.6, ColorAlpha(White, 0.9 * fade));
    DrawCube({(left + right) * 0.5, 0.1, sign.line - 1.5}, right - left, 0.02, 2.4, ColorAlpha({255, 60, 50, 255}, 0.25 * fade));

    // A post with a red octagon on it, facing the cars
    base := Vector3{sign.position.x + 1.6, 0, sign.position.z - 1.2};
    assets.drawBox(base + Vector3{0, 2.2, 0}, {0.18, 4.4, 0.18}, {200, 200, 205, 255});
    top := base + Vector3{0, 4.6, 0};
    DrawCylinderEx(top + Vector3{0, 0, -0.12}, top + Vector3{0, 0, 0.0}, 1.25, 1.25, 8, White);
    DrawCylinderEx(top + Vector3{0, 0, -0.2}, top + Vector3{0, 0, -0.1}, 1.08, 1.08, 8, {205, 30, 35, 255});
}

drawHero :: (assets: *Assets, game: *Game, index: int) {
    player := &game.players[index];
    hero := &player.hero;
    info := hero.info();
    isYou := index == game.watched;

    // In the pose of its clip, when its model has them: then the walk does its own bobbing
    animated := assets.poseHero(game, hero);

    // Bobbing while walking, jumping when across
    bob: f32 = 0;
    if (hero.isMoving || hero.hook.hasValue()) && !animated { bob = math.fabsf(math.sinf(hero.walkCycle)) * 0.35; }
    if player.phase.kind == .crossed         { bob = math.fabsf(math.sinf(hero.walkCycle)) * 2.2; }
    if hero.walksThroughWalls()             { bob = 0.6 + math.sinf(GetTime() as f32 * 3) * 0.25; }
    if hero.leap.hasValue()                 { bob = math.sinf(hero.leap.value().flight * Pi) * hero.leap.value().height; }
    if hero.isStopped()                     { bob = 0; }
    bob += game.rideHeight(hero) + game.bridgeHeightAt(hero.ground());

    // A shadow that stays on the ground, and a circle in the color of the player. Yours is thicker
    shadow := info.width * 0.55 * (1 - bob / (LeapHeight * 2));
    DrawCylinder(hero.position + Vector3{0, 0.12, 0}, shadow, shadow, 0.02, 16, ShadowColor);
    ring := info.width * 0.85;
    ringColor := ColorAlpha(player.color, 0.85);
    DrawCircle3D(hero.position + Vector3{0, 0.18, 0}, ring, {1, 0, 0}, 90, ringColor);
    DrawCircle3D(hero.position + Vector3{0, 0.18, 0}, ring * 0.94, {1, 0, 0}, 90, ringColor);
    if isYou { DrawCircle3D(hero.position + Vector3{0, 0.18, 0}, ring * 0.88, {1, 0, 0}, 90, ringColor); }

    tint := White;
    if hero.walksThroughWalls() { tint.a = 150; }      // Ghosty is see-through
    if hero.isFaded()           { tint.a = 70; }       // and more so when he fades
    if hero.has(.timeLock)      { tint = {200, 160, 255, 255}; }
    if hero.has(.frozen)        { tint = {165, 220, 255, 255}; }       // Frozen by Frosty
    if hero.has(.trance)        { tint = {215, 175, 255, 150}; }       // Hugo, half there
    if hero.has(.berserk)       { tint = {255, 165, 140, 255}; }       // Ivar, seeing red
    if hero.isBlended() || hero.inShadow { tint.a = 110; }
    if hero.possess.hasValue() {
        // In the car: only a wisp over its roof
        return;
    } else if hero.has(.igloo) {
        drawIgloo(hero);
    } else if hero.has(.hex) {
        drawToad(hero.position + Vector3{0, bob, 0}, hero.facing, game.time);
    } else {
        assets.drawHero(hero.kind, hero.position + Vector3{0, bob, 0}, hero.facing, tint, hero.hook.hasValue());
    }
    drawHeroExtras(game, index, bob);

    // Stunned: stars going round over the head. Locked in time: a clock face over it
    top := hero.position + Vector3{0, info.height + 0.6, 0};
    if hero.has(.timeLock) {
        DrawCylinderEx(top, top + Vector3{0, 0.1, 0}, 1.2, 1.2, 20, {230, 210, 255, 200});
        angle := -GetTime() as f32 * 6;
        DrawCylinderEx(top + Vector3{0, 0.12, 0}, top + Vector3{math.sinf(angle) * 0.9, 0.12, math.cosf(angle) * 0.9}, 0.08, 0.08, 4, {60, 30, 90, 255});
    } else if hero.has(.stun) {
        for k in 0..3 {
            angle := GetTime() as f32 * 5 + k as f32 * Pi * 2 / 3;
            DrawSphere(top + Vector3{math.sinf(angle) * 0.9, 0, math.cosf(angle) * 0.9}, 0.22, {255, 230, 90, 255});
        }
    }

    // The hook flies from the butcher's hand, with its chain, and drags back an enemy it caught
    if hero.hook.hasValue() {
        hook := hero.hook.value();
        forward := Vector3{math.sinf(hero.facing), 0, math.cosf(hero.facing)};
        right   := Vector3{forward.z, 0, -forward.x};
        hand := assets.heroHand(hero.kind, hero.position + Vector3{0, bob, 0}, hero.facing) ?? (hero.position + Vector3{0, 1.5 + bob, 0} + forward * 1.3 - right * 1.45);
        head := game.hookHead(hook, hand);
        // Flying out and back, it is drawn from the hand that throws it rather than from where he stood when he threw it
        if hook.car < 0 { head = hand.lerp(hook.point + Vector3{0, 1.2, 0}, hook.flight); }
        drawMeatHook(assets, hand, head, hook.car >= 0);
    }
}

// The meat hook on its chain: heavy links from the butcher's hand to the hook, which points on along the chain, with
// blood on its point once it has caught someone
drawMeatHook :: (assets: *Assets, hand: Vector3, head: Vector3, caught: bool) {
    along := head - hand;
    length := along.length();
    if length < 0.01 { return; }
    forward := along / length;
    side := Vector3Normalize(Vector3CrossProduct({0, 1, 0}, forward));
    if side.length() < 0.5 { side = {1, 0, 0}; }
    up := Vector3CrossProduct(forward, side);

    // The links, each a quarter turned from the one before so they hang in each other, stretched a little so a whole
    // number of them reaches the ring of the hook
    LinkPitch :: 0.6;               // How far apart links are on the chain, where they hold each other
    ChainScale :: 1.25;             // How much bigger than in the model they are drawn
    pitch := LinkPitch * ChainScale;
    reach := math.max(length - 0.45, 0.1);
    links := math.max(1, math.roundf(reach / pitch) as int);
    stretch := reach / (links as f32 * pitch);
    for k in 0..links {
        at := hand + forward * ((k as f32 + 0.5) * pitch * stretch);
        if k % 2 == 0 { drawModelFacing(assets.chainLink, at, side * ChainScale, up * ChainScale, forward * ChainScale * stretch); }
        else          { drawModelFacing(assets.chainLink, at, up * ChainScale, side * -ChainScale, forward * ChainScale * stretch); }
    }

    // The hook: its ring at the head, the shank on along the chain, and the curve bending round to the side, lying flat
    // so it reads as a hook from the camera above
    drawModelFacing(assets.meatHook, head, side, up, forward);
    if caught { DrawSphere(head + forward * 1.3 + side * 1.85 - up * 0.1, 0.22, {150, 15, 20, 255}); }
}


// The reach of an ability while the mouse is on its icon, and the chill aura all the time
drawAbilityHints :: (game: *Game) {
    hero := &game.you().hero;
    ground := hero.ground();

    aura := hero.chillAura();
    if aura.hasValue() {
        DrawCircle3D(ground.at(0.15), aura.value().radius, {1, 0, 0}, 90, {170, 230, 255, 60});
    }

    abilities := hero.abilities();

    // Where a rewind would take her: a faint copy of her, there
    for ability, slot in abilities {
        if ability.bot != .rewind || !hero.abilityReady(slot as int) { continue; }
        back := hero.rewindSample(ability.duration);
        if !back.hasValue() || Vector3Distance(back.value().position, hero.position) < 1.5 { continue; }
        DrawCircle3D(back.value().position + Vector3{0, 0.16, 0}, hero.info().width * 0.6, {1, 0, 0}, 90, {120, 220, 255, 140});
    }

    shown := game.hoveredAbility;
    if shown < 0 { shown = game.aiming; }
    if shown < 0 || shown >= abilities.count { return; }

    reach := abilities[shown].shownReach();
    if abilities[shown].range > 0 { reach = hero.reach(reach); }
    if reach > 0 {
        DrawCircle3D(ground.at(0.15), reach, {1, 0, 0}, 90, {255, 255, 255, 90});
        DrawCircle3D(ground.at(0.15), reach - 0.15, {1, 0, 0}, 90, {255, 255, 255, 90});
    }
}

drawHitboxes :: (game: *Game) {
    for *car in game.traffic.cars {
        if !car.isActive { continue; }
        rect := car.rect();
        DrawCubeWires(rect.center().at(0.2), rect.width, 0.1, rect.height, Red);
    }
    for wall in game.world.walls {
        DrawCubeWires(wall.center().at(0.2), wall.width, 0.1, wall.height, Orange);
    }
    for player in game.players {
        hero := player.hero;
        DrawCircle3D(hero.position + Vector3{0, 0.2, 0}, hero.info().hitRadius, {1, 0, 0}, 90, Lime);
        if hero.isMoving {
            DrawSphere(hero.target, 0.3, Lime);
        }
    }
}

// Three functions of rlgl, the layer under raylib, for the wireframes of F1 and the depth range. raylib.dll has them
extern "raylib.dll" {
    rlEnableWireMode  :: () -> void;
    rlDisableWireMode :: () -> void;
    rlSetClipPlanes   :: (near: f64, far: f64) -> void;
}

// Bent knows the timetable: a lane lights up at the far end of the field before its next car comes
drawTimetable :: (game: *Game) {
    if !game.you().hero.stats.timetable || !game.you().isPlaying() { return; }
    Soon :: 1.5;
    for lane, i in game.traffic.lanes {
        if lane.spawnTimer > Soon { continue; }
        alpha := 1 - lane.spawnTimer / Soon;
        x := laneCenter(i as int);
        DrawCube({x, 0.1, -MapHalfLength + 6}, LaneWidth * 0.7, 0.02, 12, ColorAlpha({255, 200, 60, 255}, 0.45 * alpha));
        DrawCube({x, 0.11, -MapHalfLength + 1}, LaneWidth * 0.8, 0.02, 0.6, ColorAlpha({255, 230, 120, 255}, alpha));
    }
}
