namespace core;

// The ways a hero moves besides walking, and what the world gets built on it: riding on a car (Bent), dashing (Mads),
// getting out of the way of a car by itself (Spring Shoes, Kenji's roll, the talent nimble), and footbridges over the road
// (Birgit). Leaps and hooks are in heroes.sd and heroes/butcher.sd

import math;
use raylib;

//
// Riding a car
//

RideHopOff :: 4.5;      // How far towards the goal it jumps off the car

// Gets onto the roof of a car, for a while
startRide :: method (game: *Game, index: int, car: int, duration: f32) {
    hero := &game.players[index].hero;
    target := &game.traffic.cars[car];
    hero.ride = RideState{car: car, timeLeft: duration, offset: math.clamp(hero.position.z - target.z, -target.length() * 0.3, target.length() * 0.3)};
    hero.stop();
    hero.hook = null;
    game.effects.particles.emit(.dust, hero.position, 10);
}

rideCar :: method (game: *Game, index: int, dt: f32) {
    hero := &game.players[index].hero;
    ride := hero.ride.value();
    car := &game.traffic.cars[ride.car];
    ride.timeLeft -= dt;
    if !car.isActive || ride.timeLeft <= 0 || math.fabsf(car.z) > MapHalfLength - 2 {
        game.hopOff(index);
        return;
    }
    hero.position = Vector3{car.x(), 0, car.z + ride.offset};
    hero.walkCycle += dt * 2;
    hero.ride = ride;
}

// Jumps off the car, towards the goal
hopOff :: method (game: *Game, index: int) {
    hero := &game.players[index].hero;
    if !hero.ride.hasValue() { return; }
    car := game.traffic.cars[hero.ride.value().car];
    hero.ride = null;
    to := hero.ground() + Vector2{hero.goalSign * RideHopOff, 0};
    to.y = math.clamp(to.y, -MapHalfLength + 2, MapHalfLength - 2);
    hero.startLeap(to, 0.45, 2.5 + car.height());
}

// How high a hero rides, on the roof of its car
rideHeight :: method (game: *Game, hero: *Hero) -> f32 {
    if !hero.ride.hasValue() { return 0; }
    return game.traffic.cars[hero.ride.value().car].height();
}

//
// Dashing
//

moveDash :: method (game: *Game, index: int, dt: f32) {
    hero := &game.players[index].hero;
    dash := hero.dash.value();
    dash.timeLeft -= dt;
    before := hero.position;
    hero.position += dash.velocity.at() * dt;
    hero.position = game.world.resolveCollisions(hero.ground(), hero.info().hitRadius, hero.walksThroughWalls()).at();
    hero.walkCycle += dt * 8;
    if dash.timeLeft <= 0 || Vector3Distance(before, hero.position) < dash.velocity.length() * dt * 0.2 {
        hero.dash = null;
        hero.stop();
        return;
    }
    hero.dash = dash;
}

//
// What some traits do over time
//

NearMissReach :: 1.0;      // How near a car must pass to be a near miss (the trait adrenaline)
NearMissEvery :: 8.0;

updateTraitsOverTime :: method (game: *Game, index: int, dt: f32) {
    hero := &game.players[index].hero;

    // Ditte's bandage heals while she stands still, and stops when she walks
    if hero.has(.mending) {
        if hero.isMoving { hero.clearStatus(.mending); }
        else { hero.health = math.min(hero.maxHealth(), hero.health + hero.maxHealth() * hero.status(.mending).amount * dt); }
    }
}

// A car only just missed a hero with Adrenaline: its abilities are ready again
nearMiss :: method (game: *Game, index: int) {
    hero := &game.players[index].hero;
    if !hero.stats.adrenaline || hero.nearMissLeft > 0 || hero.carsPass() { return; }
    car := game.traffic.carHitting(hero.ground(), hero.info().hitRadius + NearMissReach);
    if !car.hasValue() || car.value().speed < 2 { return; }
    hero.nearMissLeft = NearMissEvery;
    game.readyAbilities(index);
    game.announce(index, {255, 120, 90, 255}, "That was close! % is ready again", game.players[index].name);
}

// An enemy was run over: the heroes with Bloodlust near it are ready again, and heal
feedBloodlust :: method (game: *Game, victim: int) {
    where := game.players[victim].hero.ground();
    for *player, i in game.players {
        if i as int == victim || !player.isPlaying() || !player.hero.stats.bloodlust { continue; }
        if player.hero.ground().distance(where) > BloodlustReach { continue; }
        player.hero.health = math.min(player.hero.maxHealth(), player.hero.health + player.hero.maxHealth() * 0.2);
        game.readyAbilities(i as int);
    }
}

//
// Out of the way of a car, by itself
//

NimbleCooldown :: 20.0;

// A car is on the hero: true when something got it out of the way instead of being hit
dodgedCar :: method (game: *Game, index: int, car: *Car) -> bool {
    if game.bounced(index) { return true; }
    hero := &game.players[index].hero;
    if hero.isAirborne() || hero.displacement.hasValue() { return false; }

    // Out of the lane, to the nearer side of it
    side: f32 = 1;
    if hero.position.x < car.x() { side = -1; }
    out := Vector2{car.x() + side * (CarWidth * 0.5 + hero.info().hitRadius + 1.2), hero.position.z};

    if game.substitute(index) { return true; }
    if hero.stats.nimble && hero.nimbleLeft <= 0 {
        hero.nimbleLeft = NimbleCooldown;
        hero.startLeap(out, 0.3, 1.5);
        game.effects.particles.emit(.dust, hero.position, 10);
        return true;
    }
    return false;
}

//
// Footbridges, that Birgit builds over the road. Anyone on one is safe from the cars under it
//

Bridge :: struct {
    center:     Vector2;
    halfWidth:  f32;        // Across the road
    halfLength: f32;        // Along it
    timeLeft:   f32;
    age:        f32;
    owner:      int;
}

BridgeHeight   :: 3.0;
BridgeRaiseTime :: 0.35;    // Seconds it takes to go up, before it is safe

bridgeRect :: method (bridge: Bridge) -> Rectangle {
    return {bridge.center.x - bridge.halfWidth, bridge.center.y - bridge.halfLength, bridge.halfWidth * 2, bridge.halfLength * 2};
}

// On a footbridge that is up
onBridge :: method (game: *Game, point: Vector2) -> bool {
    for bridge in game.bridges {
        if bridge.age >= BridgeRaiseTime && CheckCollisionPointRec(point, bridge.bridgeRect()) { return true; }
    }
    return false;
}

updateBridges :: method (game: *Game, dt: f32) {
    for *bridge in game.bridges {
        bridge.timeLeft -= dt;
        bridge.age += dt;
    }
    game.bridges.removeWhere(bridge => bridge.timeLeft <= 0);
}

// The height of the deck over a point: up on the ramps, flat over the lanes
bridgeHeightAt :: method (game: *Game, point: Vector2) -> f32 {
    for bridge in game.bridges {
        if !CheckCollisionPointRec(point, bridge.bridgeRect()) { continue; }
        rise := math.min(bridge.age / BridgeRaiseTime, 1);
        edge := bridge.halfWidth - math.fabsf(point.x - bridge.center.x);
        return BridgeHeight * rise * math.clamp(edge / RampLength, 0, 1);
    }
    return 0;
}

RampLength :: 2.5;

// The models of tools/make_heroes.py: a span for each lane, and a ramp at each end with the scaffold under the deck's
// edge. It grows up out of the road as it is raised, and sinks back into it at the end
drawBridges :: (game: *Game, assets: *Assets) {
    for bridge in game.bridges {
        rise := math.min(bridge.age / BridgeRaiseTime, 1);
        sink := math.min(bridge.timeLeft / 0.4, 1);
        tall := rise * sink;
        deep := bridge.halfLength / BridgeModelHalfLength;
        flat := bridge.halfWidth - RampLength;
        lanes := math.max((flat * 2 / LaneWidth + 0.5) as int, 1);
        span := flat * 2 / lanes as f32;
        for i in 0..lanes {
            x := bridge.center.x - flat + span * (i as f32 + 0.5);
            DrawModelEx(assets.footbridgeSpan, {x, 0, bridge.center.y}, {0, 1, 0}, 0, {span / LaneWidth, tall, deep}, White);
        }
        DrawModelEx(assets.footbridgeRamp, {bridge.center.x + flat, 0, bridge.center.y}, {0, 1, 0}, 0, {1, tall, deep}, White);
        DrawModelEx(assets.footbridgeRamp, {bridge.center.x - flat, 0, bridge.center.y}, {0, 1, 0}, 180, {1, tall, deep}, White);
    }
}

BridgeModelHalfLength :: 2.2;       // How deep the models of the footbridge are made, half of it

extern "raylib.dll" {
    rlPushMatrix :: () -> void;
    rlPopMatrix  :: () -> void;
    rlTranslatef :: (x: f32, y: f32, z: f32) -> void;
    rlRotatef    :: (angle: f32, x: f32, y: f32, z: f32) -> void;
}
