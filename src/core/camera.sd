namespace core;

import math;
use raylib;

// A camera like in an RTS: it looks down at a point on the ground from a fixed angle. It follows the hero, and the wheel
// zooms. Unlocked (Y), the point moves with the arrow keys or the mouse at the edge of the window, and space brings it
// back to the hero while held

RtsCamera :: struct {
    focus:          Vector3;
    distance:       f32 = 90;
    targetDistance: f32 = 90;
    isLocked:       bool = true;    // Follows the hero
    takesKeys:      bool = true;
    mouseMoved:     bool;           // Edge scrolling waits for the mouse to move, so it doesn't pan before anyone touched it    // Arrows pan and the wheel zooms. Not while the console has the keyboard
    shake:          f32;            // Seconds of shaking left
    view:           Camera3D;
}

CameraPitch       :: 1.05;          // Radians above the ground: about 60 degrees
CameraMinDistance :: 35.0;
CameraMaxDistance :: 170.0;
CameraPanSpeed    :: 70.0;
CameraEdgeMargin  :: 6;             // Pixels from the edge of the window that pan the camera

newRtsCamera :: (focus: Vector3) -> RtsCamera {
    camera := RtsCamera{focus: Vector3{focus.x, 0, focus.z}};
    camera.view = Camera3D{up: {0, 1, 0}, fovy: 45, projection: .perspective};
    camera.place(0);
    return camera;
}

update :: method (camera: *RtsCamera, dt: f32, hero: Vector3, recenter: bool) {
    // Zoom
    wheel: f32 = 0;
    if camera.takesKeys { wheel = GetMouseWheelMove(); }
    if wheel != 0 {
        camera.targetDistance = math.clamp(camera.targetDistance - wheel * 10, CameraMinDistance, CameraMaxDistance);
    }
    camera.distance = math.lerp(camera.distance, camera.targetDistance, math.min(1, dt * 10));

    if camera.isLocked || recenter {
        camera.focus = camera.focus.lerp(Vector3{hero.x, 0, hero.z}, math.min(1, dt * 8));
    } else {
        pan := Vector2{0, 0};
        if camera.takesKeys {
            if IsKeyDown(.left)  { pan.x -= 1; }
            if IsKeyDown(.right) { pan.x += 1; }
            if IsKeyDown(.up)    { pan.y -= 1; }
            if IsKeyDown(.down)  { pan.y += 1; }
        }

        // The mouse at the edge of the window, when the window has it
        delta := GetMouseDelta();
        if delta.x != 0 || delta.y != 0 { camera.mouseMoved = true; }
        if camera.mouseMoved && IsWindowFocused() && IsCursorOnScreen() {
            mouse := GetMousePosition();
            if mouse.x < CameraEdgeMargin                     { pan.x -= 1; }
            if mouse.x > GetScreenWidth() - CameraEdgeMargin  { pan.x += 1; }
            if mouse.y < CameraEdgeMargin                     { pan.y -= 1; }
            if mouse.y > GetScreenHeight() - CameraEdgeMargin { pan.y += 1; }
        }

        if pan.lengthSqr() > 0 {
            // Faster when zoomed out
            speed := CameraPanSpeed * (camera.distance / 100);
            move := pan.normalize() * (speed * dt);
            camera.focus.x = math.clamp(camera.focus.x + move.x, -MapHalfWidth, MapHalfWidth);
            camera.focus.z = math.clamp(camera.focus.z + move.y, -MapHalfLength, MapHalfLength);
        }
    }

    camera.place(dt);
}

// Puts the camera where it looks at its focus from
place :: method (camera: *RtsCamera, dt: f32) {
    offset := Vector3{0, math.sinf(CameraPitch), math.cosf(CameraPitch)} * camera.distance;

    shake := Vector3{0, 0, 0};
    if camera.shake > 0 {
        camera.shake -= dt;
        strength := camera.shake * 2;
        time := GetTime() as f32;
        shake = Vector3{math.sinf(time * 61) * strength, 0, math.cosf(time * 47) * strength};
    }

    camera.view.target   = camera.focus + shake;
    camera.view.position = camera.focus + offset + shake;
}

// The point on the ground under a point of the window, e.g the mouse
groundPoint :: method (camera: *RtsCamera, screen: Vector2) -> ?Vector3 {
    ray := GetScreenToWorldRay(screen, camera.view);
    if math.fabsf(ray.direction.y) < 0.0001 { return null; }

    t := -ray.position.y / ray.direction.y;
    if t < 0 { return null; }
    return ray.position + ray.direction * t;
}

// What the camera sees: a pyramid from the camera along its view, as wide as the window. Things outside of it aren't
// drawn
ViewFrustum :: struct {
    position: Vector3;
    forward:  Vector3;
    right:    Vector3;
    up:       Vector3;
    tanX:     f32;          // How far it spreads to each side, and up and down, for each step forward
    tanY:     f32;
    secX:     f32;          // How much further a sphere reaches across its side than its radius
    secY:     f32;
}

frustum :: method (camera: *RtsCamera) -> ViewFrustum {
    view := camera.view;
    f: ViewFrustum;
    f.position = view.position;
    f.forward = (view.target - view.position).normalize();
    f.right = f.forward.cross(view.up).normalize();
    f.up = f.right.cross(f.forward);
    f.tanY = math.tanf(view.fovy * Deg2Rad * 0.5);
    f.tanX = f.tanY * GetScreenWidth() as f32 / math.max(GetScreenHeight(), 1) as f32;
    f.secY = math.sqrtf(1 + f.tanY * f.tanY);
    f.secX = math.sqrtf(1 + f.tanX * f.tanX);
    return f;
}

// Whether any of a sphere is in view
sees :: method (f: *ViewFrustum, center: Vector3, radius: f32) -> bool {
    d := center - f.position;
    z := d.dot(f.forward);
    if z < -radius { return false; }
    if math.fabsf(d.dot(f.right)) > z * f.tanX + radius * f.secX { return false; }
    if math.fabsf(d.dot(f.up)) > z * f.tanY + radius * f.secY { return false; }
    return true;
}
