namespace core;

import math;
import random;
use raylib;

// The city around the motorway: on the pavement on both sides, street lamps along the walls, trees in planters, benches,
// hydrants and bins; past the field, blocks of buildings with streets between them. It is only for the eye: nothing walks
// into it. The models are made by tools/make_models.py city

SceneryKind :: enum {
    office,
    brick,
    shop,
    tower,
    lamp,
    tree,
    bench,
    hydrant,
    bin,
}

SceneryModels :: ["building_office", "building_brick", "building_shop", "building_tower", "lamp", "tree", "bench", "hydrant", "bin"];

Decoration :: struct {
    kind:     SceneryKind;
    position: Vector3;
    angle:    f32;          // Degrees around y
    size:     Vector3;      // Times the model, e.g a building that is taller
}

// How tall and wide each model is, about: for the sphere around a decoration, which isn't drawn when it is out of view
@private
modelExtent :: (kind: SceneryKind) -> Vector2 {
    return switch kind {
        case .office  => Vector2{BuildingSize, 34};
        case .brick   => Vector2{BuildingSize, 17};
        case .shop    => Vector2{BuildingSize, 10};
        case .tower   => Vector2{BuildingSize, 51};
        case .lamp    => Vector2{5, 7};
        case .tree    => Vector2{5, 7};
        case .bench   => Vector2{2.5, 1.2};
        case .hydrant => Vector2{1, 1.2};
        case .bin     => Vector2{1, 1.2};
    };
}

// The sphere around it: its middle, and its radius
bounds :: method (decoration: Decoration) -> Vector3, f32 {
    extent := modelExtent(decoration.kind);
    width := extent.x * math.max(decoration.size.x, decoration.size.z);
    height := extent.y * decoration.size.y;
    radius := math.sqrtf(width * width * 0.5 + height * height * 0.25);
    return decoration.position + Vector3{0, height * 0.5, 0}, radius;
}

BlockSize   :: 40.0;        // A block of the city: four buildings with room between them
StreetWidth :: 14.0;
CityReach   :: 280.0;       // How far across the city goes
CityLength  :: 260.0;       // and along the road

newScenery :: (seed: u64) -> [..]Decoration {
    rng := random.newRandom(seed);
    scenery: [..]Decoration;

    add :: (scenery: *[..]Decoration, kind: SceneryKind, x: f32, z: f32, angle: f32, size: Vector3) {
        scenery.add(Decoration{kind: kind, position: {x, 0, z}, angle: angle, size: size});
    };

    // On the pavement of both sides of the road
    pavement := RoadHalfWidth + WallWidth;
    for side in [-1.0, 1.0] {
        // Lamps along the walls, their arms over the road
        lampAngle: f32 = 0;
        if side > 0 { lampAngle = 180; }
        z := -MapHalfLength + 6;
        while z < MapHalfLength {
            add(&scenery, .lamp, side * (pavement + 1.5), z, lampAngle, {1, 1, 1});
            z += 18;
        }
        // Trees in planters along the far edge, with benches between some of them
        z = -MapHalfLength + 4;
        while z < MapHalfLength {
            add(&scenery, .tree, side * (MapHalfWidth - 3), z, rng.uniform(0, 360) as f32, {1, 1, 1} *rng.uniform(0.85, 1.2) as f32);
            if rng.chance(0.5) { add(&scenery, .bench, side * (MapHalfWidth - 3), z + 7, 90 * -side, {1, 1, 1}); }
            z += 14;
        }
        // Hydrants and bins here and there
        for 0..6 {
            kind := SceneryKind.hydrant;
            if rng.chance(0.5) { kind = .bin; }
            add(&scenery, kind, side * rng.uniform(pavement + 4, MapHalfWidth - 6) as f32, rng.uniform(-MapHalfLength, MapHalfLength) as f32,
                rng.uniform(0, 360) as f32, {1, 1, 1});
        }
    }

    // The blocks of the city past the field: four buildings each, of any kind and height, turned any way
    kinds := [SceneryKind.office, SceneryKind.brick, SceneryKind.brick, SceneryKind.shop, SceneryKind.tower];
    lot := (BlockSize - StreetWidth) * 0.5;      // The room of one building
    for side in [-1.0, 1.0] {
        x := MapHalfWidth + StreetWidth * 0.5;
        while x < CityReach {
            z := -CityLength;
            while z < CityLength {
                for k in 0..4 {
                    cx := side * (x + StreetWidth * 0.5 + lot * ((k % 2) as f32 + 0.5));
                    cz := z + StreetWidth * 0.5 + lot * ((k / 2) as f32 + 0.5);
                    kind := rng.choice(kinds);
                    width := lot / BuildingSize * rng.uniform(0.82, 0.96) as f32;
                    height := rng.uniform(0.6, 1.35) as f32;
                    add(&scenery, kind, cx, cz, (rng.between(0, 3) * 90) as f32, {width, height, width});
                }
                z += BlockSize;
            }
            x += BlockSize;
        }
    }
    return scenery;
}

BuildingSize :: 16.0;       // The footprint of the models of the buildings (tools/make_models.py)

// The pavement of each block of the city, raised a little from the streets around it
cityBlocks :: () -> [..]Rectangle {
    blocks: [..]Rectangle;
    for side in [-1.0, 1.0] {
        x := MapHalfWidth + StreetWidth * 0.5;
        while x < CityReach {
            z := -CityLength;
            while z < CityLength {
                left := x + StreetWidth * 0.5;
                if side < 0 { left = -(x + BlockSize - StreetWidth * 0.5); }
                blocks.add(Rectangle{left, z + StreetWidth * 0.5, BlockSize - StreetWidth, BlockSize - StreetWidth});
                z += BlockSize;
            }
            x += BlockSize;
        }
    }
    return blocks;
}
