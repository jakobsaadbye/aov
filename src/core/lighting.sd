namespace core;

use raylib;

// The sun: a directional light with a bit of shine, plus ambient light, and a haze in the distance. The shader is
// data/shaders/lighting.vs and lighting.fs

Lighting :: struct {
    shader:       Shader;
    viewPosition: int;          // The location of the uniform of the camera position
}

SunDirection :: Vector3{-0.45, -1, -0.35};
SunColor     :: Vector3{1.0, 0.95, 0.85};
AmbientColor :: Vector3{0.42, 0.45, 0.52};
HazeColor    :: Vector3{0.36, 0.46, 0.38};

newLighting :: () -> Lighting {
    vsPath := dataPath("shaders/lighting.vs");
    fsPath := dataPath("shaders/lighting.fs");
    defer vsPath.free();
    defer fsPath.free();
    shader := LoadShader(vsPath, fsPath);

    // DrawMesh sets these when the shader has them
    shader.locs[ShaderLocationIndex.shaderLocMatrixModel as int]  = GetShaderLocation(shader, "matModel");
    shader.locs[ShaderLocationIndex.shaderLocMatrixNormal as int] = GetShaderLocation(shader, "matNormal");

    lighting := Lighting{shader: shader, viewPosition: GetShaderLocation(shader, "viewPos")};
    lighting.setVector("sunDirection", SunDirection.normalize());
    lighting.setVector("sunColor", SunColor);
    lighting.setVector("ambientColor", AmbientColor);
    lighting.setVector("hazeColor", HazeColor);
    return lighting;
}

setVector :: method (lighting: *Lighting, name: string, value: Vector3) {
    cName := name.toCString();
    defer cName.free();
    SetShaderValue(lighting.shader, GetShaderLocation(lighting.shader, cName), &value, .vec3);
}

// Once a frame, before drawing, for the shine and the haze
setCamera :: method (lighting: *Lighting, camera: Camera3D) {
    position := camera.position;
    SetShaderValue(lighting.shader, lighting.viewPosition, &position, .vec3);
}

// A material that is lit by the sun, in a color
newMaterial :: method (lighting: *Lighting, color: Color) -> Material {
    material := LoadMaterialDefault();
    material.shader = lighting.shader;
    material.maps[MaterialMapIndex.materialMapAlbedo as int].color = color;
    return material;
}

// A model of the data folder, e.g models/car.obj, with all of its materials lit by the sun
loadModel :: method (lighting: *Lighting, file: string) -> Model {
    path := dataPath(file);
    defer path.free();
    model := LoadModel(path);
    for i in 0..model.materialCount {
        model.materials[i].shader = lighting.shader;
    }
    return model;
}

unload :: method (lighting: *Lighting) {
    UnloadShader(lighting.shader);
}
