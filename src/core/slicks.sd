namespace core;

// Oil: now and then a car leaks for a moment, and leaves a trail of black, glossy blobs behind it on its lane. A hero
// that walks onto the oil slides: it keeps the way and the speed it had, a bit faster, and can't turn until it is off
// the oil again. Walk around it, or cross it on purpose, in a straight line. The cars drive over it. After a while it
// dries up.

import math;
import random;
use raylib;

// A blob of oil: round, with an edge that isn't. It spreads out over its first moment
Slick :: struct {
    center:   Vector2;
    radius:   f32;
    seed:     f32;          // The shape of its edge
    timeLeft: f32;
    age:      f32;          // Below 0 while it is still flying, thrown (Karl's oil): it lands at 0
    boost:    f32 = 1.15;   // Times the speed of a hero that slides onto it: SlideSpeedUp for a leak
    from:     Vector3;      // Where it was thrown from

    hasLanded :: method () -> bool {
        return self.age >= 0;
    }

    // How far it has spread, 0 to 1
    spread :: method () -> f32 {
        if self.age < 0 { return 0; }
        t := math.min(self.age / SpreadTime, 1);
        return 1 - (1 - t) * (1 - t) * (1 - t);
    }

    contains :: method (point: Vector2) -> bool {
        return self.hasLanded() && point.distance(self.center) <= self.radius * 0.95 * self.spread();
    }
}

SpreadTime :: 0.3;          // Seconds a blob takes to spread out

MaxSlicks     :: 40;        // Blobs on the road at once. The oldest dries up when there are more
LeakEveryLow  :: 12.0;      // Seconds between two cars that leak, at random between these
LeakEveryHigh :: 24.0;
LeakTimeLow   :: 0.7;       // Seconds a car leaks
LeakTimeHigh  :: 1.4;
LeakDrop      :: 0.22;      // Seconds between two blobs of a leaking car
SlickLifeLow  :: 45.0;      // Seconds a blob lies on the road
SlickLifeHigh :: 70.0;
SlideTime     :: 0.6;       // Seconds a hero slides each time, again and again while it is on the oil
SlideSpeedUp  :: 1.15;      // Times the speed it had

Slicks :: struct {
    list:   [..]Slick;
    nextIn: f32 = 6;        // Seconds to the next car that leaks
    rng:    random.Random;
}

newSlicks :: (seed: u64) -> Slicks {
    return Slicks{rng: random.newRandom(seed ^ 0x5117c)};
}

updateSlicks :: method (game: *Game, dt: f32) {
    slicks := &game.slicks;
    for *slick in slicks.list {
        flying := !slick.hasLanded();
        slick.age += dt;
        slick.timeLeft -= dt;
        // Thrown oil lands with a splash
        if flying && slick.hasLanded() {
            game.effects.particles.emit(.oilSplash, slick.center.at(0.3), 60, tint: White);
            game.sounds.playAt("ability.oil_splat", slick.center.at(0), 0.9, 0.08);
        }
    }
    slicks.list.removeWhere(slick => slick.timeLeft <= 0);

    // The cars that leak drop a blob now and then, behind them
    for *car in game.traffic.cars {
        if !car.isActive || car.leakLeft <= 0 { continue; }
        car.leakLeft -= dt;
        car.leakTimer -= dt;
        if car.leakTimer > 0 { continue; }
        car.leakTimer = LeakDrop;
        back := Vector2{car.x() + slicks.rng.uniform(-0.6, 0.6) as f32, car.z - car.length() * 0.5};
        if math.fabsf(back.y) < MapHalfLength { game.addSlick(back, slicks.rng.uniform(1.4, 2.1) as f32); }
    }

    // Now and then a car on the field starts to leak
    slicks.nextIn -= dt;
    if slicks.nextIn > 0 { return; }
    slicks.nextIn = slicks.rng.uniform(LeakEveryLow, LeakEveryHigh) as f32;
    game.leak(&slicks.rng);
}

// A car that is coming onto the field starts to leak, if there is one
leak :: method (game: *Game, rng: *random.Random) -> bool {
    candidates: [..]int;
    defer candidates.free();
    for car, i in game.traffic.cars {
        if car.isActive && car.kind != .ambulance && car.z > -MapHalfLength && car.z < 0 { candidates.add(i as int); }
    }
    if candidates.count == 0 { return false; }
    car := &game.traffic.cars[rng.choice(candidates)];
    car.leakLeft = rng.uniform(LeakTimeLow, LeakTimeHigh) as f32;
    car.leakTimer = 0;
    return true;
}

addSlick :: method (game: *Game, center: Vector2, radius: f32) {
    slicks := &game.slicks;
    if slicks.list.count >= MaxSlicks { _ := slicks.list.removeAt(0); }
    slicks.list.add(Slick{
        center:   center,
        radius:   radius,
        seed:     slicks.rng.uniform(0, 100) as f32,
        timeLeft: slicks.rng.uniform(SlickLifeLow, SlickLifeHigh) as f32,
    });
}

// Oil thrown from a point: it flies for flight seconds, then lands as a big puddle that heroes slide off it boost times
// as fast as they came, for life seconds
throwSlick :: method (game: *Game, from: Vector3, center: Vector2, radius: f32, boost: f32, flight: f32, life: f32) {
    slicks := &game.slicks;
    if slicks.list.count >= MaxSlicks { _ := slicks.list.removeAt(0); }
    slicks.list.add(Slick{center: center, radius: radius, seed: slicks.rng.uniform(0, 100) as f32, timeLeft: life + flight, age: -flight,
        boost: boost, from: from});
}

// If there is oil under a point
slickAt :: method (game: *Game, point: Vector2) -> bool {
    return game.slickBoost(point) > 0;
}

// How much faster the oil under a point sends a hero on, the most of the blobs there, or 0 when there is none
slickBoost :: method (game: *Game, point: Vector2) -> f32 {
    boost: f32 = 0;
    for slick in game.slicks.list {
        if slick.contains(point) { boost = math.max(boost, slick.boost); }
    }
    return boost;
}

// While a hero is on the oil: on in the way it was going, without turning. False when it isn't sliding
slide :: method (game: *Game, hero: *Hero, dt: f32) -> bool {
    if hero.stats.oilProof { return false; }
    if hero.slideLeft <= 0 {
        boost := game.slickBoost(hero.ground());
        if !hero.isMoving || boost <= 0 { return false; }
        toTarget := hero.target.xz() - hero.ground();
        if toTarget.length() < 0.5 { return false; }
        hero.slideVelocity = toTarget.normalize() * hero.speed() * boost;
        hero.slideLeft = SlideTime;
    } else {
        // Onto oil that sends it on faster: faster, still the same way
        boost := game.slickBoost(hero.ground());
        wanted := hero.speed() * boost;
        current := hero.slideVelocity.length();
        if current > 0.01 && wanted > current { hero.slideVelocity = hero.slideVelocity * (wanted / current); }
    }
    hero.slideLeft -= dt;
    hero.position += hero.slideVelocity.at() * dt;
    hero.walkCycle += dt * 3;
    // Black drops kicked up from its feet
    game.effects.particles.emitRate(.oilSplash, hero.position + Vector3{0, 0.2, 0}, 18, dt);
    // Still on the oil: on sliding
    if hero.slideLeft <= 0 && game.slickAt(hero.ground()) { hero.slideLeft = SlideTime; }
    return true;
}

//
// Drawing
//

TarColor :: Color{10, 9, 8, 255};
TarEdge  :: Color{38, 32, 26, 255};      // A wet, brownish edge
TarShine :: Color{150, 155, 170, 255};   // Where the sky is mirrored in it

// The radius of a blob in a direction: its edge goes in and out a little
@private
edgeAt :: (slick: Slick, angle: f32) -> f32 {
    s := slick.seed;
    return slick.radius * (1 + 0.16 * math.sinf(angle * 3 + s) + 0.09 * math.sinf(angle * 5 + s * 1.7) + 0.05 * math.sinf(angle * 9 + s * 2.3));
}

// Black and glossy: the asphalt darkened round it, drops splashed round its edge, a wet brownish rim, the tar, the colors of
// oil drifting slowly over it, and the sky shining in it. It spreads out when it lands, and fades as it dries up. Oil
// that is still flying is a blob in the air, in an arc
drawSlicks :: (game: *Game) {
    for slick in game.slicks.list {
        if !slick.hasLanded() { drawFlying(game, slick); }
    }
    // The wet ground round it, then the edges, under all the blobs, so a trail of blobs is one patch with one edge
    for slick in game.slicks.list {
        if !slick.hasLanded() { continue; }
        drawBlob(slick, 1.3 * slick.spread(), 0.09, ColorAlpha({20, 20, 22, 255}, 0.22 * fadeOf(slick)));
    }
    for slick in game.slicks.list {
        if !slick.hasLanded() { continue; }
        drawBlob(slick, 1.08 * slick.spread(), 0.095, ColorAlpha(TarEdge, 0.85 * fadeOf(slick)));
        drawDroplets(slick, 0.096, ColorAlpha(TarEdge, 0.85 * fadeOf(slick)), 1.25);
    }
    for slick in game.slicks.list {
        if !slick.hasLanded() { continue; }
        drawBlob(slick, slick.spread(), 0.1, ColorAlpha(TarColor, 0.96 * fadeOf(slick)));
        drawDroplets(slick, 0.1, ColorAlpha(TarColor, 0.96 * fadeOf(slick)), 1);
    }
    for slick in game.slicks.list {
        if !slick.hasLanded() { continue; }
        fade := fadeOf(slick) * slick.spread();
        r := slick.radius * slick.spread();
        // The colors of oil: purple, teal and gold, drifting round each other
        for k in 0..3 {
            t := game.time * (0.25 + 0.07 * k as f32) + slick.seed + k as f32 * 2.1;
            at := slick.center + Vector2{math.sinf(t) * r * 0.35, math.cosf(t * 0.8) * r * 0.35};
            hue := [Color{110, 50, 170, 255}, Color{30, 140, 150, 255}, Color{170, 130, 40, 255}][k];
            drawEllipse(at, r * (0.34 - 0.05 * k as f32), r * (0.26 - 0.03 * k as f32), 0.101 + 0.0005 * k as f32, ColorAlpha(hue, 0.2 * fade));
        }
        // The shine: a smear on the side towards the sun, and a small bright spot in it
        side := math.sinf(slick.seed * 3.1) * 0.25;
        shine := slick.center + Vector2{-r * (0.25 + side), -r * (0.3 - side)};
        drawEllipse(shine, r * 0.5, r * 0.14, 0.103, ColorAlpha(TarShine, 0.2 * fade));
        drawEllipse(shine + Vector2{r * 0.15, 0}, r * 0.2, r * 0.05, 0.104, ColorAlpha(White, 0.2 * fade));
        drawEllipse(slick.center + Vector2{r * 0.3, r * 0.25}, r * 0.08, r * 0.03, 0.104, ColorAlpha(White, 0.12 * fade));
    }
}

// Oil in the air: a lump that wobbles as it flies from where it was thrown, in an arc, and a few drops trailing it
@private
drawFlying :: (game: *Game, slick: Slick) {
    t := 1 + slick.age / ThrowFlight;
    if t < 0 { return; }
    t = math.min(t, 1);
    ground := slick.center.at(0.3);
    at := Vector3Lerp(slick.from, ground, t) + Vector3{0, math.sinf(t * Pi) * 3.5, 0};
    wobble := 1 + 0.2 * math.sinf(game.time * 30);
    size := 0.35 + 0.25 * t;
    DrawSphereEx(at, size * wobble, 8, 8, TarColor);
    DrawSphere(at + Vector3{-0.1, 0.15, 0}, size * 0.3, ColorAlpha(TarShine, 0.7));
    for k in 1..4 {
        back := math.max(t - k as f32 * 0.06, 0);
        drop := Vector3Lerp(slick.from, ground, back) + Vector3{0, math.sinf(back * Pi) * 3.5, 0};
        DrawSphere(drop, size * (0.45 - k as f32 * 0.1), TarColor);
    }
}

ThrowFlight :: 0.45;        // Seconds thrown oil flies (Karl's)

// Drops splashed round the edge of a big blob, outside it, as many as its seed says
@private
drawDroplets :: (slick: Slick, y: f32, color: Color, scale: f32) {
    if slick.radius < 1.3 { return; }
    count := 4 + (slick.seed as int) % 4 + (slick.radius as int);
    for k in 0..count {
        a := slick.seed * 1.7 + k as f32 * 2.399;
        out := slick.radius * slick.spread() * (1.15 + 0.35 * math.fmodf(slick.seed * 0.37 + k as f32 * 0.61, 1));
        size := slick.radius * (0.05 + 0.07 * math.fmodf(slick.seed * 0.53 + k as f32 * 0.29, 1)) * scale * slick.spread();
        at := slick.center + Vector2{math.cosf(a) * out, math.sinf(a) * out};
        drawEllipse(at, size, size * 0.85, y, color);
    }
}

@private
fadeOf :: (slick: Slick) -> f32 {
    return math.clamp(math.min(slick.age * 3, slick.timeLeft / 3), 0, 1);
}

@private
drawBlob :: (slick: Slick, scale: f32, y: f32, color: Color) {
    if scale <= 0.001 { return; }
    Segments :: 32;
    middle := slick.center.at(y);
    for i in 0..Segments {
        a := Pi * 2 * i as f32 / Segments;
        b := Pi * 2 * (i + 1) as f32 / Segments;
        ra := edgeAt(slick, a) * scale;
        rb := edgeAt(slick, b) * scale;
        p := Vector3{slick.center.x + math.cosf(a) * ra, y, slick.center.y + math.sinf(a) * ra};
        q := Vector3{slick.center.x + math.cosf(b) * rb, y, slick.center.y + math.sinf(b) * rb};
        DrawTriangle3D(middle, q, p, color);
    }
}

@private
drawEllipse :: (center: Vector2, halfWidth: f32, halfLength: f32, y: f32, color: Color) {
    Segments :: 20;
    middle := center.at(y);
    for i in 0..Segments {
        a := Pi * 2 * i as f32 / Segments;
        b := Pi * 2 * (i + 1) as f32 / Segments;
        p := Vector3{center.x + math.cosf(a) * halfWidth, y, center.y + math.sinf(a) * halfLength};
        q := Vector3{center.x + math.cosf(b) * halfWidth, y, center.y + math.sinf(b) * halfLength};
        DrawTriangle3D(middle, q, p, color);
    }
}

//
// Console commands, to try them out
//

// The body of the console command rushHour (console_commands.sd)
startRushHour :: (game: *Game) {
    game.traffic.rush = .calm;
    game.traffic.rushLeft = 0;
}

// The body of the console command ambulance (console_commands.sd)
soundSirenNow :: (game: *Game, lane: ?int) {
    game.traffic.sirenFor(lane ?? game.slicks.rng.between(0, LaneCount - 1));
}
