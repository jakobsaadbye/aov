namespace core;

// Perks: after each crossing, every player picks one of three, at random, for the rest of the game. Like the items,
// each is a trait (traits.sd) of all the heroes of its player, so two players with the same hero still play it
// differently. A new perk is a value of PerkKind and its definition.

use raylib;

PerkKind :: enum {
    thickSoles,
    thickSkin,
    scavenger,
    revenge,
    hitAndRun,
    pocket,
    nimble,
    coldBlooded,
    hotPotato,
    scrapper,
    focus,
    longArms,
}

PerkDefinition :: struct {
    name:        string;
    description: string;
    icon:        string;        // data/icons/<icon>.png
    trait:       Trait;
}

perkDefinition :: method (kind: PerkKind) -> PerkDefinition {
    return switch kind {
        case .thickSoles  => PerkDefinition{"Thick Soles", "Doesn't slip on banana peels, nor slide on oil", "perk_thick_soles", .slipProof};
        case .thickSkin   => PerkDefinition{"Thick Skin", "20% more health", "perk_thick_skin", Trait{maxHealth: 1.2}};
        case .scavenger   => PerkDefinition{"Scavenger", "Picks items up from 3 further away", "perk_scavenger", Trait{itemReach: 3}};
        case .revenge     => PerkDefinition{"Revenge", "Whoever got it run over has 3 seconds more on all cooldowns", "perk_revenge", Trait{revenge: 3}};
        case .hitAndRun   => PerkDefinition{"Hit and Run", "Getting an enemy run over makes all the abilities ready again", "perk_hit_and_run", .hitAndRun};
        case .pocket      => PerkDefinition{"Deep Pockets", "One more slot in the backpack", "perk_pocket", .pocket};
        case .nimble      => PerkDefinition{"Nimble", "Steps aside by itself when a car is about to hit it. Every 20 seconds", "perk_nimble", .nimble};
        case .coldBlooded => PerkDefinition{"Cold Blooded", "Cars it freezes, stops or slows stay so 1 second longer", "perk_cold_blooded", Trait{coldBlooded: 1}};
        case .hotPotato   => PerkDefinition{"Hot Potato", "Shoving an enemy swaps an item with it", "perk_hot_potato", .hotPotato};
        case .scrapper    => PerkDefinition{"Scrapper", "Shoves enemies twice as far", "perk_scrapper", Trait{shoveTaken: 2}};
        case .focus       => PerkDefinition{"Focus", "The abilities cool down 12% faster", "perk_focus", Trait{cooldown: 0.88}};
        case .longArms    => PerkDefinition{"Long Arms", "The abilities reach 15% further", "perk_long_arms", Trait{reach: 1.15}};
    };
}

PerkChoices  :: 3;
PerkPickTime :: 12.0;      // Seconds to pick, before the first one is taken

// Three perks to pick one of
PerkOffer :: struct {
    perks:    [PerkChoices]PerkKind;
    timeLeft: f32;
}

// After a crossing: every player is offered perks, three it doesn't have, at random
offerPerks :: method (game: *Game) {
    for i in 0..game.players.count { game.offerPerksTo(i as int); }
}

@private
offerPerksTo :: method (game: *Game, index: int) {
    player := &game.players[index];
    offer := PerkOffer{timeLeft: PerkPickTime};
    count := 0;
    attempts := 0;
    while count < PerkChoices && attempts < 60 {
        attempts += 1;
        kind := game.rng.between(0, PerkKind.count as int - 1) as PerkKind;
        if hasPerk(player, kind) || isOffered(&offer, count, kind) { continue; }
        offer.perks[count] = kind;
        count += 1;
    }
    if count == PerkChoices { player.perkOffer = offer; }
}

@private
hasPerk :: (player: *Player, kind: PerkKind) -> bool {
    for owned in player.perks {
        if owned == kind { return true; }
    }
    return false;
}

@private
isOffered :: (offer: *PerkOffer, count: int, kind: PerkKind) -> bool {
    for k in 0..count {
        if offer.perks[k] == kind { return true; }
    }
    return false;
}

choosePerk :: method (game: *Game, index: int, choice: int) {
    player := &game.players[index];
    if !player.perkOffer.hasValue() || choice < 0 || choice >= PerkChoices { return; }
    kind := player.perkOffer.value().perks[choice];
    player.perkOffer = null;
    player.perks.add(kind);
    player.refreshStats();
    if index == game.watched { game.showBanner(UiGold, "Perk: %", kind.perkDefinition().name); }
    else                      { game.announce(index, player.color, "% picked %", player.name, kind.perkDefinition().name); }
}

// Picks a perk at random for whoever didn't pick in time
updatePerkOffers :: method (game: *Game, dt: f32) {
    for *player, i in game.players {
        if !player.perkOffer.hasValue() { continue; }
        offer := player.perkOffer.value();
        offer.timeLeft -= dt;
        player.perkOffer = offer;
        if offer.timeLeft <= 0 { game.choosePerk(i as int, game.rng.between(0, PerkChoices - 1)); }
    }
}

// The offer of the player at the keyboard: three cards in the middle of the screen. A click on one, or 1, 2 or 3 while
// the hero waits for the next round, picks it
PerkCardWidth  :: 230;
PerkCardHeight :: 150;

drawPerkOffer :: (game: *Game, assets: *Assets) {
    game.hoveredPerk = -1;
    if !game.hasLocal() || game.watched != game.local { return; }
    player := &game.players[game.local];
    if !player.perkOffer.hasValue() { return; }
    offer := player.perkOffer.value();
    gap := 24;
    total := PerkChoices * PerkCardWidth + (PerkChoices - 1) * gap;
    x := (GetScreenWidth() - total) / 2;
    y := 215;
    uiPlaque(tprint("Pick a perk  ·  % s", math.ceilf(offer.timeLeft) as int), GetScreenWidth() / 2, y - 48, 22);
    mouse := GetMousePosition();
    for k in 0..PerkChoices {
        definition := offer.perks[k].perkDefinition();
        card := Rectangle{(x + k as int * (PerkCardWidth + gap)) as f32, y as f32, PerkCardWidth, PerkCardHeight};
        hovered := CheckCollisionPointRec(mouse, card);
        if hovered { game.hoveredPerk = k as int; }
        uiPanel(card, 0.6);
        icon := assets.icons[definition.icon];
        iconBox := Rectangle{card.x + 16, card.y + 16, 48, 48};
        DrawTexturePro(icon, {0, 0, icon.width as f32, icon.height as f32}, iconBox, {0, 0}, 0, White);
        highlight: ?Color = null;
        if hovered { highlight = UiGold; }
        uiIconFrame(iconBox, highlight);
        drawTitle(definition.name, card.x as int + 76, card.y as int + 20, 18, UiGold);
        drawText(tprint("%", k + 1), card.x as int + PerkCardWidth - 28, card.y as int + 16, 16, UiGoldDim);
        lines := wrapText(definition.description, 15, PerkCardWidth - 32);
        for line, n in lines { drawText(line, card.x as int + 16, card.y as int + 76 + n as int * 19, 15, Parchment); }
        lines.free();
    }
}
