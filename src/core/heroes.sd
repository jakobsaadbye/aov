namespace core;

import math;
use raylib;

// Every time a hero is run over, the player gets a new one at random. A hero has any number of abilities, like in
// Dota 2. The abilities that are cast are on the keys in order: the first on Q, the second on W, and so on
// (AbilityKeys). Then they cool down. A passive is always on, and has no key.
//
// Each hero is a file in core/heroes/: its definition, and the abilities that are its own. A new hero is a value of
// HeroKind, its file, its line in defineHero, a model (tools/make_models.py) and the icons of its abilities
// (tools/make_textures.py)

HeroKind :: enum {
    allan,
    ghosty,
    butcher,
    frosty,
    bjorn,
    hilda,
    mira,
}

// The keys of the abilities that are cast, in order. A hero can have as many of them as there are keys, and passives
AbilityKeys     :: [KeyboardKey.q, .w, .e, .r, .d, .f];
AbilityKeyNames :: ["Q", "W", "E", "R", "D", "F"];
MaxAbilities    :: 8;

HeroDefinition :: struct {
    name:      string;
    title:     string;          // What kind of hero it is, e.g "the Mechanic"
    color:     Color;           // Of the portrait and the bits flying when run over
    width:     f32;             // Of the model, for its shadow and the circle under it
    height:    f32;
    moveSpeed: f32;
    hitRadius: f32;             // The circle on the ground that the cars hit
    maxHealth: f32;             // A car takes CarDamagePerSecond, so a tanky hero survives a car for a moment
    abilities: [..]Ability;
}

@private
heroDefinitions: [HeroKind.count]HeroDefinition;
@private
heroesDefined: bool;

// The heroes and their abilities, each in its file in core/heroes/. Made the first time they are asked for
definition :: method (kind: HeroKind) -> *HeroDefinition {
    if !heroesDefined {
        heroesDefined = true;
        for k in HeroKind.values { heroDefinitions[k] = defineHero(k); }
    }
    return &heroDefinitions[kind];
}

@private
defineHero :: (kind: HeroKind) -> HeroDefinition {
    return switch kind {
        case .allan   => defineAllan();
        case .ghosty  => defineGhosty();
        case .butcher => defineButcher();
        case .frosty  => defineFrosty();
        case .bjorn   => defineBjorn();
        case .hilda   => defineHilda();
        case .mira    => defineMira();
    };
}

// Moved by something else, e.g knocked away or dragged by a hook. The hero can't act until it is over
Displacement :: struct {
    to:    Vector3;
    speed: f32;
}

LeapHeight :: 7.0;

// A jump through the air, over cars and walls, e.g Bjørn's leap
LeapState :: struct {
    from:     Vector3;
    to:       Vector3;
    duration: f32;
    flight:   f32;          // 0 to 1
    height:   f32 = LeapHeight;
}


// Where the hero was, for Mira's rewind: a sample every RewindInterval seconds, the last RewindSamples of them
RewindInterval :: 0.1;
RewindSamples  :: 32;

RewindSample :: struct {
    position: Vector3;
    health:   f32;
}

Hero :: struct {
    kind:      HeroKind;
    position:  Vector3;
    target:    Vector3;
    isMoving:  bool;
    facing:    f32;         // Radians around y. 0 looks down +z
    walkCycle: f32;         // Drives the bobbing while walking
    timeAlive: f32;

    cooldowns: [MaxAbilities]f32;   // Seconds before each ability can be cast again, in the order of the abilities
    health:    f32;
    hurtFor:   f32;                 // Seconds since a car last hurt the hero. With a First Aid Kit it heals after a while
    stats:     HeroStats;               // Of its passives, the items and the perks of its player (traits.sd)
    statuses:  Statuses;            // Stunned, faded, hasted, ... (status.sd)
    savesLeft: int;                 // Of the clovers: times it still gets away from a car
    slideLeft:     f32;             // On an oil slick: seconds it slides on before it may turn (slicks.sd)
    slowedBy:      f32;             // By the Garlic of an enemy near it: 0.3 is 30% slower
    bounceLeft:    f32;             // Seconds until Spring Shoes bounce it again
    shoveLeft:     f32;             // Seconds until it can shove another hero again (match.sd)
    slideVelocity: Vector2;

    // What the abilities are doing right now
    hook:             ?HookState;
    leap:             ?LeapState;

    // What the enemies did to the hero
    harmedBy:     int = -1;             // The player that last hooked, bashed or locked it, who gets the kill if a car
    harmedAt:     f32;                  // gets it soon after: at this time of the game
    displacement: ?Displacement;

    // The way back for a rewind: a ring of samples, the newest at trailNext - 1
    trail:      [RewindSamples]RewindSample;
    trailNext:  int;
    trailCount: int;
    trailTimer: f32;

    info :: method () -> *HeroDefinition {
        return self.kind.definition();
    }

    abilities :: method () -> [..]Ability {
        return self.info().abilities;
    }

    ground :: method () -> Vector2 {
        return self.position.xz();
    }

    speed :: method () -> f32 {
        return self.info().moveSpeed * self.stats.speed * self.statusSpeed() * (1 - self.slowedBy);
    }

    walksThroughWalls :: method () -> bool {
        return self.stats.throughWalls;
    }

    // Its own aura, or else the one of a Frost Charm
    chillAura :: method () -> ?ChillAura {
        return self.stats.chill;
    }

    // The aura is its own, not of an item
    hasChillAbility :: method () -> bool {
        return self.abilities().some(ability => ability.trait.kind == .chillAura);
    }

    isFaded :: method () -> bool {
        return self.has(.fade);
    }

    // In the air, where no car reaches
    isAirborne :: method () -> bool {
        return self.leap.hasValue();
    }

    // Enemies' spells can find it
    isTargetable :: method () -> bool {
        return !self.isAirborne() && !self.anyStatus(rules => rules.untargetable);
    }

    // The cars drive through it
    carsPass :: method () -> bool {
        return self.isAirborne() || self.anyStatus(rules => rules.carsPass);
    }

    // If it can be given orders: not stunned, dragged, or in the middle of a hook or a leap
    canAct :: method () -> bool {
        return !self.isStopped() && !self.displacement.hasValue() && !self.isPulledByHook() && !self.leap.hasValue();
    }

    // If it can cast: it can act, and isn't silenced, e.g a toad or scared
    canCast :: method () -> bool {
        return self.canAct() && !self.isSilenced();
    }

    // Pulled to a car by his hook. While the hook flies he can still walk
    isPulledByHook :: method () -> bool {
        return self.hook.hasValue() && self.hook.value().car >= 0;
    }

    // How much of the damage of a car the hero takes: 1 is all of it
    damageTaken :: method () -> f32 {
        return self.stats.damageTaken;
    }

    maxHealth :: method () -> f32 {
        return self.info().maxHealth * self.stats.maxHealth;
    }

    // How far an ability with this range reaches
    reach :: method (range: f32) -> f32 {
        return range * self.stats.reach;
    }

    // Jumps through the air to a point
    startLeap :: method * (to: Vector2, duration: f32, height: f32) {
        toTarget := to - self.ground();
        self.leap = LeapState{from: self.position, to: to.at(), duration: duration, height: height};
        self.isMoving = false;
        if toTarget.lengthSqr() > 0.0001 { self.facing = math.atan2f(toTarget.x, toTarget.y); }
    }

    // Remembers where the hero is, every RewindInterval seconds
    recordTrail :: method * (dt: f32) {
        self.trailTimer -= dt;
        if self.trailTimer > 0 { return; }
        self.trailTimer += RewindInterval;
        self.trail[self.trailNext] = RewindSample{self.position, self.health};
        self.trailNext = (self.trailNext + 1) % RewindSamples;
        self.trailCount = math.min(self.trailCount + 1, RewindSamples);
    }

    // Where the hero was about seconds ago, or as far back as it remembers
    rewindSample :: method (seconds: f32) -> ?RewindSample {
        if self.trailCount == 0 { return null; }
        back := math.clamp((seconds / RewindInterval) as int, 1, self.trailCount);
        index := (self.trailNext - back + RewindSamples) % RewindSamples;
        return self.trail[index];
    }

    forgetTrail :: method * () {
        self.trailCount = 0;
        self.trailTimer = 0;
    }

    // The ability on the nth key (0 is Q): the nth ability that isn't a passive, or -1 when there is none
    abilityOnKey :: method (key: int) -> int {
        keyed := 0;
        for ability, i in self.abilities() {
            if ability.isPassive() { continue; }
            if keyed == key { return i as int; }
            keyed += 1;
        }
        return -1;
    }

    // The key of an ability (0 is Q), or -1 for a passive
    keyOf :: method (slot: int) -> int {
        abilities := self.abilities();
        if abilities[slot].isPassive() { return -1; }
        key := 0;
        for i in 0..slot {
            if !abilities[i].isPassive() { key += 1; }
        }
        return key;
    }

    // If an ability can be cast now. slot is its place in the abilities of the hero
    abilityReady :: method (slot: int) -> bool {
        abilities := self.abilities();
        if slot < 0 || slot >= abilities.count { return false; }
        return !abilities[slot].isPassive() && self.cooldowns[slot] <= 0 && self.canCast();
    }

    // Starts walking to a point on the ground
    moveTo :: method * (point: Vector3) {
        if !self.canAct() { return; }     // A hook, a leap or a stun is in charge until it is done
        self.target   = Vector3{point.x, 0, point.z};
        self.isMoving = true;
    }

    stop :: method * () {
        self.isMoving = false;
        self.target   = self.position;
    }
}

newHero :: (kind: HeroKind, position: Vector3, facing: f32) -> Hero {
    return Hero{
        kind:     kind,
        position: position,
        target:   position,
        facing:   facing,
        health:   kind.definition().maxHealth,
        hurtFor:  1000,
    };
}
