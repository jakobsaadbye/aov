namespace core;

// What is on a hero right now, as a row of small round badges over the hero card: its statuses, its passives, and
// what else holds it or helps it for a while. A green ring is good for it, a red one bad, and it runs down with the time
// left. The mouse on one says what it is

import fmt;
import math;
use raylib;

Buff :: struct {
    icon:        string;
    name:        string;
    description: string;
    good:        bool;
    timeLeft:    f32;           // Seconds left, or 0 for one that lasts
    duration:    f32;
    count:       int;           // A number in the corner, e.g charges, or 0
    meter:       bool;          // Its ring is how full something is, not a time, e.g Mads' speed
}

BuffSize :: 38;
BuffGap  :: 6;
BuffMiddleGap :: 16;        // Between the good ones and the bad ones
GoodBuffColor :: Color{80, 220, 90, 255};
BadBuffColor  :: Color{230, 60, 50, 255};

buffsOf :: (game: *Game, index: int) -> [..]Buff {
    buffs: [..]Buff;
    player := &game.players[index];
    hero := &player.hero;

    for kind in StatusKind.values {
        if !hero.has(kind) { continue; }
        look := statusLook(kind);
        status := hero.status(kind);
        buffs.add(Buff{look.icon, look.name, look.description, statusRules(kind).good, status.timeLeft, math.max(status.duration, status.timeLeft)});
    }
    if hero.possess.hasValue() {
        buffs.add(Buff{"possess", "Possessing", "In a car, steering it", true, hero.possess.value().timeLeft, 4});
    }
    if hero.isBlended() { buffs.add(Buff{"blend_in", "Blended In", "Enemies can't target him until he moves", true}); }
    if hero.inShadow    { buffs.add(Buff{"shadowed", "In the Shadows", "Enemies can't target him next to the car", true}); }
    if hero.slowedBy > 0 {
        buffs.add(Buff{"item_garlic", "Stench", tprint("The garlic of an enemy near: %% slower", (hero.slowedBy * 100) as int, "%"), false});
    }

    // What it always has: the passives of the hero (its talents are in its tree, next to the portrait)
    for ability in hero.abilities() {
        if !ability.isPassive() { continue; }
        buff := Buff{ability.icon, ability.name, ability.description, true};
        kind := ability.trait.kind;
        if (kind == .blendIn && hero.isBlended()) || (kind == .shadowed && hero.inShadow) { continue; }      // Shown as on
        if kind == .adrenaline {
            buff.timeLeft = hero.nearMissLeft;
            buff.duration = NearMissEvery;
        }
        if kind == .staticCharge { buff.count = hero.castCount % 3; }
        // Rolling fills its ring as Mads gathers speed, and counts how much faster he is, in percent
        if kind == .momentum && hero.momentum > 0.01 {
            buff.timeLeft = hero.momentum;
            buff.duration = 1;
            buff.count = (hero.momentum * MomentumBonus * 100 + 0.5) as int;
            buff.meter = true;
        }
        buffs.add(buff);
    }
    return buffs;
}

// Over the middle of the hero card, as in Dota: the good ones to the left of the middle, the bad ones to the right of it,
// each side growing outwards from the middle
drawBuffs :: (game: *Game, assets: *Assets, panel: Rectangle) {
    buffs := buffsOf(game, game.watched);
    defer buffs.free();
    y := panel.y as int - BuffSize - 12;
    middle := (panel.x + panel.width * 0.5) as int;
    goods := 0;
    for buff in buffs { if buff.good { goods += 1; } }
    left := middle - BuffMiddleGap / 2 - BuffSize;          // The good ones, from the middle leftwards
    right := middle + BuffMiddleGap / 2;                    // and the bad ones rightwards
    if goods == buffs.count { left = middle - BuffSize / 2 + (goods - 1) * (BuffSize + BuffGap) / 2; }
    else if goods == 0 { right = middle - BuffSize / 2 - (buffs.count as int - 1) * (BuffSize + BuffGap) / 2; }
    mouse := GetMousePosition();
    hovered := -1;
    hoveredBox: Rectangle;
    for buff, i in buffs {
        x := right;
        if buff.good {
            x = left;
            left -= BuffSize + BuffGap;
        } else {
            right += BuffSize + BuffGap;
        }
        box := Rectangle{x as f32, y as f32, BuffSize, BuffSize};
        drawBuff(assets, buff, box);
        if CheckCollisionPointRec(mouse, box) {
            hovered = i as int;
            hoveredBox = box;
        }
    }
    if hovered >= 0 {
        buff := buffs[hovered];
        lines := wrapText(buff.description, 16, 300);
        defer lines.free();
        sub := "";
        if buff.meter { sub = tprint("%% faster", buff.count, "%"); }
        else if buff.timeLeft > 0 { sub = tprint("% s left", fmt.fixed(buff.timeLeft, 1)); }
        color := GoodBuffColor;
        if !buff.good { color = BadBuffColor; }
        uiTooltip(hoveredBox, buff.name, color, lines, sub);
    }
}

// A round badge: a soft shadow, the icon in a circle, and a ring round it, bevelled, light on top and dark below, green for
// good and red for bad. As in Dota, the ring is the clock of one that wears off: what has gone of its time goes dark,
// clockwise from the top. The number of one that counts sits in a little disc at its foot
drawBuff :: (assets: *Assets, buff: Buff, box: Rectangle) {
    color := GoodBuffColor;
    if !buff.good { color = BadBuffColor; }
    center := Vector2{box.x + box.width * 0.5, box.y + box.height * 0.5};
    r := box.width * 0.5;
    DrawCircleV(center + Vector2{1.5, 2.5}, r + 1, {0, 0, 0, 110});
    DrawCircleV(center, r, {12, 12, 16, 235});
    inner := r - 4;
    if assets.icons.has(buff.icon) { drawRoundTexture(assets.icons[buff.icon], center, inner); }
    gone: f32 = 0;
    if buff.timeLeft > 0 && buff.duration > 0 { gone = 1 - math.clamp(buff.timeLeft / buff.duration, 0, 1); }
    // The ring: bright where its time is left, dark where it has gone, from the top round clockwise, a light rim on top
    // and a dark one below
    DrawRing(center, r - 4, r, -90 + gone * 360, 270, 40, color);
    if gone > 0 { DrawRing(center, r - 4, r, -90, -90 + gone * 360, 40, ColorAlpha(ColorBrightness(color, -0.6), 0.95)); }
    DrawRing(center, r - 1.2, r, 200, 340, 24, ColorAlpha(ColorBrightness(color, 0.6), 0.9));
    DrawRing(center, r - 4, r - 2.8, 20, 160, 24, ColorAlpha(Black, 0.45));
    DrawRing(center, r, r + 1.3, 0, 360, 40, {0, 0, 0, 200});
    DrawRing(center, inner - 0.8, inner, 0, 360, 40, ColorAlpha(Black, 0.6));
    // A glint on the glass of it
    DrawCircleV(center + Vector2{-inner * 0.4, -inner * 0.45}, inner * 0.22, {255, 255, 255, 40});
    if buff.count > 0 {
        text := tprint("%", buff.count);
        at := center + Vector2{r * 0.62, r * 0.62};
        DrawCircleV(at, 8.5, {0, 0, 0, 230});
        DrawRing(at, 7, 8.5, 0, 360, 20, color);
        drawText(text, (at.x - textWidth(text, 13) * 0.5) as int, (at.y - 7) as int, 13, White);
    }
}

// A texture in a circle: wedges from its middle, each with its part of the texture. Drawn as quads (a wedge is the middle
// and three points on the edge), as raylib draws its textures: rlgl starts a new draw with no texture when the mode
// changes, so in triangles the texture was lost and the icon came out white
drawRoundTexture :: (texture: Texture, center: Vector2, radius: f32) {
    Segments :: 18;
    rlSetTexture(texture.id);
    rlBegin(RlQuads);
    rlColor4ub(255, 255, 255, 255);
    for k in 0..Segments {
        a := Pi * 2 * k as f32 / Segments;
        b := Pi * 2 * (k + 1) as f32 / Segments;
        m := (a + b) * 0.5;
        rlTexCoord2f(0.5, 0.5);
        rlVertex2f(center.x, center.y);
        for angle in [b, m, a] {
            rlTexCoord2f(0.5 + math.cosf(angle) * 0.5, 0.5 + math.sinf(angle) * 0.5);
            rlVertex2f(center.x + math.cosf(angle) * radius, center.y + math.sinf(angle) * radius);
        }
    }
    rlEnd();
    rlSetTexture(0);
}

extern "raylib.dll" {
    rlVertex2f :: (x: f32, y: f32) -> void;
}
