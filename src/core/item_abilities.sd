namespace core;

// What the items that are used do, and using them: with 1, 2 or 3, or a click on the item in the backpack, like an
// ability. Each is an Ability (abilities.sd), so the bots know how to use it by its BotUse, like any other

import math;
use raylib;

ItemKeys :: [KeyboardKey.one, .two, .three];

// The ability of the item in a slot of a player's backpack, if it is used and ready
itemReady :: method (game: *Game, index: int, slot: int) -> bool {
    player := &game.players[index];
    if slot < 0 || slot >= player.backpack.count { return false; }
    definition := player.backpack.items[slot].itemDefinition();
    return definition.isUsed() && player.backpack.cooldowns[slot] <= 0 && player.hero.canCast();
}

// Uses the item in a slot of the backpack, aimed at a point. One with charges is gone when they are used up
useItem :: method (game: *Game, index: int, slot: int, target: Vector2) {
    if !game.itemReady(index, slot) { return; }
    player := &game.players[index];
    kind := player.backpack.items[slot];
    definition := kind.itemDefinition();
    ability := definition.action;
    if !ability.cast(game, index, &ability, target) { return; }
    player.backpack.cooldowns[slot] = ability.cooldown;
    if ability.sound.len > 0 { game.sounds.playAt(ability.sound, player.hero.position); }
    if definition.charges > 0 {
        player.backpack.charges[slot] -= 1;
        if player.backpack.charges[slot] <= 0 {
            _ := player.backpack.remove(slot);
            player.refreshStats();
        }
    }
}

// The cooldowns of the items, once a frame
coolItems :: method (player: *Player, dt: f32) {
    for slot in 0..player.backpack.count {
        player.backpack.cooldowns[slot] = math.max(0, player.backpack.cooldowns[slot] - dt);
    }
    player.hero.mirrorLeft = math.max(0, player.hero.mirrorLeft - dt);
    player.hero.portalLeft = math.max(0, player.hero.portalLeft - dt);
}

castBananaPeel :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    return game.throwProjectile(caster, .banana, target, hero.reach(ability.range), 26, 0);
}

castEnergyDrink :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    hero.addStatus(.sugarRush, ability.duration, ability.power);
    game.effects.particles.emit(.sparkles, hero.position + Vector3{0, 2, 0}, 16, tint: {90, 160, 255, 255});
    return true;
}

// A cone in a lane: the cars that come to it swerve round it
castTrafficCone :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    point := towards(hero.ground(), target, hero.reach(ability.range)) ?? hero.ground();
    if math.fabsf(point.x) > RoadHalfWidth { return false; }
    point.x = laneCenter(laneAt(point.x));
    game.cones.add(Cone{position: point, timeLeft: ability.duration * hero.stats.buildTime});
    return true;
}

// The car nearest the point goes count lanes over, away from the hero
castRemoteControl :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    aim := towards(hero.ground(), target, hero.reach(ability.range)) ?? hero.ground();
    index := game.traffic.carNear(aim, 6);
    if index < 0 { return false; }
    car := &game.traffic.cars[index];
    if car.kind == .ambulance || car.kind == .bus { return false; }
    away: f32 = 1;
    if hero.position.x > car.x() { away = -1; }
    if car.lane + (away as int) * ability.count < 0 || car.lane + (away as int) * ability.count >= LaneCount { away = -away; }
    game.traffic.moveToLane(index, car.lane + (away as int) * ability.count);
    game.effects.particles.emit(.sparks, car.position() + Vector3{0, car.height() + 0.5, 0}, 10, tint: {120, 220, 255, 255});
    return true;
}

castStopwatch :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    if !hero.cooldowns.some(cooldown => cooldown > 0) { return false; }
    game.readyAbilities(caster);
    return true;
}

castSnowGlobe :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    duration := ability.duration + hero.stats.coldBlooded;
    for *car in game.traffic.cars {
        if !car.isActive || car.kind == .ambulance { continue; }
        car.frozenLeft = math.max(car.frozenLeft, duration);
    }
    for *player, i in game.players {
        if i as int == caster || !player.isPlaying() || !player.hero.isTargetable() { continue; }
        player.hero.addStatus(.timeLock, ability.duration, source: caster, time: game.time);
        game.effects.particles.emit(.snow, player.hero.position + Vector3{0, 2, 0}, 14);
    }
    game.effects.addRing(hero.ground(), 1, 40, {220, 240, 255, 255}, 0.6);
    game.announce(-1, {200, 230, 255, 255}, "% shook a snow globe: everything stops!", game.players[caster].name);
    return true;
}

castPortalGun :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    to := towards(hero.ground(), target, hero.reach(ability.range));
    if !to.hasValue() { return false; }
    there := game.world.resolveCollisions(to.value(), PortalRadius, false);
    game.portals.add(Portal{ends: [hero.ground(), there], timeLeft: ability.duration});
    hero.portalLeft = PortalCooldown;     // It doesn't send the hero through it at once
    return true;
}

//
// Portals: anyone that walks into one end comes out of the other
//

Portal :: struct {
    ends:     [2]Vector2;
    timeLeft: f32;
}

PortalRadius   :: 1.2;
PortalCooldown :: 1.0;     // Seconds before a hero that came through a portal can go through one again

updatePortals :: method (game: *Game, dt: f32) {
    for *portal in game.portals { portal.timeLeft -= dt; }
    game.portals.removeWhere(portal => portal.timeLeft <= 0);
}

walkThroughPortal :: method (game: *Game, index: int) {
    hero := &game.players[index].hero;
    if hero.portalLeft > 0 || hero.isAirborne() { return; }
    for portal in game.portals {
        for end, k in portal.ends {
            if hero.ground().distance(end) > PortalRadius { continue; }
            out := portal.ends[1 - k];
            game.effects.particles.emit(.blink, hero.position + Vector3{0, 1.5, 0}, 14, tint: {90, 200, 255, 255});
            // It walks on from the other end, to where it was going
            hero.target += (out - end).at();
            hero.position = game.world.resolveCollisions(out, hero.info().hitRadius, hero.walksThroughWalls()).at();
            hero.portalLeft = PortalCooldown;
            hero.forgetTrail();
            game.effects.particles.emit(.blink, hero.position + Vector3{0, 1.5, 0}, 14, tint: {255, 160, 60, 255});
            game.sounds.playAt("ability.blink", hero.position, 0.6);
            return;
        }
    }
}

drawPortals :: (game: *Game) {
    for portal in game.portals {
        fade := math.min(portal.timeLeft, 1);
        colors := [Color{90, 200, 255, 255}, Color{255, 160, 60, 255}];
        for end, k in portal.ends {
            spin := game.time * 3 + k as f32;
            center := end.at(1.6);
            DrawCylinderEx(end.at(0.05), end.at(0.1), PortalRadius, PortalRadius, 24, ColorAlpha(colors[k], 0.35 * fade));
            for r in 0..3 {
                radius := PortalRadius * (0.5 + 0.25 * r as f32);
                DrawCircle3D(center + Vector3{0, math.sinf(spin + r as f32) * 0.2, 0}, radius, {0, 1, 0}, spin * 30, ColorAlpha(colors[k], fade));
            }
        }
    }
}

castMegaphone :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    for *player, i in game.players {
        if i as int == caster || !player.isPlaying() { continue; }
        for *cooldown in player.hero.cooldowns { *cooldown += ability.power; }
    }
    game.effects.addRing(game.players[caster].hero.ground(), 1, 30, {255, 255, 255, 255}, 0.5);
    game.announce(-1, {255, 255, 255, 255}, "% shouted through a megaphone", game.players[caster].name);
    return true;
}

castRubberChicken :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    range := hero.reach(ability.range);
    for *player, i in game.players {
        if i as int == caster || !player.isPlaying() || !player.hero.isTargetable() { continue; }
        if player.hero.ground().distance(hero.ground()) > range { continue; }
        player.hero.addStatus(.taunt, ability.duration, point: hero.ground(), source: caster, time: game.time);
    }
    game.effects.addRing(hero.ground(), 0.5, range, {255, 230, 80, 255}, 0.35);
    return true;
}

// A random ability of a random hero, that is cast and not a passive, cast as if the hero had it
castLuckyDice :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    for attempt in 0..20 {
        kind := game.rng.between(0, HeroKind.count as int - 1) as HeroKind;
        abilities := kind.definition().abilities;
        pick := abilities[game.rng.between(0, abilities.count as int - 1)];
        if pick.isPassive() { continue; }
        if pick.cast(game, caster, &pick, target) {
            game.announce(caster, {245, 245, 245, 255}, "The dice rolled %", pick.name);
            if pick.sound.len > 0 { game.sounds.playAt(pick.sound, game.players[caster].hero.position); }
            return true;
        }
    }
    return false;
}
