namespace core;

// What happens to the traffic now and then, to keep a crossing from being the same every time:
//
//   * Rush hour: after a calm while, a warning, then for a few seconds the cars come much closer after each other, so
//     there are hardly any gaps. Wait it out, or get across before it comes.
//   * Ambulances: a siren, and a couple of seconds later three ambulances come down three lanes next to each other, much
//     faster than the cars, with their lights flashing; the one in the middle a bit ahead. Arrows flash down their
//     lanes until they come.
//
// Both follow the random numbers of the traffic, so a replay has them at the same times.

import math;
import random;
use raylib;

RushPhase :: enum {
    calm,
    coming,         // The warning
    rush,
}

RushCalmLow    :: 35.0;     // Seconds of calm between two rush hours, at random between these
RushCalmHigh   :: 55.0;
RushWarning    :: 5.0;      // Seconds of warning
RushLengthLow  :: 9.0;      // Seconds a rush hour lasts
RushLengthHigh :: 13.0;
RushGap        :: 0.35;     // Times the room between the cars of a lane in rush hour

EmergencyEveryLow  :: 30.0; // Seconds between two ambulances, at random between these
EmergencyEveryHigh :: 55.0;
EmergencyWarning   :: 2.5;  // Seconds from the siren to the ambulance on the road
EmergencySpeed     :: 1.5;  // Times the speed of the fastest cars there can be
EmergencyLanes     :: 3;    // Ambulances that come at once, in lanes next to each other
EmergencyBehind    :: 7.0;  // How far the ones at the sides are behind the one in the middle

startEvents :: method (traffic: *Traffic, rng: *random.Random) {
    traffic.hasEvents = true;
    traffic.rush = .calm;
    traffic.rushLeft = rng.uniform(RushCalmLow, RushCalmHigh) as f32;
    traffic.nextEmergency = rng.uniform(EmergencyEveryLow, EmergencyEveryHigh) as f32;
    traffic.emergencyLane = -1;
}

updateEvents :: method (traffic: *Traffic, dt: f32, rng: *random.Random) {
    if !traffic.hasEvents { return; }

    traffic.rushLeft -= dt;
    if traffic.rushLeft <= 0 {
        switch traffic.rush {
            case .calm   { traffic.startRush(rng, warning: true); }
            case .coming { traffic.startRush(rng, warning: false); }
            case .rush {
                traffic.rush = .calm;
                traffic.rushLeft = rng.uniform(RushCalmLow, RushCalmHigh) as f32;
            }
        }
    }

    if traffic.emergencyLane >= 0 {
        traffic.emergencyIn -= dt;
        if traffic.emergencyIn <= 0 {
            traffic.spawnEmergency(traffic.emergencyLane);
            traffic.emergencyLane = -1;
            traffic.nextEmergency = rng.uniform(EmergencyEveryLow, EmergencyEveryHigh) as f32;
        }
    } else {
        traffic.nextEmergency -= dt;
        if traffic.nextEmergency <= 0 { traffic.sirenFor(rng.between(0, LaneCount - 1)); }
    }
}

// The warning of a rush hour, or the rush hour itself
startRush :: method (traffic: *Traffic, rng: *random.Random, warning: bool) {
    if warning {
        traffic.rush = .coming;
        traffic.rushLeft = RushWarning;
        return;
    }
    traffic.rush = .rush;
    traffic.rushLeft = rng.uniform(RushLengthLow, RushLengthHigh) as f32;
    // The next car of every lane comes sooner too
    for *lane in traffic.lanes { lane.spawnTimer *= RushGap; }
}

// Times the room between the cars of a lane, now
rushGap :: method (traffic: *Traffic) -> f32 {
    if traffic.rush == .rush { return RushGap; }
    return 1;
}

// The siren: ambulances come down the lane and the ones on each side of it in a moment
sirenFor :: method (traffic: *Traffic, lane: int) {
    traffic.emergencyLane = math.clamp(lane, 1, LaneCount - 2);
    traffic.emergencyIn = EmergencyWarning;
}

// The lanes of the ambulances that are coming, from the first
emergencyLanes :: method (traffic: *Traffic) -> int, int {
    first := traffic.emergencyLane - EmergencyLanes / 2;
    return first, first + EmergencyLanes - 1;
}

// Where an ambulance starts in a lane of the convoy: the middle one ahead
emergencyStart :: method (traffic: *Traffic, lane: int) -> f32 {
    behind: f32 = 0;
    if lane != traffic.emergencyLane { behind = EmergencyBehind; }
    return -RoadEnd - VanLength * 0.5 - behind;
}

spawnEmergency :: method (traffic: *Traffic, middle: int) {
    first, last := traffic.emergencyLanes();
    for lane in first...last {
        for *car in traffic.cars {
            if car.isActive { continue; }
            *car = Car{
                isActive: true,
                kind:     .ambulance,
                lane:     lane,
                z:        traffic.emergencyStart(lane),
                color:    White,
                speed:    traffic.emergencySpeed(),
                layer:    3,
            };
            break;
        }
    }
}

// How fast an ambulance drives: faster than any car on the road
emergencySpeed :: method (traffic: *Traffic) -> f32 {
    return MaxCarSpeed * (1 + SpeedUpPerLevel * traffic.level as f32) * MaxSpawnSpeed * EmergencySpeed;
}

// Lights that flash red and blue
flashColor :: (time: f32, offset: f32) -> Color {
    if math.fmodf(time * 3 + offset, 1) < 0.5 { return {255, 40, 40, 255}; }
    return {40, 90, 255, 255};
}

// The ambulance's lights on its roof
drawEmergencyLights :: (assets: *Assets, car: *Car, time: f32) {
    top := car.position() + Vector3{0, car.height() + 0.25, 0};
    assets.drawBox(top + Vector3{-0.7, 0, 0}, {1.1, 0.4, 0.7}, flashColor(time, 0));
    assets.drawBox(top + Vector3{0.7, 0, 0}, {1.1, 0.4, 0.7}, flashColor(time, 0.5));
    // A red stripe along each side
    for side in [-1.0, 1.0] {
        assets.drawBox(car.position() + Vector3{side * (CarWidth * 0.5 + 0.02), 1.2, 0}, {0.05, 0.4, VanLength * 0.9}, {220, 30, 30, 255});
    }
}

// Where the ambulance will come: arrows that flash down the whole of its lane, from the far end, until it comes
drawEmergencyWarning :: (game: *Game) {
    if game.traffic.emergencyLane < 0 { return; }
    first, last := game.traffic.emergencyLanes();
    for lane in first...last {
        x := laneCenter(lane);
        color := flashColor(game.time, (lane - first) as f32 * 0.5);
        steps := 14;
        for k in 0..steps {
            z := -MapHalfLength + 3 + k as f32 * (MapHalfLength * 2 - 6) / steps as f32;
            // A wave that runs down the lane, the way the ambulance will come
            alpha := 0.15 + 0.55 * math.fmodf(k as f32 * 0.12 - game.time * 1.5 + 100, 1);
            tip := Vector3{x, 0.13, z + 2.5};
            DrawTriangle3D(tip, {x + 1.5, 0.13, z}, {x - 1.5, 0.13, z}, ColorAlpha(color, alpha));
        }
    }
}
