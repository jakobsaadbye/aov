namespace core;

// What is happening to a hero for a while: stunned, faded, hasted, turned into a toad, asleep, scared... Each kind has
// one slot on the hero; a new one of a kind that is already there lasts for the longer of the two. What each kind does
// is said once, in statusRules, and the game asks the hero (canAct, canCast, isTargetable, ...) instead of checking each
// kind itself. A new kind of status is a value of StatusKind, a line in statusRules, and where its amount or point is
// read, if it has one.

import math;
use raylib;

StatusKind :: enum {
    stun,           // Can't move or cast
    timeLock,       // Stunned, frozen in time (Mira)
    sleep,          // Stunned until it is shoved or hit, or the time is up (Hugo)
    fade,           // The cars drive through it, and enemies can't target it (Ghosty)
    hidden,         // In smoke: enemies can't target it (Kenji)
    haste,          // amount times as fast
    slow,           // amount slower, e.g 0.5 is half as fast
    hex,            // A toad: slow, and can't cast (Sigrid)
    blind,          // The screen is white; a bot can't see the cars (Tobias)
    taunt,          // Walks towards point (a rubber chicken)
    tangled,        // In yarn: amount slower (Gudrun)
    windedDown,     // After an energy drink: amount slower
    mending,        // Heals amount of its most health a second while it stands still (Ditte)
    sugarRush,      // amount times as fast, then winded down when it is over (an energy drink)
    igloo,          // In an igloo: stands still and heals, out of reach of cars and spells (Frosty)
    leashed,        // Tied to the hero of source: can't get further from it than amount (Gudrun)
    substitute,     // A log waits at point: a car that would hit the hero hits the log, and the hero is back at point (Kenji)
    trance,         // Walks slowly in a trance, and the cars go through it as if it weren't there (Hugo)
    berserk,        // A car that hits it is thrown a lane aside instead, for a little of its health (Ivar)
    repel,          // The cars that come near are pushed out of its way, into the lanes beside it (Magnus)
    crossing,       // The cars that come to it stop and wait until it has gone by (Gudrun)
    frozen,         // Frozen solid: can't move or cast (Frosty's cold snap)
    greased,        // Runs faster, from the oil it ran on, for a moment after it is off it (Karl)
}

Status :: struct {
    timeLeft: f32;
    duration: f32;              // How long it was put on for, to show how much of it is left
    amount:   f32;
    point:    Vector2;
    source:   int = -1;        // The player that did it, or -1
}

StatusRules :: struct {
    stops:        bool;     // Can't be given orders, and stands still
    silences:     bool;     // Can't cast
    untargetable: bool;     // Enemies' spells don't find it
    carsPass:     bool;     // The cars drive through it
    steers:       bool;     // Walks by itself, to or from its point
    harms:        bool;     // Done by an enemy: a car that gets it soon after gives that enemy the kill
    good:         bool;     // Good for the hero: green in the row of what is on it, else red
}

statusRules :: (kind: StatusKind) -> StatusRules {
    return switch kind {
        case .stun       => StatusRules{stops: true, silences: true, harms: true};
        case .timeLock   => StatusRules{stops: true, silences: true, harms: true};
        case .sleep      => StatusRules{stops: true, silences: true, harms: true};
        case .fade       => StatusRules{untargetable: true, carsPass: true, good: true};
        case .hidden     => StatusRules{untargetable: true, good: true};
        case .haste      => StatusRules{good: true};
        case .slow       => StatusRules{harms: true};
        case .hex        => StatusRules{silences: true, harms: true};
        case .blind      => StatusRules{harms: true};
        case .taunt      => StatusRules{steers: true, harms: true};
        case .tangled    => StatusRules{harms: true};
        case .windedDown => StatusRules{};
        case .mending    => StatusRules{good: true};
        case .sugarRush  => StatusRules{good: true};
        case .igloo      => StatusRules{stops: true, untargetable: true, carsPass: true, good: true};
        case .leashed    => StatusRules{harms: true};
        case .substitute => StatusRules{good: true};
        case .trance     => StatusRules{carsPass: true, good: true};
        case .berserk    => StatusRules{good: true};
        case .repel      => StatusRules{good: true};
        case .crossing   => StatusRules{good: true};
        case .frozen     => StatusRules{stops: true, silences: true, harms: true};
        case .greased    => StatusRules{good: true};
    };
}

// How a status is shown in the row of what is on a hero, and its tooltip
StatusLook :: struct {
    name:        string;
    description: string;
    icon:        string;
}

statusLook :: (kind: StatusKind) -> StatusLook {
    return switch kind {
        case .stun       => StatusLook{"Stunned", "Can't move or cast", "status_stun"};
        case .timeLock   => StatusLook{"Time Locked", "Frozen in time: can't move or cast", "time_lock"};
        case .sleep      => StatusLook{"Asleep", "Can't move or cast, until shoved or hit", "sleep"};
        case .fade       => StatusLook{"Faded", "The cars drive through, and enemies can't target", "fade"};
        case .hidden     => StatusLook{"Hidden", "Enemies can't target", "smoke_bomb"};
        case .haste      => StatusLook{"Haste", "Runs faster", "sprint"};
        case .slow       => StatusLook{"Slowed", "Walks slower", "status_slow"};
        case .hex        => StatusLook{"Hexed", "A toad: slow, and can't cast", "hex"};
        case .blind      => StatusLook{"Blinded", "Can't see", "flash_photo"};
        case .taunt      => StatusLook{"Taunted", "Walks towards what taunts it", "item_rubber_chicken"};
        case .tangled    => StatusLook{"Tangled", "Walks slower", "knitting"};
        case .windedDown => StatusLook{"Winded", "Walks slower, after a sugar rush", "status_winded"};
        case .mending    => StatusLook{"Mending", "Heals while standing still", "bandage"};
        case .sugarRush  => StatusLook{"Sugar Rush", "Runs much faster, for now", "item_energy_drink"};
        case .igloo      => StatusLook{"Igloo", "Safe inside, and healing: no car or spell gets in", "igloo"};
        case .leashed    => StatusLook{"Leashed", "Tied to an enemy: can't get far from it", "yarn_leash"};
        case .substitute => StatusLook{"Substitute", "A car that would hit takes a log instead, and back to the mark", "substitution"};
        case .trance     => StatusLook{"Trance", "Walks slowly, and the cars go through", "trance_walk"};
        case .berserk    => StatusLook{"Berserk", "A car that hits is thrown aside instead", "berserk"};
        case .repel      => StatusLook{"Repel", "The cars that come near are pushed aside", "repel"};
        case .crossing   => StatusLook{"Crossing", "The cars stop and wait until she has gone by", "grannys_crossing"};
        case .frozen     => StatusLook{"Frozen", "Frozen solid: can't move or cast", "freeze"};
        case .greased    => StatusLook{"Greased", "Runs 60% faster on oil, and for a moment after it", "grease_monkey"};
    };
}

// The statuses of a hero: a slot for each kind
Statuses :: struct {
    slots: [StatusKind.count]Status;
}

has :: method (hero: Hero, kind: StatusKind) -> bool {
    return hero.statuses.slots[kind].timeLeft > 0;
}

timeLeft :: method (hero: Hero, kind: StatusKind) -> f32 {
    return math.max(hero.statuses.slots[kind].timeLeft, 0);
}

status :: method (hero: Hero, kind: StatusKind) -> Status {
    return hero.statuses.slots[kind];
}

// Puts a status on the hero, for the longer of what is left and the new duration. An enemy's status is shorter on a hero
// with the trait stunTaken, and gives the enemy the kill if a car gets the hero soon after
addStatus :: method (hero: *Hero, kind: StatusKind, duration: f32, amount: f32 = 0, point := Vector2{0, 0}, source: int = -1, time: f32 = 0) {
    rules := statusRules(kind);
    if rules.stops || rules.steers || kind == .hex { duration *= hero.stats.stunTaken; }
    slot := &hero.statuses.slots[kind];
    if slot.timeLeft <= 0 || duration >= slot.timeLeft {
        slot.timeLeft = duration;
        slot.duration = duration;
        slot.amount = amount;
        slot.point = point;
        slot.source = source;
    }
    if rules.harms && source >= 0 {
        hero.harmedBy = source;
        hero.harmedAt = time;
    }
    if rules.stops || rules.steers {
        hero.stop();
        hero.hook = null;
    }
}

clearStatus :: method (hero: *Hero, kind: StatusKind) {
    hero.statuses.slots[kind].timeLeft = 0;
}

updateStatuses :: method (hero: *Hero, dt: f32) {
    rushing := hero.has(.sugarRush);
    for *slot in hero.statuses.slots { slot.timeLeft = math.max(0, slot.timeLeft - dt); }
    // The sugar rush is over: now it is tired
    if rushing && !hero.has(.sugarRush) { hero.addStatus(.windedDown, EnergyCrash, 0.35); }
}

EnergyCrash :: 2.0;     // Seconds it is slower after an energy drink

// Any of its statuses does this
anyStatus :: method (hero: Hero, test: (StatusRules) -> bool) -> bool {
    for kind in StatusKind.values {
        if hero.statuses.slots[kind].timeLeft > 0 && test(statusRules(kind)) { return true; }
    }
    return false;
}

isStopped :: method (hero: Hero) -> bool {
    return hero.anyStatus(rules => rules.stops);
}

isSilenced :: method (hero: Hero) -> bool {
    return hero.anyStatus(rules => rules.silences);
}

// Walking by itself, to a point: to what taunts it. Or nothing
steeredTo :: method (hero: Hero) -> ?Vector2 {
    if hero.has(.taunt)  { return hero.status(.taunt).point; }
    return null;
}

// How much its statuses make it faster or slower
statusSpeed :: method (hero: Hero) -> f32 {
    speed: f32 = 1;
    if hero.has(.haste)      { speed *= hero.status(.haste).amount; }
    if hero.has(.sugarRush)  { speed *= hero.status(.sugarRush).amount; }
    if hero.has(.slow)       { speed *= 1 - hero.status(.slow).amount; }
    if hero.has(.tangled)    { speed *= 1 - hero.status(.tangled).amount; }
    if hero.has(.windedDown) { speed *= 1 - hero.status(.windedDown).amount; }
    if hero.has(.hex)        { speed *= HexSpeed; }
    if hero.has(.trance)     { speed *= TranceSpeed; }
    return speed;
}

HexSpeed :: 0.55;
TranceSpeed :: 0.6;
