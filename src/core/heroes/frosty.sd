namespace core;

// Frosty: the cars slow down near him, and stop when he snaps his fingers, and so do his enemies, for a moment. When it
// gets too hot on the road, he builds himself an igloo and hides in it, healing, while the cars drive through

import math;
use raylib;

defineFrosty :: () -> HeroDefinition {
    hero := HeroDefinition{name: "Frosty", title: "the Snowman", color: {110, 220, 235, 255}, width: 2.6, height: 4.6, moveSpeed: 8, hitRadius: 0.7, maxHealth: 35};
    hero.abilities.add(Ability{
        name: "Cold snap", icon: "freeze", sound: "ability.freeze", cooldown: 10, cast: castFreeze, bot: .stopCars,
        description: "Freezes the cars around him for 2.5 seconds, and the enemies for 1.2",
        radius: 20, duration: 2.5, power: 1.2,
    });
    hero.abilities.add(Ability{
        name: "Igloo", icon: "igloo", sound: "ability.igloo", cooldown: 20, cast: castIgloo, bot: .untouchable,
        description: "Hides in an igloo for up to 10 seconds, healing 10% of his health a second. Nothing gets in: the cars drive through it, and no spell finds him. W again, or a move, and he comes out",
        duration: 10, radius: IglooRadius, power: 0.1, endsEarly: .igloo,
    });
    hero.abilities.add(passive("Chill aura", "chill", "Cars near him drive 40% slower", Trait{chillAura: {radius: 12, slow: 0.4}}));
    return hero;
}

IglooRadius :: 2.4;

castIgloo :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    hero.addStatus(.igloo, ability.duration);
    game.effects.particles.emit(.snow, hero.position + Vector3{0, 1.5, 0}, 40);
    return true;
}

// In the igloo he heals, power of his most health a second
updateIgloo :: method (game: *Game, index: int, dt: f32) {
    hero := &game.players[index].hero;
    if !hero.has(.igloo) { return; }
    heal := IglooHeal;
    for ability in hero.abilities() {
        if ability.endsEarly.hasValue() && ability.endsEarly.value() == .igloo { heal = ability.power; }
    }
    hero.health = math.min(hero.maxHealth(), hero.health + hero.maxHealth() * heal * dt);
}

IglooHeal :: 0.1;

// Seconds since he built his igloo
iglooAge :: (hero: *Hero) -> f32 {
    return hero.status(.igloo).duration - hero.timeLeft(.igloo);
}

IglooBuild :: 0.4;      // Seconds it takes to go up round him

// The model of tools/make_heroes.py, its door towards the side he is going: it grows up out of the snow round him with
// a little bounce, and slumps and spreads as it melts
drawIgloo :: (assets: *Assets, hero: *Hero) {
    t := math.min(iglooAge(hero) / IglooBuild, 1);
    melt := math.min(hero.timeLeft(.igloo) / 0.4, 1);
    tall := (t + math.sinf(t * Pi) * 0.15) * melt;
    wide := (0.8 + 0.2 * t) * (1 + 0.12 * (1 - melt));
    angle: f32 = 0;
    if hero.goalSign < 0 { angle = 180; }
    DrawModelEx(assets.igloo, hero.position, {0, 1, 0}, angle, {wide, tall, wide}, White);
}
