namespace core;

// Frosty: the cars slow down near him, and stop when he snaps his fingers. When it gets too hot on the road, he builds
// himself an igloo

import math;
use raylib;

defineFrosty :: () -> HeroDefinition {
    hero := HeroDefinition{name: "Frosty", title: "the Snowman", color: {110, 220, 235, 255}, width: 2.6, height: 4.6, moveSpeed: 8, hitRadius: 0.7, maxHealth: 35};
    hero.abilities.add(Ability{
        name: "Cold snap", icon: "freeze", sound: "ability.freeze", cooldown: 10, cast: castFreeze, bot: .stopCars,
        description: "Freezes the cars around him for 2.5 seconds",
        radius: 20, duration: 2.5,
    });
    hero.abilities.add(Ability{
        name: "Igloo", icon: "igloo", sound: "ability.freeze", cooldown: 13, cast: castIgloo, bot: .untouchable,
        description: "Builds an igloo round himself for 3 seconds. Nothing gets in: no car, no spell. A car that drives into it is stuck in the ice until it melts. He can't move meanwhile",
        duration: 3, radius: IglooRadius,
    });
    hero.abilities.add(passive("Chill aura", "chill", "Cars near him drive 40% slower", Trait{chillAura: {radius: 12, slow: 0.4}}));
    return hero;
}

IglooRadius :: 2.4;

castIgloo :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    hero.addStatus(.igloo, ability.duration);
    game.effects.particles.emit(.snow, hero.position + Vector3{0, 1.5, 0}, 40);
    return true;
}

// The cars that run into an igloo are stuck in it until it melts
holdCarsAtIgloo :: method (game: *Game, index: int) {
    hero := &game.players[index].hero;
    if !hero.has(.igloo) { return; }
    for *car in game.traffic.cars {
        if !car.isActive || car.kind == .ambulance { continue; }
        if CheckCollisionCircleRec(hero.ground(), IglooRadius, car.rect()) {
            car.frozenLeft = math.max(car.frozenLeft, hero.timeLeft(.igloo));
        }
    }
}

drawIgloo :: (hero: *Hero) {
    melt := math.min(hero.timeLeft(.igloo) / 0.4, 1);
    at := hero.position;
    DrawSphereEx(at, IglooRadius * melt, 12, 12, {235, 245, 255, 255});
    // The blocks of snow, and the door towards the far side
    for k in 1..4 { DrawCircle3D(at + Vector3{0, k as f32 * 0.55 * melt, 0}, IglooRadius * melt * math.sqrtf(1 - (k as f32 * 0.23) * (k as f32 * 0.23)), {1, 0, 0}, 90, {180, 200, 220, 255}); }
    DrawCube(at + Vector3{hero.goalSign * IglooRadius * 0.85 * melt, 0.6 * melt, 0}, 0.8 * melt, 1.2 * melt, 1.1 * melt, {60, 70, 90, 255});
}
