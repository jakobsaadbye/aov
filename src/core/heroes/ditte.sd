namespace core;

// Ditte the Paramedic: the ambulances know her and drive round her. She calls one down any lane she likes, and
// patches herself up

use raylib;

defineDitte :: () -> HeroDefinition {
    hero := HeroDefinition{name: "Ditte", title: "the Paramedic", color: {230, 230, 235, 255}, width: 2.3, height: 4.3, moveSpeed: 8, hitRadius: 0.75, maxHealth: 35};
    hero.abilities.add(Ability{
        name: "Call it in", icon: "call_ambulance", sound: "ability.radio", cooldown: 14, targeting: .point, cast: castCallAmbulance, bot: .disableEnemy,
        description: "Calls an ambulance down the lane at the cursor. It comes fast, from the far end of the road",
        range: 60,
    });
    hero.abilities.add(Ability{
        name: "Bandage", icon: "bandage", sound: "ability.bandage", cooldown: 12, cast: castBandage, bot: .heal,
        description: "Bandages herself: heals 36% of her health over 3 seconds, while she stands still",
        duration: 3, power: 0.12,
    });
    hero.abilities.add(passive("Colleague", "colleague", "The ambulances know her: they never hit her", .ambulanceProof));
    return hero;
}

castCallAmbulance :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    point := towards(hero.ground(), target, hero.reach(ability.range)) ?? hero.ground();
    if math.fabsf(point.x) > RoadHalfWidth { return false; }
    lane := laneAt(point.x);
    game.traffic.spawnAmbulance(lane);
    game.sounds.playAt("traffic.siren", Vector3{laneCenter(lane), 0, -MapHalfLength}, 0.7);
    game.announce(caster, {255, 90, 90, 255}, "% called an ambulance", hero.info().name);
    return true;
}

castBandage :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    hero.stop();
    hero.addStatus(.mending, ability.duration, ability.power);
    return true;
}
