namespace core;

// Magnus the Magnet: a man of steel. He turns his poles round and the cars are pushed out of his way, he pulls his enemies
// in to him, and nothing pushes him

import math;
use raylib;

defineMagnus :: () -> HeroDefinition {
    hero := HeroDefinition{name: "Magnus", title: "the Magnet", color: {150, 155, 170, 255}, width: 3.6, height: 5.6, moveSpeed: 7.2, hitRadius: 0.9, maxHealth: 65};
    hero.abilities.add(Ability{
        name: "Repel", icon: "repel", sound: "ability.repel", cooldown: 12, cast: castRepel, bot: .stopCars,
        description: "Turns his poles round for 2.5 seconds: the cars that come within 8 of him are pushed out of his way, into the lanes beside his. Whoever is there had better watch out",
        duration: 2.5, radius: RepelRadius,
    });
    hero.abilities.add(Ability{
        name: "Attract", icon: "attract", sound: "ability.attract", cooldown: 12, targeting: .enemy, cast: castAttract, bot: .pullEnemy,
        description: "Pulls the enemy nearest the cursor, up to 32 away, right up to him, through whatever is in the way",
        range: 32,
    });
    hero.abilities.add(passive("Steel frame", "steel_frame", "Too heavy to move: nobody shoves him, and nothing knocks him away", .unshovable));
    return hero;
}

RepelRadius :: 8.0;

castRepel :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    hero.addStatus(.repel, ability.duration);
    game.effects.addRing(hero.ground(), 1, RepelRadius, {120, 170, 255, 255}, 0.35);
    game.effects.particles.emit(.sparks, hero.position + Vector3{0, 2.5, 0}, 20, tint: {150, 190, 255, 255});
    return true;
}

// The cars that come near a hero who repels them, and would hit him, are pushed into a lane beside his, away from him
repelCars :: method (game: *Game, index: int) {
    hero := &game.players[index].hero;
    if !hero.has(.repel) { return; }
    ground := hero.ground();
    reach := CarWidth * 0.5 + hero.info().hitRadius + 1;
    for *car, c in game.traffic.cars {
        if !car.isActive || car.kind == .ambulance || car.kind == .bus || car.fromLane >= 0 { continue; }
        if math.fabsf(car.x() - ground.x) > reach { continue; }                     // Not in his way
        if car.z - car.length() * 0.5 > ground.y + hero.info().hitRadius { continue; }  // Gone past
        if !CheckCollisionCircleRec(ground, RepelRadius, car.rect()) { continue; }
        side := 1;
        if car.x() < ground.x { side = -1; }
        if car.lane + side < 0 || car.lane + side >= LaneCount { side = -side; }
        game.traffic.moveToLane(c as int, car.lane + side);
        game.effects.particles.emit(.sparks, car.position() + Vector3{0, car.height(), 0}, 8, tint: {150, 190, 255, 255});
    }
}

castAttract :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    victim := game.spellTarget(caster, ability, target);
    if victim < 0 { return spent(victim); }
    enemy := &game.players[victim].hero;
    if enemy.stats.unshovable { return true; }
    toward := enemy.ground() - hero.ground();
    if toward.length() < 0.1 { return true; }
    stop := hero.ground() + toward.normalize() * (hero.info().hitRadius + enemy.info().hitRadius + 0.6);
    enemy.displacement = Displacement{to: stop.at(), speed: KnockbackSpeed};
    enemy.clearStatus(.sleep);
    enemy.stop();
    enemy.hook = null;
    enemy.harmedBy = caster;
    enemy.harmedAt = game.time;
    hero.attracting = victim;
    hero.attractedAt = game.time;
    toTarget := enemy.ground() - hero.ground();
    if !hero.isMoving { hero.facing = math.atan2f(toTarget.x, toTarget.y); }     // His magnet at it
    game.announce(victim, {200, 210, 255, 255}, "% was pulled in by Magnus (%)!", enemy.info().name, game.players[caster].name);
    return true;
}

// While Magnus pulls an enemy in, lines of his field run from the poles of his magnet to it: blue arcs that ripple
// towards him, and sparks round the enemy. From the hand of his model, so they come out of the magnet he holds out
drawMagnetPull :: (game: *Game, assets: *Assets, index: int, bob: f32) {
    hero := &game.players[index].hero;
    if hero.attracting < 0 || hero.attracting >= game.players.count { return; }
    since := game.time - hero.attractedAt;
    if since < 0 || since > AttractShown { return; }
    victim := &game.players[hero.attracting];
    if !victim.isPlaying() { return; }
    if !victim.hero.displacement.hasValue() && since > 0.3 { return; }
    forward := Vector3{math.sinf(hero.facing), 0, math.cosf(hero.facing)};
    hand := assets.heroHand(hero.kind, hero.position + Vector3{0, bob, 0}, hero.facing) ?? (hero.position + Vector3{0, 3, 0});
    from := hand + forward * 1.4;
    to := victim.hero.position + Vector3{0, victim.hero.info().height * 0.5, 0};
    along := to - from;
    length := Vector3Length(along);
    if length < 0.5 { return; }
    side := Vector3Normalize(Vector3CrossProduct(along, {0, 1, 0}));
    fade := math.min((AttractShown - since) / 0.2, 1);
    Steps :: 14;
    for line in 0..3 {
        bend := (line as f32 - 1) * 0.9;
        previous := from;
        for k in 1..(Steps + 1) {
            t := k as f32 / Steps as f32;
            wave := math.sinf(t * Pi) * (bend + 0.25 * math.sinf(game.time * 18 + t * 9 + line as f32 * 2));
            point := from + along * t + side * wave + Vector3{0, math.sinf(t * Pi) * 0.4 * (line as f32 - 1), 0};
            pulse := 0.5 + 0.5 * math.sinf(t * 12 + game.time * 20);
            DrawCylinderEx(previous, point, 0.07, 0.07, 4, ColorAlpha({120 + (pulse * 100) as u8, 180, 255, 255}, fade * (0.55 + 0.4 * pulse)));
            previous = point;
        }
    }
}

AttractShown :: 1.2;        // Seconds at most that the field is drawn
