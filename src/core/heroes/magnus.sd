namespace core;

// Magnus the Magnet: a man of steel. He turns a car into a magnet for his enemies, pulls them in to him, and
// nothing pushes him

import math;
use raylib;

defineMagnus :: () -> HeroDefinition {
    hero := HeroDefinition{name: "Magnus", title: "the Magnet", color: {150, 155, 170, 255}, width: 3.6, height: 5.6, moveSpeed: 7.2, hitRadius: 1.05, maxHealth: 65};
    hero.abilities.add(Ability{
        name: "Magnetize", icon: "magnetize", sound: "ability.repel", cooldown: 12, targeting: .point, cast: castMagnetize, bot: .dropTrap,
        description: "Magnetizes the car nearest the cursor, up to 16 away, for 5 seconds: it pulls his enemies within 9 of it towards it",
        range: 16, duration: 5, power: 4.5,
    });
    hero.abilities.add(Ability{
        name: "Attract", icon: "attract", sound: "ability.attract", cooldown: 12, targeting: .enemy, cast: castAttract, bot: .pullEnemy,
        description: "Pulls the enemy nearest the cursor, up to 16 away, right up to him, through whatever is in the way",
        range: 16,
    });
    hero.abilities.add(passive("Steel frame", "steel_frame", "Too heavy to move: nobody shoves him, and nothing knocks him away", .unshovable));
    return hero;
}

MagnetRadius :: 9.0;

castMagnetize :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    aim := towards(hero.ground(), target, hero.reach(ability.range)) ?? hero.ground();
    index := game.traffic.carNear(aim, 6);
    if index < 0 { return false; }
    car := &game.traffic.cars[index];
    car.magnetLeft = ability.duration + hero.stats.coldBlooded;
    car.magnetOwner = caster;
    car.magnetPull = ability.power;
    game.effects.addRing(car.position().xz(), 0.5, MagnetRadius, {200, 210, 255, 255}, 0.4);
    game.effects.particles.emit(.sparks, car.position() + Vector3{0, car.height(), 0}, 16);
    return true;
}

// The magnetized cars pull the enemies of their magnet's owner in
pullToMagnets :: method (game: *Game, dt: f32) {
    for car in game.traffic.cars {
        if !car.isActive || car.magnetLeft <= 0 || car.magnetOwner < 0 { continue; }
        center := car.position().xz();
        for *player, i in game.players {
            if i as int == car.magnetOwner || !player.isPlaying() { continue; }
            hero := &player.hero;
            if hero.stats.unshovable || hero.isAirborne() || !hero.isTargetable() { continue; }
            offset := center - hero.ground();
            distance := offset.length();
            if distance > MagnetRadius || distance < 0.5 { continue; }
            step := offset.normalize() * math.min(car.magnetPull * dt, distance);
            hero.position = game.world.resolveCollisions(hero.ground() + step, hero.info().hitRadius, hero.stats.throughWalls).at(hero.position.y);
            hero.harmedBy = car.magnetOwner;
            hero.harmedAt = game.time;
        }
    }
}

castAttract :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    victim := game.spellTarget(caster, ability, target);
    if victim < 0 { return spent(victim); }
    enemy := &game.players[victim].hero;
    if enemy.stats.unshovable { return true; }
    toward := enemy.ground() - hero.ground();
    if toward.length() < 0.1 { return true; }
    stop := hero.ground() + toward.normalize() * (hero.info().hitRadius + enemy.info().hitRadius + 0.6);
    enemy.displacement = Displacement{to: stop.at(), speed: KnockbackSpeed};
    enemy.clearStatus(.sleep);
    enemy.stop();
    enemy.hook = null;
    enemy.harmedBy = caster;
    enemy.harmedAt = game.time;
    game.announce(victim, {200, 210, 255, 255}, "% was pulled in by Magnus (%)!", enemy.info().name, game.players[caster].name);
    return true;
}
