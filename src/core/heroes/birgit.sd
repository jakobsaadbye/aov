namespace core;

// Birgit the Builder: she puts a footbridge over the road and trampolines by it, that anyone can use

import math;
use raylib;

defineBirgit :: () -> HeroDefinition {
    hero := HeroDefinition{name: "Birgit", title: "the Builder", color: {245, 160, 40, 255}, width: 2.4, height: 4.4, moveSpeed: 7.8, hitRadius: 0.8, maxHealth: 40};
    hero.abilities.add(Ability{
        name: "Footbridge", icon: "footbridge", sound: "ability.footbridge", cooldown: 14, targeting: .point, cast: castFootbridge, bot: .stopCarsAhead,
        description: "Builds a footbridge over the three lanes at the cursor, up to 20 away, for 5 seconds. Anyone on it is safe from the cars. Enemies too",
        range: 20, duration: 5, count: 3,
    });
    hero.abilities.add(Ability{
        name: "Trampoline", icon: "trampoline", sound: "ability.trampoline", cooldown: 9, targeting: .point, cast: castTrampoline, bot: .none,
        description: "Puts a trampoline at the cursor, up to 24 away, for 8 seconds. Anyone that walks onto it is bounced 12 on the way it walks, high over the cars. Enemies too",
        range: 24, duration: 8, power: 12,
    });
    hero.abilities.add(passive("Overtime", "overtime", "She builds to last: what she builds stays up 50% longer", Trait{buildTime: 1.5}));
    return hero;
}

castFootbridge :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    point := towards(hero.ground(), target, hero.reach(ability.range)) ?? hero.ground();
    if math.fabsf(point.x) > RoadHalfWidth { return false; }
    faceTowards(hero, point);         // She slams her hammer down towards it
    lane := laneAt(point.x);
    halfWidth := LaneWidth * ability.count as f32 * 0.5 + RampLength;
    // On the road, not over the walls
    center := Vector2{math.clamp(laneCenter(lane), -RoadHalfWidth + halfWidth, RoadHalfWidth - halfWidth), point.y};
    game.bridges.add(Bridge{center: center, halfWidth: halfWidth, halfLength: 2.2, timeLeft: ability.duration * hero.stats.buildTime, owner: caster});
    game.effects.particles.emit(.dust, center.at(0.5), 30);
    return true;
}

castTrampoline :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    point := towards(hero.ground(), target, hero.reach(ability.range)) ?? hero.ground();
    point = game.world.resolveCollisions(point, TrampolineRadius, false);
    faceTowards(hero, point);         // and tosses it out towards where it lands
    // It flies from her hand, as she swings it forward, and bounces no one until it is down
    hand := hero.position + Vector3{math.sinf(hero.facing) * 0.8, 2.6, math.cosf(hero.facing) * 0.8};
    game.trampolines.add(Trampoline{position: point, timeLeft: ability.duration * hero.stats.buildTime, power: ability.power, from: hand});
    return true;
}

// Turns a hero that stands still to a point, e.g to what she builds. One that walks keeps the way it walks
faceTowards :: (hero: *Hero, point: Vector2) {
    toward := point - hero.ground();
    if !hero.isMoving && toward.length() > 0.1 { hero.facing = math.atan2f(toward.x, toward.y); }
}

// A trampoline: anyone that walks onto it is bounced on, the way it walks
Trampoline :: struct {
    position: Vector2;
    timeLeft: f32;
    power:    f32;              // How far it bounces
    age:      f32;              // Seconds since it was tossed: it flies, lands at TrampolineLands and pops up
    bounced:  f32 = 100;        // Seconds since it last bounced someone, for how its mat dips
    from:     Vector3;          // Where it was tossed from
}

TrampolineThrown :: 0.2;    // Seconds into her toss that it leaves her hand
TrampolineLands  :: 0.5;    // and that it lands

// Down, where it bounces
hasLanded :: method (trampoline: Trampoline) -> bool {
    return trampoline.age >= TrampolineLands;
}

TrampolineRadius :: 1.4;
TrampolineAir    :: 0.7;        // Seconds a bounce takes
TrampolineHeight :: 6.0;

updateTrampolines :: method (game: *Game, dt: f32) {
    for *trampoline in game.trampolines {
        trampoline.timeLeft -= dt;
        before := trampoline.hasLanded();
        trampoline.age += dt;
        trampoline.bounced += dt;
        if !before && trampoline.hasLanded() { game.effects.particles.emit(.dust, trampoline.position.at(0.5), 16); }
    }
    game.trampolines.removeWhere(trampoline => trampoline.timeLeft <= 0);
}

bounceOnTrampoline :: method (game: *Game, index: int) {
    hero := &game.players[index].hero;
    if !hero.isMoving || hero.isAirborne() { return; }
    for *trampoline in game.trampolines {
        if !trampoline.hasLanded() || hero.ground().distance(trampoline.position) > TrampolineRadius + hero.info().hitRadius * 0.5 { continue; }
        heading := hero.target.xz() - hero.ground();
        if heading.length() < 0.1 { return; }
        to := hero.ground() + heading.normalize() * trampoline.power;
        hero.startLeap(to, TrampolineAir, TrampolineHeight);
        trampoline.bounced = 0;
        game.effects.particles.emit(.dust, trampoline.position.at(0.5), 10);
        game.sounds.playAt("ability.leap", hero.position, 0.9, 0.1);
        return;
    }
}

// The model of tools/make_heroes.py: folded small, it flies in an arc from her hand, tumbling, then pops up where it
// lands with a wobble. Its mat dips when it bounces someone, and it folds away at the end
drawTrampolines :: (game: *Game, assets: *Assets) {
    for trampoline in game.trampolines {
        base := trampoline.position.at(0);
        if trampoline.age < TrampolineThrown { continue; }
        if !trampoline.hasLanded() {
            k := (trampoline.age - TrampolineThrown) / (TrampolineLands - TrampolineThrown);
            at := Vector3Lerp(trampoline.from, base, k) + Vector3{0, math.sinf(k * Pi) * 3, 0};
            DrawModelEx(assets.trampoline, at, {1, 0, 0.3}, k * 540, {0.35, 0.35, 0.35}, White);
            continue;
        }
        t := math.min((trampoline.age - TrampolineLands) / TrampolinePop, 1);
        size := (t + math.sinf(t * Pi) * 0.3) * math.min(trampoline.timeLeft * 3, 1);
        if size <= 0.01 { continue; }
        DrawModelEx(assets.trampoline, base, {0, 1, 0}, 0, {size, size, size}, White);
        dip: f32 = 0;
        if trampoline.bounced < TrampolineDip { dip = math.sinf(trampoline.bounced / TrampolineDip * Pi) * 0.3; }
        DrawModelEx(assets.trampolineMat, base - Vector3{0, dip * size, 0}, {0, 1, 0}, 0, {size, size, size}, White);
    }
}

TrampolinePop :: 0.25;      // Seconds it takes to pop up
TrampolineDip :: 0.35;      // and for its mat to dip and spring back
