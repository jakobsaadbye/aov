namespace core;

// Allan: quick on his feet, and quicker when he sprints. The hero of the game's name

defineAllan :: () -> HeroDefinition {
    hero := HeroDefinition{name: "Allan", title: "the Runner", color: {214, 48, 49, 255}, width: 2.2, height: 4.2, moveSpeed: 9, hitRadius: 0.75, maxHealth: 25};
    hero.abilities.add(Ability{
        name: "Sprint", icon: "sprint", sound: "ability.sprint", cooldown: 6, cast: castSprint, bot: .speedUp,
        description: "Runs twice as fast for a moment",
        power: 2.1, duration: 1.4,
    });
    hero.abilities.add(passive("Quick feet", "quick_feet", "Walks 10% faster than he looks", Trait{speed: 1.1}));
    return hero;
}
