namespace core;

// Gudrun the Grandmother: slow, but hard to break. The cars stop for her when she crosses, her yarn ties the young ones to
// her, and who tries to push her over falls over her cane

import math;
use raylib;

defineGudrun :: () -> HeroDefinition {
    hero := HeroDefinition{name: "Gudrun", title: "the Grandmother", color: {170, 110, 170, 255}, width: 2.3, height: 3.6, moveSpeed: 6.2, hitRadius: 0.85, maxHealth: 80, drawExtras: drawGudrun};
    hero.abilities.add(Ability{
        name:        "Granny's crossing", icon: "grannys_crossing", sound: "ability.grannys_crossing", cooldown: 12, cast: castGrannysCrossing, bot: .stopCars,
        description: "Nobody runs over a grandmother: for 4 seconds, the cars that come to her stop and wait until she has gone by",
        duration:    4,
    });
    hero.abilities.add(Ability{
        name:        "Yarn leash", icon: "yarn_leash", sound: "ability.yarn_leash", cooldown: 12, targeting: .enemy, cast: castYarnLeash, bot: .disableEnemy,
        description: "Ties the enemy nearest the cursor, up to 24 away, to her with yarn for 5 seconds: it can't get further from her than it is now. Where she walks, it comes along",
        range:       24, duration: 5,
    });
    hero.abilities.add(passive("Mind the cane", "mind_the_cane", "Nobody pushes her: who walks into her trips over her cane, and lies still for a second", .tripsShovers));
    return hero;
}

LeashShortest :: 3.0;
CaneTripTime :: 1.0;

castGrannysCrossing :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    hero.addStatus(.crossing, ability.duration);
    game.effects.addRing(hero.ground(), 1, 4, {255, 255, 255, 255}, 0.35);
    return true;
}

// The cars that come to a grandmother who is crossing stop, a little before her, until she is out of their way. One that
// is already on her doesn't stop in time
GrannyBrakeGap :: 4.0;      // How far before her they stop, at the most

waitForGranny :: method (game: *Game, index: int) {
    hero := &game.players[index].hero;
    if !hero.has(.crossing) { return; }
    ground := hero.ground();
    radius := hero.info().hitRadius;
    reach := CarWidth * 0.5 + radius + 0.6;
    for *car in game.traffic.cars {
        if !car.isActive || car.kind == .ambulance { continue; }
        if math.fabsf(car.x() - ground.x) > reach { continue; }
        gap := ground.y - radius - (car.z + car.length() * 0.5);
        if gap < -0.3 || gap > GrannyBrakeGap { continue; }
        car.frozenLeft = math.max(car.frozenLeft, 0.15);
    }
}

tripOverCane :: method (game: *Game, victim: int, gudrun: int, duration: f32) {
    enemy := &game.players[victim].hero;
    enemy.addStatus(.stun, duration, source: gudrun, time: game.time);
    enemy.stop();
    game.effects.particles.emit(.shove, enemy.position + Vector3{0, 1, 0}, 10);
    game.sounds.playAt("ability.cane", enemy.position);
    game.announce(victim, {200, 150, 200, 255}, "% tripped over Gudrun's cane!", game.players[victim].name);
}

castYarnLeash :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    victim := game.spellTarget(caster, ability, target);
    if victim < 0 { return spent(victim); }
    enemy := &game.players[victim].hero;
    length := math.max(enemy.ground().distance(hero.ground()), LeashShortest);
    enemy.addStatus(.leashed, ability.duration, length, source: caster, time: game.time);
    game.effects.particles.emit(.wisps, enemy.position + Vector3{0, 1, 0}, 16, tint: {230, 90, 160, 255});
    return true;
}

// A hero on a leash is pulled back to within its length of the one who holds it
holdLeash :: method (game: *Game, index: int) {
    hero := &game.players[index].hero;
    if !hero.has(.leashed) { return; }
    leash := hero.status(.leashed);
    holder := leash.source;
    if holder < 0 || !game.players[holder].isPlaying() { hero.clearStatus(.leashed); return; }
    center := game.players[holder].hero.ground();
    offset := hero.ground() - center;
    if offset.length() <= leash.amount { return; }
    pulled := center + offset.normalize() * leash.amount;
    hero.position = game.world.resolveCollisions(pulled, hero.info().hitRadius, hero.stats.throughWalls).at(hero.position.y);
}

// A zebra crossing under her while she crosses, and the yarn from her to everyone she has on a leash
drawGudrun :: (game: *Game, index: int, bob: f32) {
    gudrun := &game.players[index].hero;
    if gudrun.has(.crossing) {
        fade := math.min(gudrun.timeLeft(.crossing) / 0.4, 1);
        for k in -3...3 {
            DrawCube(gudrun.position + Vector3{k as f32 * 1.1, 0.12, 0}, 0.6, 0.02, 3.2, ColorAlpha({250, 250, 250, 255}, 0.85 * fade));
        }
    }
    hand := gudrun.position + Vector3{0, bob + 2.2, 0};
    for *player in game.players {
        if !player.isPlaying() { continue; }
        if !player.hero.has(.leashed) || player.hero.status(.leashed).source != index { continue; }
        other := player.hero.position + Vector3{0, 1.6, 0};
        middle := (hand + other) * 0.5 - Vector3{0, 0.6, 0};
        DrawCylinderEx(hand, middle, 0.06, 0.06, 4, {230, 90, 160, 255});
        DrawCylinderEx(middle, other, 0.06, 0.06, 4, {230, 90, 160, 255});
    }
}
