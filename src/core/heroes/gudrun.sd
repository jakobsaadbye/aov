namespace core;

// Gudrun the Grandmother: slow, but hard to break. The cars brake for her, and her cane and her knitting get the young
// ones out of her way

use raylib;

defineGudrun :: () -> HeroDefinition {
    hero := HeroDefinition{name: "Gudrun", title: "the Grandmother", color: {170, 110, 170, 255}, width: 2.6, height: 4.0, moveSpeed: 6.2, hitRadius: 0.85, maxHealth: 80};
    hero.abilities.add(Ability{
        name: "Cane trip", icon: "cane_trip", sound: "ability.cane", cooldown: 8, cast: castCaneTrip, bot: .disableEnemy,
        description: "Hooks her cane round the nearest enemy within 3.5: it falls over, and can't move for 1.2 seconds",
        range: 3.5, duration: 1.2,
    });
    hero.abilities.add(Ability{
        name: "Knitting", icon: "knitting", sound: "ability.knit", cooldown: 10, targeting: .enemy, cast: castKnitting, bot: .disableEnemy,
        description: "Throws her ball of yarn at the enemy nearest the cursor, up to 12 away: tangled, it walks half as fast for 3 seconds",
        range: 12, duration: 3, power: 0.5,
    });
    hero.abilities.add(passive("Respect your elders", "respect", "The cars slow right down when she is on the road in front of them", Trait{carsBrake: 9}));
    return hero;
}

castCaneTrip :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    victim := game.enemyNear(caster, hero.ground(), hero.reach(ability.range));
    if victim < 0 { return false; }
    enemy := &game.players[victim].hero;
    enemy.addStatus(.stun, ability.duration, source: caster, time: game.time);
    game.effects.particles.emit(.shove, enemy.position + Vector3{0, 1, 0}, 10);
    game.announce(victim, {200, 150, 200, 255}, "% tripped over Gudrun's cane!", game.players[victim].name);
    return true;
}

castKnitting :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    victim := game.spellTarget(caster, ability, target);
    if victim < 0 { return spent(victim); }
    enemy := &game.players[victim].hero;
    enemy.addStatus(.tangled, ability.duration, ability.power, source: caster, time: game.time);
    game.effects.particles.emit(.wisps, enemy.position + Vector3{0, 1, 0}, 16, tint: {230, 90, 160, 255});
    return true;
}
