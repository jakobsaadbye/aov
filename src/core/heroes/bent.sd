namespace core;

// Bent the Bus Driver: he knows the timetable by heart, hops onto passing cars, and honks people out of his way

import math;
use raylib;

defineBent :: () -> HeroDefinition {
    hero := HeroDefinition{name: "Bent", title: "the Bus Driver", color: {40, 140, 90, 255}, width: 2.8, height: 4.3, moveSpeed: 7.5, hitRadius: 0.95, maxHealth: 55};
    hero.abilities.add(Ability{
        name: "Hop on", icon: "hop_on", sound: "ability.hop_on", cooldown: 11, cast: castHopOn, bot: .untouchable,
        description: "Climbs onto the roof of the nearest car, within 5, and rides it for up to 2.5 seconds. Then he jumps off towards the far side",
        range: 5, duration: 2.5,
    });
    hero.abilities.add(Ability{
        name: "Honk", icon: "honk", sound: "ability.honk", cooldown: 9, cast: castHonk, bot: .knockEnemy,
        description: "Honks the horn: every enemy within 8 jumps 5 away from him",
        range: 8, power: 5, duration: 0.3,
    });
    hero.abilities.add(passive("Timetable", "timetable", "He knows when the next cars come: the lanes light up before a car comes onto the field", .timetable));
    return hero;
}

castHopOn :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    car := game.traffic.carNear(hero.ground(), hero.reach(ability.range));
    if car < 0 { return false; }
    game.startRide(caster, car, ability.duration);
    return true;
}

castHonk :: (game: *Game, caster: int, ability: *Ability, target: Vector2) -> bool {
    hero := &game.players[caster].hero;
    ground := hero.ground();
    range := hero.reach(ability.range);
    for *player, i in game.players {
        if i as int == caster || !player.isPlaying() || !player.hero.isTargetable() { continue; }
        if player.hero.ground().distance(ground) > range { continue; }
        player.hero.addStatus(.stun, ability.duration, source: caster, time: game.time);
        game.knockAway(i as int, ground, ability.power, caster);
    }
    game.effects.addRing(ground, 1, range, {255, 230, 120, 255}, 0.35);
    game.effects.addRing(ground, 0.5, range * 0.6, {255, 230, 120, 255}, 0.25);
    return true;
}
