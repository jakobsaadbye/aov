namespace core;

import fmt;
import math;
use raylib;

// The textures, models and the shader of the game, from the data folder of the repository

Assets :: struct {
    lighting: Lighting;
    lit:      Material;     // The lit material that the lane markings are drawn with
    cube:     Mesh;         // A 1x1x1 cube, scaled to make the walls and the lane markings

    ground:          Mesh;  // The field
    groundMaterial:  Material;
    road:            Mesh;
    laneMarkings:    Mesh;  // All of the lines on the road (render.sd)
    laneMarkingsMaterial: Material;
    roadMaterial:    Material;
    outside:         Mesh;  // The land around the field, to the horizon
    outsideMaterial: Material;

    vehicles: [CarKind.count]Model;
    particleTextures: [ParticleTexture.count]Texture;
    vehicleBody: [CarKind.count]int;   // The material of each vehicle that gets the color of the car
    heroes:   [HeroKind.count]Model;
    heroAnimations: [HeroKind.count]HeroAnimations;    // The clips of the heroes whose models have skeletons (hero_animation.sd)
    portrait: RenderTexture;          // The hero of the HUD, drawn in 3D
    wall:     Model;                   // A segment of the wall, repeated along it
    meatHook:  Model;                  // The Butcher's hook as it flies, and a link of its chain (tools/make_heroes.py)
    chainLink: Model;
    footbridgeSpan: Model;             // Birgit's builds: a lane of her footbridge, its ramp, a trampoline and its mat
    footbridgeRamp: Model;
    trampoline:     Model;
    trampolineMat:  Model;

    icons: Map<string, Texture>;       // The icon of each ability, by its name in heroes.sd

    sceneryModels: [SceneryKind.count]Model;
    scenery:       [..]Decoration;
    cityBlocks:    [..]Rectangle;

    cursor: Texture;
}

// The data folder is next to src, and the program is in src/build, so it is found from wherever the game is started
// The data folder, until the end of the frame (temp.sd)
dataFolder :: () -> string {
    return tprint("%../../data/", GetApplicationDirectory().toString());
}

// A file of the data folder, for raylib, until the end of the frame
dataPath :: (file: string) -> c.string {
    return tempCString(tprint("%../../data/%", GetApplicationDirectory().toString(), file));
}

loadAssets :: () -> Assets {
    assets: Assets;

    assets.lighting = newLighting();
    assets.cube     = GenMeshCube(1, 1, 1);
    assets.lit      = assets.lighting.newMaterial(White);

    // The field: the pavement of a city, slabs of 2.5 meters, 8 by 8 in the texture
    pavement := loadTexture("textures/pavement/pavement.png");
    assets.ground = GenMeshPlane(MapHalfWidth * 2, MapHalfLength * 2, 1, 1);
    tileTexture(&assets.ground, MapHalfWidth * 2 / 20, MapHalfLength * 2 / 20);
    assets.groundMaterial = assets.lighting.newMaterial(White);
    assets.groundMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture = pavement;

    // The streets of the city around it, darker, so the field stands out
    assets.outside = GenMeshPlane(900, 900, 1, 1);
    tileTexture(&assets.outside, 56, 56);
    assets.outsideMaterial = assets.lighting.newMaterial({140, 140, 148, 255});
    assets.outsideMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture = loadTexture("textures/road/asphalt.png");

    // The road: asphalt, a tile every 16
    assets.road = GenMeshPlane(RoadHalfWidth * 2, RoadEnd * 2, 1, 1);
    tileTexture(&assets.road, RoadHalfWidth * 2 / 16, RoadEnd * 2 / 16);
    assets.roadMaterial = assets.lighting.newMaterial(White);
    assets.roadMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture = loadTexture("textures/road/asphalt.png");

    rects := laneMarkingRects();
    assets.laneMarkings = flatMesh(rects, 0.09);
    rects.free();
    assets.laneMarkingsMaterial = LoadMaterialDefault();      // Unlit, like the paint should look
    assets.laneMarkingsMaterial.maps[MaterialMapIndex.materialMapAlbedo].color = LaneLineColor;

    // The models, lit by the sun like the rest
    for kind in CarKind.values {
        model := CarKind.names[kind];
        if kind == .ambulance { model = "van"; }        // A white van, with lights on its roof
        assets.vehicles[kind] = assets.lighting.loadModel(tprint("models/%.obj", model));
        assets.vehicleBody[kind] = findBodyMaterial(assets.vehicles[kind]);
    }
    for kind in HeroKind.values {
        // A model with a skeleton and clips when there is one, else the still one
        glb := tprint("models/%.glb", HeroKind.names[kind]);
        if FileExists(dataPath(glb)) { assets.loadAnimatedHero(kind, glb); }
        else                         { assets.heroes[kind] = assets.lighting.loadModel(tprint("models/%.obj", HeroKind.names[kind])); }

        for ability in kind.definition().abilities {
            if assets.icons.has(ability.icon) { continue; }
            assets.icons[ability.icon] = loadTexture(tprint("icons/%.png", ability.icon));
        }
    }
    for kind in ItemKind.values {
        icon := kind.itemDefinition().icon;
        assets.icons[icon] = loadTexture(tprint("icons/%.png", icon));
    }
    for kind in PerkKind.values {
        icon := kind.perkDefinition().icon;
        assets.icons[icon] = loadTexture(tprint("icons/%.png", icon));
    }
    for kind in StatusKind.values {
        icon := statusLook(kind).icon;
        if !assets.icons.has(icon) { assets.icons[icon] = loadTexture(tprint("icons/%.png", icon)); }
    }
    for kind in ParticleTexture.values {
        assets.particleTextures[kind] = loadTexture(tprint("textures/particles/%.png", ParticleTexture.names[kind]));
    }
    assets.wall = assets.lighting.loadModel("models/wall.obj");
    assets.meatHook  = assets.lighting.loadModel("models/meat_hook.obj");
    assets.chainLink = assets.lighting.loadModel("models/chain_link.obj");
    assets.footbridgeSpan = assets.lighting.loadModel("models/footbridge_span.obj");
    assets.footbridgeRamp = assets.lighting.loadModel("models/footbridge_ramp.obj");
    assets.trampoline     = assets.lighting.loadModel("models/trampoline.obj");
    assets.trampolineMat  = assets.lighting.loadModel("models/trampoline_mat.obj");
    assets.portrait = LoadRenderTexture(PortraitResolution, PortraitResolution);
    SetTextureFilter(assets.portrait.texture, .bilinear);

    for kind in SceneryKind.values {
        assets.sceneryModels[kind] = assets.lighting.loadModel(tprint("models/%.obj", SceneryModels[kind]));
    }
    assets.scenery = newScenery(77);
    assets.cityBlocks = cityBlocks();

    loadFonts();
    loadUi();

    assets.cursor = loadTexture("textures/cursor/human.png");

    icon := LoadImage(dataPath("window_icon.png"));
    ImageFormat(&icon, .uncompressedR8g8b8a8);
    SetWindowIcon(icon);
    UnloadImage(icon);

    return assets;
}

unload :: method (assets: *Assets) {
    UnloadTexture(assets.groundMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture);
    UnloadTexture(assets.roadMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture);
    UnloadTexture(assets.cursor);

    for model in assets.vehicles { UnloadModel(model); }
    for model in assets.heroes   { UnloadModel(model); }
    assets.unloadHeroAnimations();
    UnloadModel(assets.wall);
    UnloadModel(assets.meatHook);
    UnloadModel(assets.chainLink);
    UnloadModel(assets.footbridgeSpan);
    UnloadModel(assets.footbridgeRamp);
    UnloadModel(assets.trampoline);
    UnloadModel(assets.trampolineMat);
    UnloadRenderTexture(assets.portrait);
    for model in assets.sceneryModels { UnloadModel(model); }
    assets.scenery.free();
    assets.cityBlocks.free();
    unloadFonts();
    unloadUi();
    for _, icon in assets.icons  { UnloadTexture(icon); }

    UnloadMesh(assets.cube);
    UnloadMesh(assets.laneMarkings);
    UnloadMesh(assets.ground);
    UnloadMesh(assets.road);
    UnloadMesh(assets.outside);

    assets.lighting.unload();
}

// Draws a model turned so its x, y and z go along side, up and forward, with its origin at position
drawModelFacing :: (model: Model, position: Vector3, side: Vector3, up: Vector3, forward: Vector3) {
    m: Matrix;
    m.m0 = side.x;    m.m1 = side.y;    m.m2 = side.z;
    m.m4 = up.x;      m.m5 = up.y;      m.m6 = up.z;
    m.m8 = forward.x; m.m9 = forward.y; m.m10 = forward.z;
    m.m12 = position.x; m.m13 = position.y; m.m14 = position.z;
    m.m15 = 1;
    transform := model.transform * m;
    for i in 0..model.meshCount {
        DrawMesh(model.meshes[i], model.materials[model.meshMaterial[i]], transform);
    }
}

// Draws the unit cube scaled and moved, with the lit material in a color
drawBox :: method (assets: *Assets, center: Vector3, size: Vector3, color: Color) {
    assets.lit.maps[MaterialMapIndex.materialMapAlbedo].color = color;
    transform := MatrixScale(size.x, size.y, size.z) * MatrixTranslate(center.x, center.y, center.z);
    DrawMesh(assets.cube, assets.lit, transform);
}

// Draws a wall: its segment, repeated along it, and stretched a bit so a whole number of them fits
drawWall :: method (assets: *Assets, wall: Rectangle) {
    count := math.max(1, math.roundf(wall.height / WallSegmentLength) as int);
    stretch := wall.height / (count as f32 * WallSegmentLength);
    x := wall.x + wall.width * 0.5;
    for i in 0..count {
        z := wall.y + (i as f32 + 0.5) * WallSegmentLength * stretch;
        DrawModelEx(assets.wall, {x, 0, z}, {0, 1, 0}, 0, {1, 1, stretch}, White);
    }
}

// Draws a vehicle with the color of the car on its body
// The tufts, flowers and rocks near a point, e.g what the camera looks at
drawScenery :: method (assets: *Assets, frustum: *ViewFrustum) {
    // The pavement of the blocks, with a curb around it
    for block in assets.cityBlocks {
        center := block.center();
        if !frustum.sees(center.at(0), block.width * 0.75) { continue; }
        DrawCube(center.at(0.1), block.width + 0.8, 0.2, block.height + 0.8, {120, 118, 112, 255});
        DrawCube(center.at(0.12), block.width, 0.22, block.height, {172, 168, 158, 255});
    }
    for decoration in assets.scenery {
        center, radius := decoration.bounds();
        if !frustum.sees(center, radius) { continue; }
        DrawModelEx(assets.sceneryModels[decoration.kind], decoration.position, {0, 1, 0}, decoration.angle, decoration.size, White);
    }
}

drawVehicle :: method (assets: *Assets, kind: CarKind, position: Vector3, color: Color, scale: f32) {
    model := assets.vehicles[kind];
    model.materials[assets.vehicleBody[kind]].maps[MaterialMapIndex.materialMapAlbedo].color = color;
    DrawModelEx(model, position, {0, 1, 0}, 0, {scale, scale, scale}, White);
}

// Draws a hero turned to look along the angle, in radians around y (0 looks towards +z)
drawHero :: method (assets: *Assets, kind: HeroKind, position: Vector3, facing: f32, tint: Color, hookThrown := false) {
    hook := assets.heroAnimations[kind].hookMesh;
    if hookThrown && hook >= 0 {
        assets.drawHeroWithout(kind, position, facing, tint, hook);
        return;
    }
    DrawModelEx(assets.heroes[kind], position, {0, 1, 0}, facing * Rad2Deg, {1, 1, 1}, tint);
}

PortraitResolution :: 256;

// Draws the hero into the portrait of the HUD, from the front, slowly turning, against a backdrop of its color
drawPortrait :: method (assets: *Assets, kind: HeroKind, game: *Game = null, hero: *Hero = null) {
    info := kind.definition();
    height := info.height;
    anims := &assets.heroAnimations[kind];

    // Doing what the hero does, when its model has clips: the face roars when it throws its hook
    if game == null || hero == null || !assets.poseHero(game, hero, portrait: true) { assets.poseIdle(kind, GetTime() as f32); }

    target := Vector3{0, height * 0.66, 0};
    distance := height * 1.05 + 1.5;
    turn := math.sinf(GetTime() as f32 * 0.7) * 0.45;
    at := Vector3{0, 0, 0};
    if anims.headBone >= 0 {
        // A hero with a skeleton: its face, close up, wherever the clip puts the head, and turned about the head, not
        // the feet, so the face stays in the middle
        head := assets.heroes[kind].bindPose[anims.headBone].translation;
        turn *= 0.6;
        if anims.lastClip >= 0 {
            pose := anims.clips[anims.lastClip].framePoses[anims.lastFrame][anims.headBone];
            head = pose.translation;
            // And turned back by as much as the clip turns the head, so the face looks at us
            facing := Vector3RotateByQuaternion({0, 0, 1}, pose.rotation);
            turn -= math.atan2f(facing.x, facing.z);
        }
        turned := Vector3Transform({head.x, 0, head.z}, MatrixRotateY(turn));
        at = Vector3{head.x - turned.x, 0, head.z - turned.z};
        target = head + Vector3{0, 0.05, 0};
        distance = height * 0.55 + 1.6;
    }
    camera := Camera3D{
        position:   target + Vector3{0, height * 0.06, distance},
        target:     target,
        up:         {0, 1, 0},
        fovy:       34,
        projection: .perspective,
    };

    BeginTextureMode(assets.portrait);
    defer EndTextureMode();
    ClearBackground(Black);
    DrawRectangleGradientV(0, 0, PortraitResolution, PortraitResolution, ColorBrightness(info.color, -0.55), {12, 12, 16, 255});
    // A soft light behind the head
    DrawCircleGradient(PortraitResolution / 2, PortraitResolution * 2 / 5, PortraitResolution * 0.45, ColorAlpha(ColorBrightness(info.color, 0.2), 0.45), Blank);

    assets.lighting.setCamera(camera);
    // Nothing nearer than just in front of the face, e.g an arm that swings past it (drawScene sets them back)
    if anims.headBone >= 0 { rlSetClipPlanes(math.max(distance - 2.6, 0.5), distance + 40); }
    BeginMode3D(camera);
    assets.drawHero(kind, at, turn, White, hero != null && hero.hook.hasValue());
    EndMode3D();
}

// The material that a vehicle's body has: the one that is pure white (see tools/make_models.py)
findBodyMaterial :: (model: Model) -> int {
    for i in 0..model.materialCount {
        color := model.materials[i].maps[MaterialMapIndex.materialMapAlbedo].color;
        if color == White { return i as int; }
    }
    fmt.print("WARNING: A vehicle model has no white body material, see tools/make_models.py");
    return 0;
}

loadTexture :: (file: string) -> Texture {
    texture := LoadTexture(dataPath(file));
    GenTextureMipmaps(&texture);
    SetTextureFilter(texture, .trilinear);
    return texture;
}

// Makes a texture repeat over a plane of GenMeshPlane, which goes from 0 to 1 over the whole plane
tileTexture :: (mesh: *Mesh, repeatX: f32, repeatZ: f32) {
    for i in 0..mesh.vertexCount {
        mesh.texcoords[i * 2]     *= repeatX;
        mesh.texcoords[i * 2 + 1] *= repeatZ;
    }
    UpdateMeshBuffer(*mesh, 1, mesh.texcoords, mesh.vertexCount * 2 * sizeof(f32) as int, 0);
}
