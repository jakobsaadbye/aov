namespace core;

import fmt;
import math;
use raylib;

// The textures, models and the shader of the game, from the data folder of the repository

Assets :: struct {
    lighting: Lighting;
    lit:      Material;     // The lit material that the lane markings are drawn with
    cube:     Mesh;         // A 1x1x1 cube, scaled to make the walls and the lane markings

    ground:          Mesh;  // The field
    groundMaterial:  Material;
    road:            Mesh;
    roadMaterial:    Material;
    outside:         Mesh;  // The land around the field, to the horizon
    outsideMaterial: Material;

    vehicles: [CarKind.count]Model;
    vehicleBody: [CarKind.count]int;   // The material of each vehicle that gets the color of the car
    heroes:   [HeroKind.count]Model;
    portrait: RenderTexture;          // The hero of the HUD, drawn in 3D
    wall:     Model;                   // A segment of the wall, repeated along it

    icons: Map<string, Texture>;       // The icon of each ability, by its name in heroes.sd

    sceneryModels: [SceneryKind.count]Model;
    scenery:       [..]Decoration;

    cursor: Texture;
}

// The data folder is next to src, and the program is in src/build, so it is found from wherever the game is started
// The data folder, until the end of the frame (temp.sd)
dataFolder :: () -> string {
    return tprint("%../../data/", GetApplicationDirectory().toString());
}

// A file of the data folder, for raylib, until the end of the frame
dataPath :: (file: string) -> c.string {
    return tempCString(tprint("%../../data/%", GetApplicationDirectory().toString(), file));
}

loadAssets :: () -> Assets {
    assets: Assets;

    assets.lighting = newLighting();
    assets.cube     = GenMeshCube(1, 1, 1);
    assets.lit      = assets.lighting.newMaterial(White);

    // The field: grass, tiled
    grass := loadTexture("textures/grass/grass.png");
    assets.ground = GenMeshPlane(MapHalfWidth * 2, MapHalfLength * 2, 1, 1);
    tileTexture(&assets.ground, 10, 8);
    assets.groundMaterial = assets.lighting.newMaterial(White);
    assets.groundMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture = grass;

    // The land around it, darker, so the field stands out
    assets.outside = GenMeshPlane(900, 900, 1, 1);
    tileTexture(&assets.outside, 56, 56);
    assets.outsideMaterial = assets.lighting.newMaterial({150, 160, 140, 255});
    assets.outsideMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture = grass;

    // The road: asphalt, a tile every 16
    assets.road = GenMeshPlane(RoadHalfWidth * 2, RoadEnd * 2, 1, 1);
    tileTexture(&assets.road, RoadHalfWidth * 2 / 16, RoadEnd * 2 / 16);
    assets.roadMaterial = assets.lighting.newMaterial(White);
    assets.roadMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture = loadTexture("textures/road/asphalt.png");

    // The models, lit by the sun like the rest
    for kind in CarKind.values {
        assets.vehicles[kind] = assets.lighting.loadModel(tprint("models/%.obj", CarKind.names[kind]));
        assets.vehicleBody[kind] = findBodyMaterial(assets.vehicles[kind]);
    }
    for kind in HeroKind.values {
        assets.heroes[kind] = assets.lighting.loadModel(tprint("models/%.obj", HeroKind.names[kind]));

        for ability in kind.definition().abilities {
            if assets.icons.has(ability.icon) { continue; }
            assets.icons[ability.icon] = loadTexture(tprint("icons/%.png", ability.icon));
        }
    }
    assets.wall = assets.lighting.loadModel("models/wall.obj");
    assets.portrait = LoadRenderTexture(PortraitResolution, PortraitResolution);
    SetTextureFilter(assets.portrait.texture, .bilinear);

    for kind in SceneryKind.values {
        assets.sceneryModels[kind] = assets.lighting.loadModel(tprint("models/%.obj", SceneryModels[kind]));
    }
    assets.scenery = newScenery(77);

    loadFonts();

    assets.cursor = loadTexture("textures/cursor/human.png");

    icon := LoadImage(dataPath("window_icon.png"));
    ImageFormat(&icon, .uncompressedR8g8b8a8);
    SetWindowIcon(icon);
    UnloadImage(icon);

    return assets;
}

unload :: method (assets: *Assets) {
    UnloadTexture(assets.groundMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture);
    UnloadTexture(assets.roadMaterial.maps[MaterialMapIndex.materialMapAlbedo].texture);
    UnloadTexture(assets.cursor);

    for model in assets.vehicles { UnloadModel(model); }
    for model in assets.heroes   { UnloadModel(model); }
    UnloadModel(assets.wall);
    UnloadRenderTexture(assets.portrait);
    for model in assets.sceneryModels { UnloadModel(model); }
    assets.scenery.free();
    unloadFonts();
    for _, icon in assets.icons  { UnloadTexture(icon); }

    UnloadMesh(assets.cube);
    UnloadMesh(assets.ground);
    UnloadMesh(assets.road);
    UnloadMesh(assets.outside);

    assets.lighting.unload();
}

// Draws the unit cube scaled and moved, with the lit material in a color
drawBox :: method (assets: *Assets, center: Vector3, size: Vector3, color: Color) {
    assets.lit.maps[MaterialMapIndex.materialMapAlbedo].color = color;
    transform := MatrixScale(size.x, size.y, size.z) * MatrixTranslate(center.x, center.y, center.z);
    DrawMesh(assets.cube, assets.lit, transform);
}

// Draws a wall: its segment, repeated along it, and stretched a bit so a whole number of them fits
drawWall :: method (assets: *Assets, wall: Rectangle) {
    count := math.max(1, math.roundf(wall.height / WallSegmentLength) as int);
    stretch := wall.height / (count as f32 * WallSegmentLength);
    x := wall.x + wall.width * 0.5;
    for i in 0..count {
        z := wall.y + (i as f32 + 0.5) * WallSegmentLength * stretch;
        DrawModelEx(assets.wall, {x, 0, z}, {0, 1, 0}, 0, {1, 1, stretch}, White);
    }
}

// Draws a vehicle with the color of the car on its body
// The tufts, flowers and rocks near a point, e.g what the camera looks at
drawScenery :: method (assets: *Assets, around: Vector3, reach: f32) {
    for decoration in assets.scenery {
        if math.fabsf(decoration.position.x - around.x) > reach || math.fabsf(decoration.position.z - around.z) > reach { continue; }
        s := decoration.scale;
        DrawModelEx(assets.sceneryModels[decoration.kind], decoration.position, {0, 1, 0}, decoration.angle, {s, s, s}, White);
    }
}

drawVehicle :: method (assets: *Assets, kind: CarKind, position: Vector3, color: Color, scale: f32) {
    model := assets.vehicles[kind];
    model.materials[assets.vehicleBody[kind]].maps[MaterialMapIndex.materialMapAlbedo].color = color;
    DrawModelEx(model, position, {0, 1, 0}, 0, {scale, scale, scale}, White);
}

// Draws a hero turned to look along the angle, in radians around y (0 looks towards +z)
drawHero :: method (assets: *Assets, kind: HeroKind, position: Vector3, facing: f32, tint: Color) {
    DrawModelEx(assets.heroes[kind], position, {0, 1, 0}, facing * Rad2Deg, {1, 1, 1}, tint);
}

PortraitResolution :: 256;

// Draws the hero into the portrait of the HUD, from the front, slowly turning, against a backdrop of its color
drawPortrait :: method (assets: *Assets, kind: HeroKind) {
    info := kind.definition();
    height := info.height;
    target := Vector3{0, height * 0.66, 0};
    camera := Camera3D{
        position:   target + Vector3{0, height * 0.12, height * 1.05 + 1.5},
        target:     target,
        up:         {0, 1, 0},
        fovy:       34,
        projection: .perspective,
    };

    BeginTextureMode(assets.portrait);
    defer EndTextureMode();
    ClearBackground(Black);
    DrawRectangleGradientV(0, 0, PortraitResolution, PortraitResolution, ColorBrightness(info.color, -0.55), {12, 12, 16, 255});
    // A soft light behind the head
    DrawCircleGradient(PortraitResolution / 2, PortraitResolution * 2 / 5, PortraitResolution * 0.45, ColorAlpha(ColorBrightness(info.color, 0.2), 0.45), Blank);

    assets.lighting.setCamera(camera);
    BeginMode3D(camera);
    turn := math.sinf(GetTime() as f32 * 0.7) * 0.45;
    assets.drawHero(kind, {0, 0, 0}, turn, White);
    EndMode3D();
}

// The material that a vehicle's body has: the one that is pure white (see tools/make_models.py)
findBodyMaterial :: (model: Model) -> int {
    for i in 0..model.materialCount {
        color := model.materials[i].maps[MaterialMapIndex.materialMapAlbedo].color;
        if color == White { return i as int; }
    }
    fmt.print("WARNING: A vehicle model has no white body material, see tools/make_models.py");
    return 0;
}

loadTexture :: (file: string) -> Texture {
    texture := LoadTexture(dataPath(file));
    GenTextureMipmaps(&texture);
    SetTextureFilter(texture, .trilinear);
    return texture;
}

// Makes a texture repeat over a plane of GenMeshPlane, which goes from 0 to 1 over the whole plane
tileTexture :: (mesh: *Mesh, repeatX: f32, repeatZ: f32) {
    for i in 0..mesh.vertexCount {
        mesh.texcoords[i * 2]     *= repeatX;
        mesh.texcoords[i * 2 + 1] *= repeatZ;
    }
    UpdateMeshBuffer(*mesh, 1, mesh.texcoords, mesh.vertexCount * 2 * sizeof(f32) as int, 0);
}
