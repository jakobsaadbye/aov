namespace core;

// Items: now and then one lies in the middle of the road, and the first hero that walks over it puts it in the backpack of
// its player. An item is for every hero of that player for the rest of the game, also the ones after the hero that
// picked it up is run over. A backpack holds two (three with the perk Deep Pockets).
//
// A new item is a value of ItemKind and its definition in itemDefinition: its traits (traits.sd) say what it does while
// it is in the backpack, and an item that is used has an Ability, like a hero's, cast with 1, 2 or 3
// (item_abilities.sd).

import console;
import fmt;
import math;
import random;
use raylib;

ItemKind :: enum {
    hardHat,
    hourglass,
    spyglass,
    firstAid,
    clover,
    garlic,
    springShoes,
    bananaPeel,
    mirror,
    energyDrink,
    trafficCone,
    megaphone,
    rubberChicken,
    balloon,
    luckyDice,
    umbrella,
    remoteControl,
    stopwatch,
    snowGlobe,
    portalGun,
}

ItemDefinition :: struct {
    name:        string;
    description: string;
    icon:        string;        // data/icons/<icon>.png
    color:       Color;         // Of the item on the road
    trait:       Trait;         // What it does for the heroes of its player (traits.sd)
    also:        Trait;         // and a second thing it does, if any
    action:      Ability;       // An item that is used, with 1, 2 or 3 or a click on it: what it casts. No cast when it
                                // isn't used (item_abilities.sd)
    charges:     int;           // Times it can be used before it is gone. 0 for an item that only cools down

    isUsed :: method () -> bool {
        return self.action.cast != null;
    }
}

ItemAuraSlow   :: 0.3;      // How much slower Garlic makes the enemies
StenchRadius   :: 6.0;
BounceCooldown :: 12.0;
BounceDistance :: 7.0;      // How far towards the far side a bounce takes the hero
BounceTime     :: 0.55;

itemDefinition :: method (kind: ItemKind) -> ItemDefinition {
    return switch kind {
        case .hardHat   => ItemDefinition{"Hard Hat", "The cars do 35% less damage", "item_hard_hat", {255, 200, 30, 255}, Trait{damageTaken: 0.65}};
        case .hourglass => ItemDefinition{"Hourglass", "The abilities cool down 30% faster", "item_hourglass", {230, 190, 120, 255}, Trait{cooldown: 0.7}};
        case .spyglass  => ItemDefinition{"Spyglass", "The abilities reach 30% further", "item_spyglass", {120, 170, 255, 255}, Trait{reach: 1.3}};
        case .firstAid  => ItemDefinition{"First Aid Kit", "40% more health, and heals 10% of it a second when no car is on it. Nothing else heals", "item_first_aid", {235, 60, 60, 255}, Trait{regen: 0.1}, Trait{maxHealth: 1.4}};
        case .garlic      => ItemDefinition{"Garlic", "A stench: enemy heroes near the hero walk 30% slower", "item_garlic", {200, 230, 120, 255}, Trait{stench: StenchRadius}};
        case .springShoes => ItemDefinition{"Spring Shoes", "A car that hits the hero bounces it over the car, towards the far side. Every 12 seconds", "item_spring_shoes", {255, 150, 60, 255}, .bounce};
        case .clover    => ItemDefinition{"Four-Leaf Clover", "Once each hero: a car that would run it over leaves it with a bit of health, out of the way for a moment", "item_clover", {80, 220, 90, 255}, Trait{saves: 1}};
        case .mirror     => ItemDefinition{"Mirror", "The next spell cast on the hero goes back to whoever cast it. Every 15 seconds", "item_mirror", {210, 230, 255, 255}, .mirror};
        case .umbrella   => ItemDefinition{"Umbrella", "Floats: leaps, flights and bounces stay up 40% longer, and the hero is knocked half as far", "item_umbrella", {230, 60, 80, 255}, Trait{airTime: 1.4}, Trait{knockTaken: 0.5}};
        case .bananaPeel => ItemDefinition{name: "Banana Peel", description: "Throws a banana peel at the cursor, up to 28 away. The first enemy that steps on it slips. 3 of them",
            icon: "item_banana_peel", color: {250, 220, 60, 255}, action: Ability{name: "Banana Peel", icon: "item_banana_peel", sound: "item.banana_peel", cooldown: 2,
            targeting: .point, cast: castBananaPeel, bot: .dropTrap, range: 28}, charges: 3};
        case .energyDrink => ItemDefinition{name: "Energy Drink", description: "70% faster for 3 seconds, then 35% slower for 2. Two cans",
            icon: "item_energy_drink", color: {60, 140, 255, 255}, action: Ability{name: "Energy Drink", icon: "item_energy_drink", sound: "item.energy_drink", cooldown: 1,
            cast: castEnergyDrink, bot: .speedUp, duration: 3, power: 1.7}, charges: 2};
        case .trafficCone => ItemDefinition{name: "Traffic Cone", description: "Puts a cone in the lane at the cursor, up to 20 away, for 8 seconds: the cars that come to it swerve into the lane beside it. A bus runs it over. 3 of them",
            icon: "item_traffic_cone", color: {255, 120, 30, 255}, action: Ability{name: "Traffic Cone", icon: "item_traffic_cone", sound: "item.traffic_cone", cooldown: 3,
            targeting: .point, cast: castTrafficCone, bot: .stopCarsAhead, range: 20, duration: 8}, charges: 3};
        case .megaphone => ItemDefinition{name: "Megaphone", description: "Shouts at every enemy: 3 seconds more on all of their cooldowns. Every 25 seconds",
            icon: "item_megaphone", color: {240, 240, 240, 255}, action: Ability{name: "Megaphone", icon: "item_megaphone", sound: "item.megaphone", cooldown: 25,
            cast: castMegaphone, bot: .disableEnemy, range: 200, power: 3}};
        case .rubberChicken => ItemDefinition{name: "Rubber Chicken", description: "Squeaks: the enemies within 20 walk towards the hero for 1.2 seconds. Every 18 seconds",
            icon: "item_rubber_chicken", color: {255, 230, 80, 255}, action: Ability{name: "Rubber Chicken", icon: "item_rubber_chicken", sound: "item.rubber_chicken", cooldown: 18,
            cast: castRubberChicken, bot: .disableEnemy, range: 20, duration: 1.2}};
        case .balloon => ItemDefinition{name: "Decoy Balloon", description: "A balloon that looks just like the hero walks on ahead for 4 seconds. Spells cast on the hero hit it first. Every 20 seconds",
            icon: "item_balloon", color: {255, 80, 120, 255}, trait: .decoysFirst, action: Ability{name: "Decoy Balloon", icon: "item_balloon", sound: "item.balloon", cooldown: 20,
            cast: castSplit, bot: .speedUp, duration: 4}};
        case .luckyDice => ItemDefinition{name: "Lucky Dice", description: "Casts a random ability of a random hero, at the cursor. Every 15 seconds",
            icon: "item_lucky_dice", color: {245, 245, 245, 255}, action: Ability{name: "Lucky Dice", icon: "item_lucky_dice", sound: "item.lucky_dice", cooldown: 15,
            targeting: .point, cast: castLuckyDice, bot: .speedUp, range: 20}};
        case .remoteControl => ItemDefinition{name: "Remote Control", description: "Steers the car nearest the cursor, up to 40 away, two lanes over, away from the hero. Every 9 seconds",
            icon: "item_remote_control", color: {70, 70, 80, 255}, action: Ability{name: "Remote Control", icon: "item_remote_control", sound: "item.remote_control", cooldown: 9,
            targeting: .point, cast: castRemoteControl, bot: .stopCarsAhead, range: 40, count: 2}};
        case .stopwatch => ItemDefinition{name: "Stopwatch", description: "All the abilities of the hero are ready at once. Every 40 seconds",
            icon: "item_stopwatch", color: {220, 220, 230, 255}, action: Ability{name: "Stopwatch", icon: "item_stopwatch", sound: "item.stopwatch", cooldown: 40,
            cast: castStopwatch, bot: .none}};
        case .snowGlobe => ItemDefinition{name: "Snow Globe", description: "Shakes the snow globe: every car but the ambulances stops dead, and every enemy is frozen in time, for 1.5 seconds. Once",
            icon: "item_snow_globe", color: {170, 220, 255, 255}, action: Ability{name: "Snow Globe", icon: "item_snow_globe", sound: "item.snow_globe", cooldown: 1,
            cast: castSnowGlobe, bot: .stopCars, duration: 1.5}, charges: 1};
        case .portalGun => ItemDefinition{name: "Portal Gun", description: "Opens a portal where the hero stands and another at the cursor, up to 25 away, for 6 seconds. Anyone who walks into one comes out of the other. Every 22 seconds",
            icon: "item_portal_gun", color: {90, 200, 255, 255}, action: Ability{name: "Portal Gun", icon: "item_portal_gun", sound: "item.portal_gun", cooldown: 22,
            targeting: .point, cast: castPortalGun, bot: .escape, range: 25, duration: 6}};
    };
}

BackpackMax  :: 3;          // With the perk Deep Pockets
BackpackSize :: 2;

// The items of a player, the oldest first. A locked item stays when a new one is picked up; else the new one takes the
// place of the oldest that isn't locked. An item that is used keeps its cooldown and its charges in its slot
Backpack :: struct {
    items:     [BackpackMax]ItemKind;
    locked:    [BackpackMax]bool;
    cooldowns: [BackpackMax]f32;
    charges:   [BackpackMax]int;
    count:     int;
    size:      int = BackpackSize;

    isFull :: method () -> bool {
        return self.count >= self.size;
    }

    // The slot a new item goes in when it is full: the oldest that isn't locked, or -1 when all are
    oldestUnlocked :: method () -> int {
        for slot in 0..self.count {
            if !self.locked[slot] { return slot as int; }
        }
        return -1;
    }

    // If it can take a new item: there is room, or an item that isn't locked to give up for it
    canTake :: method () -> bool {
        return !self.isFull() || self.oldestUnlocked() >= 0;
    }

    // Puts an item in, at the end, with its charges
    put :: method * (kind: ItemKind) {
        self.items[self.count] = kind;
        self.locked[self.count] = false;
        self.cooldowns[self.count] = 0;
        self.charges[self.count] = kind.itemDefinition().charges;
        self.count += 1;
    }

    // Takes an item out, and the ones after it move up
    remove :: method * (slot: int) -> ItemKind {
        item := self.items[slot];
        for i in slot + 1..self.count {
            self.items[i - 1] = self.items[i];
            self.locked[i - 1] = self.locked[i];
            self.cooldowns[i - 1] = self.cooldowns[i];
            self.charges[i - 1] = self.charges[i];
        }
        self.count -= 1;
        self.locked[self.count] = false;
        return item;
    }

    list :: method * () -> []ItemKind {
        result: []ItemKind;
        result.data = &self.items[0];
        result.count = self.count;
        return result;
    }
}

// The item that lies on the road
GroundItem :: struct {
    kind:     ItemKind;
    position: Vector2;
}

FirstItemAfter :: 10.0;     // Seconds into a game
ItemEveryLow   :: 15.0;     // Seconds after one is picked up, at random between these
ItemEveryHigh  :: 30.0;
ItemReach      :: 1.3;      // How close a hero must come to an item, besides its own radius
ItemRoadLength :: 44.0;     // It lies somewhere between -this and this along the road

Items :: struct {
    onRoad: ?GroundItem;
    age:    f32;                    // Seconds the one on the road has been there
    nextIn: f32 = FirstItemAfter;   // Seconds until the next one, while there is none on the road
    rng:    random.Random;
}

newItems :: (seed: u64) -> Items {
    return Items{rng: random.newRandom(seed ^ 0x17e45)};
}

// Once a frame: the next item when its time comes, and the heroes that walk over one
updateItems :: method (game: *Game, dt: f32) {
    items := &game.items;
    if !items.onRoad.hasValue() {
        items.nextIn -= dt;
        if items.nextIn <= 0 {
            kind := items.rng.between(0, ItemKind.count as int - 1) as ItemKind;
            z := items.rng.uniform(-ItemRoadLength, ItemRoadLength) as f32;
            game.placeItem(kind, Vector2{0, z});
        }
        return;
    }

    onRoad := items.onRoad.value();
    items.age += dt;
    for *player, i in game.players {
        if !player.isPlaying() || !player.backpack.canTake() { continue; }
        hero := &player.hero;
        if hero.isAirborne() { continue; }
        if hero.ground().distance(onRoad.position) > hero.info().hitRadius + ItemReach + hero.stats.itemReach { continue; }
        game.pickUp(i as int, onRoad.kind);
        items.onRoad = null;
        items.nextIn = items.rng.uniform(ItemEveryLow, ItemEveryHigh) as f32;
        return;
    }
}

placeItem :: method (game: *Game, kind: ItemKind, position: Vector2) {
    game.items.onRoad = GroundItem{kind: kind, position: position};
    game.items.age = 0;
    game.announce(-1, {255, 210, 90, 255}, "% lies on the road", kind.itemDefinition().name);
}

// Into the backpack of the player, and the hero has the boost at once
pickUp :: method (game: *Game, index: int, kind: ItemKind) {
    player := &game.players[index];
    if !player.backpack.canTake() { return; }
    given: ?ItemKind = null;
    if player.backpack.isFull() { given = player.backpack.remove(player.backpack.oldestUnlocked()); }
    player.backpack.put(kind);
    player.stats.items += 1;
    player.refreshStats();
    if given.hasValue() {
        game.announce(index, player.color, "% picked up %, in place of %", player.name, kind.itemDefinition().name, given.value().itemDefinition().name);
    } else {
        game.announce(index, player.color, "% picked up %", player.name, kind.itemDefinition().name);
    }
    game.sounds.playAt("item.pickup", player.hero.position, 0.9);
    game.effects.particles.emit(.sparkles, player.hero.position + Vector3{0, 1.5, 0}, 30, tint: kind.itemDefinition().color);
}

// The stats of the hero, after an item or a perk was added. Its health goes up with its most health
refreshStats :: method (player: *Player) {
    hero := &player.hero;
    share := hero.health / hero.maxHealth();
    savesUsed := hero.stats.saves - hero.savesLeft;
    hero.stats = statsOf(player);
    player.backpack.size = BackpackSize + hero.stats.pockets;
    hero.health = share * hero.maxHealth();
    hero.savesLeft = math.max(0, hero.stats.saves - savesUsed);
}

// How much of the cooldown of an item is left, 0 to 1, and the seconds of it, for the HUD. 1 and 0 seconds for one that
// is used up until the next hero, the clover
itemCooldown :: (player: *Player, slot: int) -> f32, f32 {
    hero := &player.hero;
    kind := player.backpack.items[slot];
    definition := kind.itemDefinition();
    if definition.isUsed() {
        left := player.backpack.cooldowns[slot];
        return left / math.max(definition.action.cooldown, 0.01), left;
    }
    if kind == .springShoes { return hero.bounceLeft / BounceCooldown, hero.bounceLeft; }
    if kind == .mirror      { return hero.mirrorLeft / MirrorCooldown, hero.mirrorLeft; }
    if kind == .clover && hero.savesLeft <= 0 { return 1, 0; }
    return 0, 0;
}

// With Spring Shoes, a car that hits the hero bounces it over the car, towards the side it is going to. True when it did
bounced :: method (game: *Game, index: int) -> bool {
    player := &game.players[index];
    hero := &player.hero;
    if !hero.stats.bounces || hero.bounceLeft > 0 || hero.isAirborne() { return false; }
    hero.bounceLeft = BounceCooldown;
    across := player.startSide.opposite().sign();
    to := hero.position + Vector3{across * BounceDistance, 0, 2.5};
    hero.leap = LeapState{from: hero.position, to: to, duration: BounceTime};
    hero.isMoving = false;
    game.effects.addRing(hero.ground(), 0.5, 4, {255, 150, 60, 255}, 0.35);
    game.effects.particles.emit(.dust, hero.position, 12);
    game.sounds.playAt("ability.leap", hero.position, 0.9, 0.1);
    game.announce(index, {255, 150, 60, 255}, "% bounced off a car", player.name);
    return true;
}

// Garlic: how much slower each hero walks, by the enemies that stink near it. Once a frame
updateStench :: method (game: *Game) {
    for *player, i in game.players {
        player.hero.slowedBy = 0;
        if !player.isPlaying() { continue; }
        for other, k in game.players {
            if k == i || !other.isPlaying() || other.hero.stats.stench <= 0 { continue; }
            if other.hero.ground().distance(player.hero.ground()) <= other.hero.stats.stench {
                player.hero.slowedBy = ItemAuraSlow;
            }
        }
    }
}

// The auras of the items, around the heroes that have them: cold blue, and a green stench that wafts
drawItemAuras :: (game: *Game) {
    for player in game.players {
        if !player.isPlaying() { continue; }
        hero := player.hero;
        ground := hero.ground();
        if hero.stats.chill.hasValue() && !hero.hasChillAbility() {
            chill := hero.stats.chill.value().radius;
            DrawCircle3D(ground.at(0.14), chill, {1, 0, 0}, 90, {170, 230, 255, 110});
            DrawCylinder(ground.at(0.12), chill, chill, 0.02, 40, {170, 230, 255, 25});
        }
        if hero.stats.stench > 0 {
            pulse := 0.5 + 0.5 * math.sinf(game.time * 3);
            DrawCircle3D(ground.at(0.15), hero.stats.stench * (0.95 + pulse * 0.05), {1, 0, 0}, 90, {215, 185, 60, 170});
            DrawCylinder(ground.at(0.12), hero.stats.stench, hero.stats.stench, 0.02, 40, {200, 170, 50, 45 + (pulse * 20) as u8});
        }
        if hero.stats.bounces && hero.bounceLeft <= 0 {
            DrawCircle3D(ground.at(0.16), hero.info().hitRadius + 0.9, {1, 0, 0}, 90, {255, 150, 60, 140});
        }
    }
}

// A car would run the hero over: with a clover it gets away, with a little health, and is out of the way of the cars for
// a moment. True when it got away
savedByClover :: method (game: *Game, index: int) -> bool {
    hero := &game.players[index].hero;
    if hero.savesLeft <= 0 { return false; }
    hero.savesLeft -= 1;
    hero.health = hero.maxHealth() * 0.25;
    hero.addStatus(.fade, 1.2);
    game.announce(index, {80, 220, 90, 255}, "The clover saved %", game.players[index].name);
    game.effects.particles.emit(.sparkles, hero.position + Vector3{0, 1.5, 0}, 40, tint: {120, 255, 120, 255});
    game.sounds.playAt("ability.fade", hero.position, 0.9);
    return true;
}

// The item on the road: turning and bobbing over a ring, with a beam that is seen from far
drawItem :: (game: *Game, assets: *Assets) {
    if !game.items.onRoad.hasValue() { return; }
    item := game.items.onRoad.value();
    definition := item.kind.itemDefinition();
    t := game.items.age;
    ground := item.position.at(0.14);
    pulse := 0.5 + 0.5 * math.sinf(t * 4);

    DrawCylinder(ground, 2.6, 2.6, 0.03, 32, ColorAlpha(definition.color, 0.3 + 0.2 * pulse));
    DrawCircle3D(ground + Vector3{0, 0.02, 0}, 2.6 + pulse * 0.5, {1, 0, 0}, 90, ColorAlpha(definition.color, 0.9));

    // The icon, on a pedestal, and the beam above it, which starts over the icon so it doesn't cut through it
    height := 3.2 + 0.4 * math.sinf(t * 2.5);
    beamStart := item.position.at(height + 2.7);
    DrawCylinderEx(beamStart, beamStart + Vector3{0, 16, 0}, 0.5, 0.12, 12, ColorAlpha(definition.color, 0.22));
    DrawCube(item.position.at(0.5), 1.6, 0.8, 1.6, {40, 36, 30, 255});
    DrawCubeWires(item.position.at(0.5), 1.6, 0.8, 1.6, definition.color);
    icon := assets.icons[definition.icon];
    DrawBillboard(game.camera.view, icon, item.position.at(height), 5, White);
}

//
// Console commands, e.g to try an item out
//

@console.command("Puts an item on the road, a random one without a name, at z along the road or anywhere")
spawnItem :: (game: *Game, kind: ?ItemKind, z: ?f32) {
    item := kind ?? game.items.rng.between(0, ItemKind.count as int - 1) as ItemKind;
    at := z ?? game.items.rng.uniform(-ItemRoadLength, ItemRoadLength) as f32;
    game.placeItem(item, Vector2{0, at});
}

@console.command("Puts an item in the backpack of a player, you when no player is given. In a full backpack it takes the place of the oldest that isn't locked")
giveItem :: (game: *Game, kind: ItemKind, player: ?int) {
    index := player ?? game.watched;
    if index < 0 || index >= game.players.count {
        console.fail("There is no player %. status lists them", index);
        return;
    }
    if !game.players[index].backpack.canTake() {
        console.fail("The backpack of % is full of locked items", game.players[index].name);
        return;
    }
    game.pickUp(index, kind);
}

@console.command("The items there are, and what is in each backpack")
items :: (game: *Game) {
    for kind in ItemKind.values {
        definition := kind.itemDefinition();
        console.print("    %  -  %: %", ItemKind.names[kind], definition.name, definition.description);
    }
    for player, i in game.players {
        names := "empty";
        for item, k in player.backpack.list() {
            if k == 0 { names = item.itemDefinition().name; }
            else      { names = tprint("%, %", names, item.itemDefinition().name); }
        }
        console.print("    %. %: %", i, player.name, names);
    }
    if game.items.onRoad.hasValue() { console.print("On the road: %", game.items.onRoad.value().kind.itemDefinition().name); }
    else                            { console.print("The next item in % s", fmt.fixed(game.items.nextIn, 1)); }
}
