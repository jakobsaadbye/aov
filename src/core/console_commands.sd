namespace core;

// Every console command of core, in one place (F1, console.sd): each is a function with @consoleCommand, named as it is
// typed, which gets the game it works on from the console (main.sd provides it). A command whose work belongs to a part
// of the game calls a function of that part, e.g spawnSlick calls spawnSlickAt in slicks.sd, so this file is the list of
// them all. Two kinds of command can't be here, as core can't see what they work on: those of the session, that make a
// new game (setSpeed, setBots, spectate, ...), are in main.sd, and those of the bots (toggleHitReports,
// toggleAsyncBots) in bots/.

import fmt;
import math;
use raylib;

@consoleCommand("Shows the edges of the triangles of the models")
toggleWireframes :: (game: *Game) {
    game.debug.wireframes = !game.debug.wireframes;
}

@consoleCommand("Shows the boxes the heroes and the cars collide with")
toggleHitboxes :: (game: *Game) {
    game.debug.hitboxes = !game.debug.hitboxes;
}

@consoleCommand("Shows the frames a second, where the camera and the hero are, and the number of cars")
toggleDebugOverlay :: (game: *Game) {
    game.debug.overlay = !game.debug.overlay;
}

@consoleCommand("Shows or hides the keys in the corner (H)")
toggleHelp :: (game: *Game) {
    game.showHelp = !game.showHelp;
}

@consoleCommand("Pauses the game, or goes on (P)")
togglePause :: (game: *Game) {
    game.isPaused = !game.isPaused;
    game.sounds.setPaused(game.isPaused);
}

@consoleCommand("Starts the game again, with the same players (F5)")
restartGame :: (game: *Game) {
    game.restartPending = true;
}

@consoleCommand("Your hero becomes another one, e.g setHero butcher. It is recorded, so a replay does the same")
setHero :: (game: *Game, hero: HeroKind) {
    if game.replay != null {
        consoleFail("A replay plays what was recorded");
        return;
    }
    if !game.hasLocal() {
        consoleFail("You have no hero: you are spectating");
        return;
    }
    game.pendingHero = hero;
}

@consoleCommand("Your hero becomes the next one")
nextHero :: (game: *Game) {
    if !game.hasLocal() {
        consoleFail("You have no hero: you are spectating");
        return;
    }
    setHero(game, ((game.players[game.local].hero.kind as int + 1) % HeroKind.count) as HeroKind);
}

@consoleCommand("Opens the inspector (F4) on a player, e.g inspect 1 for the first bot of a game with you. Without one, opens or closes it")
inspect :: (game: *Game, player: ?int) {
    if !player.hasValue() {
        game.inspector.isOpen = !game.inspector.isOpen;
        if game.inspector.isOpen && !game.inspectedIsBot() { game.inspectNextBot(); }
        return;
    }
    index := player.value();
    if index < 0 || index >= game.players.count || !game.players[index].isBot() {
        consoleFail("Player % isn't a bot. status lists the players", index);
        return;
    }
    game.inspector = Inspector{isOpen: true, player: index};
}

@consoleCommand("Saves what was played so far to a file, or to recordings/<time>.json (F8)")
writeRecording :: (game: *Game, file: ?string) {
    if !file.hasValue() {
        game.saveRecordingNow();
        return;
    }
    err := game.saveRecording(file.value());
    if err != null { consoleFail("Couldn't save %: %", file.value(), err.message); }
    else           { consolePrint("Saved the recording to %", file.value()); }
}

@consoleCommand("Turns the music on or off (M)")
toggleMusic :: (game: *Game) {
    game.sounds.toggleSoundtrack();
}

@consoleCommand("Plays another soundtrack, e.g folk, or lists them")
soundtrack :: (game: *Game, name: ?string) {
    if name.hasValue() && game.sounds.playSoundtrack(name.value(), game.sounds.soundtrackVolume) {
        consolePrint("Playing the soundtrack %", name.value());
        return;
    }
    if name.hasValue() { consoleFail("There is no soundtrack named %", name.value()); }
    for info in Soundtracks {
        mark := " ";
        if info.name == game.sounds.soundtrackName { mark = ">"; }
        consolePrint("% %: %", mark, info.name, info.about);
    }
}

@consoleCommand("The time of the game, and how each player is doing")
status :: (game: *Game) {
    state := "playing";
    if game.isPaused { state = "paused"; }
    if game.replay != null { state = fmt.sprint("replaying, frame % of %", game.replay.frame, game.replay.recording.frames.count); }
    consolePrint("% s, level %, bots %, seed %, %", fmt.fixed(game.time, 1), game.level() + 1, Difficulty.names[game.difficulty],
        game.recording.seed, state);
    focus := game.camera.focus;
    consolePrint("    The camera looks at (% %), % m away", fmt.fixed(focus.x, 1), fmt.fixed(focus.z, 1), game.camera.distance as int);
    for player, i in game.players {
        who := "bot";
        if !player.isBot() { who = "you"; }
        hero := player.hero;
        consolePrint("    %. % (%) % at (% %), health %, % across, % run over, % kills", i, player.name, who,
            HeroKind.names[hero.kind], fmt.fixed(hero.position.x, 1), fmt.fixed(hero.position.z, 1), hero.health as int,
            player.stats.crossings, player.stats.deaths, player.stats.kills);
    }
}

@consoleCommand("The heroes there are, for setHero")
heroes :: () {
    for kind in HeroKind.values {
        consolePrint("    %  -  %", HeroKind.names[kind], kind.definition().name);
    }
}

@consoleCommand("Moves the camera to a point on the ground and unlocks it from the hero (Y locks it again)")
cameraTo :: (game: *Game, x: f32, z: f32, distance: ?f32) {
    game.camera.isLocked = false;
    game.camera.focus = Vector3{x, 0, z};
    if distance.hasValue() { game.camera.targetDistance = math.clamp(distance.value(), CameraMinDistance, CameraMaxDistance); }
}

@consoleCommand("Watches a player, when spectating or in a replay (Tab, 1 to 6)")
watch :: (game: *Game, player: int) {
    if !game.canSwitchView() {
        consoleFail("You are playing: spectate to watch the others");
        return;
    }
    if player < 0 || player >= game.players.count {
        consoleFail("There is no player %. status lists them", player);
        return;
    }
    game.watch(player);
}

@consoleCommand("Casts an ability (0 is Q) of a player's hero at a point x z, or where it stands. You when no player is given, e.g cast 0 -80 10. It is an order, so it is recorded")
cast :: (game: *Game, slot: int, x: ?f32, z: ?f32, player: ?int) {
    index := player ?? game.watched;
    if index < 0 || index >= game.players.count {
        consoleFail("There is no player %. status lists them", index);
        return;
    }
    hero := &game.players[index].hero;
    abilities := hero.abilities();
    if slot < 0 || slot >= abilities.count {
        consoleFail("% has abilities 0 to %", hero.info().name, abilities.count - 1);
        return;
    }
    target := hero.ground();
    if x.hasValue() && z.hasValue() { target = Vector2{x.value(), z.value()}; }
    if !hero.abilityReady(slot) { consoleFail("% isn't ready", abilities[slot].name); }
    game.players[index].order(Command{cast: {slot: slot, target: target}});
}

@consoleCommand("Walks a player's hero to a point x z, you when no player is given")
walk :: (game: *Game, x: f32, z: f32, player: ?int) {
    index := player ?? game.watched;
    if index < 0 || index >= game.players.count {
        consoleFail("There is no player %. status lists them", index);
        return;
    }
    game.players[index].order(Command{move: Vector2{x, z}});
}

@consoleCommand("Uses the item in a slot of the backpack (0 is the first) at a point x z, or where the hero stands. You when no player is given")
useItemNow :: (game: *Game, slot: int, x: ?f32, z: ?f32, player: ?int) {
    index := player ?? game.watched;
    if index < 0 || index >= game.players.count {
        consoleFail("There is no player %. status lists them", index);
        return;
    }
    target := game.players[index].hero.ground();
    if x.hasValue() && z.hasValue() { target = Vector2{x.value(), z.value()}; }
    if !game.itemReady(index, slot) { consoleFail("There is no item to use in slot %, or it isn't ready", slot); }
    game.players[index].order(Command{useItem: {slot: slot, target: target}});
}

@consoleCommand("Offers every player three talents to pick one of, as after a crossing")
offerTalentsNow :: (game: *Game) {
    game.offerTalents();
}

@consoleCommand("The talents there are, and the ones each player has")
talents :: (game: *Game) {
    for kind in TalentKind.values {
        definition := kind.talentDefinition();
        consolePrint("    %  -  %: %", TalentKind.names[kind], definition.name, definition.description);
    }
    for player, i in game.players {
        names := "none";
        for pick, k in player.talents {
            if k == 0 { names = pick.taken().talentDefinition().name; }
            else      { names = tprint("%, %", names, pick.taken().talentDefinition().name); }
        }
        consolePrint("    %. %: %", i, player.name, names);
    }
}

//
// The console itself
//

@consoleCommand("Lists the commands, or says how one is used, e.g help setSpeed")
help :: (name: ?string) {
    consoleHelp(name);
}

@consoleCommand("The commands whose name or help has the text in it")
find :: (text: string) {
    consoleFind(text);
}

@consoleCommand("Prints the text")
echo :: (text: string) {
    consoleEcho(text);
}

@consoleCommand("Clears the console")
clear :: () {
    consoleClear();
}

@consoleCommand("Runs the commands of a file, a line each. Lines that start with // are left out")
exec :: (file: string) {
    consoleExec(file);
}

@consoleCommand("Runs a command at a time of the game, in seconds, e.g at 10 screenshot shot.png")
at :: (seconds: f32, line: string) {
    consoleAt(seconds, line);
}

//
// Particles (effect_styles.sd)
//

@consoleCommand("Makes a particle effect at the hero that is watched, e.g effect blood 60")
effect :: (game: *Game, fx: Fx, count: int = 30) {
    emitEffectAtWatched(game, fx, count);
}

@consoleCommand("How many particles there are, and what they cost")
particles :: (game: *Game) {
    printParticleStats(game);
}

@consoleCommand("Makes a lot of particles at once, to see what they cost")
particleStorm :: (game: *Game, count: int = 5000) {
    makeParticleStorm(game, count);
}

//
// Items (items.sd)
//

@consoleCommand("Puts an item on the road, a random one without a name, at z along the road or anywhere")
spawnItem :: (game: *Game, kind: ?ItemKind, z: ?f32) {
    spawnItemAt(game, kind, z);
}

@consoleCommand("Puts an item in the backpack of a player, you when no player is given. In a full backpack it takes the place of the oldest that isn't locked")
giveItem :: (game: *Game, kind: ItemKind, player: ?int) {
    giveItemTo(game, kind, player);
}

@consoleCommand("The items there are, and what is in each backpack")
items :: (game: *Game) {
    printItems(game);
}

//
// The match (match.sd)
//

@consoleCommand("Ends the game now, with a player as the winner, the one ahead when none is given")
winGame :: (game: *Game, player: ?int) {
    winGameNow(game, player);
}

//
// The profiler (profiler.sd)
//

@consoleCommand("What each part of a frame costs, in milliseconds: on average, and at the worst of the last 2 seconds")
profile :: () {
    printProfile();
}

//
// Oil and traffic events (slicks.sd)
//

@consoleCommand("Makes a car that is coming onto the field leak oil, or drops a blob at x and z")
spawnSlick :: (game: *Game, x: ?f32, z: ?f32) {
    spawnSlickAt(game, x, z);
}

@consoleCommand("Starts a rush hour now, after its warning")
rushHour :: (game: *Game) {
    startRushHour(game);
}

@consoleCommand("Sounds the siren of the ambulances, around a lane or a random one")
ambulance :: (game: *Game, lane: ?int) {
    soundSirenNow(game, lane);
}
