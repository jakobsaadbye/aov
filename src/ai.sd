import "entities";
import "windows_thread";
import "constants";
import "c_stdlib";
import "time";
import "heapq";

MAX_SEARCH_DEPTH_SECONDS :: 3.5;

MAX_QUEUED_NODES :: 16384;
MAX_VISITED_NODES :: 16384;

// How much of an extra margin the AI should keep a distance to the cars
AI_CAR_SAFETY_MARGIN :: 0.3;

StepSize :: 1.0;
MaxIterations :: 32;
GoalThreshold :: StepSize * 0.5;

TIME_BUCKET :: 0.5;
MAX_TIME_BUCKETS :: 8;

MAX_VISITABLE_NODES :: GRID_SIZE * GRID_SIZE * MAX_TIME_BUCKETS;

REFRESH_PATH_RATE_MS :: 60000;


Heuristic :: (p: Vector2, goal: Vector2) -> float {
    return Vector2Distance(p, goal);
}

HasHitGoal :: (x, y: float, goal: Vector2) -> bool {
    dist := Vector2Distance(Vector2{x, y}, goal);
    if dist < GoalThreshold {
        return true;
    }

    return false;
}

ReconstructPath :: (endNode: Node) -> [..]Vector2 {
    path: [..]Vector2;
    cap := MaxIterations * 2 * sizeof(Vector2);
    path.data = malloc(cap);
    path.capacity = cap;

    currentNode := endNode;
    while currentNode.cameFrom != null {
        append(path, Vector2{currentNode.x, currentNode.y});

        currentNode = *currentNode.cameFrom;
    }

    // Add the start node
    append(path, Vector2{currentNode.x, currentNode.y});

    // Reverse the path to go from start -> end
    for i in 0..path.count {
        j := path.count - 1 - i;

        if i > j {
            break;
        }

        tmp := path[i];

        path[i] = path[j];
        path[j] = tmp;
    }

    return path;
}

GetVisitedIndex :: (pos: Vector3) -> int {
    // Shift the position by half the grid size
    pos.x = Clamp(pos.x, -GRID_LEN, GRID_LEN);
    pos.y = Clamp(pos.y, -GRID_LEN, GRID_LEN);
    x := pos.x as int + GRID_LEN as int - 1;
    y := pos.y as int + GRID_LEN as int - 1;
    timeBucket := (pos.z / TIME_BUCKET) as int;
    timeBucket = Clamp(timeBucket as float, 0, MAX_TIME_BUCKETS - 1) as int;

    idx := (GRID_SIZE * GRID_SIZE) * timeBucket + (GRID_SIZE - 1) * x + y;
    if idx >= MAX_VISITABLE_NODES {
        print("Wrong index. index = %, x = %, y = %, t = %", idx, x, y, pos.z);
        assert(false);
        return 0;
    }
    return idx;
}

SetIsVisited :: (visitMask: [..]bool, pos: Vector3) {
    idx := GetVisitedIndex(pos);
    visitMask[idx] = true;
}

IsVisited :: (visitMask: [..]bool, pos: Vector3) -> bool {
    idx := GetVisitedIndex(pos);
    return visitMask[idx];
}

ComputeFastestPath :: (
    start, goal: Vector2, 
    hero: Hero, 
    staticObstacles: [..]Rectangle, 
    dynamicObstacles: [..]DynamicObstacle
) -> [..]Vector2 {
    timeStart := getSystemTime();

    durationFindVisit := 0 as s64;
    durationQueue     := 0 as s64;

    neighborDirections: [9]Vector2 = [
        {0, StepSize},
        {StepSize, StepSize},
        {StepSize, 0},
        {StepSize, -StepSize},
        {0, -StepSize},
        {-StepSize, -StepSize},
        {-StepSize, 0},
        {-StepSize, StepSize},
        {0, 0},
    ];

    // @CompilerBug: We error out, when setting the dynamic arrays directly on the struct
    // queue.elements: [..]Entry; 
    // queue.elements.data = malloc(MAX_QUEUED_NODES * sizeof(Entry));
    // queue.elements.capacity = MAX_QUEUED_NODES;
    queue := newHeapQueue(MAX_QUEUED_NODES);

    startNode := Node{0, 0, start.x, start.y, 0, null};
    queue.push(startNode);

    
    bestNode: Node;
    visited: [..]Node;
    visited.data = malloc(MAX_VISITED_NODES * sizeof(Node));
    visited.capacity = MAX_VISITED_NODES;
    memset(visited.data, 0, MAX_VISITED_NODES);

    
    visitedMask: [..]bool;
    visitedMask.data = malloc(MAX_VISITABLE_NODES);
    visitedMask.capacity = MAX_VISITABLE_NODES;
    memset(visitedMask.data, 0, MAX_VISITABLE_NODES);

    timePerStep := StepSize / hero.stats.moveSpeed;
    heroRadius := hero.getHitboxRadius();

    closestDistance := 999.0;


    carCollisionCheckingTimeTotal := 0 as s64;

    while queue.count() != 0 {
        queuePopStart := getSystemTime();
        e := queue.pop();
        durationQueue += getSystemTime() - queuePopStart;
        
        x := e.x;
        y := e.y;
        t := e.t;

        dg := Vector2Distance(Vector2{x, y}, goal);
        if (dg < closestDistance) {
            bestNode = e;
            closestDistance = dg;
        }
        
        if HasHitGoal(x, y, goal) {
            bestNode = e;
            break;
        }

        findVisitStart := getSystemTime();
        isVisited := IsVisited(visitedMask, Vector3{x, y, t});
        durationFindVisit += getSystemTime() - findVisitStart;
        if isVisited {
            continue;
        }

        SetIsVisited(visitedMask, Vector3{x, y, t});
        append(visited, e);
        currentStable := &visited[visited.count - 1];

        if t >= MAX_SEARCH_DEPTH_SECONDS {
            // Max depth reached for this branch
            continue;
        }

        // Visit neighboring cells
        for d in neighborDirections {
            nx := x + d.x;
            ny := y + d.y;

            stepDist := Vector2Distance(Vector2{0, 0}, d);
            stepTime := stepDist / hero.stats.moveSpeed;
            nt := t + stepTime;

            playerPos := Vector2{nx, ny};

            // Check walls + world bounds
            hitStaticObstacle := false;
            for staticOb in staticObstacles {
                if CheckCollisionCircleRec(playerPos, heroRadius, staticOb) {
                    hitStaticObstacle = true;
                    break;
                }
            }
            if hitStaticObstacle {
                continue;
            }

            // Check cars
            carCollisionCheckingTimeStart := getSystemTime();

            hitDynamicObstacle := false;
            for dob in dynamicObstacles {
                if !dob.active {
                    continue;
                }

                // Interpolate the cars hitbox to at timestep t and check if it collides with the player
                recT := Rectangle{
                    x = dob.rec.x,
                    y = dob.rec.y + dob.velocity * nt,
                    width = dob.rec.width,
                    height = dob.rec.height,
                };

                if CheckCollisionCircleRec(playerPos, heroRadius, recT) {
                    hitDynamicObstacle = true;
                    break;
                }
            }
            carCollisionCheckingTimeEnd := getSystemTime();
            carCollisionCheckingTimeTotal += carCollisionCheckingTimeEnd - carCollisionCheckingTimeStart;
            if hitDynamicObstacle {
                continue;
            }

            // No collision was detected
            findVisitStart = getSystemTime();
            isVisited := IsVisited(visitedMask, Vector3{nx, ny, nt});
            durationFindVisit += getSystemTime() - findVisitStart;
            if !isVisited {
                ng := e.g + stepDist;
                nf := ng + Heuristic(Vector2{nx, ny}, goal);

                newNode := Node{nf, ng, nx, ny, nt, currentStable};
                queue.push(newNode);
            }
        }
    }

    timeEnd := getSystemTime();

    durationMs := timeEnd - timeStart;

    Print("\n---------------------");
    Print("Took:            % ms.", durationMs);
    Print("Visited:         % ", visited.count);
    Print("Queue cap:       % ", queue.elements.capacity);
    Print("Queue time:      % ", durationQueue);
    Print("Collision time:  % ms.", carCollisionCheckingTimeTotal);
    Print("Find visit time: % ms.", durationFindVisit);
    Print("---------------------");

    
    bestPath := ReconstructPath(bestNode);

    free(queue.elements.data);
    free(visited.data);
    free(visitedMask.data);

    return bestPath;
}

TargetReachedThreshold :: 0.5;

ReachedPoint :: (p1, p2: Vector2, margin: float) -> bool {
    return Vector2Distance(p1, p2) < margin;
}

SnapToGrid :: (v: Vector2) -> Vector2 {
    return Vector2{
        x = (round(v.x / StepSize as f64) * StepSize) as f32,
        y = (round(v.y / StepSize as f64) * StepSize) as f32,
    };
}

RecalculateDynamicObstacles :: (game: *Game, aiManager: *AiManager) {
    // Reset
    memset(aiManager.dynamicObstacles.data, 0, MAX_DYNAMIC_OBSTACLES);
    aiManager.dynamicObstacles.count = 0;

    for *car, i in game.cars {
        if !car.live {
            continue;
        }

        carRec := Rectangle{
            x = car.head.position.x - CAR_WIDTH*0.5 - AI_CAR_SAFETY_MARGIN,
            y = car.head.position.z - CAR_LENGTH*0.5 - AI_CAR_SAFETY_MARGIN,
            width = CAR_WIDTH + AI_CAR_SAFETY_MARGIN*2,
            height = CAR_LENGTH + AI_CAR_SAFETY_MARGIN*2,
        };

        dob := DynamicObstacle{
            rec = carRec,
            velocity = car.head.velocity.z,
            active = true,
        };
        
        aiManager.dynamicObstacles[i] = dob;
        aiManager.dynamicObstacles.count += 1;
    }
}

UpdateSingleAI :: (game: *Game, ai: *AiBot) {
    aiManager := &game.aiManager;

    hero := ai.player.hero;
    
    position3d := ai.player.hero.head.position;
    position2d := Vector2{position3d.x, position3d.z};

    // TODO(jsd): Remove
    ai.goal = aiManager.rightEntrance;

    start := SnapToGrid(position2d);
    goal := SnapToGrid(ai.goal);

    // Update the ai path when it has reached the end of its path
    if ai.path.count > 1 {
        target2d := Vector2{x = hero.target.x, y = hero.target.z};

        if ReachedPoint(position2d, target2d, 0.5) {
            ai.nextPoint += 1;

            // TODO(jsd): Remove
            if ai.nextPoint == 6 {
                ai.shouldRecalculatePath = true;
            }
        };

        if ai.nextPoint >= ai.path.count && !ai.shouldRecalculatePath {
            ai.nextPoint = 0;
            ai.shouldRecalculatePath = true;
        }
    }

    // Check if we have gotten a new path result
    if ai.waitingForPath {
        result: AiPathResult;
        if PollPathResult(&ai.worker, result) {
            ai.path          = result.path;
            ai.nextPoint     = 0;
            ai.waitingForPath = false;
        }
    }

    if ai.shouldRecalculatePath && !ai.waitingForPath {
        Print("[AI 1]: Calculating new path");
        RecalculateDynamicObstacles(game, aiManager);

        request := AiPathRequest{
            start            = SnapToGrid(ai.player.hero.pos2d()),
            goal             = SnapToGrid(ai.goal),
            hero             = ai.player.hero,
            staticObstacles  = aiManager.staticObstacles,
            dynamicObstacles = aiManager.dynamicObstacles,
        };

        SubmitPathRequest(&ai.worker, request);

        ai.path = ComputeFastestPath(start, goal, hero, aiManager.staticObstacles, aiManager.dynamicObstacles, iterations = MaxIterations);
        ai.shouldRecalculatePath = false;
        ai.waitingForPath = true;
    }

    // Update the hero position
    {
        if ai.path.count > 1 {
            nextPoint := ai.nextPoint;
    
            if nextPoint < ai.path.count {
                point := ai.path[nextPoint];
                target := Vector3{
                    x = point.x,
                    y = 0,
                    z = point.y,
                };
                ai.player.hero.target = target;
                ai.player.hero.isMoving = true;
            } else {
                ai.player.hero.isMoving = false;
                ai.player.hero.target = Vector3{0};
            }
        }
        else {
            ai.player.hero.isMoving = false;
            ai.player.hero.target = Vector3{0};
        }
    }

}

UpdateAIs :: (game: *Game) {
    aiManager := &game.aiManager;

    for *ai in aiManager.aiBots {
        UpdateSingleAI(game, ai);
    }
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Ai worker stuff
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

// Entry point for each worker thread
WorkerThreadProc :: (lpParam: *void) -> u32 {
    worker := lpParam as *AiWorker;

    while true {
        // Lock and wait for work
        EnterCriticalSection(&worker.lock);
        while !worker.hasRequest {
            SleepConditionVariableCS(&worker.workReady, &worker.lock, INFINITE);
        }

        // Grab the request and clear it
        request := worker.request;
        worker.hasRequest = false;
        LeaveCriticalSection(&worker.lock);

        // Do the work outside the lock so the main thread isn't blocked
        path := ComputeFastestPath(
            request.start,
            request.goal,
            request.hero,
            request.staticObstacles,
            request.dynamicObstacles,
        );

        // Write result
        worker.result.path = path;
        InterlockedExchange(&worker.hasResult, 1);
    }

    return 0;
}

InitializeAiWorker :: (worker: *AiWorker) {
    InitializeCriticalSection(&worker.lock);
    InitializeConditionVariable(&worker.workReady);
    worker.hasRequest = false;
    worker.hasResult  = 0;

    worker.thread = CreateThread(null, 0, WorkerThreadProc, worker, 0, null);
}

// Call this from the main thread to submit work
SubmitPathRequest :: (worker: *AiWorker, request: PathRequest) {
    EnterCriticalSection(&worker.lock);
    worker.request    = request;
    worker.hasRequest = true;
    LeaveCriticalSection(&worker.lock);

    // Wake the worker thread
    WakeConditionVariable(&worker.workReady);
}

// Call this from the main thread to check if result is ready
PollPathResult :: (worker: *AiWorker, result: *PathResult) -> bool {
    if InterlockedCompareExchange(&worker.hasResult, 0, 1) == 1 {
        result = *worker.result;
        return true;
    }
    return false;
}