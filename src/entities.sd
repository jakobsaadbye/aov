import "raylib";
import "windows_thread";

Game :: struct {
    tempStorage: Arena;
    sun: Light;
    camera: *Camera3D;
    mousePosition: Vector2;
    assets: Assets;
    clientPlayer: *Player;
    cars: []Car;
    players: [..]Player;
    walls: []Wall;
    aiManager: AiManager;
    carSpawner: *CarSpawner;
    disableCameraMovement: bool;
    lockCamera: bool;
    isDebug: bool;
    debug: DebugToggles;
}

AiManager :: struct {
    aiBots: [..]AiBot;
    staticObstacles: [..]Rectangle;
    dynamicObstacles: [..]DynamicObstacle;
    leftEntrance: Vector2;
    rightEntrance: Vector2;
}

AiBot :: struct {
    player: *Player;
    path: [..]Vector2;
    nextPoint: int;
    goal: Vector2;
    worker: AiWorker;
    shouldRecalculatePath: bool;
    waitingForPath: bool;
}

AiWorker :: struct {
    thread: *void;

    // Shared state between main thread and worker
    lock:      CriticalSection;
    workReady: ConditionVariable;

    // Work request — main thread writes, worker reads
    request:    AiPathRequest;
    hasRequest: bool;

    // Result — worker writes, main thread reads
    result:    AiPathResult;
    hasResult: u32;  // atomic, 0 = no result, 1 = result ready
}

AiPathRequest :: struct {
    start, goal: Vector2;
    hero: Hero;
    staticObstacles: [..]Rectangle;
    dynamicObstacles: [..]DynamicObstacle;
}

AiPathResult :: struct {
    path: [..]Vector2;
}

DynamicObstacle :: struct {
    rec: Rectangle;
    velocity: float;
    active: bool;
}

CameraInput :: struct {
    zoom: float;
    rotation: Vector3;
    movement: Vector3;
    speed: float;
}

Assets :: struct {
    // Textures
    cursorTexture: Texture;
    // Meshes
    groundMesh: Mesh;
    roadMesh: Mesh;
    // Shaders
    lightShader: Shader;
    // Materials
    groundMaterial: Material;
    roadMaterial: Material;
}

DebugToggles :: struct {
    drawWireframes: bool;
    drawHitboxes: bool;
}

HeroType :: enum {
    none,
    allan,
    ghosty,
    pudge,
}

HeroStats :: struct {
    health: float;
    mana: float;
    moveSpeed: float;
}

EntityType :: enum {
    Hero,
    Car,
    Wall,
}

Entity :: struct {
    type: EntityType;
    position: Vector3;
    velocity: Vector3;
}

Hero :: struct {
    head: Entity;
    type: HeroType;
    stats: HeroStats;
    target: Vector3;
    isMoving: bool;

    // Bounding box of the hero
    width: float;
    height: float;
    length: float;
}

Wall :: struct {
    head: Entity;
    length: float;
}

Car :: struct {
    head: Entity;
    live: bool;
}

CarSpawner :: struct {
    cars: []Car;
    numLive: int;
}

Player :: struct {
    id: int;
    hero: Hero;
    deaths: int;
    isAi: bool;
}

//////////////////////////////////////////////////////////
// Ai types
//////////////////////////////////////////////////////////

Node :: struct {
    f: float;
    g: float;
    x: float;
    y: float;
    t: float;
    cameFrom: *Node;

    // Needed in the priority queue
    index: int;
}




HERO_DEFN_ALLAN :: Hero{
    head = {
        type = .Hero,
    },
    type = .allan,
    stats = {
        health = 1,
        mana = 50,
        moveSpeed = 8,
    },
    width = 2,
    height = 4,
    length = 2,
};

HERO_DEFN_GHOSTY :: Hero{
    head = {
        type = .Hero,
    },
    type = .ghosty,
    stats = {
        health = 1,
        mana = 50,
        moveSpeed = 8,
    },
    width = 2,
    height = 3,
    length = 2,
};

AllHeroes :: [
    HERO_DEFN_ALLAN,
    HERO_DEFN_GHOSTY,
];

pos2d :: method (hero: Hero) -> Vector2 {
    return Vector2{hero.head.position.x, hero.head.position.z};
}

getHitboxRadius :: method (hero: Hero) -> float {
    return hero.width * 0.5 * PLAYER_HITBOX_ASPECT_RATIO;
}

getHitbox :: method (hero: Hero) -> Vector2, float {
    radius := hero.getHitboxRadius();
    return Vector2{hero.head.position.x, hero.head.position.z}, radius;
}