// Allan over vejen: get the hero across the motorway without being run over. Every time a car gets you, you go on
// with a new hero at random.
//
//     saad run main.sd        from this folder

import aov;
import math;
import time;
use raylib;

main :: () {
    SetConfigFlags(.msaa4xHint | .windowResizable | .vsyncHint);
    InitWindow(aov.WindowWidth, aov.WindowHeight, "Allan over vejen");
    defer CloseWindow();
    SetTargetFPS(aov.TargetFps);
    SetExitKey(.null);      // Escape doesn't close the game. Closing the window does

    assets := aov.loadAssets();
    defer assets.unload();
    if assets.cursor.hasValue() { HideCursor(); }

    game := aov.newGame(time.now().unixMilli() as u64);
    defer game.free();

    while !WindowShouldClose() {
        // A long frame, e.g while the window is dragged, mustn't throw the hero through a car
        dt := math.min(GetFrameTime(), 0.05);
        game.update(dt);

        BeginDrawing();
        ClearBackground(aov.SkyColor);
        game.drawScene(&assets);
        game.drawHud(&assets);
        EndDrawing();
    }
}
