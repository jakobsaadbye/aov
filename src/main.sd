CheckHeroWallCollision :: (game: *Game, hero: Hero) -> Rectangle, bool {
    hbCenter, hbRadius := hero.getHitbox();

    // Check collisions against the wall
    for *wall in game.walls {

        wallRec := Rectangle{
            wall.head.position.x - WALL_WIDTH*0.5,
            wall.head.position.z - wall.length*0.5,
            WALL_WIDTH,
            wall.length,
        };

        if CheckCollisionCircleRec(hbCenter, hbRadius, wallRec) {
            return wallRec, true;
        }
    }

    // Check collision with the world bounds
    for mapBoundRec in MapBoundRects {
        if CheckCollisionCircleRec(hbCenter, hbRadius, mapBoundRec) {
            return mapBoundRec, true;
        }
    }

    return {}, false;
}

min :: (values: ...float) -> float {
    smallest := values[0];
    for v in values {
        if v < smallest {
            smallest = v;
        }
    }
    return smallest;
}

ResolveCircleRecCollision2 :: (center: Vector2, radius: float, rec: Rectangle) -> Vector2 {
    // Closest point on rect to circle center
    closest := Vector2{
        Clamp(center.x, rec.x, rec.x + rec.width),
        Clamp(center.y, rec.y, rec.y + rec.height),
    };

    delta  := Vector2Subtract(center, closest);
    length := sqrt((delta.x * delta.x + delta.y * delta.y) as f64);

    // Center is inside the rectangle — find minimum exit along each axis
    if length == 0 {
        overlapLeft   := center.x - rec.x;
        overlapRight  := (rec.x + rec.width)  - center.x;
        overlapTop    := center.y - rec.y;
        overlapBottom := (rec.y + rec.height) - center.y;

        min_overlap := min(overlapLeft, overlapRight, overlapTop, overlapBottom);

        if      min_overlap == overlapLeft   { return Vector2{center.x - (overlapLeft   + radius), center.y}; }
        else if min_overlap == overlapRight  { return Vector2{center.x + (overlapRight  + radius), center.y}; }
        else if min_overlap == overlapTop    { return Vector2{center.x, center.y - (overlapTop    + radius)}; }
        else                                 { return Vector2{center.x, center.y + (overlapBottom + radius)}; }
    }

    // Normal case — push circle out by overlap amount along contact normal
    // @CompilerBug: Assertion failed: arg->type->size == param->type->size && "Unexpected f64 argument to f32 parameter adaptation", file src/code_generator.c, line 1069
    overlap := (radius as f64) - length;
    normal  := Vector2Normalize(delta);
    scaled := Vector2Scale(normal, overlap as f32);
    return Vector2Add(center, scaled);
}

ResolveHeroWallCollision :: (hero: *Hero, rec: Rectangle) {
    // Resolve the player position to get unstuck
    heroCenter, radius := hero.getHitbox();

    newPos := ResolveCircleRecCollision2(heroCenter, radius, rec);

    hero.head.position.x = newPos.x;
    hero.head.position.z = newPos.y;
}

UpdateCars :: (spawner: *CarSpawner) {
    dt := GetFrameTime();

    for *car in spawner.cars {
        if !car.live {
            continue;
        }

        car.head.position.z += car.head.velocity.z * dt;

        if car.head.position.z > GRID_SIZE / 2 {
            car.live = false;
            spawner.numLive -= 1;
        }
    }
}

RespawnCar :: (car: *Car) {
    car.head.position.x = GetRandomValue((ROAD_WIDTH * -0.5 + CAR_WIDTH*0.5) as int, (ROAD_WIDTH * 0.5 - CAR_WIDTH*0.5) as int) as float;
    car.head.position.y = 0;
    car.head.position.z = -GRID_LEN as float;

    car.head.velocity.z = GetRandomValue(2, 10) as float;
    car.live = true;
}

InitializeCars :: (spawner: *CarSpawner) {
    for *car in spawner.cars {

        // Assign each car a random starting position on the ground
        RespawnCar(car);
        car.head.position.z = GetRandomValue(-GRID_LEN as int, GRID_LEN as int) as float;

        spawner.numLive += 1;
    }
}

SpawnCars :: (spawner: *CarSpawner) {
    if spawner.numLive >= spawner.cars.count {
        return;
    }

    // Find an empty car slot
    newCar: *Car;
    for *car in spawner.cars {
        if !car.live {
            newCar = car;
            break;
        }
    }

    RespawnCar(newCar);
    spawner.numLive += 1;
}

CheckPlayerCarCollision :: (player: *Player, cars: []Car) -> *Car, bool {
    for *car in cars {
        if !car.live {
            continue;
        }

        carHitbox := Rectangle{
            car.head.position.x - CAR_WIDTH*0.5,
            car.head.position.z - CAR_LENGTH*0.5,
            CAR_WIDTH,
            CAR_LENGTH,
        };

        if CheckCollisionCircleRec(Vector2{player.hero.head.position.x, player.hero.head.position.z}, player.hero.width * 0.5 * PLAYER_HITBOX_ASPECT_RATIO, carHitbox) {
            return car, true;
        }
    }

    return null, false;
}


GetRandomHero :: () -> Hero {
    randomIndex := GetRandomValue(0, AllHeroes.count - 1);
    return AllHeroes[randomIndex];
}

InitializePlayers :: (game: *Game) {
    totalPlayerCount := NORMAL_PLAYER_COUNT + AI_PLAYER_COUNT;

    players: [..]Player;
    players.data = malloc(sizeof(Player) * MAX_PLAYER_COUNT);
    players.capacity = MAX_PLAYER_COUNT;
    players.count = 0;

    for i in 0..totalPlayerCount {
        player := Player{
            id = i,
            deaths = 0,
            isAi = i >= NORMAL_PLAYER_COUNT
        };

        append(players, player);
    }

    game.players = players;
    game.clientPlayer = &game.players[0];
}

GetAiFromPlayerId :: (game: *Game, playerId: int) -> *AiBot {
    aiManager := &game.aiManager;

    for *ai in aiManager.aiBots {
        if ai.player.id == playerId {
            return ai;
        }
    }

    return null;
}

RespawnAI :: (game: *Game, player: *Player) {
    ai := GetAiFromPlayerId(game, player.id);
    if ai == null {
        return;
    }

    ai.player.hero.head.position.x = game.walls[0].head.position.x;
    ai.player.hero.head.position.z = game.walls[0].head.position.z + game.walls[0].length;

    // Reset the AI to move to the entrance first
    ai.goalCursor = 1;
    ai.shouldRecalculatePath = true;
}

RespawnPlayer :: (game: *Game, player: *Player) {
    player.hero = GetRandomHero();

    if player.isAi {
        RespawnAI(game, player);
    } else {
        player.hero.head.position.x = -GRID_LEN + 2;
        player.hero.head.position.z = 0;
    }
}

HandleCarCollision :: (game: *Game, player: *Player, car: *Car) {
    car.live = false;

    player.deaths += 1;

    RespawnPlayer(game, player);
}

UpdateHero :: (hero: *Hero, newHero: Hero) {
    hero.head.velocity = newHero.head.velocity;
    hero.head.position = newHero.head.position;
    hero.isMoving      = newHero.isMoving;
}

GetCameraInput :: () -> CameraInput {
    dt := GetFrameTime();

    zoom     := 0.0;
    rotation := Vector3{0, 0, 0};
    movement := Vector3{0, 0, 0};
    moveSpeedMultiplier := 1.0;

    // Zoom
    mouseWheel := GetMouseWheelMoveV();
    if mouseWheel.y != 0 {
        zoom -= mouseWheel.y;
    }

    // Rotation
    mouseDelta := GetMouseDelta();
    rotation.x += mouseDelta.x * 0.125;
    rotation.y += mouseDelta.y * 0.125;

    // Movement
    if IsKeyDown(.left_shift) {
        moveSpeedMultiplier = 2.0;
    }

    baseMoveSpeed :: 30;

    if IsKeyDown(.w) {
        movement.x += baseMoveSpeed * moveSpeedMultiplier * dt;
    }
    if IsKeyDown(.s) {
        movement.x -= baseMoveSpeed * moveSpeedMultiplier * dt;
    }
    if IsKeyDown(.a) {
        movement.y -= baseMoveSpeed * moveSpeedMultiplier * dt;
    }
    if IsKeyDown(.d) {
        movement.y += baseMoveSpeed * moveSpeedMultiplier * dt;
    }

    return CameraInput{
        zoom,
        rotation,
        movement,
        moveSpeedMultiplier,
    };
}

SplitMesh :: (mesh: Mesh, numTiles: float) {
    // The generated mesh has 4 vertices; patch the UVs to [0, numTiles]
    // GenMeshPlane stores texcoords as { u, v } floats, 2 floats per vertex
    // Vertex order (looking down): BL, BR, TL, TR
    uvs: [8]float = [
        0,           0,
        numTiles,    0,
        0,           numTiles,
        numTiles,    numTiles,
    ];

    // Copy into the mesh texcoords buffer and re-upload
    for i in 0..8 {
        mesh.texcoords[i] = uvs[i];
    }

    // index 1 = texcoord buffer
    UpdateMeshBuffer(mesh, 1, uvs.data, 8 * sizeof(float), 0);
}

StartNewGame :: (game: *Game) {
    // Respawn all players
    for *player in game.players {
        RespawnPlayer(game, player);
    }
}

InitializeAiManager :: (game: *Game) {
    aiManager := &game.aiManager;

    // Ai bots
    {
        aiBots: [..]AiBot;
        aiBots.data = malloc(sizeof(AiBot) * AI_PLAYER_COUNT);
        aiBots.capacity = AI_PLAYER_COUNT;
    
        for *player in game.players {
            if !player.isAi {
                continue;
            }

            aiBot: AiBot;
            aiBot.player = player;

            append(aiBots, aiBot);
        }

        aiManager.aiBots = aiBots;
    }

    // Static obstacles
    {
        staticObstacles: [..]Rectangle;
        for *wall in game.walls {
            rect := Rectangle{
                x = wall.head.position.x - WALL_WIDTH*0.5,
                y = wall.head.position.z - wall.length*0.5,
                width = WALL_WIDTH,
                height = wall.length,
            };
    
            append(staticObstacles, rect);
        }
    
        for mapBound in MapBoundRects {
            append(staticObstacles, mapBound);
        }
    
        aiManager.staticObstacles = staticObstacles;
    }

    // TODO(jsd): Reconsider if we still want this structure
    // Dynamic obstacles
    {
        dynamicObstacles: [..]DynamicObstacle;
        dynamicObstacles.data = calloc(MAX_DYNAMIC_OBSTACLES, sizeof(DynamicObstacle));
        dynamicObstacles.capacity = MAX_DYNAMIC_OBSTACLES;
        aiManager.dynamicObstacles = dynamicObstacles;

        RecalculateDynamicObstacles(game, aiManager);
    }

    // Goal points
    {
        wallTopL := game.walls[0];
        wallTopR := game.walls[2];
    
        leftEntrance := Vector2{
            x = wallTopL.head.position.x, 
            y = wallTopL.head.position.z + wallTopL.length*0.5 + ENTRANCE_LENGTH*0.5
        };

        rightEntrance := Vector2{
            x = wallTopR.head.position.x, 
            y = wallTopR.head.position.z + wallTopR.length*0.5 + ENTRANCE_LENGTH*0.5
        };

        aiManager.leftEntrance  = leftEntrance;
        aiManager.rightEntrance = rightEntrance;
    }
}

InitializeGame :: (game: *Game) {
    InitializeCars(game.carSpawner);
    InitializePlayers(game);
    InitializeAiManager(game);
}

main :: () {
    InitWindow(WindowWidth, WindowHeight, xx "Allan over vejen");
    DisableCursor();
    SetTargetFPS(TARGET_FPS);

    icon := LoadImage(xx "../data/window_icon.png");
    ImageFormat(&icon, PixelFormat.uncompressed_r8g8b8a8);
    SetWindowIcon(icon);


    // InitializeGame :: ()
    // @CompilerBug: Arrays seems not to be zero initialized when being inside the Game struct.
    // Perhaps we are calculating the struct size incorrectly???
    cars: [MAX_CAR_COUNT]Car;

    carSpawner := CarSpawner{
        cars = cars,
    };

    
    walls: [4]Wall;
    {
        SMALL_SEGNMENT_LENGTH :: 15;

        wallTopLeft := Wall{
            head = {
                type = .Wall,
                position = {-ROAD_WIDTH*0.5 - WALL_WIDTH*0.5, WALL_HEIGHT*0.5, -GRID_LEN + SMALL_SEGNMENT_LENGTH*0.5}
            },
            length = SMALL_SEGNMENT_LENGTH,
        };

        wallBottomLeftLen := GRID_SIZE - ENTRANCE_LENGTH - wallTopLeft.length;
        wallBottomLeft := Wall{
            head = {
                type = .Wall,
                position = {-ROAD_WIDTH*0.5 - WALL_WIDTH*0.5, WALL_HEIGHT*0.5, wallTopLeft.head.position.z + wallTopLeft.length*0.5 + ENTRANCE_LENGTH + wallBottomLeftLen*0.5}
            },
            length = wallBottomLeftLen,
        };

        wallTopRightLen := GRID_SIZE - ENTRANCE_LENGTH - SMALL_SEGNMENT_LENGTH as float;
        wallTopRight := Wall{
            head = {
                type = .Wall,
                position = {ROAD_WIDTH*0.5 + WALL_WIDTH*0.5, WALL_HEIGHT*0.5, -GRID_LEN + wallTopRightLen*0.5}
            },
            length = wallTopRightLen,
        };

        wallBottomRight := Wall{
            head = {
                type = .Wall,
                position = {ROAD_WIDTH*0.5 + WALL_WIDTH*0.5, WALL_HEIGHT*0.5, GRID_LEN - SMALL_SEGNMENT_LENGTH + SMALL_SEGNMENT_LENGTH*0.5}
            },
            length = SMALL_SEGNMENT_LENGTH,
        };

        walls[0] = wallTopLeft;
        walls[1] = wallBottomLeft;
        walls[2] = wallTopRight;
        walls[3] = wallBottomRight;
    }

    origCameraPosition := Vector3{0, 80, 64};
    origCameraTarget := Vector3{0, -45.0, -0};

    camera := Camera3D{
        position = origCameraPosition,
        target = origCameraTarget,
        up = {0, 1, 0},
        fovy = 45,
        projection = .perspective,
    };

    game := Game{
        tempStorage = NewArena(4 * Kilobyte),
        camera = &camera,
        cars = cars,
        walls = walls,
        carSpawner = &carSpawner,
        disableCameraMovement = true,
        lockCamera = true,
        isDebug = true,
    };


    //
    // Initialization
    //
    InitializeGame(&game);

    //
    // Asset loading
    //

    // Texture loading
    groundTexture     := LoadTexture(xx "../data/textures/grass/Grass_02.png");
    groundTextureNorm := LoadTexture(xx "../data/textures/grass/Grass_02_Nrm.png");
    roadTexture       := LoadTexture(xx "../data/textures/road/Ground_03.png");
    roadTextureNorm   := LoadTexture(xx "../data/textures/road/Ground_03_Nrm.png");
    cursorTexture     := LoadTexture(xx "../data/textures/cursor/human.png");

    // Load basic lighting shader
    lightShader: Shader = LoadShader(xx "../data/shaders/lighting.vs", xx "../data/shaders/lighting.fs");

    // Get some required shader locations
    lightShader.locs[ShaderLocationIndex.SHADER_LOC_VECTOR_VIEW] = GetShaderLocation(lightShader, xx "viewPos");

    // Ambient light level (some basic lighting)
    ambientLoc: int = GetShaderLocation(lightShader, xx "ambient");
    SetShaderValue(lightShader, ambientLoc, [0.4, 0.4, 0.4, 1.0].data, .VEC4);

    // Create lights
    game.sun = CreateLight(.directional, { 0, 128, GRID_LEN }, {0, 0, 0}, {180, 180, 160, 255}, lightShader);
    
    // Setup the ground floor
    groundMesh := GenMeshPlane(GRID_SIZE, GRID_SIZE, 1, 1);
    SplitMesh(groundMesh, 4);

    // Create a material using the grid texture
    groundMaterial := LoadMaterialDefault();
    groundMaterial.shader = lightShader;
    groundMaterial.maps[MaterialMapIndex.MATERIAL_MAP_ALBEDO].texture = groundTexture;
    groundMaterial.maps[MaterialMapIndex.MATERIAL_MAP_ALBEDO].color = GREEN;
    groundMaterial.maps[MaterialMapIndex.MATERIAL_MAP_NORMAL].texture = groundTextureNorm;

    roadMesh := GenMeshPlane(ROAD_WIDTH, ROAD_HEIGHT, 1, 1);
    SplitMesh(roadMesh, 8);
    roadMaterial := LoadMaterialDefault();
    roadMaterial.maps[MaterialMapIndex.MATERIAL_MAP_ALBEDO].texture = roadTexture;
    roadMaterial.maps[MaterialMapIndex.MATERIAL_MAP_ALBEDO].color = WHITE;
    roadMaterial.maps[MaterialMapIndex.MATERIAL_MAP_NORMAL].texture = roadTextureNorm;

    
    StartNewGame(&game);

    game.assets.cursorTexture = cursorTexture;
    game.assets.groundMesh = groundMesh;
    game.assets.roadMesh = roadMesh;
    game.assets.lightShader = lightShader;
    game.assets.groundMaterial = groundMaterial;
    game.assets.roadMaterial = roadMaterial;

    while !WindowShouldClose() {
        dt := GetFrameTime();

        game.tempStorage.clear();

        //
        // GetInput()
        //
        camInput := GetCameraInput();

        if (IsKeyPressed(.space)) {
            game.lockCamera = !game.lockCamera;
        }

        if (IsKeyPressed(.r)) {
            camera.position = origCameraPosition;
            camera.target   = origCameraTarget;
            game.lockCamera = true;
        }

        if (IsMouseButtonPressed(.right)) {
            ray := GetScreenToWorldRay(game.mousePosition, camera);
            collision := GetRayCollisionMesh(ray, groundMesh, MatrixIdentity());

            if collision.hit {
                game.clientPlayer.hero.target = collision.point;
                game.clientPlayer.hero.isMoving = true;
            }
        }

        if (game.isDebug) {
            if (IsKeyPressed(.one)) {
                game.clientPlayer = &game.players[0];
            }
            if (IsKeyPressed(.two)) {
                game.clientPlayer = &game.players[1];
            }
            if (IsKeyPressed(.f1)) {
                game.debug.drawWireframes = !game.debug.drawWireframes;
            }
            if (IsKeyPressed(.f2)) {
                game.debug.drawHitboxes = !game.debug.drawHitboxes;
            }
        }

        game.mousePosition = GetMousePosition();

        //
        // UpdateGame()
        //

        // Update camera
        if game.lockCamera {
            // Lock camera rotation
            UpdateCameraPro(game.camera, camInput.movement, {0, 0 ,0}, camInput.zoom);
        } else {
            UpdateCameraPro(game.camera, camInput.movement, camInput.rotation, camInput.zoom);
        }

        // Simulate heroes
        for *player in game.players {
            simHero := SimulateHero(player.hero, dt);
    
            // Check player vs wall collisions
            {
                rec, collided := CheckHeroWallCollision(&game, simHero);
                if collided {
                    ResolveHeroWallCollision(&simHero, rec);
                }
            }
    
            // Update the hero with the simulated hero
            UpdateHero(&player.hero, simHero);
    
            // Check player vs car collision
            {
                car, collided := CheckPlayerCarCollision(player, game.cars);
                if collided {
                    HandleCarCollision(&game, player, car);
                }
            }

        }

        // Update AI path finding
        UpdateAIs(&game);
        
        // Update cars
        SpawnCars(game.carSpawner);
        UpdateCars(game.carSpawner);

        // Update the shader with the camera view vector (points towards { 0.0f, 0.0f, 0.0f })
        SetShaderValue(game.assets.lightShader, game.assets.lightShader.locs[ShaderLocationIndex.SHADER_LOC_VECTOR_VIEW], &game.camera.position, .VEC3);

        // Update light values (actually, only enable/disable them)
        UpdateLightValues(game.assets.lightShader, game.sun);
        

        //
        // DrawGame()
        //
        DrawGame(&game);
    }

    CloseWindow();
}