// Allan over vejen: get the hero across the motorway without being run over. Every time a car gets you, you go on
// with a new hero at random. Bots race you across.
//
//     saad run main.sd                                   from this folder
//     saad run main.sd -- --bots 5 --seed 7              options after --, see Options below

import core;
import bots;
import bots.DefaultBots;
import fmt;
import math;
import os;
import time;
use raylib;

// What can be given on the command line. Mostly for trying things out and testing, e.g by an agent that can't play:
//
//     --bots N            How many bots (0 to 5, 3 when not given)
//     --difficulty D      How good the bots are: easy, normal (when not given), hard or expert
//     --spectate          No hero of your own: the camera follows the first bot
//     --seed N            The same seed gives the same game
//     --hero NAME         Your first hero, e.g --hero butcher
//     --inspect N         Open the inspector (F4) on the bot of player N, e.g 1 for the first bot of a game with you
//     --speed X           Run the game X times as fast, e.g 4 to see a lot quickly
//     --screenshot S F    Save a screenshot to the file F after S seconds of game time
//     --quit S            Close after S seconds of game time, or at the end of a replay
//     --mute              No sound
//     --record FILE       Save a recording of the game to FILE when it closes. F8 saves one at any time
//     --replay FILE       Play a recording back (recording.sd). The other options of the game are the recording's
Options :: struct {
    bots:       int = DefaultBots;
    difficulty: core.Difficulty = .normal;
    spectate:   bool;
    seed:       ?u64;
    hero:       ?core.HeroKind;
    inspect:    ?int;
    speed:      f32 = 1;
    shots:      [..]Screenshot;
    quitAt:     ?f32;
    mute:       bool;
    record:     ?string;
    replay:     ?string;
}

Screenshot :: struct {
    at:   f32;
    file: string;
}

readOptions :: () -> Options {
    options: Options;
    args := os.args();
    i := 1;
    while i < args.count {
        arg := args[i];
        next := "";
        if i + 1 < args.count { next = args[i + 1]; }
        switch arg {
            case "--bots"     { options.bots = (next.toInt() ?? bots.DefaultBots) as int; i += 1; }
            case "--spectate" { options.spectate = true; }
            case "--difficulty" {
                index := core.Difficulty.names.indexOf(next);
                if index >= 0 { options.difficulty = index as core.Difficulty; }
                else          { fmt.print("WARNING: No difficulty named '%': easy, normal, hard or expert", next); }
                i += 1;
            }
            case "--seed"     { options.seed = (next.toInt() ?? 1) as u64; i += 1; }
            case "--inspect"  { options.inspect = (next.toInt() ?? 1) as int; i += 1; }
            case "--speed"    { options.speed = (next.toFloat() ?? 1) as f32; i += 1; }
            case "--quit"     { options.quitAt = (next.toFloat() ?? 10) as f32; i += 1; }
            case "--mute"     { options.mute = true; }
            case "--record"   { options.record = next; i += 1; }
            case "--replay"   { options.replay = next; i += 1; }
            case "--hero" {
                index := core.HeroKind.names.indexOf(next);
                if index >= 0 { options.hero = index as core.HeroKind; }
                else          { fmt.print("WARNING: No hero named '%'", next); }
                i += 1;
            }
            case "--screenshot" {
                if i + 2 < args.count {
                    options.shots.add(Screenshot{(next.toFloat() ?? 5) as f32, args[i + 2]});
                }
                i += 2;
            }
            else { fmt.print("WARNING: Unknown option '%'", arg); }
        }
        i += 1;
    }
    return options;
}

main :: () {
    options := readOptions();

    SetConfigFlags(.msaa4xHint | .windowResizable | .vsyncHint);
    InitWindow(core.WindowWidth, core.WindowHeight, "Allan over vejen");
    defer CloseWindow();
    SetTargetFPS(core.TargetFps);
    SetExitKey(.null);      // Escape doesn't close the game. Closing the window does

    assets := core.loadAssets();
    defer assets.unload();

    game: *core.Game = null;
    if options.replay.hasValue() {
        recording, err := core.loadRecording(options.replay.value());
        if err != null {
            fmt.print("ERROR: Couldn't read the recording %: %", options.replay.value(), err.message);
            return;
        }
        game = bots.newReplay(recording);
    } else {
        seed := options.seed ?? time.now().unixMilli() as u64;
        humans := 1;
        if options.spectate { humans = 0; }
        game = bots.newGame(seed, bots: options.bots, humans: humans, difficulty: options.difficulty);
        if options.hero.hasValue() && !options.spectate {
            game.spawnHero(game.local, options.hero.value());
            game.recording.firstHero = options.hero.value() as int;
        }
    }
    defer game.free();
    defer {
        if options.record.hasValue() {
            err := game.saveRecording(options.record.value());
            if err != null { fmt.print("ERROR: Couldn't save the recording: %", err.message); }
        }
    }
    if options.inspect.hasValue() {
        game.inspector = core.Inspector{isOpen: true, player: options.inspect.value()};
    }

    if !options.mute {
        folder := core.dataFolder();
        game.sounds.load(folder);
        folder.free();
        game.sounds.playMusic("theme", 0.5);
        game.sounds.playMusic("traffic", 0.3, pausesWithGame: true);
    }
    defer game.sounds.unload();
    HideCursor();       // The cursor of Warcraft is drawn instead

    nextShot := 0;
    replayClock: f32 = 0;
    while !WindowShouldClose() {
        // A long frame, e.g while the window is dragged, mustn't throw the hero through a car. Faster with --speed, in
        // steps that are no longer. A replay plays its recorded frames as fast as they were played, times the speed
        dt := math.min(GetFrameTime(), 0.05);
        game.handleKeys();
        if game.replay != null {
            replayClock += dt * options.speed;
            while !game.isPaused && !game.replay.isFinished() {
                next := game.replay.recording.frames[game.replay.frame].dt;
                if replayClock < next { break; }
                replayClock -= next;
                game.advance(next);
            }
        } else {
            steps := math.max(1, math.ceilf(options.speed) as int);
            for 0..steps { game.advance(dt * options.speed / steps as f32); }
        }
        game.updateCamera(dt);

        if IsKeyPressed(.m) { game.sounds.toggleMute("theme"); }
        game.sounds.setListener(game.camera.focus);
        game.sounds.update(dt);

        BeginDrawing();
        ClearBackground(core.SkyColor);
        game.drawScene(&assets);
        game.drawHud(&assets);
        EndDrawing();

        if nextShot < options.shots.count && game.time >= options.shots[nextShot].at {
            file := options.shots[nextShot].file.toCString();
            TakeScreenshot(file);
            file.free();
            nextShot += 1;
        }
        if options.quitAt.hasValue() && game.time >= options.quitAt.value() { break; }
        if options.quitAt.hasValue() && game.replay != null && game.replay.isFinished() { break; }
    }
}
