// Allan over vejen: get the hero across the motorway without being run over. Every time a car gets you, you go on
// with a new hero at random. Bots race you across.
//
//     saad run main.sd                                       from this folder
//     saad run main.sd -- +setBots 5 +setSeed 7              console commands after --, each after a +
//
// Everything that can be set is a command of the console (F1, console/console_commands.sd), e.g setSpeed 8 or toggleMute. help
// in the console lists them. The commands on the command line run before the game starts, in their order, and at
// <seconds> <command> runs one at a time of the game, e.g for an agent that can't play:
//
//     out.exe +spectate +inspect 0 +setSpeed 4 +at 8 screenshot shot.png +at 10 quit
//
// data/autoexec.cfg, when there is one, runs first: a command a line.

import console;
import core;
import bots;
import bots.DefaultBots;
import fmt;
import math;
import os;
import time;
use raylib;

main :: () {
    SetConfigFlags(.msaa4xHint | .windowResizable | .vsyncHint);
    InitWindow(core.WindowWidth, core.WindowHeight, "Allan over vejen");
    defer CloseWindow();
    SetTargetFPS(core.TargetFps);
    SetExitKey(.null);      // Escape doesn't close the game. Closing the window does

    assets := core.loadAssets();
    defer assets.unload();

    console.provide(console.currentGame);
    console.provide(console.currentSession);
    autoexec := core.tprint("%autoexec.cfg", core.dataFolder());
    if os.fileExists(autoexec) { console.runFile(autoexec); }
    console.runArguments(os.args());
    console.session.ensureGame();
    if !console.session.muted { console.session.loadSounds(); }
    defer {
        console.session.saveRecording(console.session.game);
        console.session.game.sounds.unload();
        console.session.game.free();
    }
    HideCursor();       // The game draws its own cursor

    view := &console.session.view;
    while !WindowShouldClose() && !console.session.quit {
        // A long frame, e.g while the window is dragged, mustn't throw the hero through a car. Faster with setSpeed, in
        // steps that are no longer. A replay plays its recorded frames as fast as they were played, times the speed
        dt := math.min(GetFrameTime(), 0.05);
        keyboardTaken := view.update(dt);           // May run commands
        console.update(console.session.game.time);          // The commands of at
        console.session.ensureGame();
        game := console.session.game;
        game.keyboardTaken = keyboardTaken;

        game.handleKeys();
        speed := console.session.speed;
        if game.replay != null {
            console.session.replayClock += dt * speed;
            while !game.isPaused && !game.replay.isFinished() {
                next := game.replay.recording.frames[game.replay.frame].dt;
                if console.session.replayClock < next { break; }
                console.session.replayClock -= next;
                game.advance(next);
            }
        } else {
            steps := math.max(1, math.ceilf(speed) as int);
            for 0..steps { game.advance(dt * speed / steps as f32); }
        }
        game.updateCamera(dt);

        if IsKeyPressed(.m) && !keyboardTaken { game.sounds.toggleSoundtrack(); }
        game.sounds.setListener(game.camera.focus);
        game.sounds.update(dt);

        BeginDrawing();
        ClearBackground(core.SkyColor);
        game.drawScene(&assets);
        core.profileBegin(.hud);
        game.drawHud(&assets);
        console.drawConsole(view);
        core.profileEnd(.hud);
        EndDrawing();
        core.profileEnd(.frame);
        core.profileFrame();
        core.profileBegin(.frame);

        if console.session.screenshot.hasValue() {
            TakeScreenshot(core.tempCString(console.session.screenshot.value()));
            console.session.screenshot = null;
        }
        core.freeTemp();            // What was allocated for this frame only (core/temp.sd)
    }
}
