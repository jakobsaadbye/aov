namespace bots;

use core;

import math;
import mem;
use raylib;

// What the road will look like in the next seconds, for the bots: the ground as a grid of cells, and for each cell the
// intervals of time when no car is on it (safe intervals).
//
// A car only ever drives along its lane, so where it will be is a function of time with a few straight pieces: held by a
// freeze, slowed by a time warp, stopped at Hilda's line, then on at its speed. Each car's pieces are worked out once
// (Trajectory), and when it is on a cell is then solved exactly from them instead of stepping through time. The safe
// intervals of a cell are only worked out when the search asks for them, so the cells it never looks at cost nothing.
//
// It is made for one hero: the cells are blocked where that hero doesn't fit, its size makes the cars wider, and Ghosty
// isn't stopped by the walls. Times are seconds from when it is made.

CellSize        :: 1.5;
GridColumns     :: 171;         // MapHalfWidth * 2 / CellSize, rounded up
GridRows        :: 86;          // MapHalfLength * 2 / CellSize, rounded up
GridCells       :: GridColumns * GridRows;
ForecastHorizon :: 12.0;        // Seconds ahead. After it, a car is taken to be gone

Forever :: 1000000.0;

TimeInterval :: struct {
    start: f32;
    end:   f32;                 // Forever when it doesn't end within what is known
}

operator < :: (a: TimeInterval, b: TimeInterval) -> bool {
    return a.start < b.start;
}

// One straight piece of where a car is: from the time start, at z, at a speed
TrajectoryPiece :: struct {
    start: f32;
    z:     f32;
    speed: f32;
}

MaxPieces :: 6;
MaxHitsPerCell :: 48;

// Where a car will be along its lane, as straight pieces in order of time. Before the first piece the car isn't there
// yet, e.g the next car of a lane
Trajectory :: struct {
    pieces:     [MaxPieces]TrajectoryPiece;
    count:      int;
    halfLength: f32;
    leaveWith:  int = -1;       // A car that isn't spawned yet: when it leaves a cell is by the slowest it could be, in
                                // Forecast.slowSpawns
    harmlessUntil: f32;         // Up on Karl's jack until then: it hits nobody

    add :: method * (start: f32, z: f32, speed: f32) {
        assert(self.count < MaxPieces);
        self.pieces[self.count] = TrajectoryPiece{start, z, speed};
        self.count += 1;
    }

    // The first time from `from` on that the middle of the car is at z or further, or Forever
    timeAt :: method (z: f32, from: f32 = 0) -> f32 {
        for i in 0..self.count {
            piece := self.pieces[i];
            end := Forever;
            if i + 1 < self.count { end = self.pieces[i + 1].start; }
            if end <= from { continue; }
            begin := math.max(piece.start, from);
            zBegin := piece.z + piece.speed * (begin - piece.start);
            if zBegin >= z { return begin; }
            if piece.speed <= 0 { continue; }
            t := piece.start + (z - piece.z) / piece.speed;
            if t < end { return t; }
        }
        return Forever;
    }
}

ForecastOptions :: struct {
    radius:       f32;          // Of the hero
    throughWalls: bool;
    margin:       f32 = 0.4;    // Room kept to the cars, besides the radius
    leadTime:     f32 = 0.5;    // Seconds before a car gets to a cell that it isn't taken to be safe any more. Long, so a
                                // hero never runs just in front of a car, with no time left to step aside
    trailTime:    f32 = 0.1;    // Seconds after a car has left a cell that it is safe again: right behind a car is safe

    // A cell isn't safe from when a car that hasn't been spawned yet could get to it at the earliest. Very careful: in
    // heavy traffic there is then seldom a way all the way across. Without it, a new car is seen more than 2 seconds
    // before it can get onto the field, which a bot that plans a few times a second has time for
    fearUnknownCars: bool;

    oilProof:       bool;       // The oil doesn't make the hero slide (Karl)
    ambulanceProof: bool;       // The ambulances drive round the hero (Ditte)
}

// A footbridge over the road: the cells under it are safe while it is up, from start to end
SafeZone :: struct {
    rect:  Rectangle;
    start: f32;
    end:   f32;
}

Forecast :: struct {
    options:    ForecastOptions;
    blocked:    []bool;                 // For each cell: a wall, or the edge of the field. Never safe. Shared (blockedCells)
    slicks:     [..]Slick;              // The oil slicks, where a hero can't turn. Never safe either
    safeZones:  [..]SafeZone;           // Footbridges
    firstSafe:  [..]int;                // For each cell: where its safe intervals start in safe, -1 until asked for
    safeCount:  [..]int;
    safe:       [..]TimeInterval;
    lanes:      [LaneCount][..]Trajectory;
    slowSpawns:  [..]Trajectory;
    unknownFrom: [LaneCount]f32;        // When a car that isn't predicted could be spawned in a lane at the earliest
    fastest:     [LaneCount]f32;        // and how fast it could drive
    reachX:     f32;                    // How far from the middle of a lane its cars reach a hero

    // The safe intervals of a cell, in order of time, as indexes into safe: from first, count of them
    intervalsOf :: method * (cell: int) -> int, int {
        if self.firstSafe[cell] < 0 { self.work(cell); }
        return self.firstSafe[cell], self.safeCount[cell];
    }

    // The safe interval of a cell at a time, or -1 when a car is on it then (or it is blocked)
    intervalAt :: method * (cell: int, time: f32) -> int {
        if self.blocked[cell] { return -1; }
        first, count := self.intervalsOf(cell);
        for i in first..first + count {
            interval := self.safe[i];
            if time < interval.start { return -1; }
            if time <= interval.end { return i as int; }
        }
        return -1;
    }

    // When a car that is known is first on a hero standing at a point, from a time on, with only the hero's own size
    // and an extra margin: no padding, and no cars that aren't spawned yet. Forever when none comes in the horizon
    hitTime :: method (point: Vector2, from: f32, extraMargin: f32 = 0) -> f32 {
        reachX := CarWidth * 0.5 + self.options.radius + extraMargin;
        if math.fabsf(point.x) > RoadHalfWidth + reachX { return Forever; }
        first: f32 = Forever;
        for lane in laneAt(point.x - reachX)...laneAt(point.x + reachX) {
            if math.fabsf(laneCenter(lane) - point.x) >= reachX { continue; }
            for *trajectory in self.lanes[lane] {
                if trajectory.leaveWith >= 0 { continue; }
                reach := trajectory.halfLength + self.options.radius + extraMargin;
                enter := math.max(trajectory.timeAt(point.y - reach, from), trajectory.harmlessUntil);
                if enter >= first { continue; }
                // Already past the point
                if trajectory.timeAt(point.y + reach, from) <= from { continue; }
                first = enter;
            }
        }
        return first;
    }

    // How long a point stays free of cars, from a time: 0 when a car is on it
    safeFor :: method * (point: Vector2, time: f32) -> f32 {
        cell := cellAt(point);
        if cell < 0 { return 0; }
        interval := self.intervalAt(cell, time);
        if interval < 0 { return 0; }
        return self.safe[interval].end - time;
    }

    // Works out the safe intervals of a cell: the times between the cars of the lanes that reach it
    @private
    work :: method * (cell: int) {
        self.firstSafe[cell] = self.safe.count as int;
        center := cellCenter(cell);
        for slick in self.slicks {
            if self.options.oilProof { break; }
            if slick.contains(center) {
                self.safeCount[cell] = 0;
                return;
            }
        }

        // The cars on the cell, sorted by when they come, in a buffer of the stack
        hits: [MaxHitsPerCell]TimeInterval;
        count := 0;
        // The hero walks between the middles of the cells, so it can be half a cell nearer a car than either middle
        reachX := self.reachX + CellSize * 0.5;
        if math.fabsf(center.x) < RoadHalfWidth + reachX {
            reachZ := self.options.radius + self.options.margin + CellSize * 0.5;
            firstLane := laneAt(center.x - reachX);
            lastLane := laneAt(center.x + reachX);
            for lane in firstLane...lastLane {
                if math.fabsf(laneCenter(lane) - center.x) >= reachX { continue; }
                // A car that isn't known yet could be on the cell from when it could get there at the earliest
                unknown := self.unknownFrom[lane] + math.max(0, center.y - reachZ + RoadEnd) / self.fastest[lane];
                if self.options.fearUnknownCars && unknown < ForecastHorizon && count < MaxHitsPerCell {
                    hits[count] = TimeInterval{unknown, Forever};
                    count += 1;
                    at := count - 1;
                    while at > 0 && hits[at].start < hits[at - 1].start {
                        hits.swap(at, at - 1);
                        at -= 1;
                    }
                }
                for *trajectory in self.lanes[lane] {
                    // On the cell from when its front gets to it until its back has left it
                    reach := trajectory.halfLength + reachZ;
                    enter := math.max(trajectory.timeAt(center.y - reach), trajectory.harmlessUntil);
                    if enter >= ForecastHorizon { continue; }
                    leave: f32 = 0;
                    if trajectory.leaveWith >= 0 {
                        // A car that isn't spawned yet: what is past the horizon isn't known, so not blocked for ever
                        leave = math.min(self.slowSpawns[trajectory.leaveWith].timeAt(center.y + reach, enter), ForecastHorizon);
                    } else {
                        leave = trajectory.timeAt(center.y + reach, enter);
                        if leave >= ForecastHorizon { leave = Forever; }     // Still there when the horizon ends
                    }
                    if count == MaxHitsPerCell { break; }
                    hit := TimeInterval{math.max(enter - self.options.leadTime, 0), leave + self.options.trailTime};
                    at := count;
                    while at > 0 && hit.start < hits[at - 1].start {
                        hits[at] = hits[at - 1];
                        at -= 1;
                    }
                    hits[at] = hit;
                    count += 1;
                }
            }
        }

        free: f32 = 0;          // Safe from here
        for i in 0..count {
            hit := hits[i];
            if hit.start > free { self.safe.add(TimeInterval{free, hit.start}); }
            free = math.max(free, hit.end);
        }
        if free < Forever { self.safe.add(TimeInterval{free, Forever}); }
        self.safeCount[cell] = self.safe.count as int - self.firstSafe[cell];
        for zone in self.safeZones {
            if CheckCollisionPointRec(center, zone.rect) { self.addSafe(cell, zone.start, zone.end); }
        }
    }

    // Makes a cell safe from start to end too, whatever its cars: its intervals and this one, joined. The cell's
    // intervals must be the last of safe
    @private
    addSafe :: method * (cell: int, start: f32, end: f32) {
        first := self.firstSafe[cell];
        count := self.safeCount[cell];
        merged: [MaxHitsPerCell + 2]TimeInterval;
        n := 0;
        added := false;
        for i in first..first + count {
            interval := self.safe[i];
            if !added && start < interval.start {
                merged[n] = TimeInterval{start, end};
                n += 1;
                added = true;
            }
            if n >= merged.count { break; }
            merged[n] = interval;
            n += 1;
        }
        if !added && n < merged.count {
            merged[n] = TimeInterval{start, end};
            n += 1;
        }
        // Join the ones that overlap
        self.safe.count = first;
        for k in 0..n {
            interval := merged[k];
            last := self.safe.count as int - 1;
            if last >= first && interval.start <= self.safe[last].end {
                self.safe[last].end = math.max(self.safe[last].end, interval.end);
            } else {
                self.safe.add(interval);
            }
        }
        self.safeCount[cell] = self.safe.count as int - first;
    }
}

// The cell a point of the ground is in, or -1 outside of the field
cellAt :: (point: Vector2) -> int {
    column := math.floorf((point.x + MapHalfWidth) / CellSize) as int;
    row    := math.floorf((point.y + MapHalfLength) / CellSize) as int;
    if column < 0 || column >= GridColumns || row < 0 || row >= GridRows { return -1; }
    return row * GridColumns + column;
}

cellCenter :: (cell: int) -> Vector2 {
    column := cell % GridColumns;
    row    := cell / GridColumns;
    return {-MapHalfWidth + (column as f32 + 0.5) * CellSize, -MapHalfLength + (row as f32 + 0.5) * CellSize};
}

// Predicts the cars of the game. Its lists take their memory from the allocator of the thread, e.g the arena of a bot
newForecast :: (game: *Game, options: ForecastOptions) -> Forecast {
    forecast := Forecast{options: options, reachX: CarWidth * 0.5 + options.radius + options.margin};
    forecast.blocked = blockedCells(game, options);
    for slick in game.slicks.list { forecast.slicks.add(slick); }
    // Nothing worked out yet: -1 for every cell (all its bytes set), and no intervals
    forecast.firstSafe.reserve(GridCells);
    forecast.safeCount.reserve(GridCells);
    mem.set(forecast.firstSafe.data, 255, GridCells * sizeof(int));
    mem.set(forecast.safeCount.data, 0, GridCells * sizeof(int));
    forecast.firstSafe.count = GridCells;
    forecast.safeCount.count = GridCells;
    forecast.safe.reserve(4096);

    for car in game.traffic.cars {
        if !car.isActive || (options.ambulanceProof && car.kind == .ambulance) { continue; }
        forecast.lanes[car.lane].add(trajectoryOf(game, car, 0));
    }
    for bridge in game.bridges {
        // Safe a little after it starts to go up, and a little before it is gone
        inner := bridge.bridgeRect();
        inner.x += RampLength;
        inner.width -= RampLength * 2;
        start := math.max(BridgeRaiseTime - bridge.age, 0) + 0.1;
        forecast.safeZones.add(SafeZone{inner, start, bridge.timeLeft - 0.3});
    }
    // An ambulance that was heard: it is on the road after its siren
    traffic := &game.traffic;
    if traffic.emergencyLane >= 0 && !options.ambulanceProof {
        first, last := traffic.emergencyLanes();
        for lane in first...last {
            ambulance := Car{isActive: true, kind: .ambulance, lane: lane, z: traffic.emergencyStart(lane), speed: traffic.emergencySpeed()};
            forecast.lanes[lane].add(trajectoryOf(game, ambulance, traffic.emergencyIn));
        }
    }
    for lane, i in game.traffic.lanes {
        // The next car of the lane, from when it is spawned. It gets to the cells as soon as a truck as fast as a car of
        // the lane gets would
        next := Car{isActive: true, kind: .truck, lane: i as int, z: -RoadEnd - TruckLength * 0.5, speed: lane.speed * MaxSpawnSpeed};
        fast := trajectoryOf(game, next, lane.spawnTimer);
        // Leaving: a car at the speed of the lane. A slower one, or a truck, is seen when it is spawned, seconds before it
        // can get onto the field
        next.speed = lane.speed;
        next.kind = .car;
        next.z = -RoadEnd - CarLength * 0.5;
        slow := trajectoryOf(game, next, lane.spawnTimer);
        fast.leaveWith = forecast.slowSpawns.count as int;
        forecast.slowSpawns.add(slow);
        forecast.lanes[i].add(fast);

        // The one after it can't come sooner than the shortest gap
        forecast.unknownFrom[i] = lane.spawnTimer + minSpawnGap(&game.traffic, lane.speed);
        forecast.fastest[i] = lane.speed * MaxSpawnSpeed;
    }
    return forecast;
}

// The cells where a hero of a size doesn't fit: the walls (unless it goes through them) and the edges of the field. The
// walls never move, so each thread works them out once for each size and keeps them on the heap
@private @threadLocal
blockedGrids: Map<int, *[..]bool>;

blockedCells :: (game: *Game, options: ForecastOptions) -> []bool {
    key := (options.throughWalls as int) * 10000 + (options.radius * 100) as int;
    if blockedGrids.has(key) { return *blockedGrids[key]; }

    previous := mem.setAllocator(mem.heap());
    defer mem.setAllocator(previous);
    grid := new([..]bool, mem.heap());
    grid.reserve(GridCells);
    for cell in 0..GridCells {
        center := cellCenter(cell as int);
        isBlocked := math.fabsf(center.x) > MapHalfWidth - options.radius || math.fabsf(center.y) > MapHalfLength - options.radius;
        if !options.throughWalls && !isBlocked && math.fabsf(center.x) < RoadHalfWidth + WallWidth + options.radius + 1 {
            for wall in game.world.walls {
                if CheckCollisionCircleRec(center, options.radius + 0.3, wall) { isBlocked = true; }
            }
        }
        grid.add(isBlocked);
    }
    blockedGrids[key] = grid;
    return *grid;
}

// Where a car will be, the way Traffic.update moves it, from the time it appears
trajectoryOf :: (game: *Game, car: Car, appears: f32) -> Trajectory {
    traffic := &game.traffic;
    lane := traffic.lanes[car.lane];
    trajectory := Trajectory{halfLength: car.length() * 0.5};

    // An ambulance drives on at its speed, whatever happens
    if car.kind == .ambulance {
        trajectory.add(appears, car.z, car.speed);
        return trajectory;
    }

    t := appears;
    z := car.z;
    if car.liftedLeft > 0 {
        trajectory.add(t, z, 0);
        t += car.liftedLeft;
        trajectory.harmlessUntil = t;
    }
    if car.frozenLeft > 0 {
        trajectory.add(t, z, 0);
        t += car.frozenLeft;
    }

    // Slower near a hero with a chill aura, as long as it is near it now
    speed := car.speed;
    for player in game.players {
        aura := player.hero.chillAura();
        if aura.hasValue() && player.isPlaying() && CheckCollisionCircleRec(player.hero.ground(), aura.value().radius, car.rect()) {
            speed *= 1 - aura.value().slow;
        }
    }

    // Held before Hilda's line until her sign comes down
    if t < lane.haltLeft && z + trajectory.halfLength <= lane.haltLine + 0.5 {
        stopAt := lane.haltLine - trajectory.halfLength;
        warped := speed;
        if t < traffic.warpLeft { warped *= 1 - traffic.warpSlow; }
        arrives := t + math.max(stopAt - z, 0) / math.max(warped, 0.01);
        if arrives < lane.haltLeft {
            trajectory.add(t, z, warped);
            trajectory.add(arrives, stopAt, 0);
            t = lane.haltLeft;
            z = stopAt;
        }
    }

    // Slowed by a time warp, then at its own speed
    if t < traffic.warpLeft {
        warped := speed * (1 - traffic.warpSlow);
        trajectory.add(t, z, warped);
        z += warped * (traffic.warpLeft - t);
        t = traffic.warpLeft;
    }
    trajectory.add(t, z, speed);
    return trajectory;
}
