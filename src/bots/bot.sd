namespace bots;

use core;

// The bots. A bot is a Brain: something that looks at the game and gives its player's hero orders, with the same
// Commands that your keys and mouse give (game.sd). So a bot can't do anything you can't, and a new kind of bot, e.g one
// that learns, or plays a team game, is a new struct with the methods of Brain, without changing the game.
//
// The Bot of this file thinks in three parts, each of which can be changed on its own:
//
//   * Forecast (forecast.sd): when each cell of the ground is free of cars, for the next seconds
//   * planCrossing (planner.sd): the fastest way across through those free times (Safe Interval Path Planning)
//   * Tactics (below): when to cast which ability. Every effect of an ability has a case in scoreAbility, which the
//     compiler checks is there, so a new ability can't be forgotten by the bots
//
// How a bot plays (how careful, how quick, how mean) is a BotPersonality: numbers, not code.

import allocators;
import math;
import mem;
import random;
import time;
import fmt;
use raylib;

// What a bot is doing this frame, for the inspector
BotMode :: enum {
    waiting,            // For a gap, before it leaves for the next point of its plan
    walking,            // To the next point of its plan
    dodging,            // The reflex: away from a car its plan didn't see coming
    casting,            // An ability
    noPlan,             // No way anywhere: it stands still
    cantAct,            // Stunned, dragged, in the air or on its hook
    notPlaying,         // Run over, or across
}

// The last look at the abilities: the score of each, and the bar a score must be over to cast it
BotDecision :: struct {
    mode:       BotMode;
    scores:     [MaxAbilities]f32;
    bar:        f32;
    lastCast:   string;             // The name of the last ability it cast
    lastCastAt: f32;
    lastSearch: f64;                // Seconds the last search took
    lastStates: int;
    chosen:     string;             // The ability the last look chose, if any
}

// How a bot plays: its genes (genome.sd), trained by bot_train.sd or tuned by hand, and a name for it
BotPersonality :: struct {
    label:  string;
    genome: Genome;
}

Bot :: struct {
    personality: BotPersonality;
    rng:         random.Random;
    arena:       allocators.Arena;  // The forecast and the search of the last plan
    forecast:    Forecast;
    forecastAt:  f32;               // The time of the game it was made
    hasForecast: bool;
    plan:        [..]Waypoint;      // On the heap: it lives longer than the arena
    next:        int;               // The waypoint it is going to
    pacing:      bool;              // A hero that can't stop (Mads), waiting: rolling to and fro over paceAnchor
    paceAnchor:  Vector2;
    paceSign:    f32 = 1;
    reachesGoal: bool;
    replanIn:    f32;
    searchedAt:  f32;               // The time of the game of the last search
    mustSearch:  bool;              // The plan is no good any more, e.g after an ability moved the hero
    thinkIn:     f32;
    lastKind:    HeroKind;
    wasActing:   bool;
    decision:    BotDecision;
    chasing:     ?Vector2;          // The item it plans to pick up on its way
    stats:       BotProfile;
    job:         *SearchJob;        // Searches on a thread of its own, with game.asyncBots (search_job.sd)
    generation:  int;               // Counts the resets, so a search of before one is thrown away
    committed:   ?Waypoint;
    planLives:   f32;               // Until when, in the time of the game, its plan keeps it alive as far as it knows         // The point it was walking to when it searched, which the new plan starts with
}

// Why a bot searched for a new plan
SearchReason :: enum {
    told,               // Something said it must: a new hero, a cast, a dodge, late for its plan, an item
    broken,             // The plan doesn't hold in the new forecast
    better,             // To look for a better one than a plan that doesn't get across
}

// What the thinking of a bot has cost, for bot_arena.sd and the debug overlay
BotProfile :: struct {
    forecasts:       int;
    plans:           int;           // Searches for a way across
    forecastSeconds: f64;
    planSeconds:     f64;
    expanded:        i64;
    reachedGoal:     int;           // Plans that found a way all the way across
    waiting:         f64;           // Seconds it stood still waiting for a gap, while playing
    walking:         f64;
    noPlan:          f64;           // Seconds it had no plan to follow
    dodges:          int;
    searchedFor:     [SearchReason.count]int;   // Why it searched, how many times
    progress:        f32;           // How far across each of its heroes got at most (0 to 1 each), added up
    lifeProgress:    f32;           // and the one it has now
}

newBot :: (seed: u64, personality: BotPersonality) -> *Bot {
    bot := new(Bot, mem.heap());
    bot.personality = personality;
    bot.rng = random.newRandom(seed);
    bot.plan.allocator = mem.heap();
    return bot;
}

reset :: method (bot: *Bot) {
    bot.plan.clear();
    bot.next = 0;
    bot.replanIn = 0;
    bot.mustSearch = true;
    bot.hasForecast = false;
    bot.chasing = null;
    bot.arena.clear();
    bot.generation += 1;
}

free :: method (bot: *Bot) {
    if bot.job != null {
        bot.job.stop();
        mem.delete(bot.job);
    }
    bot.arena.free();
    bot.plan.free();
    mem.delete(bot);
}

// Plays with the genes of another difficulty, from now on
setDifficulty :: method (bot: *Bot, difficulty: Difficulty) {
    bot.personality = personalityFor(difficulty, &bot.rng);
    bot.reset();
}

// The bots take turns to search for a way across, so a frame doesn't take long when many of them want to at once.
// Counted for each game and each thread, so games can run on many threads at once
SearchesPerFrame :: 1;

@private @threadLocal searchGame: *Game;
@private @threadLocal searchTime: f32 = -1;
@private @threadLocal searchesLeft: int;

// Whether a bot of the game may search this frame, which takes the search
takeSearchTurn :: (game: *Game) -> bool {
    if searchGame != game || searchTime != game.time {
        searchGame = game;
        searchTime = game.time;
        searchesLeft = SearchesPerFrame;
    }
    if searchesLeft <= 0 { return false; }
    searchesLeft -= 1;
    return true;
}

gene :: method (bot: *Bot, gene: Gene) -> f32 {
    return bot.personality.genome.get(gene);
}

plannedPath :: method (bot: *Bot) -> []Waypoint {
    return bot.plan;
}

profile :: method (bot: *Bot) -> BotProfile {
    return bot.stats;
}

think :: method (bot: *Bot, game: *Game, me: int, dt: f32) {
    player := &game.players[me];
    // A talent to pick: one of them, at random, after a moment to think
    if player.talentOffer.hasValue() && player.talentOffer.value().timeLeft < TalentPickTime - 1 {
        player.order(Command{chooseTalent: bot.rng.between(0, TalentChoices - 1)});
    }
    if player.isPlaying() {
        bot.stats.lifeProgress = math.max(bot.stats.lifeProgress, progressOf(player.hero.ground(), player.startSide));
    } else if bot.stats.lifeProgress > 0 {
        bot.stats.progress += bot.stats.lifeProgress;       // Run over, or across
        bot.stats.lifeProgress = 0;
    }
    if !player.isPlaying() {
        if debugTrace && bot.decision.mode != .notPlaying { fmt.print("DEATH % at (% %) crossings %", fmt.fixed(game.time, 2), fmt.fixed(player.hero.position.x, 1), fmt.fixed(player.hero.position.z, 1), player.stats.crossings); }
        bot.plan.clear();
        bot.replanIn = 0;
        bot.decision.mode = .notPlaying;
        return;
    }
    hero := &player.hero;

    // A new hero, or one that was moved by something else, needs a new plan
    canAct := hero.canAct();
    if hero.kind != bot.lastKind || (canAct && !bot.wasActing) {
        bot.replanIn = 0;
        bot.mustSearch = true;
    }
    bot.lastKind = hero.kind;
    bot.wasActing = canAct;
    // In an igloo: out once it has healed, when no car will be on it for a while
    if hero.has(.igloo) && hero.health >= hero.maxHealth() * 0.98 && !carComing(game, hero.ground(), hero.info().hitRadius + 0.5) {
        player.order(Command{move: hero.ground()});
    }
    if !canAct {
        bot.decision.mode = .cantAct;
        return;
    }

    bot.takeSearch(game);
    // Blinded by a flash: it can't see the cars, and walks on with the plan it had
    if hero.has(.blind) {
        bot.follow(game, me, dt);
        return;
    }

    bot.replanIn -= dt;
    if bot.isBehindPlan(game.time) { bot.mustSearch = true; }
    if bot.replanIn <= 0 || bot.mustSearch {
        bot.replan(game, me);
        bot.replanIn = bot.gene(.replanEvery) * bot.rng.uniform(0.8, 1.2) as f32;
    }

    bot.thinkIn -= dt;
    if bot.thinkIn <= 0 {
        bot.thinkIn = bot.gene(.reactionTime);
        cast := bot.chooseAbility(game, me);
        if cast.hasValue() {
            player.order(cast.value());
            bot.decision.mode = .casting;
            bot.decision.lastCast = bot.decision.chosen;
            bot.decision.lastCastAt = game.time;
            bot.replanIn = 0;           // Where it is going to be has changed
            bot.mustSearch = true;
            return;
        }
    }

    if bot.dodge(game, me) {
        bot.decision.mode = .dodging;
        bot.trace(game, me);
        return;
    }
    bot.follow(game, me, dt);
    bot.trace(game, me);
}

// If a car will be on a circle in the next IglooLookAhead seconds, as the cars drive now
carComing :: (game: *Game, center: Vector2, radius: f32) -> bool {
    for k in 0..5 {
        if game.traffic.carWillHit(center, radius, k as f32 * IglooLookAhead / 4) { return true; }
    }
    return false;
}

IglooLookAhead :: 2.0;

// bot_arena.sd --trace: what a bot does each frame, the cars near it and its plans, which tools/plot_bot.py draws
debugTrace := false;
trace :: method (bot: *Bot, game: *Game, me: int) {
    if !debugTrace { return; }
    hero := &game.players[me].hero;
    now := game.time - bot.forecastAt;
    next := "-";
    if bot.next < bot.plan.count {
        w := bot.plan[bot.next];
        next = tprint("(% %) dep % arr % [%/%] safeAtArrive %", fmt.fixed(w.point.x, 2), fmt.fixed(w.point.y, 2), fmt.fixed(w.depart, 2), fmt.fixed(w.arrive, 2), bot.next, bot.plan.count,
            fmt.fixed(bot.forecast.safeFor(w.point, w.arrive - bot.forecastAt), 2));
    }
    // Every half second: the cars near it and its plan, to draw (tools/plot_bot.py)
    if (game.time * 60) as int % 15 == 0 {
        fmt.print("SNAP % % %", fmt.fixed(game.time, 2), fmt.fixed(hero.position.x, 2), fmt.fixed(hero.position.z, 2));
        for car in game.traffic.cars {
            if !car.isActive || math.fabsf(car.x() - hero.position.x) > 30 || math.fabsf(car.z - hero.position.z) > 40 { continue; }
            fmt.print("CAR % % % % %", fmt.fixed(car.x(), 2), fmt.fixed(car.z, 2), fmt.fixed(car.length(), 1), fmt.fixed(car.speed, 1), car.lane);
        }
        for i in bot.next..bot.plan.count {
            w := bot.plan[i];
            fmt.print("PLAN % % % %", fmt.fixed(w.point.x, 2), fmt.fixed(w.point.y, 2), fmt.fixed(w.depart, 2), fmt.fixed(w.arrive, 2));
        }
    }
    fmt.print("TRACE % % pos (% %) % hit % safeFor % searched % | %", fmt.fixed(game.time, 2), BotMode.names[bot.decision.mode], fmt.fixed(hero.position.x, 2), fmt.fixed(hero.position.z, 2),
        hero.isMoving, fmt.fixed(bot.forecast.hitTime(hero.ground(), now, 0) - now, 2), fmt.fixed(bot.forecast.safeFor(hero.ground(), now), 2), fmt.fixed(bot.searchedAt, 2), next);
}

// The reflex under the plan: a car that is about to be on the hero, which the plan doesn't take it away from, e.g as
// the forecast changed, or an enemy moved it. It goes to the point near it it can get to without a car on the way, that
// then stays free the longest. On the road without a plan, it doesn't wait for a car to come
noDodge := false;
searchLanes := SearchLanes;
lookEvery: f32 = 0;             // bot_arena.sd --look S: a plan that doesn't get across is searched again this often too

// When a plan that doesn't get across is searched again for a better one
MinLookAgain    :: 0.5;         // Not sooner than this, in seconds
MaxLookAgain    :: 2.0;         // and at the latest
LookAgainBefore :: 1.5;         // or when what it keeps the bot alive for is this much more than survive, or less     // bot_arena.sd --lanes N: how far to either side a search looks     // bot_arena.sd --nododge: no reflex, to see what the plans do on their own

dodge :: method (bot: *Bot, game: *Game, me: int) -> bool {
    if !bot.hasForecast || noDodge { return false; }
    player := &game.players[me];
    hero := &player.hero;
    now := game.time - bot.forecastAt;
    here := hero.ground();
    hit := bot.forecast.hitTime(here, now, 0);
    hasPlan := bot.next < bot.plan.count;
    stranded := !hasPlan && isOnRoad(here);
    if hit - now > bot.gene(.dodgeTime) && !stranded { return false; }

    // The plan moves on before the car gets here: it leaves for its next point in time
    if hasPlan && bot.plan[bot.next].depart - bot.forecastAt < hit - 0.1 {
        return false;
    }

    best := here;
    bestFree := math.min(hit - now, DodgeEnough);
    speed := hero.speed();
    for k in 0..16 {
        angle := k as f32 * Pi / 8;
        for reach in [1.5, 3.0, 4.5, 6.0] {
            point := here + Vector2{math.cosf(angle), math.sinf(angle)} *reach;
            cell := cellAt(point);
            if cell < 0 || bot.forecast.blocked[cell] { continue; }
            arrive := now + reach / speed;
            free := math.min(bot.forecast.hitTime(point, arrive, 0) - arrive, DodgeEnough);
            if free <= bestFree + 0.05 { continue; }
            if !bot.wayIsFree(here, point, now, speed, 0) { continue; }
            best = point;
            bestFree = free;
        }
    }
    if best.distance(here) < 0.01 { return false; }
    if !hero.isMoving || hero.target.xz().distance(best) > 0.5 { player.order(Command{move: best}); }
    bot.mustSearch = true;
    bot.stats.dodges += 1;
    return true;
}

DodgeEnough :: 3.0;     // Seconds free that are as good as any more, so a nearer point wins

// A hero that can't stop (Mads) waits by rolling to and fro over the spot it waits on, along the road, not into it
pace :: method (bot: *Bot, game: *Game, me: int) {
    player := &game.players[me];
    hero := &player.hero;
    if !bot.pacing {
        bot.pacing = true;
        bot.paceAnchor = hero.ground();
    }
    target := bot.paceAnchor + Vector2{0, bot.paceSign * PaceReach};
    if hero.ground().distance(target) < 0.8 {
        bot.paceSign = -bot.paceSign;
        target = bot.paceAnchor + Vector2{0, bot.paceSign * PaceReach};
    }
    if !hero.isMoving || hero.target.xz().distance(target) > 0.3 { player.order(Command{move: target}); }
}

PaceReach :: 1.6;

// If a hero going straight from one point to another at a speed, from a time, has no car on it on the way
wayIsFree :: method (bot: *Bot, from: Vector2, to: Vector2, start: f32, speed: f32, margin: f32) -> bool {
    distance := from.distance(to);
    steps := math.max(2, math.ceilf(distance / CellSize) as int);
    for k in 1...steps {
        t := k as f32 / steps as f32;
        point := from.lerp(to, t);
        at := start + distance * t / speed;
        if bot.forecast.hitTime(point, at, margin) <= at + 0.05 { return false; }
    }
    return true;
}

// Makes a new forecast of the cars. When the plan doesn't hold up against it, or it is time to look for a better one,
// it searches for a new plan through them
replan :: method (bot: *Bot, game: *Game, me: int) {
    // Still searching on its thread: on with the plan it has, until the new one comes
    if bot.job != null && bot.job.isBusy() { return; }
    hero := &game.players[me].hero;
    bot.arena.clear();
    previous := mem.setAllocator(&bot.arena);
    defer mem.setAllocator(previous);

    started := time.clock();
    options := ForecastOptions{
        radius:         hero.info().hitRadius,
        throughWalls:   hero.walksThroughWalls(),
        margin:         bot.gene(.margin),
        leadTime:       bot.gene(.leadTime),
        trailTime:      bot.gene(.trailTime),
        me:             me,
        heroMargin:     bot.gene(.heroMargin),
        heroPredict:    bot.gene(.heroPredict),
        oilProof:       hero.stats.oilProof,
        ambulanceProof: hero.stats.ambulanceProof,
    };
    bot.forecast = newForecast(game, options);
    bot.forecastAt = game.time;
    bot.hasForecast = true;
    forecastDone := time.clock();
    bot.stats.forecasts += 1;
    bot.stats.forecastSeconds += forecastDone - started;

    // An item that came or went, or that another hero took: a new plan
    target := bot.itemTarget(game, me);
    if target.hasValue() != bot.chasing.hasValue() || (target.hasValue() && target.value() != bot.chasing.value()) {
        bot.chasing = target;
        bot.mustSearch = true;
    }

    // A plan that doesn't get across yet ends where what is known ends: as more is known, it can go further. It looks
    // again when what the plan keeps it alive for gets short, and now and then
    sinceSearch := game.time - bot.searchedAt;
    runningOut := bot.planLives - game.time < bot.gene(.survive) + LookAgainBefore;
    lookForBetter := !bot.reachesGoal && sinceSearch > MinLookAgain && (runningOut || sinceSearch > MaxLookAgain || lookEvery > 0 && sinceSearch > lookEvery);
    holds := !bot.mustSearch && bot.planHolds();
    if holds && !lookForBetter { return; }
    reason := SearchReason.better;
    if bot.mustSearch { reason = .told; }
    else if !holds    { reason = .broken; }

    // On a thread of its own, the frame doesn't wait for it. Otherwise: another bot searched this frame, so its turn is
    // next frame. Unless it is by the road, where a plan that doesn't hold any more can't wait
    if !game.asyncBots && !takeSearchTurn(game) && !isNearRoad(game.players[me].hero.ground()) {
        bot.mustSearch = true;
        return;
    }
    bot.mustSearch = false;
    bot.searchedAt = game.time;
    bot.stats.searchedFor[reason] += 1;

    speed := hero.speed();
    // Momentum (Mads) is lost when he turns, so the plan counts on the speed without it
    if hero.stats.momentum { speed /= 1 + MomentumBonus * hero.momentum; }
    sprintSpeed := speed;
    if hero.has(.haste) { speed = speed / hero.status(.haste).amount; }
    // Walking to the next point of a plan that still holds: the new plan starts there, when it gets there, so it doesn't
    // plan from the cell it is passing through, which may be about to be blocked
    bot.committed = null;
    start := hero.ground();
    startAt: f32 = 0;
    if hero.isMoving && bot.next < bot.plan.count && bot.planHolds() && bot.plan[bot.next].arrive > game.time {
        bot.committed = bot.plan[bot.next];
        start = bot.plan[bot.next].point;
        startAt = bot.plan[bot.next].arrive - game.time;
    }
    request := PlanRequest{
        start:       start,
        startAt:     startAt,
        goalSide:    game.players[me].startSide.opposite(),
        goalPoint:   bot.chasing,
        speed:       speed,
        sprintSpeed: sprintSpeed,
        sprintLeft:  hero.timeLeft(.haste),
        now:         game.time,
        survive:     bot.gene(.survive),
        stay:        bot.gene(.stay),
        trust:       bot.gene(.trust),
        laneWeight:  bot.gene(.laneWeight),
        lanes:       searchLanes,
        safety:      bot.gene(.safety),
    };
    if game.asyncBots {
        if bot.job == null { bot.job = new(SearchJob, mem.heap()); }
        bot.job.start(game, options, request, bot.generation);
        return;
    }
    result := planCrossing(&bot.forecast, request);
    bot.usePlan(&result, time.clock() - forecastDone);
}

// A search on its thread that is done: its plan is followed from now on
takeSearch :: method (bot: *Bot, game: *Game) {
    if bot.job == null || !bot.job.takeResult() { return; }
    if bot.job.generation != bot.generation { return; }      // Of before a reset
    bot.usePlan(&bot.job.result, bot.job.seconds);
}

@private
usePlan :: method (bot: *Bot, result: *PlanResult, seconds: f64) {
    // A plan that still holds isn't swapped for one that is cornered: the search starts from the cell the hero is in,
    // which between two cells can be one that is about to be blocked, as it walks on out of it
    if result.cornered && !bot.reachesGoal && bot.next < bot.plan.count && bot.planHolds() {
        bot.stats.plans += 1;
        bot.stats.planSeconds += seconds;
        return;
    }
    bot.stats.plans += 1;
    bot.stats.planSeconds += seconds;
    bot.decision.lastSearch = seconds;
    bot.decision.lastStates = result.expanded;
    bot.stats.expanded += result.expanded;
    if result.reachesGoal { bot.stats.reachedGoal += 1; }

    if debugTrace {
        holds := bot.next < bot.plan.count && bot.planHolds();
        fmt.print("SEARCH % goal % cornered % lives % waypoints % | the old plan had % left, holds % | %", fmt.fixed(bot.forecastAt, 2), result.reachesGoal, result.cornered, fmt.fixed(result.lives, 2), result.waypoints.count, bot.plan.count - bot.next, holds, HeroKind.names[bot.lastKind]);
    }
    bot.planLives = bot.forecastAt + result.lives;
    if result.reachesGoal { bot.planLives = Forever; }
    bot.plan.clear();
    if bot.committed.hasValue() { bot.plan.add(bot.committed.value()); }
    for waypoint in result.waypoints { bot.plan.add(waypoint); }
    bot.next = 0;
    bot.reachesGoal = result.reachesGoal;
}

// The item on the road, when its backpack has room and the way past it isn't much longer than the way across, by the gene
// itemDetour
itemTarget :: method (bot: *Bot, game: *Game, me: int) -> ?Vector2 {
    player := &game.players[me];
    if player.backpack.isFull() || !game.items.onRoad.hasValue() || !player.isPlaying() { return null; }
    item := game.items.onRoad.value().position;
    ground := player.hero.ground();
    goalX := GoalX * player.startSide.opposite().sign();
    direct := math.fabsf(goalX - ground.x);
    past := ground.distance(item) + math.fabsf(goalX - item.x);
    if past - direct > bot.gene(.itemDetour) { return null; }
    return item;
}

// If the rest of the plan is still free of cars in the new forecast: the hero can wait where it is until it leaves for
// the next point, and each point is free from when it gets there until it leaves for the one after
planHolds :: method (bot: *Bot) -> bool {
    if bot.next >= bot.plan.count { return false; }
    for i in bot.next..bot.plan.count {
        waypoint := bot.plan[i];
        leave := waypoint.arrive;
        if i + 1 < bot.plan.count { leave = bot.plan[i + 1].depart; }
        cell := cellAt(waypoint.point);
        if cell < 0 { return false; }
        interval := bot.forecast.intervalAt(cell, waypoint.arrive - bot.forecastAt + bot.gene(.planSlack));
        if interval < 0 || bot.forecast.safe[interval].end < leave - bot.forecastAt - bot.gene(.planSlack) { return false; }
    }
    return true;
}

// Late for the next point of the plan: the cars won't be where the plan thought
isBehindPlan :: method (bot: *Bot, now: f32) -> bool {
    if bot.next >= bot.plan.count { return false; }
    return now > bot.plan[bot.next].arrive + 0.35;
}

// Walks the plan: to each point in turn, waiting before it until it is time to leave for it
follow :: method (bot: *Bot, game: *Game, me: int, dt: f32) {
    player := &game.players[me];
    hero := &player.hero;

    while bot.next < bot.plan.count && hero.ground().distance(bot.plan[bot.next].point) < 0.25 {
        bot.next += 1;
    }
    if bot.next >= bot.plan.count {
        if hero.stats.momentum { bot.pace(game, me); }
        else if hero.isMoving  { player.order(.stop); }
        bot.stats.noPlan += dt;
        bot.decision.mode = .noPlan;
        return;
    }

    waypoint := bot.plan[bot.next];
    if game.time < waypoint.depart - 0.02 {
        if hero.stats.momentum { bot.pace(game, me); }
        else if hero.isMoving  { player.order(.stop); }       // Waiting for a gap
        bot.stats.waiting += dt;
        bot.decision.mode = .waiting;
        return;
    }
    bot.pacing = false;
    bot.stats.walking += dt;
    bot.decision.mode = .walking;
    if !hero.isMoving || hero.target.xz().distance(waypoint.point) > 0.01 {
        player.order(Command{move: waypoint.point});
    }
}

//
// Tactics: which ability to cast, and where. Each ability gets a score from 0 (no) to 1 (now!), and the best one over
// the bar of the personality is cast
//

// What the tactics look at
TacticsView :: struct {
    me:          int;
    ground:      Vector2;
    danger:      f32;           // Seconds until a car is on the hero, as forecast. Large when it is safe
    onRoad:      bool;
    nearRoad:    bool;          // On the road, or about to step onto it
    progress:    f32;           // 0 at the start side to 1 at the goal
    goalSide:    Side;
    healthShare: f32;
}

chooseAbility :: method (bot: *Bot, game: *Game, me: int) -> ?Command {
    if !bot.hasForecast { return null; }
    player := &game.players[me];
    hero := &player.hero;

    view := TacticsView{
        me:          me,
        ground:      hero.ground(),
        danger:      bot.forecast.safeFor(hero.ground(), game.time - bot.forecastAt),
        onRoad:      isOnRoad(hero.ground()),
        nearRoad:    math.fabsf(hero.position.x) < RoadHalfWidth + 3,
        progress:    progressOf(hero.ground(), player.startSide),
        goalSide:    player.startSide.opposite(),
        healthShare: hero.health / hero.maxHealth(),
    };

    bestScore := bot.gene(.castBar);
    bot.decision.bar = bestScore;
    best: ?Command = null;
    abilities := hero.abilities();
    for ability, slot in abilities {
        bot.decision.scores[slot] = -1;                         // Not ready, or a passive
        if !hero.abilityReady(slot as int) { continue; }
        choice := bot.scoreAbility(game, view, &abilities[slot]);
        bot.decision.scores[slot] = choice.score;
        if choice.score > bestScore {
            bestScore = choice.score;
            bot.decision.chosen = ability.name;
            best = Command{cast: {slot: slot as int, target: choice.target}};
        }
    }
    // The items that are used, like abilities
    for slot in 0..player.backpack.count {
        if !game.itemReady(me, slot as int) { continue; }
        action := player.backpack.items[slot].itemDefinition().action;
        choice := bot.scoreAbility(game, view, &action);
        if choice.score > bestScore {
            bestScore = choice.score;
            bot.decision.chosen = action.name;
            best = Command{useItem: {slot: slot as int, target: choice.target}};
        }
    }
    return best;
}

AbilityChoice :: struct {
    score:  f32;
    target: Vector2;
}

// How much it wants to cast an ability now, and at what. It only knows what kind of ability it is (its BotUse), so it
// plays any ability of a kind it knows. The weights are genes, so training decides what is worth it
scoreAbility :: method (bot: *Bot, game: *Game, view: TacticsView, ability: *Ability) -> AbilityChoice {
    no := AbilityChoice{0, view.ground};
    here := AbilityChoice{0, view.ground};
    inDanger := view.danger < bot.gene(.dangerTime);
    waiting := view.onRoad && bot.isWaiting(game);
    aggression := bot.gene(.aggression);
    hero := &game.players[view.me].hero;
    range := hero.reach(ability.range);

    switch ability.bot {
        case .none {
            return no;
        }
        case .speedUp {
            if inDanger           { here.score = bot.gene(.speedUpDanger); }
            else if view.nearRoad { here.score = bot.gene(.speedUp); }
            return here;
        }
        case .stopCars {
            if inDanger     { here.score = bot.gene(.stopCars); }
            else if waiting { here.score = bot.gene(.stopCarsWaiting); }
            return here;
        }
        case .stopCarsAhead {
            // The lanes just ahead of it, on its way across
            if !inDanger && !waiting { return no; }
            ahead := view.ground + Vector2{view.goalSide.sign() * math.min(LaneWidth * 1.5, range), 0};
            score := bot.gene(.stopCarsWaiting);
            if inDanger { score = bot.gene(.stopCars); }
            return AbilityChoice{score, ahead};
        }
        case .escape {
            if inDanger { return bot.escape(game, view, range, ability.delay, bot.gene(.escape)); }
            if view.nearRoad { return bot.shortcut(game, view, range, ability.delay, bot.gene(.shortcut)); }
            return no;
        }
        case .untouchable {
            if view.danger < bot.gene(.dangerTime) * 0.6 { here.score = bot.gene(.escape); }
            return here;
        }
        case .rewind {
            if view.danger < bot.gene(.dangerTime) * 0.7 { here.score = bot.gene(.escape); }
            else if view.healthShare < bot.gene(.rewindHealth) { here.score = 0.9; }
            return here;
        }
        case .heal {
            if view.healthShare < 0.6 && !inDanger { here.score = 1 - view.healthShare; }
            return here;
        }
        case .knockEnemy {
            enemy := game.enemyNear(view.me, view.ground, range);
            if enemy < 0 || aggression <= 0 { return no; }
            return AbilityChoice{bot.bashScore(game, view, enemy, ability.power) * aggression, game.players[enemy].hero.ground()};
        }
        case .disableEnemy
        case .pullEnemy {
            enemy := bot.enemyToPunish(game, view, range);
            if enemy < 0 || aggression <= 0 { return no; }
            return AbilityChoice{aggression * bot.punishScore(game, view, enemy), game.players[enemy].hero.ground()};
        }
        case .swapEnemy {
            // One that is well ahead of it, and not on the road
            best := -1;
            bestGain: f32 = 0;
            for *player, i in game.players {
                if i as int == view.me || !player.isPlaying() || !player.hero.isTargetable() { continue; }
                ground := player.hero.ground();
                if ground.distance(view.ground) > range || isOnRoad(ground) { continue; }
                gain := progressOf(ground, game.players[view.me].startSide) - view.progress;
                if gain > bestGain {
                    best = i as int;
                    bestGain = gain;
                }
            }
            if best < 0 || bestGain < 0.2 { return no; }
            return AbilityChoice{math.min(bestGain * 2, 1), game.players[best].hero.ground()};
        }
        case .dropTrap {
            // Where an enemy behind it will walk: by its feet, while it is on the road ahead of them
            if aggression <= 0 || !view.onRoad { return no; }
            for player, i in game.players {
                if i as int == view.me || !player.isPlaying() { continue; }
                behind := view.progress - progressOf(player.hero.ground(), player.startSide);
                if behind > 0.05 && behind < 0.4 { return AbilityChoice{aggression * 0.6, view.ground}; }
            }
            return no;
        }
    }
}

// How much an enemy is worth casting on: on the road, where it can be run over, and ahead of this bot, weighed by the
// gene punishAhead. From 0 to 1
punishScore :: method (bot: *Bot, game: *Game, view: TacticsView, enemy: int) -> f32 {
    target := game.players[enemy];
    score: f32 = 0;
    if isOnRoad(target.hero.ground()) { score += 0.5; }
    ahead := progressOf(target.hero.ground(), target.startSide) - view.progress;
    if ahead > 0 { score += ahead * bot.gene(.punishAhead); }
    return math.min(score, 1);
}

// An enemy in reach worth casting on: on the road, where a stun or a drag can get it run over, or further across than
// this bot. -1 when there is none
enemyToPunish :: method (bot: *Bot, game: *Game, view: TacticsView, reach: f32) -> int {
    best := -1;
    bestScore: f32 = 0;
    for player, i in game.players {
        if i as int == view.me || !player.isPlaying() || !player.hero.isTargetable() { continue; }
        ground := player.hero.ground();
        if ground.distance(view.ground) > reach { continue; }
        score: f32 = 0;
        if isOnRoad(ground) { score += 1; }
        ahead := progressOf(ground, player.startSide) - view.progress;
        if ahead > 0.1 { score += ahead * 2; }
        if score > bestScore {
            best = i as int;
            bestScore = score;
        }
    }
    return best;
}

// A bash is worth it when it knocks the enemy onto the road, or back towards where it started
bashScore :: method (bot: *Bot, game: *Game, view: TacticsView, enemy: int, knockback: f32) -> f32 {
    target := game.players[enemy];
    away := (target.hero.ground() - view.ground).normalize();
    landing := target.hero.ground() + away * knockback;
    score: f32 = 0;
    if isOnRoad(landing) { score += 0.8; }
    setBack := progressOf(target.hero.ground(), target.startSide) - progressOf(landing, target.startSide);
    if setBack > 0.05 { score += setBack * 3; }
    return math.min(score, 1);
}

// Standing still on or by the road while the plan waits for a gap
isWaiting :: method (bot: *Bot, game: *Game) -> bool {
    if bot.next >= bot.plan.count { return false; }
    return bot.plan[bot.next].depart - game.time > 0.8;
}

// A cast to a point in reach that stays free of cars for a while after it gets there (delay seconds from now), the
// further towards the goal the better. Nothing (score 0) when there is no such point
escape :: method (bot: *Bot, game: *Game, view: TacticsView, range: f32, delay: f32, score: f32) -> AbilityChoice {
    spot := bot.safeSpot(game, view, range, delay, 1.2, false);
    if !spot.hasValue() { return AbilityChoice{0, view.ground}; }
    return AbilityChoice{score, spot.value()};
}

// A cast that gets it a good way across the road at once, to a point where it can wait
shortcut :: method (bot: *Bot, game: *Game, view: TacticsView, range: f32, delay: f32, score: f32) -> AbilityChoice {
    spot := bot.safeSpot(game, view, range, delay, 2.0, true);
    if !spot.hasValue() { return AbilityChoice{0, view.ground}; }
    gained := (spot.value().x - view.ground.x) * view.goalSide.sign();
    if gained < range * 0.6 { return AbilityChoice{0, view.ground}; }
    return AbilityChoice{score, spot.value()};
}

// The point in reach, towards the goal, that is free of cars from delay seconds from now for at least `stay`
safeSpot :: method (bot: *Bot, game: *Game, view: TacticsView, range: f32, delay: f32, stay: f32, forwardOnly: bool) -> ?Vector2 {
    time := game.time - bot.forecastAt + delay;
    best: ?Vector2 = null;
    bestScore: f32 = -Forever;
    steps := math.floorf(range / CellSize) as int;
    for dy in -steps...steps {
        for dx in -steps...steps {
            point := view.ground + Vector2{dx as f32 * CellSize, dy as f32 * CellSize};
            if point.distance(view.ground) > range { continue; }
            gained := (point.x - view.ground.x) * view.goalSide.sign();
            if forwardOnly && gained <= 0 { continue; }
            cell := cellAt(point);
            if cell < 0 || bot.forecast.blocked[cell] { continue; }
            interval := bot.forecast.intervalAt(cell, time);
            if interval < 0 || bot.forecast.safe[interval].end - time < stay { continue; }
            score := gained - point.distance(view.ground) * 0.1;
            if score > bestScore {
                best = point;
                bestScore = score;
            }
        }
    }
    return best;
}

// How far across a point is, for a hero that started on a side: 0 at its start, 1 at its goal
progressOf :: (point: Vector2, startSide: Side) -> f32 {
    across := point.x * startSide.opposite().sign();
    return math.clamp((across + GoalX) / (GoalX * 2), 0, 1);
}

// With bot_arena.sd --hits or toggleHitReports: what a bot was doing when a car got it, to find out why
debugHits := false;

// The body of the console command toggleHitReports (console/console_commands.sd)
toggleHitReportsNow :: () {
    debugHits = !debugHits;
}

wasHit :: method (bot: *Bot, game: *Game, index: int, car: *Car) {
    if !debugHits { return; }
    hero := game.players[index].hero;
    rel := game.time - bot.forecastAt;
    newCar := car.age < game.time - bot.searchedAt;
    fmt.print("HIT mode % reachesGoal % harmedBy % (% s ago) displaced %", BotMode.names[bot.decision.mode], bot.reachesGoal, hero.harmedBy, fmt.fixed(game.time - hero.harmedAt, 2), hero.displacement.hasValue());
    fmt.print("HIT car new since the plan: % (age % s, plan % s old, forecast % s old)", newCar, fmt.fixed(car.age, 2), fmt.fixed(game.time - bot.searchedAt, 2), fmt.fixed(game.time - bot.forecastAt, 2));
    fmt.print("HIT t=% % at (% %) moving % canAct % stun % | forecast % s old, says safe for % | car lane % (from % shift %) z % speed % frozen % braking %",
        fmt.fixed(game.time, 2), game.players[index].name, fmt.fixed(hero.position.x, 1), fmt.fixed(hero.position.z, 1), hero.isMoving, hero.canAct(), fmt.fixed(hero.timeLeft(.stun), 2),
        fmt.fixed(rel, 2), fmt.fixed(bot.forecast.safeFor(hero.ground(), rel), 2), car.lane, car.fromLane, fmt.fixed(car.shift, 1), fmt.fixed(car.z, 1), fmt.fixed(car.speed, 1), fmt.fixed(car.frozenLeft, 1), car.isBraking);
    if bot.next < bot.plan.count {
        w := bot.plan[bot.next];
        fmt.print("     next waypoint (% %) depart % arrive %, % of % left", fmt.fixed(w.point.x, 1), fmt.fixed(w.point.y, 1), fmt.fixed(w.depart, 2), fmt.fixed(w.arrive, 2), bot.next, bot.plan.count);
    }
}
