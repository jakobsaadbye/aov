namespace bots;

// Games with bots: the game itself (core) knows only that a bot is a Brain, so the bots are made here

use core;
import random;

BotNames :: ["Lars", "Mette", "Søren", "Freja", "Jens", "Ida", "Bo", "Karen"];

DefaultBots :: 3;

// A game with you and a number of bots of a difficulty. Without you (humans: 0), the bots play on their own, e.g in
// bot_arena.sd, and the camera follows the first of them
newGame :: (seed: u64, bots: int = DefaultBots, humans: int = 1, difficulty := Difficulty.expert) -> *Game {
    rng := random.newRandom(seed ^ 0x5bd1e995);
    personalities: [..]BotPersonality;
    defer personalities.free();
    for 0..bots { personalities.add(personalityFor(difficulty, &rng)); }
    return newGameWith(seed, personalities, humans, difficulty);
}

// A game with bots of these personalities, e.g of genomes that are being trained (bot_train.sd)
newGameWith :: (seed: u64, personalities: []BotPersonality, humans: int = 1, difficulty := Difficulty.expert) -> *Game {
    brains: [..]Brain;
    defer brains.free();
    names: [..]string;
    defer names.free();
    for personality, i in personalities {
        brains.add(newBot(seed + 101 * (i as u64 + 1), personality));
        names.add(BotNames[i % BotNames.count]);
    }
    return core.newGame(seed, brains, names, humans, difficulty);
}

// A game that plays a recording back
newReplay :: (recording: Recording) -> *Game {
    game := newGame(recording.seed, bots: recording.bots, humans: recording.humans, difficulty: recording.difficulty);
    game.setLength(recording.length);
    game.startReplay(recording);
    return game;
}
