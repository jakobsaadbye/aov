namespace bots;

use core;

// The genome of a bot: every number that says how it plays, as genes that bot_train.sd can evolve. The planner, the
// reflex and the tactics of bot.sd read them instead of numbers of their own, so a trained genome changes how careful
// it is, how quickly it thinks, and when it casts what.
//
// A new gene is a value of Gene and a range in GeneRanges, and the code that reads it with genome.get(.name). Genomes are
// saved by the names of their genes (data/bots/genomes.json), so a gene can be added or removed without breaking the
// ones that were trained: a missing gene starts at its default.

import json;
import math;
import random;

Gene :: enum {
    // Planning and the reflex
    replanEvery,            // Seconds between two looks at the cars
    reactionTime,           // Seconds between two looks at the abilities
    margin,                 // Room it keeps to the cars, besides what the forecast keeps anyway
    leadTime,               // Seconds a cell must be free before a car comes
    trailTime,              // and after one has gone
    dodgeTime,              // How soon before a car hits it the reflex steps away
    survive,                // Seconds a plan that doesn't get across must be able to live on from where it ends
    stay,                   // and how long it must be able to stand there
    trust,                  // Seconds more it counts on living where only a car that isn't spawned yet can come
    laneWeight,             // How much more a meter across the road is worth than one along it, where a plan ends
    safety,                 // Meters across a second more of living is worth, where a plan ends
    planSlack,              // How much a plan may be off in a new forecast before it plans again
    heroMargin,             // Room it keeps to the other heroes, so they don't shove each other in front of a car
    heroPredict,            // Seconds it counts on another hero walking on the way it walks
    contact,                // The share of its health it lets a car take, to slip past it narrowly instead of waiting
    desperation,            // and how much more for every 30 s of the hero's life without getting across: a hero that
    // isn't getting anywhere had better get across or be run over, and the next one may be better

    // Tactics: when to cast. A score of each ability is compared with castBar
    castBar,
    dangerTime,             // A car closer than this, in seconds, is danger
    escape,                 // Blink, leap, a hook out, fade, rewind: away from a car
    stopCars,               // Freeze, a stop sign, a snow globe: in danger
    stopCarsWaiting,        // and while it waits on the road for a gap
    speedUp,                // Sprint, charge: near the road
    speedUpDanger,          // and in danger
    shortcut,               // Blink, leap: a good way across at once, near the road
    rewindHealth,           // Rewinds when its health is below this share
    aggression,             // How keen it is to cast on enemies at all
    punishAhead,            // How much more it wants an enemy that is ahead of it than one on the road

    // Items
    itemDetour,             // How many meters out of its way an item on the road is worth
}

GeneRange :: struct {
    low:     f32;
    high:    f32;
    default: f32;
}

// The range and the default of each gene, in the order of Gene. The defaults are the hand tuned values
GeneRanges :: [
    GeneRange{0.1, 0.8, 0.3},       // replanEvery
    GeneRange{0.05, 0.6, 0.2},      // reactionTime
    GeneRange{0, 0.8, 0},           // margin
    GeneRange{0, 1.2, 0.1},         // leadTime
    GeneRange{0, 0.5, 0},           // trailTime
    GeneRange{0, 2.0, 0.6},         // dodgeTime
    GeneRange{0.5, 10, 5},          // survive
    GeneRange{0.1, 3, 0.5},         // stay
    GeneRange{0, 3, 0},             // trust
    GeneRange{0, 4, 1.0},           // laneWeight
    GeneRange{0, 8, 2.0},           // safety
    GeneRange{0.02, 0.4, 0.15},     // planSlack
    GeneRange{0, 2, 0.5},           // heroMargin
    GeneRange{0, 3, 1.2},           // heroPredict
    GeneRange{0, 0.6, 0.15},        // contact
    GeneRange{0, 1, 0.15},          // desperation
    GeneRange{0.1, 1.0, 0.51},      // castBar
    GeneRange{0.2, 1.5, 0.6},       // dangerTime
    GeneRange{0, 1, 1.0},           // escape
    GeneRange{0, 1, 0.85},          // stopCars
    GeneRange{0, 1, 0.6},           // stopCarsWaiting
    GeneRange{0, 1, 0.5},           // speedUp
    GeneRange{0, 1, 0.8},           // speedUpDanger
    GeneRange{0, 1, 0.5},           // shortcut
    GeneRange{0, 1, 0.4},           // rewindHealth
    GeneRange{0, 1, 0.5},           // aggression
    GeneRange{0, 3, 1.0},           // punishAhead
    GeneRange{0, 80, 30},           // itemDetour
];

Genome :: struct {
    genes: [Gene.count]f32;

    get :: method (gene: Gene) -> f32 {
        return self.genes[gene];
    }

    set :: method * (gene: Gene, value: f32) {
        range := GeneRanges[gene];
        self.genes[gene] = math.clamp(value, range.low, range.high);
    }
}

// The hand tuned bot
defaultGenome :: () -> Genome {
    genome: Genome;
    for gene in Gene.values { genome.genes[gene] = GeneRanges[gene].default; }
    return genome;
}

// Any genes, for the start of a training
randomGenome :: (rng: *random.Random) -> Genome {
    genome: Genome;
    for gene in Gene.values {
        range := GeneRanges[gene];
        genome.genes[gene] = rng.uniform(range.low, range.high) as f32;
    }
    return genome;
}

// Each gene from one of the parents, at random
crossover :: (a: Genome, b: Genome, rng: *random.Random) -> Genome {
    child := a;
    for gene in Gene.values {
        if rng.chance(0.5) { child.genes[gene] = b.genes[gene]; }
    }
    return child;
}

// Each gene, with a chance, moved by a normal step of strength times its range
mutate :: (genome: Genome, rng: *random.Random, chance: f64, strength: f32) -> Genome {
    child := genome;
    for gene in Gene.values {
        if !rng.chance(chance) { continue; }
        range := GeneRanges[gene];
        child.set(gene, child.genes[gene] + rng.gauss(0, 1) as f32 * strength * (range.high - range.low));
    }
    return child;
}

// A genome as JSON: an object of the genes by their names
GenomeJson :: Map<string, f32>;

toJson :: method (genome: Genome) -> GenomeJson {
    values: GenomeJson;
    for gene in Gene.values { values[Gene.names[gene]] = genome.genes[gene]; }
    return values;
}

fromJson :: (values: GenomeJson) -> Genome {
    genome := defaultGenome();
    for gene in Gene.values {
        value := values.tryGet(Gene.names[gene]);
        if value.hasValue() { genome.set(gene, value.value()); }
    }
    return genome;
}

// How well a player did in a game, for training: what counts is getting across, often and quickly. A death costs little
// more than the time it took, as the next hero may well be a better one. How far the hero it has at the end got counts
// too, as on a road this wide a crossing is rare in a game: without it, keeping off the road wins. Of the heroes that
// were run over, how far they got counts a little, so that going for it is better than waiting for ever
FitnessWeights :: struct {
    crossing:     f32 = 10;
    quick:        f32 = 4;      // More for each crossing, for one of 20 seconds or less, and less for a slower one
    death:        f32 = 1;
    kill:         f32 = 2;
    progress:     f32 = 8;      // From 0 at the start to 1 across, of the hero it has at the end
    lostProgress: f32 = 1;      // For each hero that was run over, of how far it got
}

fitnessOf :: (game: *Game, index: int, weights: FitnessWeights = FitnessWeights{}) -> f32 {
    player := &game.players[index];
    stats := player.stats;
    fitness := weights.crossing * stats.crossings as f32 - weights.death * stats.deaths as f32 + weights.kill * stats.kills as f32;
    if stats.crossings > 0 { fitness += weights.quick * stats.crossings as f32 * math.min(1, 20 / (stats.crossTime / stats.crossings as f32)); }
    // A bot keeps how far each of its heroes got (the bots of the games of training are all Bots), the ones that got
    // across too; of a human, only the hero it has now counts
    if player.isBot() {
        profile := (player.brain as *Bot).stats;
        fitness += weights.progress * profile.lifeProgress;
        fitness += weights.lostProgress * math.max(0, profile.progress - stats.crossings as f32);
    } else if player.isPlaying() {
        fitness += weights.progress * progressOf(player.hero.ground(), player.startSide);
    }
    return fitness;
}
