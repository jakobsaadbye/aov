namespace bots;

// What the Bot shows in the inspector (F4, core/inspector.sd): where it is safe from the cars, its plan, and in the panel
// what it is doing and why

use core;
import fmt;
import math;
use raylib;

// The color of how long something stays free of cars: red now, yellow soon, green for a while
safetyColor :: (seconds: f32, alpha: f32) -> Color {
    if seconds <= 0 { return ColorAlpha({230, 40, 40, 255}, alpha); }
    if seconds < 1.5 { return ColorAlpha(ColorLerp({240, 90, 40, 255}, {250, 220, 60, 255}, seconds / 1.5), alpha); }
    return ColorAlpha(ColorLerp({250, 220, 60, 255}, {80, 220, 90, 255}, math.min((seconds - 1.5) / 2.5, 1)), alpha);
}

InspectRadius :: 16.0;      // How far around its hero the inspector shows where it is safe

drawInspection :: method (bot: *Bot, game: *Game, me: int) {
    player := &game.players[me];
    if !player.isPlaying() || !bot.hasForecast { return; }
    hero := &player.hero;
    now := game.time - bot.forecastAt;

    // Each cell around it, in the color of how long it stays free of cars, by what the bot knows. Walls are grey
    center := hero.ground();
    steps := math.floorf(InspectRadius / CellSize) as int;
    centerCell := cellAt(center);
    if centerCell < 0 { return; }
    middle := cellCenter(centerCell);
    for dy in -steps...steps {
        for dx in -steps...steps {
            point := middle + Vector2{dx as f32 * CellSize, dy as f32 * CellSize};
            if point.distance(center) > InspectRadius { continue; }
            cell := cellAt(point);
            if cell < 0 { continue; }
            color := Color{120, 120, 130, 90};
            if !bot.forecast.blocked[cell] {
                interval := bot.forecast.intervalAt(cell, now);
                free: f32 = 0;
                if interval >= 0 { free = bot.forecast.safe[interval].end - now; }
                color = safetyColor(free, 0.33);
            }
            DrawCube(point.at(0.2), CellSize * 0.9, 0.03, CellSize * 0.9, color);
        }
    }

    // Its plan: the points where it waits for a gap are yellow, and bigger the longer it waits
    previous := hero.position + Vector3{0, 0.5, 0};
    arrived := game.time;
    for waypoint, i in bot.plan {
        if i < bot.next { continue; }
        point := waypoint.point.at(0.5);
        DrawCylinderEx(previous, point, 0.12, 0.12, 4, player.color);
        wait := waypoint.depart - arrived;
        if wait > 0.15 {
            DrawSphere(previous, 0.3 + math.min(wait, 3) * 0.2, {250, 220, 60, 220});
        }
        previous = point;
        arrived = waypoint.arrive;
    }

    // A ring around it in the color of how soon a car is on it
    hit := bot.forecast.hitTime(center, now, 0) - now;
    DrawCircle3D(hero.position + Vector3{0, 0.3, 0}, hero.info().hitRadius + 0.6, {1, 0, 0}, 90, safetyColor(hit, 1));
    DrawCircle3D(hero.position + Vector3{0, 0.3, 0}, hero.info().hitRadius + 0.5, {1, 0, 0}, 90, safetyColor(hit, 1));
}

describe :: method (bot: *Bot, game: *Game, me: int, lines: *[..]InspectorLine) {
    player := &game.players[me];
    hero := &player.hero;
    decision := bot.decision;
    lines.add(InspectorLine{tprint("% (%) · %", player.name, bot.personality.label, hero.info().name), player.color});

    doing := switch decision.mode {
        case .waiting    => "Waiting for a gap";
        case .walking    => "Walking its plan";
        case .dodging    => "Dodging a car it didn't plan for";
        case .casting    => tprint("Casting %", decision.lastCast);
        case .noPlan     => "No plan: standing still";
        case .cantAct    => "Can't act: stunned, dragged or in the air";
        case .notPlaying => "Not on the field";
    };
    if decision.mode == .waiting && bot.next < bot.plan.count {
        doing = tprint("Waiting for a gap: leaves in % s", fmt.fixed(bot.plan[bot.next].depart - game.time, 1));
    }
    lines.add(InspectorLine{text: doing});

    if bot.hasForecast && player.isPlaying() {
        now := game.time - bot.forecastAt;
        hit := bot.forecast.hitTime(hero.ground(), now, 0) - now;
        text := "No car coming";
        if hit < ForecastHorizon { text = tprint("A car is on it in % s", fmt.fixed(hit, 1)); }
        lines.add(InspectorLine{text, safetyColor(hit, 1)});
    }

    across := "goes part of the way, to where it can wait";
    if bot.reachesGoal { across = "all the way across"; }
    if bot.chasing.hasValue() && game.items.onRoad.hasValue() {
        item := game.items.onRoad.value().kind.itemDefinition();
        lines.add(InspectorLine{tprint("Going for the %", item.name), item.color});
    }
    lines.add(InspectorLine{text: tprint("Plan: % points, %", bot.plan.count - bot.next, across)});
    lines.add(InspectorLine{tprint("Last search: % ms, % states. Forecast % s old",
        fmt.fixed((decision.lastSearch * 1000) as f32, 1), decision.lastStates, fmt.fixed(game.time - bot.forecastAt, 2)), DimColor});

    // The abilities, with the score of the last look at them against the bar
    lines.add(InspectorLine{tprint("Abilities (cast when over %):", fmt.fixed(decision.bar, 2)), DimColor});
    for ability, slot in hero.abilities() {
        score := decision.scores[slot];
        state := "";
        color := TextColor;
        if ability.isPassive() {
            state = "passive";
            color = DimColor;
        } else if !hero.abilityReady(slot as int) || score < 0 {
            state = tprint("cooling down, % s", fmt.fixed(hero.cooldowns[slot], 1));
            color = DimColor;
        } else {
            state = tprint("%", fmt.fixed(score, 2));
            if score > decision.bar { color = {120, 255, 140, 255}; }
        }
        lines.add(InspectorLine{tprint("    %: %", ability.name, state), color});
    }
    if decision.lastCast.len > 0 {
        lines.add(InspectorLine{tprint("Last cast % % s ago", decision.lastCast, fmt.fixed(game.time - decision.lastCastAt, 1)), DimColor});
    }

    stats := bot.stats;
    lines.add(InspectorLine{tprint("Waited % s, walked % s, dodged % times", stats.waiting as int, stats.walking as int, stats.dodges), DimColor});
    lines.add(InspectorLine{tprint("Crossed %, run over %", player.stats.crossings, player.stats.deaths), DimColor});
}

// Its plan, faintly, in its color: shown for every bot while the inspector is open
drawPlan :: method (bot: *Bot, game: *Game, me: int) {
    player := &game.players[me];
    previous := player.hero.position + Vector3{0, 0.4, 0};
    path := bot.plannedPath();
    for waypoint in path {
        point := waypoint.point.at(0.4);
        DrawLine3D(previous, point, ColorAlpha(player.color, 0.7));
        previous = point;
    }
    if path.count > 0 { DrawSphere(path[path.count - 1].point.at(0.5), 0.5, player.color); }
}
