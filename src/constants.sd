Gray       :: Color{ 30, 30, 30, 255 };
DarkGray   :: Color{ 40, 40, 40, 255 };

WindowWidth  :: 1920;
WindowHeight :: 1080;

GRID_SIZE     :: 128;
GRID_LEN      :: GRID_SIZE * 0.5;
ROAD_WIDTH    :: GRID_SIZE * 0.8;
ROAD_HEIGHT   :: GRID_SIZE;
TILE_REPEAT   :: 4;

CAR_WIDTH  :: 5;
CAR_HEIGHT :: 3;
CAR_LENGTH :: 8;
// MAX_CAR_COUNT :: 128;
MAX_CAR_COUNT :: 96;

WALL_WIDTH  :: 4;
WALL_HEIGHT :: 5;
WALL_LENGTH :: GRID_SIZE;

PLAYER_HITBOX_ASPECT_RATIO :: 0.6;
MAX_PLAYER_COUNT :: 4;

ENTRANCE_LENGTH :: 20;

MapBoundThichness :: 12;
MapBoundTop :: Rectangle{
    x = -GRID_LEN,
    y = -GRID_LEN - MapBoundThichness,
    width = GRID_SIZE,
    height = MapBoundThichness,
};
MapBoundRight :: Rectangle{
    x = GRID_LEN,
    y = -GRID_LEN,
    width = MapBoundThichness,
    height = GRID_SIZE,
};
MapBoundBottom :: Rectangle{
    x = -GRID_LEN,
    y = GRID_LEN,
    width = GRID_SIZE,
    height = MapBoundThichness,
};
MapBoundLeft :: Rectangle{
    x = -GRID_LEN - MapBoundThichness,
    y = -GRID_LEN,
    width = MapBoundThichness,
    height = GRID_SIZE,
};

MapBoundRects :: [
    MapBoundTop,
    MapBoundRight,
    MapBoundBottom,
    MapBoundLeft,
];