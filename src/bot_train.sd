// Trains the bots with a genetic algorithm: a population of genomes (bots/genome.sd) plays games against each other and
// against the best of earlier generations (the hall of fame), and the fitter ones (bots.fitnessOf: crossings, deaths,
// kills, progress, speed) have the children of the next generation. The best genome is written to
// data/bots/genomes.json after each generation, which the game plays with (bots/difficulty.sd).
//
//     saad build bot_train.sd --llvm             the bots think about 10 times as fast with LLVM
//     build/out.exe --generations 40 --threads 4
//
// build/out.exe --help lists the options: --generations, --population, --games, --seconds, --threads, --seed, --playoff,
// --levels, --method, --sigma, --dt, --from-default and --out
//
// So that what is trained works for any hero, any traffic and any enemies, and not for the games it happened to play:
//
//   * Each round of a generation, every game has the same seed: the same traffic, and the same heroes in each seat. The
//     candidates are shuffled into the seats, so each plays the others on the same road, and luck counts for less
//   * The seeds are new each round and each generation, so the heroes, the traffic and its events are always others
//   * The traffic starts at a level at random each round, so it plays slow and fast traffic alike
//   * The fourth bot of each game is one of the hall of fame, so it doesn't only learn to beat the population

import core;
import bots;
import cli;
import fmt;
import json;
import math;
import os;
import random;
import thread;
import time;

Dt :: 1.0 / 60.0;          // The time step of a game, unless --dt says otherwise

@cli.Options(about: "Trains the bots: CMA-ES or a genetic algorithm, over games of the population against each other and the hall of fame")
Config :: struct {
    @cli.Arg(help: "How many generations", min: 1)
    generations:    int = 40;
    @cli.Arg(help: "Genomes in each generation (rounded down to a multiple of 3)", min: 3)
    population:     int = 24;
    @cli.Arg(help: "Games each genome plays in a generation", min: 1)
    games:          int = 6;
    @cli.Arg(help: "How long each game is", min: 1)
    seconds:        int = 90;
    @cli.Arg(help: "Games played at once", min: 1)
    threads:        int = 4;
    @cli.Arg(help: "The seed of the training")
    seed:           u64 = 1;
    @cli.Arg(skip: true)
    elite:          int = 4;        // The best, kept as they are (and played again, so luck doesn't keep them)
    @cli.Arg(skip: true)
    tournament:     int = 3;
    @cli.Arg(name: "from-default", help: "Starts from the hand tuned genes instead of the trained ones")
    fromDefault:    bool;
    @cli.Arg(help: "Games each finalist plays at the end, 0 for none", min: 0)
    playoff:        int = 32;
    @cli.Arg(help: "The traffic starts at a level up to this, at random each round", min: 0)
    levels:         int = 6;
    @cli.Arg(help: "How it trains")
    method:         Method = .cmaes;
    @cli.Arg(help: "How big the cloud of CMA-ES is at first, in the range of a gene", min: 0)
    sigma:          f64 = 0.15;
    @cli.Arg(name: "dt", help: "Steps a second of the games: fewer is quicker, and plays a little worse", min: 1)
    stepsPerSecond: f32 = 60;
    @cli.Arg(skip: true)
    dt:             f32 = Dt;       // The time step of the games, from stepsPerSecond
    @cli.Arg(help: "Where the best genome is written (data/bots/genomes.json when not given)")
    out:            string;
}

// How it trains
Method :: enum {
    cmaes,      // CMA-ES: a cloud of genomes that moves towards the better ones (bots/cmaes.sd)
    ga,         // A genetic algorithm: the fitter have the children of the next generation
}

Candidate :: struct {
    genome:    bots.Genome;
    fitness:   f32;
    games:     int;
    crossings: int;
    deaths:    int;
    kills:     int;
    index:     int;         // In the playoff
}

// A game of three candidates and one of the hall of fame
PerGame :: 4;
Candidates :: 3;

GameJob :: struct {
    genomes:    [PerGame]bots.Genome;
    candidates: [PerGame]int;       // The candidate of each bot, -1 for the one of the hall of fame
    seed:       u64;
    seconds:    int;
    level:      int;
    dt:         f32;
    fitness:    [PerGame]f32;
    crossings:  [PerGame]int;
    deaths:     [PerGame]int;
    kills:      [PerGame]int;
}

Queue :: struct {
    jobs:  [..]GameJob;
    next:  int;
    mutex: thread.Mutex;
    group: thread.WaitGroup;
}

Worker :: struct {
    queue: *Queue;
}

// Plays a game of a job, on a thread of its own
playGame :: (job: *GameJob) {
    personalities: [..]bots.BotPersonality;
    defer personalities.free();
    for genome in job.genomes { personalities.add(bots.BotPersonality{label: "trained", genome: genome}); }
    game := bots.newGameWith(job.seed, personalities, humans: 0);
    defer game.free();
    if job.level > 0 { game.startAtLevel(job.level); }

    steps := (job.seconds as f32 / job.dt) as int;
    for 0..steps { game.simulate(job.dt); }

    for i in 0..PerGame {
        job.fitness[i] = bots.fitnessOf(game, i as int);
        job.crossings[i] = game.players[i].stats.crossings;
        job.deaths[i] = game.players[i].stats.deaths;
        job.kills[i] = game.players[i].stats.kills;
    }
}

// Takes the next job until there are none
work :: (worker: *Worker) {
    queue := worker.queue;
    for {
        queue.mutex.lock();
        index := queue.next;
        queue.next += 1;
        queue.mutex.unlock();
        if index >= queue.jobs.count { break; }
        playGame(&queue.jobs[index]);
    }
    queue.group.done();
}

// Plays the jobs on the threads, and waits for all of them
playAll :: (jobs: [..]GameJob, threads: int) {
    queue := Queue{jobs: jobs};
    workers: [..]Worker;
    defer workers.free();
    for 0..threads { workers.add(Worker{&queue}); }
    queue.group.add(threads);
    for i in 0..threads { thread.spawn(work, &workers[i]); }
    queue.group.wait();
}

readConfig :: () -> Config {
    config, err := cli.parseArguments<Config>();
    if err != null {
        fmt.print("%", err.message);
        os.exit(2);
    }
    config.dt = 1 / config.stepsPerSecond;
    config.population = math.max(config.population - config.population % Candidates, Candidates);
    return config;
}

main :: () {
    config := readConfig();
    if config.out.len == 0 {
        folder := core.dataFolder();
        config.out = fmt.sprint("%%", folder, bots.TrainedGenomesFile);
    }
    rng := random.newRandom(config.seed);
    _ := core.HeroKind.allan.definition();      // Made before the threads start, which only read it

    // The first generation: the best genome there is, and variations of it
    start := bots.defaultGenome();
    if !config.fromDefault { start = bots.trainedGenome(); }
    population: [..]Candidate;
    population.add(Candidate{genome: start});
    for i in 1..config.population {
        strength: f32 = 0.15;
        if i > config.population * 2 / 3 { population.add(Candidate{genome: bots.randomGenome(&rng)}); continue; }
        population.add(Candidate{genome: bots.mutate(start, &rng, 0.6, strength)});
    }
    hallOfFame: [..]bots.Genome;
    hallOfFame.add(start);

    cmaes := config.method == .cmaes;
    es: bots.Cmaes;
    if cmaes { es = bots.newCmaes(start, population.count as int, config.sigma); }

    fmt.print("Training % generations of %, % games of % s each, traffic from level 0 to %, on % threads, with %", config.generations, config.population, config.games, config.seconds, config.levels, config.threads, config.method);
    best: Candidate;
    for generation in 0..config.generations {
        started := time.clock();
        if cmaes {
            drawn := es.draw(&rng);
            defer drawn.free();
            for genome, i in drawn { population[i] = Candidate{genome: genome}; }
        }
        evaluate(&population, generation, config, hallOfFame, &rng);
        if cmaes {
            fitness: [..]f32;
            defer fitness.free();
            for candidate in population { fitness.add(candidate.fitness); }
            es.learn(fitness);
        }
        ranked := population.copy();
        defer ranked.free();
        ranked.sort();        // The fittest first, see operator < below

        best = ranked[0];
        average: f32 = 0;
        for candidate in ranked { average += candidate.fitness; }
        average /= ranked.count as f32;
        spread := "";
        if cmaes { spread = fmt.sprint(", sigma %", fmt.fixed(es.sigma as f32, 3)); }
        fmt.print("Generation %: best % (each game % across, % run over, % kills), average %%, % s",
            generation + 1, fmt.fixed(best.fitness, 2),
            fmt.fixed(best.crossings as f32 / best.games as f32, 2), fmt.fixed(best.deaths as f32 / best.games as f32, 2),
            fmt.fixed(best.kills as f32 / best.games as f32, 2), fmt.fixed(average, 2), spread, fmt.fixed((time.clock() - started) as f32, 1));

        // CMA-ES keeps the middle of its cloud, which is the best guess: the best of a generation is mostly the luckiest
        kept := best;
        if cmaes { kept = Candidate{genome: es.best(), fitness: average}; }
        save(config.out, kept, generation + 1);
        if (generation + 1) % 5 == 0 { hallOfFame.add(kept.genome); }

        if cmaes { continue; }
        // The next generation: the elite as they are, and children of parents picked by tournaments
        next: [..]Candidate;
        for i in 0..config.elite { next.add(Candidate{genome: ranked[i].genome}); }
        strength := math.lerp(0.15, 0.04, generation as f32 / math.max(config.generations - 1, 1) as f32);
        while next.count < population.count {
            a := tournament(ranked, config.tournament, &rng);
            b := tournament(ranked, config.tournament, &rng);
            child := bots.crossover(a, b, &rng);
            child = bots.mutate(child, &rng, 0.25, strength);
            next.add(Candidate{genome: child});
        }
        population.free();
        population = next;
    }

    if config.playoff <= 0 {
        fmt.print("Done, without a playoff. The genome of the last generation is in %", config.out);
        return;
    }

    // The playoff: the best of each generation is the one that was luckiest in a few games, so the hall of fame, the
    // elite and the hand tuned genes play many games against each other, and the best of those is the one that is kept
    finalists: [..]bots.Genome;
    defer finalists.free();
    finalists.add(bots.defaultGenome());
    for genome in hallOfFame { finalists.add(genome); }
    if cmaes { finalists.add(es.best()); }
    else     { for i in 0..config.elite { finalists.add(population[i].genome); } }
    results := playoff(finalists, config.playoff, config, &rng);
    defer results.free();
    fmt.print("Playoff of % genomes, % games each:", finalists.count, config.playoff);
    for result, i in results {
        label := "";
        if result.index == 0 { label = " (hand tuned)"; }
        fmt.print("  %. fitness % (each game % across, % run over, % kills)%", i + 1, fmt.fixed(result.fitness, 2),
            fmt.fixed(result.crossings as f32 / result.games as f32, 2), fmt.fixed(result.deaths as f32 / result.games as f32, 2),
            fmt.fixed(result.kills as f32 / result.games as f32, 2), label);
    }
    save(config.out, results[0], config.generations);
    fmt.print("Done. The best genome is in %", config.out);
}

// The games of a generation: each round, the candidates in a new order, three to a game, with one of the hall of fame.
// Every game of a round has the same seed, and the level of its traffic comes from the seed, so two ways of training
// play the same games. Each candidate's fitness is the mean of its games
evaluate :: (population: *[..]Candidate, generation: int, config: Config, hallOfFame: []bots.Genome, rng: *random.Random) {
    for *candidate in *population { *candidate = Candidate{genome: candidate.genome}; }
    jobs: [..]GameJob;
    defer jobs.free();
    order: [..]int;
    defer order.free();
    for i in 0..population.count { order.add(i as int); }
    for round in 0..config.games {
        rng.shuffle(order);
        seed := config.seed * 1000003 + (generation * 1000 + round) as u64;
        level := ((seed * 2654435761) >> 7) % (config.levels as u64 + 1);
        for g in 0..population.count / Candidates {
            job := GameJob{seed: seed, seconds: config.seconds, level: level as int, dt: config.dt};
            for k in 0..Candidates {
                index := order[g * Candidates + k];
                job.genomes[k] = (*population)[index].genome;
                job.candidates[k] = index;
            }
            job.genomes[Candidates] = rng.choice(hallOfFame);
            job.candidates[Candidates] = -1;
            jobs.add(job);
        }
    }
    playAll(jobs, config.threads);

    for job in jobs {
        for k in 0..PerGame {
            index := job.candidates[k];
            if index < 0 { continue; }
            candidate := &(*population)[index];
            candidate.fitness += job.fitness[k];
            candidate.games += 1;
            candidate.crossings += job.crossings[k];
            candidate.deaths += job.deaths[k];
            candidate.kills += job.kills[k];
        }
    }
    for *candidate in *population { candidate.fitness /= math.max(candidate.games, 1) as f32; }
}

// Each finalist plays games against three others, picked at random, and their fitness is the mean of their games
playoff :: (finalists: []bots.Genome, games: int, config: Config, rng: *random.Random) -> [..]Candidate {
    jobs: [..]GameJob;
    defer jobs.free();
    order: [..]int;
    defer order.free();
    for i in 0..finalists.count { order.add(i as int); }
    for round in 0..games {
        rng.shuffle(order);
        for g in 0..finalists.count / PerGame {
            job := GameJob{seed: config.seed * 7919 + round as u64 + 99999, seconds: config.seconds, level: round % (config.levels + 1), dt: config.dt};
            for k in 0..PerGame {
                index := order[g * PerGame + k];
                job.genomes[k] = finalists[index];
                job.candidates[k] = index;
            }
            jobs.add(job);
        }
        // The ones left over play too, with others that don't count again
        left := finalists.count % PerGame;
        if left > 0 {
            job := GameJob{seed: config.seed * 7919 + round as u64 + 99999, seconds: config.seconds, level: round % (config.levels + 1), dt: config.dt};
            for k in 0..PerGame {
                if k < left {
                    index := order[finalists.count - left + k];
                    job.genomes[k] = finalists[index];
                    job.candidates[k] = index;
                } else {
                    job.genomes[k] = finalists[order[k]];
                    job.candidates[k] = -1;
                }
            }
            jobs.add(job);
        }
    }
    playAll(jobs, config.threads);

    results: [..]Candidate;
    for genome, i in finalists { results.add(Candidate{genome: genome, index: i as int}); }
    for job in jobs {
        for k in 0..PerGame {
            if job.candidates[k] < 0 { continue; }
            result := &results[job.candidates[k]];
            result.fitness += job.fitness[k];
            result.games += 1;
            result.crossings += job.crossings[k];
            result.deaths += job.deaths[k];
            result.kills += job.kills[k];
        }
    }
    for *result in results { result.fitness /= math.max(result.games, 1) as f32; }
    results.sort();
    return results;
}

// The fittest first
operator < :: (a: Candidate, b: Candidate) -> bool {
    return a.fitness > b.fitness;
}

// The fittest of a few candidates picked at random
tournament :: (population: []Candidate, size: int, rng: *random.Random) -> bots.Genome {
    best := rng.choice(population);
    for 1..size {
        other := rng.choice(population);
        if other.fitness > best.fitness { best = other; }
    }
    return best.genome;
}

save :: (path: string, best: Candidate, generations: int) {
    trained := bots.TrainedGenomes{
        best:        best.genome.toJson(),
        fitness:     best.fitness,
        generations: generations,
        trained:     time.now().format("2006-01-02 15:04"),
    };
    text := json.encode(trained, json.Pretty);
    defer text.free();
    _ := os.makeDir(path.slice(0, path.lastIndexOf("/")));
    err := os.writeFile(path, text);
    if err != null { fmt.print("ERROR: Couldn't write %: %", path, err.message); }
}
