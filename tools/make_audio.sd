//
// Voices
//

VoiceEvent :: enum {
    spawn,
    cast,
    crossed,
    death,
    kill,
    move,
}

// A hero's voice: the ElevenLabs voice, how much higher or lower it is made (semitones), its speed, a room (none, echo,
// cave), and how steady it is (lower is more expressive)
Voice :: struct {
    hero:      string;
    id:        string;
    pitch:     f32;
    speed:     f32 = 1;
    stability: f32 = 0.4;
    room:      string;
    noises:    string;      // A hero that doesn't talk makes noises: what they sound like. Its lines say what each is
}

