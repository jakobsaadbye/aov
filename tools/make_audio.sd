//
// Music
//

// What the music of the game is for, and so what every soundtrack keeps to (it is in every prompt, after the style of its
// soundtrack):
//
//   - The game comes first. The music plays quietly under the hum of the traffic, the horns and brakes, the spells and
//     the lines of the heroes, so it leaves them room: no vocals, a light low end, and few instruments at a time.
//   - Even. Heroes are run over and get across all the time, at random, so the music doesn't comment on any of it: no
//     build-ups, drops, climaxes or stingers, and the same level from start to end.
//   - Light-hearted. Being run over is the joke of the game, so the music is never tense, sad or dark.
//   - One small band for each soundtrack, in keys and tempos close to each other, so its pieces sound like one whole.
//   - About a minute and a half a piece. The game mixes the pieces of all the soundtracks, shuffled anew every game, with
//     silence between, so the pieces of one have to sit well next to those of another: the brief is what they share.
MusicBrief :: "Background music for a light-hearted party video game, played quietly under the constant noise of traffic, sound effects and spoken character lines. Instrumental only, no vocals, no choir. A light low end and an uncluttered arrangement that stays out of the way. Even dynamics from start to end: no build-ups, drops, climaxes or sudden stops. Never tense, sad or dark. It starts right away and ends with a short, clean fade";

// A soundtrack: the style its pieces share, the same little band in it. Its pieces are written to data/music/<name>/,
// and the game plays one soundtrack at a time (core/sound.sd, Soundtracks)
SoundtrackStyle :: struct {
    name:  string;
    style: string;
}

Soundtracks :: [
    // Cheerful and melodic, a little band of piano, pizzicato, marimba and guitar
    SoundtrackStyle{"band", "Cheerful, bright instrumental music for a playful video game, upbeat and light on its feet. A bouncy piano leads the melody, with pizzicato strings, a marimba and a lightly strummed acoustic guitar. Light percussion: a shaker, hand claps and a soft kick, never heavy. Around 112 BPM, with a skipping, playful rhythm. Major keys, sunny and optimistic"},
    // Calm and sparse, with room between the notes, a quiet counterweight to the chaos on the road (like Minecraft)
    SoundtrackStyle{"quiet", "Calm, sparse ambient piano music with a lot of space between the notes, like a quiet summer evening in a Nordic town. A soft felt piano plays slow, simple, slightly wistful phrases that drift and repeat, with a faint warm synth pad high up and a long, soft reverb. Around 70 BPM, unhurried and free, no drums. Gentle, peaceful, nostalgic and a little dreamy"},
    // A loop you stop noticing, like the music of a party board game (Mario Party): a short motif and a steady groove
    SoundtrackStyle{"board", "A light, loopable background groove for a party board game, friendly and unobtrusive, like menu music you soon stop noticing. A short, catchy motif repeats with small variations on marimba and vibraphone, over pizzicato strings, a soft plucked upright bass, light brushed drums and a shaker. Around 104 BPM with a relaxed swing. Simple, steady and tidy: it supports the play and never takes the lead"},
    // Toy instruments and slapstick, for the comedy of being run over
    SoundtrackStyle{"toybox", "Quirky, comedic cartoon music played on toy instruments, like a tiny orchestra in a toy box. A toy piano and a glockenspiel play a silly, bouncy tune, with a ukulele, a bassoon playing light staccato bass notes, playful clarinet accents, a few slide whistle swoops, woodblocks and a triangle. Around 116 BPM. Goofy, charming slapstick like a funny cartoon short, but kept gentle so it can play under a game"},
];

Piece :: struct {
    soundtrack: string;    // Of Soundtracks
    name:    string;    // music.<soundtrack>.<name>, written to data/music/<soundtrack>/<name>.ogg. Not ending in
                        // _<number>, and no other piece of any soundtrack has the same name: the game finds it by it
    feel:    string;
    seconds: int;
}

Pieces :: [
    Piece{"band", "first_light", "Sunny and eager, like the city waking up on a bright morning. In D major: a hopping piano melody over plucked strings, with the marimba answering each phrase", 80},
    Piece{"band", "puddles", "Playful and mischievous, like jumping in puddles after the rain. In A major: staccato piano and pizzicato, a little melody that skips up and down, and claps on the off-beats", 90},
    Piece{"band", "lanterns", "Festive and warm, like a busy evening market strung with lanterns. In G major: strummed guitar and piano chords, a light flute melody, and a bouncing bass", 100},
    Piece{"band", "far_side", "Triumphant and joyful, like making it across against the odds. In D major: a bright theme that comes back twice and grows each time, with strings and the whole little band joining in the middle", 110},

    Piece{"quiet", "dew", "Early morning, dew on the grass beside the road. In C major: a few slow piano notes, then a simple melody that rises, rests and comes back", 90},
    Piece{"quiet", "drizzle", "Light rain on the asphalt, cosy and calm. In G major: soft repeated piano notes like falling drops, and a slow melody that wanders in the middle", 90},
    Piece{"quiet", "long_light", "The long, golden light of a Nordic summer evening. In F major with a lydian colour: warm piano chords that rock gently, and a high melody that comes and goes", 90},

    Piece{"board", "dice_roll", "Breezy and curious, like waiting for your turn. In F major: a marimba motif in thirds, with the vibraphone answering softly", 80},
    Piece{"board", "town_square", "Pleasantly busy, like a sunny town square full of people. In B flat major: vibraphone chords on the off-beats and a marimba melody that hops between a few notes", 85},
    Piece{"board", "shortcut", "Sneaky and playful, like tiptoeing past the others, funny rather than dark. In D dorian: staccato pizzicato and muted plucks, with a woodblock ticking along", 80},

    Piece{"toybox", "wind_up", "A wind-up toy marching along, steady and silly. In C major: a toy piano melody over bassoon staccato, and a woodblock going tick-tock", 75},
    Piece{"toybox", "toy_parade", "A tiny parade of toy soldiers, proud and silly. In G major: a glockenspiel melody, woodblock rolls like a little snare, and bassoon oom-pahs", 75},
    Piece{"toybox", "pratfall", "Clumsy and cheerful, like slipping on a banana peel and getting right back up. In F major: glockenspiel and ukulele, with little slide whistle swoops between the phrases", 75},
];

styleOf :: (soundtrack: string) -> string {
    for track in Soundtracks { if track.name == soundtrack { return track.style; } }
    return "";
}

musicPrompt :: (piece: Piece) -> string {
    return fmt.sprint("%. %. %", piece.feel, styleOf(piece.soundtrack), MusicBrief);
}

//
// Making them
//

// A file to make: a sound or a line
Job :: struct {
    name:   string;         // e.g ability.hex, voice.hugo_cast_1
    effect: int = -1;       // In Effects, or
    line:   int = -1;       // in Lines, or
    piece:  int = -1;       // in Pieces
}

MusicRequest :: struct {
    prompt:            string;
    musicLengthMs:     int;
    modelId:           string;
    forceInstrumental: bool;
}

SoundRequest :: struct {
    text:            string;
    durationSeconds: f32;
    promptInfluence: f32;
}

VoiceSettings :: struct {
    stability:       f32;
    similarityBoost: f32;
    style:           f32;
    useSpeakerBoost: bool;
}

SpeechRequest :: struct {
    text:          string;
    modelId:       string;
    voiceSettings: VoiceSettings;
}

familyWords :: (name: string) -> string {
    for family in Families {
        if family.name == name { return family.words; }
    }
    return "";
}

voiceOf :: (hero: string) -> Voice {
    for voice in Voices {
        if voice.hero == hero { return voice; }
    }
    assert(false);
    return Voices[0];
}

prompt :: (effect: Effect) -> string {
    return fmt.sprint("%. %. Clean game sound effect, no music, no voices", effect.what, familyWords(effect.family));
}

// The noise of a hero that doesn't talk, e.g Frosty: what this one is, and what its noises sound like
noisePrompt :: (line: Line) -> string {
    return fmt.sprint("%. %", line.text, voiceOf(line.hero).noises);
}

// How long a noise is: an answer to a move order is short
noiseSeconds :: (event: VoiceEvent) -> f32 {
    if event == .move  { return 0.7; }
    if event == .death { return 2; }
    return 1.4;
}

// The lines of a hero for an event are numbered from 1
lineName :: (index: int) -> string {
    line := Lines[index];
    number := 1;
    for i in 0..index {
        if Lines[i].hero == line.hero && Lines[i].event == line.event { number += 1; }
    }
    return fmt.sprint("voice.%_%_%", line.hero, VoiceEvent.names[line.event], number);
}

// What a file is made from: when it changes, the file is made again
recipe :: (job: Job) -> string {
    if job.piece >= 0 {
        piece := Pieces[job.piece];
        return fmt.sprint("% | % | %", musicPrompt(piece), piece.seconds, MusicModel);
    }
    if job.effect >= 0 {
        effect := Effects[job.effect];
        return fmt.sprint("% | % | %", prompt(effect), effect.seconds, Model);
    }
    line := Lines[job.line];
    voice := voiceOf(line.hero);
    if voice.noises.len > 0 { return fmt.sprint("% | % | sound", noisePrompt(line), noiseSeconds(line.event)); }
    return fmt.sprint("% | % % % % % | % | %", voice.id, voice.pitch, voice.speed, voice.stability, voice.room, Model, line.text, Model);
}

apiKey :: () -> string {
    key, found := os.getEnv("ELEVENLABS_API_KEY");
    if found && key.len > 0 { return key; }
    return "proxy-injected";      // A proxy that knows the key puts it in
}

// Posts JSON to the API and returns the audio it answers with, trying again a few times when it is busy
post :: (path: string, body: string) -> string, string {
    headers := [http.Header{"Content-Type", "application/json"}, http.Header{"xi-api-key", apiKey()}];
    for attempt in 0..4 {
        response, err := http.request("POST", fmt.sprint("%%", Api, path), headers, body);
        if err != null { return "", err.message; }
        defer response.free();
        if response.status == 200 { return response.body.copy(), ""; }
        if (response.status == 429 || response.status >= 500) && attempt < 3 {
            time.sleep(4000 * (attempt + 1));
            continue;
        }
        return "", fmt.sprint("HTTP %: %", response.status, response.body.slice(0, math.min(response.body.len, 300)));
    }
    return "", "gave up";
}

makeAudio :: (job: Job) -> string, string {
    if job.piece >= 0 {
        piece := Pieces[job.piece];
        body := json.encode(MusicRequest{musicPrompt(piece), piece.seconds * 1000, MusicModel, true}, json.SnakeCase);
        return post("/music?output_format=mp3_44100_128", body);
    }
    if job.effect >= 0 {
        effect := Effects[job.effect];
        body := json.encode(SoundRequest{prompt(effect), effect.seconds, 0.6}, json.SnakeCase);
        return post("/sound-generation?output_format=mp3_44100_128", body);
    }
    line := Lines[job.line];
    voice := voiceOf(line.hero);
    if voice.noises.len > 0 {
        body := json.encode(SoundRequest{noisePrompt(line), noiseSeconds(line.event), 0.6}, json.SnakeCase);
        return post("/sound-generation?output_format=mp3_44100_128", body);
    }
    settings := VoiceSettings{stability: voice.stability, similarityBoost: 0.8, style: 0.45, useSpeakerBoost: true};
    body := json.encode(SpeechRequest{line.text, Model, settings}, json.SnakeCase);
    return post(fmt.sprint("/text-to-speech/%?output_format=mp3_44100_128", voice.id), body);
}

// Where the game finds a file: data/sounds/<group>/<name>.ogg, and data/music/<soundtrack>/<name>.ogg for music
folderOf :: (name: string) -> string {
    group := name.slice(0, name.indexOf("."));
    if group == "music" { return fmt.sprint("%/%", MusicFolder, name.slice(name.indexOf(".") + 1, name.lastIndexOf("."))); }
    return fmt.sprint("%/%", Sounds, group);
}

baseOf :: (name: string) -> string {
    return name.slice(name.lastIndexOf(".") + 1);
}

pathOf :: (name: string) -> string {
    return fmt.sprint("%/%.ogg", folderOf(name), baseOf(name));
}

// The mp3 from ElevenLabs as the .ogg of the game, with ffmpeg: trimmed, as loud as the others, and pitched and put in a
// room for the voice of its hero. Music fades in and out, and is a bit quieter. The .wav of make_sounds.py by the same
// name goes
finish :: (audio: string, job: Job) -> bool {
    folder := folderOf(job.name);
    base := baseOf(job.name);
    _ := os.makeDir(folder);
    out := pathOf(job.name);
    source := fmt.sprint("%.mp3", out);
    if os.writeFile(source, audio) != null { return false; }
    defer os.removeFile(source);

    filters := fmt.newStringBuilder(256);
    defer filters.free();
    filters.addString("silenceremove=start_periods=1:start_threshold=-45dB,areverse,silenceremove=start_periods=1:start_threshold=-45dB,areverse");
    channels := 2;
    if job.line >= 0 {
        channels = 1;
        voice := voiceOf(Lines[job.line].hero);
        rate := math.powf(2, voice.pitch / 12);
        tempo := voice.speed / rate;
        if rate != 1 || tempo != 1 {
            filters.add(",asetrate=%,aresample=44100,atempo=%", (44100 * rate) as int, fmt.fixed(tempo, 4));
        }
        if voice.room == "echo" { filters.addString(",aecho=0.8:0.6:60|120:0.25|0.15"); }
        if voice.room == "cave" { filters.addString(",aecho=0.8:0.7:180|400|700:0.35|0.25|0.15"); }
    }
    if job.piece >= 0 {
        filters.addString(",afade=t=in:d=1.5,areverse,afade=t=in:d=4,areverse,loudnorm=I=-18:TP=-2:LRA=11");
    } else {
        filters.addString(",loudnorm=I=-16:TP=-1.5:LRA=11");
    }
    command := fmt.sprint("ffmpeg -y -loglevel error -i \"%\" -af \"%\" -ar 44100 -ac % -c:a libvorbis -q:a 5 \"%\"",
        source, filters.toString(), channels, out);
    if os.run(command) != 0 { return false; }
    old := fmt.sprint("%/%.wav", folder, base);
    if os.fileExists(old) { os.removeFile(old); }
    return true;
}

// The jobs the arguments ask for: all, sfx, voices, music, or names, or the start of names, e.g music.quiet
jobsFor :: (args: []string) -> [..]Job {
    jobs: [..]Job;
    names := 0;
    for arg in args { if !arg.startsWith("--") && arg != "sfx" && arg != "voices" && arg != "music" { names += 1; } }
    wants :: (args: []string, name: string, group: string, names: int) -> bool {
        all := true;
        for arg in args {
            if arg.startsWith("--") { continue; }
            all = false;
            if arg == group || arg == name || name.startsWith(fmt.sprint("%.", arg)) { return true; }
        }
        return all;
    };
    for effect, i in Effects {
        if wants(args, effect.name, "sfx", names) { jobs.add(Job{name: effect.name, effect: i as int}); }
    }
    for line, i in Lines {
        name := lineName(i as int);
        if wants(args, name, "voices", names) { jobs.add(Job{name: name, line: i as int}); }
    }
    for piece, i in Pieces {
        name := fmt.sprint("music.%.%", piece.soundtrack, piece.name);
        if wants(args, name, "music", names) { jobs.add(Job{name: name, piece: i as int}); }
    }
    return jobs;
}

// What a file is, for --list and the output
describe :: (job: Job) -> string {
    if job.effect >= 0 { return prompt(Effects[job.effect]); }
    if job.piece >= 0  { return fmt.sprint("% s, %", Pieces[job.piece].seconds, musicPrompt(Pieces[job.piece])); }
    return Lines[job.line].text;
}

main :: () {
    all := os.args();
    args := all.slice(1);
    force := false;
    list := false;
    adopt := false;
    for arg in args {
        if arg == "--force" { force = true; }
        if arg == "--list"  { list = true; }
        if arg == "--adopt" { adopt = true; }
    }
    jobs := jobsFor(args);
    defer jobs.free();

    if list {
        for job in jobs { fmt.print("% | %", job.name, describe(job)); }
        fmt.print("% files", jobs.count);
        return;
    }

    cache: Map<string, string>;
    if os.fileExists(CacheFile) {
        text, err := os.readFile(CacheFile);
        if err == null {
            read, decodeErr := json.decode<Map<string, string>>(text);
            if decodeErr == null { cache = read; }
        }
    }

    made := 0;
    for job in jobs {
        out := pathOf(job.name);
        digest := crypto.sha256(recipe(job)).hex();
        if adopt {
            if os.fileExists(out) { cache[job.name] = digest; }
            continue;
        }
        if !force && os.fileExists(out) && cache.has(job.name) && cache[job.name] == digest { continue; }

        audio, problem := makeAudio(job);
        if problem.len > 0 {
            fmt.print("FAILED % %", job.name, problem);
            if problem.indexOf("quota") >= 0 || problem.indexOf("HTTP 401") >= 0 { break; }
            continue;
        }
        if !finish(audio, job) {
            fmt.print("FAILED % ffmpeg", job.name);
            continue;
        }
        cache[job.name] = digest;
        os.writeFile(CacheFile, json.encode(cache, json.Pretty));
        made += 1;
        fmt.print("% | %", job.name, describe(job));
    }
    if adopt { os.writeFile(CacheFile, json.encode(cache, json.Pretty)); }
    fmt.print("Made % of %", made, jobs.count);
}
